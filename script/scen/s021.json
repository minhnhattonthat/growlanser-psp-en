  },
  {
   "id": "scen021.0001",
   "jp": "青年",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen021.0002",
   "jp": "村人",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen021.0003",
   "jp": "店員",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen021.0004",
   "jp": "行商人",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen021.0005",
   "jp": "村長",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen021.0006",
   "jp": "子供",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen021.0007",
   "jp": "拳法家",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen021.0008",
   "jp": "流浪の旅人",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen021.0009",
   "jp": "占い師",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen021.0010",
   "jp": "デリス村",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0011",
   "jp": "{v:0000}ここがウォレスさんがいる村？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0012",
   "jp": "{v:0001}そうみたい。{n}待ち合わせは宿だったよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0013",
   "jp": "ウォレスさんに会わなくていいの？{n}それとも忘れ物？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0014",
   "jp": "とりゃぁっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0015",
   "jp": "ルイセちゃんを放って、どこに行く気？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0016",
   "jp": "まだ用事が済んでないでしょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0017",
   "jp": "ウォレスさんを探すんじゃないの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0018",
   "jp": "{v:0004}そういえば、俺とはここで会ったんだよな。{n}お前たちが、この目を持ってきてくれたんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0019",
   "jp": "{v:0005}僕もこの村で助けてもらったときに{n}知り合ったんですよね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0020",
   "jp": "{v:0006}どう、覚えてる？{n}ルイセちゃん？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0021",
   "jp": "‥‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0022",
   "jp": "{v:0007}やっぱり、ダメみたいね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0023",
   "jp": "{v:0036}あ、あいつがいるよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0024",
   "jp": "{v:0045}あの人がどうしたのだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0025",
   "jp": "{v:0046}何だか思い詰めてるみたいなのよね、あの男。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0026",
   "jp": "‥‥{v:0047}あの男‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0027",
   "jp": "{v:0048}あの親子を見てるみたい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0028",
   "jp": "{v:0049}何を迷っている。{n}俺で良けりゃ、話してはくれまいか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0029",
   "jp": "‥‥{v:004A}あなたは？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0030",
   "jp": "{v:004B}ああ、すまない。{n}俺の名はウォレス。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0031",
   "jp": "{v:004C}ウォレス？{n}ひょっとして、放浪の剣士と呼ばれた、{n}あのウォレスなのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0032",
   "jp": "{v:004D}まあ、そう呼ばれたこともあるが‥‥昔の話だ。{n}今はこいつらと一緒に旅をする冒険者にすぎん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0033",
   "jp": "{v:004E}あなたの哮は子供の頃に良く聞いた。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0034",
   "jp": "{v:004F}だが何故こんな村に？{n}それにその姿は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0035",
   "jp": "{v:0050}２年ほど前になるか。{n}旅の最中で賊に会い、腕と眼を奪われた。{n}これはアイツの母親に作ってもらったものだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0036",
   "jp": "{v:0051}そんな体でどこに行こうというのですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0037",
   "jp": "{v:0052}盗まれた物を取り返しにな。{n}なまった体を鍛えるにはちょうどいい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0038",
   "jp": "‥‥{v:0053}わからない。{n}何故そこまでして剣を持とうとする？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0039",
   "jp": "{v:0054}信念‥‥ってやつか。{p}{v:0055}君は何かを悩んでいるようだが、{n}信念があれば答えは見えるはずだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0040",
   "jp": "{v:0056}私には信念がないというのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0041",
   "jp": "{v:0057}もう一度よく考えてみることだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0042",
   "jp": "{v:0058}待たせたな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0043",
   "jp": "{v:0059}やっぱり年長者の言葉は重みが違うわね～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0044",
   "jp": "{v:005A}あの人、大丈夫かな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0045",
   "jp": "{v:005B}本当の答えは自ら悟るものだ。{n}他人がとやかく言える物じゃない。{p}{v:005C}さ、賊を退治しに行こう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0046",
   "jp": "いろんな物が売ってるね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0047",
   "jp": "{v:005D}あら、ルイセちゃん、買い物？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0048",
   "jp": "{v:005E}ううん。見てるだけ★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0049",
   "jp": "{v:005F}それじゃ、またね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0050",
   "jp": "{v:0060}うん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0051",
   "jp": "‥‥{v:0037}何だ、お前たちか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0052",
   "jp": "{v:0038}お前じゃないよ、ティピだよ！{n}ところで、アンタさぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0053",
   "jp": "{v:0039}アンタじゃない。ジュリアンだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0054",
   "jp": "{v:003A}ムッ！{p}{v:003B}じゃあ、ジュリアン。{n}何見てんの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0055",
   "jp": "{v:003D}どうした、もっと力強く打ち込んでこい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0056",
   "jp": "{v:003F}あの親子がどうしたの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0057",
   "jp": "{v:0040}何とか言いなさいよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0058",
   "jp": "{v:0041}うるさいな！{n}１人にしてくれないか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0059",
   "jp": "どうしますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0060",
   "jp": "・このまま立ち去る",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen021.0061",
   "jp": "・元気がないようなので励ます",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen021.0062",
   "jp": "・口のきき方をとがめる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen021.0063",
   "jp": "・あえてもう一度たずねる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen021.0064",
   "jp": "{v:0042}怒鳴ったりして、すまなかった。{n}だが、今は１人にしてくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0065",
   "jp": "{v:0043}詮索好きな男は嫌われるぞ‥‥。{n}あっちにいけ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0066",
   "jp": "１人にしてくれないか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0067",
   "jp": "{v:0002}アンタらが怪我をしても、戦えるように、{n}薬草の栽培を始めたんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0068",
   "jp": "これが初めて採れた薬草だよ。{n}よかったら、使っておくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0069",
   "jp": "　{n}　　　　　　　　{FFEF}回復薬{FFF1}をもらった！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0070",
   "jp": "インペリアル・ナイトまでいたのに、{n}ブローニュ村が滅ぼされたって話じゃないか！{n}誰もヴェンツェルに勝てやしないよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0071",
   "jp": "{v:0062}魔法学院まで行くなら今は諦めることだな。{n}一昨日、すごい突風が吹いて、橋を壊したんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0072",
   "jp": "{v:0063}えっ？{n}風で橋が壊れたの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0073",
   "jp": "{v:0064}ああ、この目で見た俺も信じられなかったよ。{n}あんな風、自然に吹くとは思えない。{p}{v:0065}とにかく、修理は急ぐつもりだけどね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0074",
   "jp": "えっ？{n}学院長の秘書？{p}‥‥って誰？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0075",
   "jp": "すっごい美人のおねーさんだよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0076",
   "jp": "そんなこと言われても誰もここを通ってないからなぁ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0077",
   "jp": "ここへは来ていないって事か‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0078",
   "jp": "えっ？{n}学院長の秘書？{n}そんな人は来てないよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0079",
   "jp": "やっと東の橋の修理が終わったみたいだよ。{n}これでまた魔法学院へ行くことができるね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0080",
   "jp": "東の橋の修理、まだ終わってないみたいだね。{n}早く終わらせて欲しいなぁ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0081",
   "jp": "バーンシュタインと戦争を始めたんだって？{p}前の盗賊騒ぎの時といい、{n}人間ってどうしてそこまで血を見たがるのかねぇ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0082",
   "jp": "こんにちは。{n}元気でやってるかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0083",
   "jp": "{v:0033}いらっしゃいませ。{n}この店では、様々なグッズをお買い求めいただけます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0084",
   "jp": "{v:0034}本日はお買い求めですか？{n}それともご売却ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0085",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen021.0086",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen021.0087",
   "jp": "他にも何かおありでしょうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0088",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen021.0089",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen021.0090",
   "jp": "{v:003E}ありがとうございました！{n}またどうぞ、お越し下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0091",
   "jp": "{v:0000}やぁ、いらっしゃい。{n}ここには、いろんな装備があるよ～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0092",
   "jp": "{v:0002}さて、何の用かな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0093",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen021.0094",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen021.0095",
   "jp": "まだ用事はあるかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0096",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen021.0097",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen021.0098",
   "jp": "{v:000B}またおいで～。待ってるよ～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0099",
   "jp": "ワシのバカ息子も、{n}若い頃はお主らのように旅をしておった‥‥。{p}じゃが回復魔法が苦手でのう。{n}いつも薬草ばかり買っているものだから{n}とにかく貧しい暮らしをしておったよ。{p}‥‥今ではどこへ行ったのか。{n}さっぱり連絡をよこさなくなって、{n}もう１０年は経ったかのう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0100",
   "jp": "はぁ、はぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0101",
   "jp": "もっと本気で来い！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0102",
   "jp": "何もないところでしょ？{n}私も都会に行きたいなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0103",
   "jp": "ん？{n}‥{FE14}‥{FE14}‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0104",
   "jp": "‥‥あぁ、びっくりした。{n}最近、北東の山小屋に怪しい連中が住みついてるから、{n}その仲間なのかと思った。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0105",
   "jp": "洞窟や遺跡にいるモンスターは倒しても、倒しても、{n}どこからともなく集まってきやがる。{p}だから俺が修行をするときには、{n}洞窟へ行くことにしているんだ。{p}‥‥だが、橋が壊れていて、洞窟へ入れないんだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0106",
   "jp": "やっと人々に活気が戻ってきましたわい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0107",
   "jp": "最近、村のみんなに覇気がなくてのぉ‥‥。{n}ワシがまだ現役じゃったら、ヴェンツェルなど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0108",
   "jp": "なに？{n}きれいな娘を見なかったかですと？{p}はて？{n}うちのばぁさんは、きれいでしたぞ。{n}いや～、昔を思い出すのう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0109",
   "jp": "何事も、ほどほどが一番じゃ。{n}そうは思いませんかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0110",
   "jp": "なに？{n}世界を混乱させていたゲヴェルを倒したのか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0111",
   "jp": "いや～、ワシももう少し若ければ、{n}戦場を駆け回って大活躍したのに‥‥。{p}残念ですわい‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0112",
   "jp": "いや～、ワシももう少し若ければ、{n}闘技大会に出たのですがのぉ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0113",
   "jp": "聞きましたぞ、{n}闘技大会で優勝されたそうですな。{p}ワシも若い頃‥‥。{p}闘技大会で賭けては大損したものですわい[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0114",
   "jp": "あなた方は腕が立つようですから、{n}グランシルの闘技大会にでも出てみては{n}いかがですかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0115",
   "jp": "そういえば以前、{n}ここで子供に剣を教えておったノランも、{n}若い頃は毎年参加しておったのう‥‥。{p}懐かしい話じゃ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0116",
   "jp": "そういえば、グランシルの闘技大会にでも出てみては{n}いかがですかな？{p}ワシも若い頃はのう‥‥。{n}ふふ、ふふふふ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0117",
   "jp": "おお、この前は助かりましたわい。{n}あなたは村の英雄ですな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0118",
   "jp": "おお、この前は助かりましたわい。{n}おかげで村が全滅せずにすみました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0119",
   "jp": "おお、この前はお世話になりました。{n}ずいぶんと寂しい村になりましたが、{n}みな、あなた方に感謝しております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0120",
   "jp": "ところで王都から来られたようですが、{n}南東の洞窟へ向かうなら、注意して下され。{p}ただ武器で殴るだけの攻撃では、{n}あそこのスペクターに苦戦しますぞ。{n}幽霊だけに、なかなか攻撃が当たらんのじゃ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0121",
   "jp": "そう言えば、ワシの心の師匠が、{n}『アンデッドには火。うひひひ。』{n}とか言っておったのう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0122",
   "jp": "正義は負けちゃいけないんだよね！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0123",
   "jp": "今度は僕が村を守るんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0124",
   "jp": "とうちゃん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0125",
   "jp": "まだまだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0126",
   "jp": "もうどこへも行かないわ。{n}土地よりも、平和の方が尊いから。{n}‥‥ちょっと悔しいけど[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0127",
   "jp": "どこに行ったって同じよ！{n}もう、イヤ！{n}こんな世の中！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0128",
   "jp": "ああ、王都かグランシルみたいな都会に住みたいわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0129",
   "jp": "もう盗賊に襲われるなんていやよ！{n}ああ、王都かグランシルみたいな都会に住みたいわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0130",
   "jp": "ああ、こんな村、はやく出たいわ。{n}誰か素敵な人が迎えに来ないかな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0131",
   "jp": "何か話によると、この国のお偉い人が隣国の王様に{n}斬りかかったそうじゃない？{p}もう、迷惑な話ねぇ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0132",
   "jp": "みんなであなた達のことを応援しているのよ。{n}だから弱気になったりしないで、{n}がんばってね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0133",
   "jp": "何だかぶっそうな世の中になったわね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0134",
   "jp": "この前はありがとう。{n}あなたたちってとっても強いのね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0135",
   "jp": "この前はありがとう。{n}おかげで一命はとりとめたけど‥‥。{n}でも、たくさんの人が死んでしまったわね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0136",
   "jp": "こんにちは、今日も風が気持ちいいわね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0137",
   "jp": "さて、次は魔法学院かグランシルか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0138",
   "jp": "ん？　君たちもどこかへ行くのかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0139",
   "jp": "・魔法学院へ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen021.0140",
   "jp": "・グランシルへ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen021.0141",
   "jp": "南東の洞窟を抜けた先にあるブローニュ村から{n}さらに東へ行けば魔法学院だ。{p}ただ、洞窟のモンスターは強いから{n}油断するなよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0142",
   "jp": "南東の洞窟を抜けた先にあるブローニュ村から、{n}さらに南へ行けば、グランシルの街だ。{p}ただ、洞窟のモンスターは強いから{n}油断するなよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0143",
   "jp": "いろいろ悩んだが、グランシルへ行くとしよう。{n}あそこの闘技場に出場して、{n}大金を稼ぐのも悪くない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0144",
   "jp": "ちょっと！{n}どこへ行く気よ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0145",
   "jp": "お客さん！{n}勝手に客室へ行かれては困ります！{p}お泊まりの時は、こちらで受付を済ませて下さいよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0146",
   "jp": "{v:0003}ウォレスさんって、どこかな？{n}それらしい人はいないよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0147",
   "jp": "{v:0004}宿の人に聞いてみたらどうかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0148",
   "jp": "さっそく記録してごらん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0149",
   "jp": "それはセーブポイントと呼ばれるものだよ。{n}普通、屋内やダンジョン内では、{n}セーブができないだろ？{p}だけどセーブポイントの上だけは、{n}セーブをすることができるのさ。{n}ちょっと試してごらん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0150",
   "jp": "私は流浪の旅人。{n}多くの新米に、旅の知識を教えているのさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0151",
   "jp": "ところで君は、そこの魔法陣が{n}何かわかるかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0152",
   "jp": "なんだ、知っているのか‥‥。{n}ダンジョンなんかでこれを見つけたら、{n}こまめに記録しておくといいぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0153",
   "jp": "これはセーブポイントと呼ばれるものだよ。{n}普通、屋内やダンジョン内では、{n}セーブができないだろ？{p}だけどセーブポイントの上だけは、{n}セーブをすることができるのさ。{n}ちょっと試してごらん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0154",
   "jp": "試しにセーブしてごらん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0155",
   "jp": "１つ忠告しておこう。{n}東へ行くほど、モンスターはどう猛になっている。{n}一見おなじようでも、油断してはダメだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0156",
   "jp": "{v:0005}いらっしゃい。お泊まりですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0157",
   "jp": "{v:0006}あの、ウォレスさんと待ち合わせなんですが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0158",
   "jp": "{v:0007}あぁ、あんた達が。{p}{v:0008}あの人は夕方に来るはずだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0159",
   "jp": "{v:0009}ちょっと早かったみたいだね。{n}どこかで時間をつぶさないと。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0160",
   "jp": "{v:000A}それじゃ、自由行動にしない？{n}ある程度時間がたったらここに戻ってくるの。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0161",
   "jp": "{v:000B}賛成！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0162",
   "jp": "{v:000C}それじゃ、わたし、その辺りを見てくるね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0163",
   "jp": "{v:000D}さ、アタシらも行きましょ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0164",
   "jp": "１泊、{FFEB}エルムになりますが？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0165",
   "jp": "ありがとうございました。{n}気を付けて行ってらっしゃいませ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0166",
   "jp": "お客さん‥‥[01BE]{n}お金が足りないみたいですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0167",
   "jp": "またのお越しをお待ちしております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0168",
   "jp": "ほら、そこにいる黒ずくめの人が{n}ウォレスさんだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0169",
   "jp": "ウォレスさんなら、まだ来てないよ。{n}そろそろ来てもいい頃なんだが‥‥。{n}ま、外でもぶらついてきたらどうだい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0170",
   "jp": "私は人をめぐる星を読む占い師。{n}私が力を発揮できる地を求めて旅をしています。{p}私が必要とするのは、{n}森に囲まれ、人々の喜びにあふれた湖‥‥。{p}あなたは、特殊な星の下に生まれた人ですね。{n}もし、私が求める場所を教えてくれたならば、{n}あなたに星の声をお聞かせしましょう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0171",
   "jp": "アンタがもらった領地に、{n}ボート乗り場を作ったんだよね？{n}あそこってどうかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0172",
   "jp": "おお、ボート乗り場！{n}まさしく人々の喜びにあふれた湖！{n}ぜひ私をそこに案内して下さい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0173",
   "jp": "・場所を教える",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen021.0174",
   "jp": "・場所を教えない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen021.0175",
   "jp": "‥‥ふむふむ‥‥。{n}ローザリアの西にそんな場所が‥‥。{p}ありがとうございます。{n}さっそく向かってみます！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0176",
   "jp": "そうですか。{n}今はまだ早いと言うことですね。{p}その時が来ましたら、{n}再び声をかけてください。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0177",
   "jp": "{v:000E}お兄ちゃん、ティピ、お帰りなさい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0178",
   "jp": "{v:000F}ウォレスさんは？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0179",
   "jp": "{v:0010}まだみたいだけど‥‥。{FFF9}{FFFB}{FC00}{n}あっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0180",
   "jp": "{v:0011}あの‥‥ウォレスさんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0181",
   "jp": "{v:0012}ああ、そうだが‥‥。{n}お前たちは？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0182",
   "jp": "{v:0013}わたしたち、母の‥‥サンドラの使いで来ました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0183",
   "jp": "{v:0014}そうか。{n}サンドラ様のお子さん達か。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0184",
   "jp": "{v:0015}そういえば、サンドラ様にお願いしていた物が{n}あったはずだが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0185",
   "jp": "{v:0016}サンドラ様にお願いしていた物があったはずだが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0186",
   "jp": "{v:0017}何やってんの！{n}早くアレを渡してあげなさいよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0187",
   "jp": "{v:0018}ティピちゃーん、きーっく！{n}らいと・ばーじょん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0188",
   "jp": "{v:0019}人前だから、この程度にしてあげる。{n}次はまじめにやんなさい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0189",
   "jp": "{v:001A}ティピちゃーん、{n}ヘビー・きーーーっく！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0190",
   "jp": "{v:001B}あ、あの、お母さんに頼まれて！{n}この魔法の眼をもってきました！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0191",
   "jp": "　{n}　　　　ルイセが『{FFEF}魔法の眼{FFF1}』を渡した！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0192",
   "jp": "　{n}　　　　『{FFEF}魔法の眼{FFF1}』をウォレスに渡した！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0193",
   "jp": "研究書を取り返せ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0194",
   "jp": "{v:001C}ありがとう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0195",
   "jp": "‥‥‥{v:001D}うむ、これはいい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0196",
   "jp": "{v:001E}それで本当に見えるようになるんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0197",
   "jp": "{v:001F}以前のようには見えねぇがな。{p}{v:0020}そうだな。{n}人の影がぼんやりわかる程度だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0198",
   "jp": "{v:0021}それじゃ、あんまりわからないね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0199",
   "jp": "{v:0022}そうでもねぇぞ。{n}今までは全く見えなかったんだ。{n}それに比べれば雲泥の差だ。{p}{v:0023}これで以前のように生活が出来る。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0200",
   "jp": "{v:0024}さて、これでお使いは終わりだね。{n}あとは研究書を盗んだ奴を追いかけましょ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0201",
   "jp": "{v:0026}ん？{n}いったいどうしたんだ？{n}良かったら教えてくれねぇか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0202",
   "jp": "{v:0027}実は‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0203",
   "jp": "‥‥{v:0028}というわけなの。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0204",
   "jp": "{v:0029}なるほど。{n}そういえば、東の森にある山小屋に{n}不審な人物が入るのを見たと、木こりが言っていたな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0205",
   "jp": "{v:002A}それよ！{n}逃げられないうちに急ぎましょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0206",
   "jp": "{v:002B}ああ、待った。{n}良かったら俺も行こう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0207",
   "jp": "{v:002C}えっ？{n}危ないかも知れませんよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen021.0208",
