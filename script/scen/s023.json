 "entries": [
  {
   "id": "scen023.0000",
   "jp": "",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen023.0001",
   "jp": "アリオスト",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen023.0002",
   "jp": "村人",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen023.0003",
   "jp": "マーナ",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen023.0004",
   "jp": "店員",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen023.0005",
   "jp": "‥‥‥{v:0002}行って来ます、父さん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0006",
   "jp": "{v:0003}アリオストさん？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0007",
   "jp": "{v:0004}ここにはね、僕の父さんが眠っているんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0008",
   "jp": "{v:0005}アリオストさんのお父さん？{n}それじゃお母さんは？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0009",
   "jp": "{v:0006}これから会いに行くのさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0010",
   "jp": "{v:0007}これから‥‥っていうと、ひょっとして‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0011",
   "jp": "{v:0008}ああ。{n}僕の母さんは人間じゃなくてフェザリアンなんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0012",
   "jp": "{v:0009}うそ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0013",
   "jp": "{v:000A}驚くのも無理はない。{n}フェザリアンは我々人間と{n}ほとんど交流を持たないからね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0014",
   "jp": "{v:000B}初めて聞いた‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0015",
   "jp": "アリオストとフェザーランドへ",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0016",
   "jp": "{v:000C}そうだろうね。{n}こんな事、話すのは君たちが初めてだからね。{p}{FC00}{v:000D}さ、そろそろ行こうか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0017",
   "jp": "{v:000C}そうだろうね。{n}こんな事、話すのは君たちが初めてだからね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0018",
   "jp": "{v:0003}一度、僕の研究室へ寄ってくれ。{n}そこでこの装置を組み込むから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0019",
   "jp": "　{n}　　　　　手入れの行き届いた墓石だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0020",
   "jp": "{v:000B}この辺りは大丈夫だったんだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0021",
   "jp": "{v:000C}これは‥‥いったいどうしてしまったのですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0022",
   "jp": "‥‥{v:0025}母さん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0023",
   "jp": "{v:000D}アリオストさんのお母さん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0024",
   "jp": "{v:000E}ヴェンツェルがね、この村の人を人質にして{n}パワーストーンを差し出せって。{p}{v:000F}それでパワーストーンを渡したのに、{n}この村を壊しちゃったの。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0025",
   "jp": "{v:0010}パワーストーンを渡した？{n}今もヴェンツェルが持っているのですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0026",
   "jp": "{v:0011}いいや。{n}奴はその場で壊しちまったようだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0027",
   "jp": "‥‥{v:0012}そんな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0028",
   "jp": "{v:0013}やっぱり、いけなかったでしょうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0029",
   "jp": "{v:0014}パワーストーンが壊されてしまったなんて‥‥。{p}{v:0015}それではヴェンツェルを倒したとしても、{n}この世界を救う方法が‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0030",
   "jp": "‥‥{v:0016}詳しく話してくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0031",
   "jp": "{v:0017}パワーストーンが、{n}時空制御装置の要だという話はしましたね。{n}あれがなければ制御装置は動きません。{p}{v:0018}つまり、この世界を維持できないのです。{p}{v:0019}現在、徐々にではありますが、{n}２つの世界は元の位置に戻ろうと、離れ始めています。{p}{v:001A}それを止めることができるのは時空制御装置。{n}もしくは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0032",
   "jp": "{v:001B}もしくは？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0033",
   "jp": "{v:001C}時空を操ることができる、ヴェンツェルのみ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0034",
   "jp": "{v:001D}それって、ヴェンツェルの言いなりになれってこと？{n}降参するしかないってこと？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0035",
   "jp": "‥‥{v:001E}悲しいことですが、パワーストーンをもう１度{n}作るには、少なくとも１国の民ほどのグローシアンが{n}必要になります。{p}{v:001F}事実上、不可能としか言いようがありません。{n}つまり、ヴェンツェル以外、世界の分離を{n}止められる者はいません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0036",
   "jp": "{v:0020}奴を倒したところで、{n}世界は破滅に向かうってわけか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0037",
   "jp": "{v:0021}だったらヴェンツェルに支配された方が{n}いいって言う人、いっぱいいそうだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0038",
   "jp": "‥‥{v:0022}うん。{n}そう思われても当然だもんね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0039",
   "jp": "{v:0023}俺たちが今までやった事は、{n}無駄だっていうのか！？{n}クソッ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0040",
   "jp": "‥‥{v:0024}ここで諦めてしまうと、{n}あの人に笑われてしまいます。{n}私は私で、別の方法を考えてみます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0041",
   "jp": "{v:0026}アリオスト。{n}あなたはあの人の息子なのですよ。{n}最後まで諦めないで。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0042",
   "jp": "{v:0027}そうだな。{n}やる前から諦めちゃ、何にも始まらねぇ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0043",
   "jp": "{v:0028}もうルイセちゃんだけだもんね、{n}グローシアンって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0044",
   "jp": "{v:0029}１国の民ほどのグローシアンか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0045",
   "jp": "{v:002A}わたし１人の力じゃ、そんなの無理だよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0046",
   "jp": "{v:002B}みんなグローシュを使えるといいのにね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0047",
   "jp": "{v:002C}グローシアンの力が、もう少し解明されないとダメだ。{n}アイリーンの治療法すらわかっていないのが{n}現状だからな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0048",
   "jp": "{v:002D}そういえば、ブラッドレー先生、{n}ペンダントを調べてくれたかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0049",
   "jp": "ブローニュ村",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0050",
   "jp": "{v:0000}ここが僕の生まれ育った村だ。{p}{FC00}{v:0001}ちょっと失礼。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0051",
   "jp": "{v:0000}おーい！{n}帰ったぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0052",
   "jp": "{v:0001}おお、アリオストさんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0053",
   "jp": "{v:0002}帰ってきたな、出世頭！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0054",
   "jp": "{v:0003}まあ、まあ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0055",
   "jp": "{v:0004}はい、これ。{n}学院から報奨金が出たんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0056",
   "jp": "{v:0005}いつもすまねぇな。{n}これでまた村が豊かになるさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0057",
   "jp": "{v:0006}いやぁ、僕はみんなみたいに{n}村の仕事をしていないから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0058",
   "jp": "{v:0007}何言うさ。{n}アリオストさんには才能があるんだから、{n}そっちをやるのが当然さ。{p}{v:0008}村のことはオラたちに任せておくさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0059",
   "jp": "{v:0009}すまないね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0060",
   "jp": "{v:000A}なんの、なんの。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0061",
   "jp": "{v:000B}僕は先に家に戻るから、後から来てくれ。{n}しばらく帰らなかったから、汚れているんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0062",
   "jp": "{v:000C}アンタら、アリオストさんの友達け？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0063",
   "jp": "{v:000D}はい。{n}魔法学院の後輩です。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0064",
   "jp": "{v:000E}どうさ、アリオストさんは？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0065",
   "jp": "{v:000F}すごい人です。{n}あの若さで自分の研究室をもらえる人は{n}そういないです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0066",
   "jp": "{v:0010}そうだろう？{n}あの人はオラたちの希望さ。{p}{v:0011}お父さんもすごい人だったけど、{n}あの人もすごいさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0067",
   "jp": "{v:0012}アリオストさんのお父さんも{n}魔法研究家だったの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0068",
   "jp": "{v:0013}いいや、そうじゃねぇさ。{p}{v:0014}オラたちがこうして生き甲斐を持てるのも、{n}お父さんのおかげさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0069",
   "jp": "{v:0015}どういう事かな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0070",
   "jp": "{v:0016}オラたちは親もなく、捨てられた存在だったさ。{n}その日の飢えをしのぐのに人の物を盗んだり、{n}悪いこともしたさ。{p}{v:0017}だけどそんなオラたちを引き取って、{n}この村に連れてきてくれたのが{n}彼のお父さんだったのさ。{p}{v:0018}そしてオラたちに畑の耕し方を教えてくれたさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0071",
   "jp": "{v:0019}ああ。{n}そして採れた物を街で売って、金を稼ぐ。{p}{v:001A}そうやって自分たちの力だけで生きていく事を{n}教えてくれたさ。{p}{v:001B}自分で何とかしようと努力すれば、{n}どんな事だって出来るんだってね。{p}{v:001C}アリオストさんは頭がいいからこんな村、{n}出ていこうと思えばいつだって出ていけるはずさ。{p}{v:001D}だけど、自分が研究を続けられるのも{n}オラたちがいるからだって、出ていこうとしないのさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0072",
   "jp": "{v:001E}あの人が才能や運だけであそこまでになったなんて、{n}誰も思っちゃいないさ。{p}{v:001F}いつだってあの人は勉強している。{n}それはすごいことさ。{p}{v:0020}それどころか今日みたいに、{n}学院から報奨金が出ると村のために回してくれるのさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0073",
   "jp": "{v:0021}天才は一日にして成らず、か。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0074",
   "jp": "{v:0022}これからもアリオストさんのこと、よろしく頼むさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0075",
   "jp": "ん？{n}１人多くねぇか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0076",
   "jp": "いや～っ、はっはっはっ！{n}バレましたか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0077",
   "jp": "君たちの後についてきたら、{n}なんとか洞窟を抜けられたよ。{n}ありがとう！{p}ああ、疲れた。{n}宿はどこかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0078",
   "jp": "宿で商売してるから、良かったら来てね～。{n}いい品そろえてるよ！{n}‥‥別に値引きはないけどね～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0079",
   "jp": "{v:0004}もう疲れた！{n}歩きたくない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0080",
   "jp": "{v:0000}ここが僕の生まれ育った村だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0081",
   "jp": "{v:0001}ここがアリオストさんが生まれ育った村だよね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0082",
   "jp": "{FFF3}{v:0002}‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0083",
   "jp": "{v:0003}どうしたの、ルイセちゃん？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0084",
   "jp": "{v:0005}そんなこと言ったって、アンタ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0085",
   "jp": "{v:0006}いやがってるのを無理矢理歩かせたって{n}しょうがねぇだろ。{n}ちと早いが、今日はここで泊まっていこう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0086",
   "jp": "{v:0007}そういうことなら家に来てくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0087",
   "jp": "{v:0008}すまねぇな、アリオスト。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0088",
   "jp": "{v:0009}う～ん、それならアリオストさんの家にでも{n}寄っていきましょ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0089",
   "jp": "何だい？{n}僕に用事かな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0090",
   "jp": "{v:000F}さ、中に入ってくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0091",
   "jp": "{v:000C}やぁ、どうしたんだい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0092",
   "jp": "{v:000D}すまないが、少し休ませてくれねぇか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0093",
   "jp": "{v:000E}ああ。{n}こんな所で良かったら。{p}{v:000F}さ、中に入ってくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0094",
   "jp": "ここが僕の家だ。{n}ちらかっているから、中に入るのはやめてくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0095",
   "jp": "お兄ちゃん！{n}アリオストさんはフェザーランドにいるよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0096",
   "jp": "こんにちは～‥‥{p}‥‥留守みたい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0097",
   "jp": "頼むから、僕を困らせないでくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0098",
   "jp": "留守だって。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0099",
   "jp": "{FFEE}全室清掃のため、{n}２、３日休ませていただきます。{FFF1}{n}　　　　　　　　　　　　　{FFEF}【店主】{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0100",
   "jp": "戦争はもう終わったんだべか？{p}そうか！？{n}したら、これでやっと安心してこの村を{n}より発展させてけるってことだな！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0101",
   "jp": "さっきの女性、綺麗だったなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0102",
   "jp": "戦争？{n}本当に始まってたのけ？{n}まあ、何とかなんべ。{p}いちお、いっとくがな、{n}俺は諦めたわけじゃねえからな。{n}自分の出来ることをやろうとしてるだけだかんな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0103",
   "jp": "魔法学院？{n}このまま村を抜けて東に行ったところだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0104",
   "jp": "‥‥ってアリオストさんも一緒け。{n}なら心配ねぇな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0105",
   "jp": "アリオストさんはすごい人だろ？{p}何といっても、この村の出世頭さ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0106",
   "jp": "そんなもんじゃないですよ、僕は。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0107",
   "jp": "グランシルへは行ったけ？{n}にぎやかでなんでもそろってる大都会さ。{n}行くなら村を出てしばらく南さ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0108",
   "jp": "いや～、いい目の保養になったさ！{n}魔法学院にはあんな美人がいるんだね。{n}アリオストさんがうらやましいさ。{p}え？{n}その人なら村を素通りして西へ向かったけど。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0109",
   "jp": "その人村を素通りして西へ向かったさ。{p}いや～、魔法学院にはあんな美人がいるんだね。{n}アリオストさんがうらやましいよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0110",
   "jp": "ちゃんと、野菜も食べてるけ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0111",
   "jp": "おら達のような農民が国の食料を支えてんだ。{n}がんばらなくちゃな！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0112",
   "jp": "おめえらも何か忙しそうだな？{n}ま、焦らずがんばりや！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0113",
   "jp": "おお、アリオストさん。{n}研究は進んでるかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0114",
   "jp": "ええ、なんとか。{n}しかし研究すればするほど、{n}新しい疑問も出てくるものだからね。{p}それが楽しいんだけど。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0115",
   "jp": "おや、アンタたちかい？{n}これからもアリオストさんのこと、よろしく頼むさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0116",
   "jp": "おや、あんた。{n}洞窟を抜けて来たのけ？{p}最近は物騒で、王都の方から来る人が{n}少ないんだよね。{p}で、どこ行くのさ？{n}やっぱりグランシルけ？{n}闘技大会出るんだろ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0117",
   "jp": "アリオストさんの言ったとおり、{n}こいつなら年に２回収穫できるさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0118",
   "jp": "品種改良の成果だよ。{n}これで一時的な天候不良の影響は受けにくくなる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0119",
   "jp": "そのかわり、一年中、畑を耕しているような‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0120",
   "jp": "あはは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0121",
   "jp": "うんうん、丈夫に育ってんな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0122",
   "jp": "あら、アリオストさん。{n}雨の日でもお洗濯できるような工夫は{n}ないものかしら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0123",
   "jp": "今度、考えておきますね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0124",
   "jp": "こののどかな村を‥‥、{n}私達の大切な村を戦争なんかから守らなくちゃね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0125",
   "jp": "そうですね‥‥。{n}その為には僕らも頑張らなくてはいけないな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0126",
   "jp": "頑張ってね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0127",
   "jp": "ここはとっても、のどかな所でしょ？{n}この村はみんなが力を合わせて、{n}森を切りひらいてつくったのよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0128",
   "jp": "あら、アリオストさん。{n}お墓参り？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0129",
   "jp": "この先には、村の功労者が眠っているんです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0130",
   "jp": "実は私、こう見えても絵心があるのよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0131",
   "jp": "家には描きためた絵がもう、何枚もあるの。{n}あの絵をお金に替えられないかしら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0132",
   "jp": "彼女の絵を買い取りますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0133",
   "jp": "えっ！{n}あなた、展示場を持っているの？{n}それじゃ、私の絵を展示させてね！{p}これで絵が売れれば、{n}この村の経済を助けることが出来るわ！{n}人に頼んで、絵を送らせるわね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0134",
   "jp": "見てくれ、こんなに大きい野菜が取れたよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0135",
   "jp": "肥料を工夫したかいがあったね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0136",
   "jp": "ああ、土地に合った肥料ってあるんだな。{n}アリオストさんの助言のおかげさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0137",
   "jp": "いえ、苦労して配分を変えたのは、{n}僕じゃなくてあなたでしょう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0138",
   "jp": "ここの畑では薬草も栽培しているだ。{n}あんたら、キュアって魔法を覚えたら{n}薬草なんて必要ねぇって思ってるだろ？{p}んだがな、魔法は詠唱時間が必要だ。{n}急いで回復させたい時は、{n}すぐに使えるアイテムの方が便利なんだな。{p}だから、見かけたら{n}いっぱい買っといた方がいいぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0139",
   "jp": "立派な村になったものですねぇ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0140",
   "jp": "そうじゃのぉ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0141",
   "jp": "おお、アリオスト。{n}お主は村の誇りじゃよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0142",
   "jp": "ふふふ、おじいさんったらそればっかり‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0143",
   "jp": "それに引き替え、うちのバカ息子は{n}グランシルなんぞへ行きおって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0144",
   "jp": "きっと彼も、いつか戻ってきますよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0145",
   "jp": "そうじゃな。{n}帰ってきたら村を見て腰を抜かすじゃろ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0146",
   "jp": "立派な村になったものじゃ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0147",
   "jp": "ほんとにねぇ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0148",
   "jp": "俺もアリオストさんみたいに頭よくなりたいなぁ～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0149",
   "jp": "頭の良し悪しじゃないさ。{n}人の役に立とうと思ったら{n}しっかり勉強するんだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0150",
   "jp": "うん、俺もがんばるよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0151",
   "jp": "無理無理！{n}アリオストさんと比べるなんて笑っちゃうわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0152",
   "jp": "ちきしょー！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0153",
   "jp": "人間、力ばっかりじゃダメよね。{n}誰かさんみたいに。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0154",
   "jp": "なんだと！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0155",
   "jp": "こらこら、けんかはいけないよ。{n}子供のうちはしっかり遊んで体を鍛えるのも大切さ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0156",
   "jp": "アリオストさんってやっぱり素敵だわ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0157",
   "jp": "{v:0010}やぁ、どうしたんだい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0158",
   "jp": "{v:0011}学院長の秘書さんを見なかった？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0159",
   "jp": "{v:0012}ああ、見かけたよ。{n}それで、声をかけたけど無視されてしまったよ。{n}聞こえなかったのかな？{p}{v:0013}それになんだか急いでるみたいだったよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0160",
   "jp": "{v:0014}それで、どっちへ行ったんだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0161",
   "jp": "{v:0015}西の、王都の方へ行ったけど？{n}何かあったのかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0162",
   "jp": "アリオストをパーティーに加えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0163",
   "jp": "{v:0015}でもこれ以上は多すぎるよ。{n}誰かを仲間から外さないと。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0164",
   "jp": "誰をメンバーから外しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0165",
   "jp": "・カレン",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen023.0166",
   "jp": "・ミーシャ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen023.0167",
   "jp": "カレンの装備を回収しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0168",
   "jp": "{v:001A}お願いお兄さま、アタシを外さないで！{p}{v:001B}アタシはおじさまに会って、本当の事を知りたいの！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0169",
   "jp": "　{n}　　　　　　{FFEF}アリオストが仲間になった！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0170",
   "jp": "{v:0017}喜んで参加させてもらうよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0171",
   "jp": "{v:0018}アリオストさんがいれば心強いもんね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0172",
   "jp": "{v:0019}はは、そんなことはないさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0173",
   "jp": "{v:001C}そうかい？{n}僕の力が必要ならいつでも会いに来てくれ。{n}力になるよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0174",
   "jp": "{v:001D}ありがとう、アリオストさん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0175",
   "jp": "がんばって下さいね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0176",
   "jp": "がんばって下さい★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0177",
   "jp": "{v:0000}おお、あんたらか！{p}{v:0001}見てくれ、このありさま。{n}ヒドイもんさ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0178",
   "jp": "{v:0002}あの‥‥わたし達のこと、怒らないの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0179",
   "jp": "{v:0003}怒る？{n}どうしてさ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0180",
   "jp": "{v:0004}だって、パワーストーン渡しちゃったのって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0181",
   "jp": "{v:0005}そりゃ、仕方ないさ。{n}おおかた、ほかの人たちに脅かされたんだろ？{p}{v:0006}あんたたちは何も悪くないさ。{n}悪いのはあのヴェンツェルとかいう奴さ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0182",
   "jp": "{v:0006}あんたたちは何も悪くないさ。{n}悪いのはあのヴェンツェルとかいう奴さ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0183",
   "jp": "{v:0007}畑がだめになったのさ。{n}だから、もう一度、作り直すさ。{p}{v:0008}元々、この村は何にもないところにオラたちが{n}造ったんだ。　幸い怪我人も出なかったし、{n}村を造り直すだけで元通りさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0184",
   "jp": "{v:0009}俺たちを守ってくれたインペリアル・ナイトさん、{n}大丈夫かなぁ？{p}{v:000A}傷がひどかったから、バーンシュタインの兵隊さんに{n}引き取ってもらったんだけど‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0185",
   "jp": "当店をご利用でしたら、こちらで記帳なさって下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0186",
   "jp": "いらっしゃいませ。{n}お泊まりは{FFEB}エルムですが？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0187",
   "jp": "ごゆっくりお休み下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0188",
   "jp": "ありがとうございました。{n}気を付けて行ってらっしゃいませ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0189",
   "jp": "お客さま‥‥[01BE]{n}お金が足りないみたいですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0190",
   "jp": "またのお越しをお待ちしております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0191",
   "jp": "{v:0000}やぁ、いらっしゃい。{n}ここには、いろんな装備があるよ～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0192",
   "jp": "{v:0002}さて、何の用かな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0193",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen023.0194",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen023.0195",
   "jp": "まだ用事はあるかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0196",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen023.0197",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen023.0198",
   "jp": "{v:000B}またおいで～。{n}待ってるよ～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0199",
   "jp": "{v:0000}つきました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0200",
   "jp": "{v:0001}ありがとう。{n}貴女はすぐに戻ってください。{n}奴に見つかって、どんな行動を取られるかわからない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0201",
   "jp": "{v:0002}う、うん‥‥。{n}気をつけてください。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0202",
   "jp": "{v:0003}よし、行くぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0203",
   "jp": "{v:0004}来たか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen023.0204",
   "jp": "{v:0005}約束の物を持ってきた。{n}村人を解放してもらおうか。",
   "en": "",
