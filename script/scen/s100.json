 "entries": [
  {
   "id": "scen100.0000",
   "jp": "",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen100.0001",
   "jp": "ダグラス卿",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen100.0002",
   "jp": "バーンシュタイン兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen100.0003",
   "jp": "王母アンジェラ",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen100.0004",
   "jp": "ティピ",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen100.0005",
   "jp": "標識",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen100.0006",
   "jp": "男",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen100.0007",
   "jp": "ウォレス",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen100.0008",
   "jp": "暖炉ガール",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen100.0009",
   "jp": "店員",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen100.0010",
   "jp": "疲れているのはわかるが、{n}休む前に報告を頼む。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0011",
   "jp": "今日はお疲れでしょう。{n}テントでお休み下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0012",
   "jp": "{s:011E}がお待ちです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0013",
   "jp": "{v:0000}{s:0008}の方はどうだった？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0014",
   "jp": "{v:0001}協力してくれることになりました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0015",
   "jp": "{v:0002}{s:0004}はどうしていますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0016",
   "jp": "{v:0003}彼は{s:0008}と一緒に行動するそうです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0017",
   "jp": "{v:0004}{s:0008}さんと一緒に行動するようです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0018",
   "jp": "{v:0005}そうですか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0019",
   "jp": "{v:0006}ところでどうしてこんな所に本陣を{n}設営しているんだ？{n}もっと進んでいてもいいはずだが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0020",
   "jp": "{v:0007}実は、この先の川で{s:00F5}の集団が暴れており、{n}これ以上進めないのだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0021",
   "jp": "{v:0008}{s:00F5}の集団？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0022",
   "jp": "{v:0009}うむ。{p}{v:000A}だが{s:00F5}が暴れている以上、{n}{s:000A}王の差し向けた軍隊も、{n}こちらに来られないでいる。{p}{v:000B}とにかく今日はここで休んでくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0023",
   "jp": "色々とお疲れでしょう。{n}テントでお休み下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0024",
   "jp": "いよいよ戦いの時が来ましたね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0025",
   "jp": "私の働きを見ていて下さい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0026",
   "jp": "ゆっくり休んでくれたまえ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0027",
   "jp": "早く戦争が終わるように、{n}がんばりましょう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0028",
   "jp": "西　：　シュッツベルグ{n}東　：　{s:0160}王都方面",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0029",
   "jp": "　{n}　　　『{FFEF}{s:000E}の可能性６{FFF1}』を手に入れた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0030",
   "jp": "エビどもがいなくなったら‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0031",
   "jp": "これじゃ進軍できないぞ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0032",
   "jp": "今度はインペリアル・ナイトだと？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0033",
   "jp": "どうすりゃいいんだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0034",
   "jp": "まったく、どうして{s:00F5}が‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0035",
   "jp": "あの{s:00F5}達は、{n}我々を進ませないために、集まっている{n}みたいだったな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0036",
   "jp": "まったく！{n}最初からこれでは、先が思いやられる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0037",
   "jp": "{v:0001}この{s:00F5}のせいで先へ進めないんですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0038",
   "jp": "{v:0002}どうしてこんなに群れているんだ？{n}この数は異常だ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0039",
   "jp": "{v:0003}うえぇっ！{n}こんなにいっぱいいるのぉ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0040",
   "jp": "{v:0004}何もしなければ、むこうからは仕掛けてこない{n}みたいなんですが、橋を渡ろうと近づくと、{n}とたんに攻撃して来るんです。{p}{v:0005}水の中にいて倒しにくいうえに、{n}倒したところで次から次へと集まってきて、{n}きりがないんです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0041",
   "jp": "‥‥{v:0006}作為的な物を感じるな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0042",
   "jp": "{s:00F5}が群れる理由を探索",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0043",
   "jp": "困ったものです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0044",
   "jp": "さぁ、疲れただろ？{n}この宿に寄っていってくれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0045",
   "jp": "この辺りに町を作りたくて、{n}こんな宿を作ったんだ！{n}この辺りの名物を{s:012A}指すんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0046",
   "jp": "‥‥ん！？{n}キミ、ずいぶんと可愛い妖精を連れてるね！{p}‥‥妖精‥‥{FE14}ふむ、なるほど‥‥。{n}これは何かひらめきそうだぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0047",
   "jp": "そうそう、前にキミの連れてる{n}可愛い妖精ホムンクルスを見て、{n}新たなサービスを思いついたんだ！{p}その名もズバリ、『妖精喫茶』！{n}可愛い妖精さんたちが、{n}旅の疲れを癒してくれるよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0048",
   "jp": "妖精喫茶ぁ～！？　何よソレ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0049",
   "jp": "まぁ、入ってみれば分かるよ。{n}興味あったら寄っていってくれ！{p}ちなみに、『妖精喫茶』は入って右だよ。{n}よろしくね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0050",
   "jp": "こちらのことは私に任せて、{n}君たちは{s:0004}様と行動を共にしてくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0051",
   "jp": "{s:0004}を頼みます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0052",
   "jp": "ここは隊列の最後尾だ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0053",
   "jp": "なるほど。{n}{s:0151}様の突入にあわせるのですね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0054",
   "jp": "では、我が隊が裏から‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0055",
   "jp": "とうとう始まったか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0056",
   "jp": "苦しいのは今だけだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0057",
   "jp": "{s:0008}将軍は大丈夫だろうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0058",
   "jp": "{v:001F}うわ、広ぉ～い‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0059",
   "jp": "{v:0020}よし、{s:0001}ちゃん！{n}向こうまで競争しよう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0060",
   "jp": "{v:0021}あ、アタシも！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0061",
   "jp": "{v:0022}それじゃ、僕も参加させてもらおうかな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0062",
   "jp": "{v:0023}それじゃ、よーい、ドン！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0063",
   "jp": "{v:0024}彼女、{s:0001}さん、と言いましたね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0064",
   "jp": "・妹だと答える",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen100.0065",
   "jp": "・{s:0001}がどうかしたかたずねる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen100.0066",
   "jp": "{v:0025}あなたの妹さんなんですね。{p}{v:0026}あの子と同じくらいの歳ですよね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0067",
   "jp": "{v:0027}ええ。{n}あの子と同じくらいの歳ですよね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0068",
   "jp": "{v:0028}{s:0004}のことですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0069",
   "jp": "{v:0029}いいえ。{n}{s:000A}のことです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0070",
   "jp": "{v:002A}ああ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0071",
   "jp": "{v:002B}私はまだ半信半疑なところがあるのです。{n}まさか{s:000A}が、偽者だったとは。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0072",
   "jp": "{v:002C}{s:014F}様‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0073",
   "jp": "{v:002D}{s:014F}様‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0074",
   "jp": "{v:002E}王位についてからの彼は今までとはまったく{n}変わってしまいました。{p}{v:002F}しかし、それまでの１４年間はまぎれもなく{n}親子だったのです。{p}{v:0030}そこへ本当の息子という{s:0004}が現れ、{n}{s:000A}を倒すべく、{s:011E}と兵を起こした。{n}そして自分もそこに身を置いているなんて‥‥。{p}{v:0031}誰かに騙されているようにも、長くて悪い夢を{n}見ているように思うときもあります。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0075",
   "jp": "{v:0032}でも、{s:0004}には火傷の跡もあったし、{n}それに{s:0025}さんだって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0076",
   "jp": "{v:0033}{s:000E}。{n}{s:014F}様の気持ちも察してやれ。{p}{v:0034}例えば、{s:0000}がいきなり、{n}俺たちの敵に回ったら、お前はどうするよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0077",
   "jp": "{FFF3}‥‥{FFF4}{v:0035}う‥それは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0078",
   "jp": "{v:0036}俺たちの味方をするか？{n}それともコイツについて、敵に回るか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0079",
   "jp": "‥{v:0037}そ‥その‥‥あう‥‥[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0080",
   "jp": "{v:0038}それが今の{s:014F}様の心境だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0081",
   "jp": "‥‥{v:0039}ご、ごめんなさい、{s:014F}様！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0082",
   "jp": "{v:003A}気にしてはいませんよ。{p}{v:003B}それよりも、実際に戦うあなた達に{n}こんなグチをこぼしてしまった、{n}私の方が悪いのですから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0083",
   "jp": "{v:003C}少し冷えてきましたね。{n}そろそろ戻りましょうか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0084",
   "jp": "{v:003D}そうはいきませんよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0085",
   "jp": "{v:003E}誰っ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0086",
   "jp": "‥‥{v:003F}俺としたことが、うかつだったぜ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0087",
   "jp": "{v:0040}我が子に弓を引くとは、いけない母上ですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0088",
   "jp": "‥‥{v:0041}あなたは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0089",
   "jp": "{v:0042}忘れもしねぇ、{n}その声は、{s:0020}か‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0090",
   "jp": "{v:0043}これは、これは{s:0002}。{n}なんとまぁ変わり果てた姿に。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0091",
   "jp": "{v:0044}相変わらず人をバカにしたような口調だな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0092",
   "jp": "{v:0045}何とでも言いなさい。{p}{v:0046}しかし、わざわざ人気のないところまで{n}来てくれたことには礼を言いましょうか。{p}{v:0047}さ、お前たち！{n}何をするかはわかっていますね？{n}さっさとその女を殺してしまいなさい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0093",
   "jp": "{v:0048}奴ら{s:014F}様を狙うつもりよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0094",
   "jp": "{v:0049}そうはさせるか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0095",
   "jp": "{v:004A}そんなこと、させないよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0096",
   "jp": "{v:004B}これを見てもまだそんなことが言えますかね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0097",
   "jp": "{v:004C}火だ！{n}お兄さま、大変だよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0098",
   "jp": "{v:004D}僕たちを焼き殺すつもりか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0099",
   "jp": "‥‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0100",
   "jp": "{v:004E}奴らを倒して突破するしかない！{n}頼むぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0101",
   "jp": "{v:0069}ふわぁ～、ヒドイ{s:012A}にあったわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0102",
   "jp": "{v:006A}あなた達がいなかったらと思うと‥‥。{FFF9}{FFFB}{n}{v:006B}ありがとうございました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0103",
   "jp": "{v:006C}みんな助かってよかったね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0104",
   "jp": "{v:006D}そろそろ覆面を取ったらどうだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0105",
   "jp": "‥{FE1E}‥{FE1E}‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0106",
   "jp": "{v:006E}やっぱり{s:0005}じゃない！{p}{FC03}{v:006F}どうして？{n}もうシャドー・ナイツにいる必要は{n}ないんじゃないの！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0107",
   "jp": "{v:0070}確かにお前たちの言ったとおり、{n}すべては{s:0020}が仕組んだことだった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0108",
   "jp": "{v:0071}やっぱりな。{n}奴はお前の力に{s:012A}を付け、{n}是が非でも自分の手駒にしたかったんだろう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0109",
   "jp": "‥‥{v:0072}その通りだ。{n}そしてそのワナに俺はまんまとはまっちまった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0110",
   "jp": "{v:0076}でもそれがわかっていて、どうして‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0111",
   "jp": "{v:0077}言っただろ？{n}『ワナにはまった』ってな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0112",
   "jp": "{v:0078}何がワナなの？{n}詳しく話してくれなきゃわかんないよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0113",
   "jp": "‥‥{v:0079}{s:0007}が‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0114",
   "jp": "{v:007A}えっ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0115",
   "jp": "{v:007B}{s:0007}を人質に取られた‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0116",
   "jp": "{v:007C}くそっ！{n}どこまでも汚い奴だぜ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0117",
   "jp": "‥‥{v:007D}俺のせいで{s:0007}が‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0118",
   "jp": "{v:007E}{s:0005}さん、これからどうするの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0119",
   "jp": "‥‥{v:008D}何とかして{s:0007}を探し、助け出す！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0120",
   "jp": "{v:007F}探すって、あてはあるの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0121",
   "jp": "‥‥{v:0080}ない。{p}{v:0081}だがお前たちに勝てない以上、{n}{s:0007}を探すしか方法はないじゃないか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0122",
   "jp": "{v:0082}身内を人質に取ってまで‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0123",
   "jp": "{v:0083}早いとこ{s:0004}を王位につけて、{n}そういう連中を切り捨てるしかねぇな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0124",
   "jp": "{v:0084}どうしました？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0125",
   "jp": "{v:0085}{s:011E}‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0126",
   "jp": "{v:0086}くせ者が{s:014F}様の命を狙って現れた。{n}だが、もう心配ない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0127",
   "jp": "‥‥{v:0087}君たちが守ってくれたのか。{n}ありがとう。{p}{v:0088}これからはもっと警戒を厳重にしなければならないな。{p}{v:0089}後は我々が警備を強化する。{n}君たちは休んでくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0128",
   "jp": "こんな夜更けに、どちらへ行かれるのですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0129",
   "jp": "{v:001E}向こうへ行ってみましょう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0130",
   "jp": "{v:000C}なぁ、川で{s:00F5}が暴れているって{n}言ってたよな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0131",
   "jp": "{v:000D}うん、そう言ってたね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0132",
   "jp": "{v:000E}やっぱり気になる？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0133",
   "jp": "{v:000F}ああ。{n}集団で暴れているってのがな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0134",
   "jp": "{v:0010}このままじゃ行軍できないんでしょ？{p}{v:0011}何とか出来ないかなぁ、お兄ちゃん？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0135",
   "jp": "{v:0012}あら、みなさんこんな所で何をしているんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0136",
   "jp": "{v:0013}{s:014F}様‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0137",
   "jp": "{v:0014}えっとね、川で暴れる{s:00F5}について、{n}ちょっと‥‥。{p}{v:0015}{s:014F}様は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0138",
   "jp": "{v:0016}私は息子のことを考えていたら、{n}こちらから声が聞こえてきたので‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0139",
   "jp": "{v:0017}大丈夫です。{n}きっと上手くいきますよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0140",
   "jp": "{v:0018}あとはアタシたちが何とかしますから、{n}{s:014F}様はお休みになってください。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0141",
   "jp": "{v:0019}あとのことは我々に任せて、{n}{s:014F}様はお休みください。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0142",
   "jp": "{v:001A}頼もしいですね。{p}{v:001B}では後少しだけ、散歩でもしながら、{n}お話をしませんか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0143",
   "jp": "{v:001C}はぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0144",
   "jp": "ねぇ‥‥。{n}こんな所に１人で来てどうするの？{n}みんなの所へ戻ろうよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0145",
   "jp": "{v:001D}あ、こんな所にも川が流れてたんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0146",
   "jp": "{v:008A}う～ん、いい天気。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0147",
   "jp": "ねぇ、お兄ちゃん‥‥。{n}{s:0005}さんのことだけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0148",
   "jp": "うん‥‥、{n}アタシ達で{s:0007}さんを探せればねぇ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0149",
   "jp": "念のために言うが、俺たちの受けている任務は、{n}{s:011E}たちの協力をし、{n}速やかに戦争を終わらせることだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0150",
   "jp": "え～っ！{n}{s:0002}さん、冷たい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0151",
   "jp": "とりあえず、事実を言ったまでだ。{n}どうするかは任せる。{p}１つ忠告があるんだが、{s:0020}の奴、{n}{s:0005}が意のままにならなくなったと知れば、{n}すぐにでも{s:0007}を殺しかねない。{p}{s:0007}を探すなら、あまり時間はないぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0152",
   "jp": "うぐぐぐ‥‥[01BE]{n}どうすればイイのよぉ‥‥[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0153",
   "jp": "橋が燃え落ちている。{n}あの時の炎の勢いがうかがえるようだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0154",
   "jp": "いつまでもここで足止めをくらっていては、{n}{s:000A}に時間を与えるだけだ‥‥。{p}あの水辺の{s:00F5}は、{n}なぜあんな群れ方をするんだろう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0155",
   "jp": "昨夜はありがとう。{n}おかげで助かりました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0156",
   "jp": "すぐに水中へ逃げられるので、{n}{s:00F5}に致命傷を与えられないのだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0157",
   "jp": "川に毒を流すという手もあるが、{n}それでは下流に住む住民に迷惑をかけてしまう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0158",
   "jp": "何かいい手はないものか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0159",
   "jp": "見回りばかりしていては、{n}さすがにあきてくるな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0160",
   "jp": "やっと動けるのね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0161",
   "jp": "このままいつまでもここにいると、{n}兵の士気が下がってしまうわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0162",
   "jp": "{s:0008}軍の援護",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0163",
   "jp": "{v:0024}こちらのことはもう心配しなくとも良いようだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0164",
   "jp": "{v:0025}君たちは確か{s:0166}王国の‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0165",
   "jp": "{v:0026}そうだよ。{n}アタシ達、この戦争を終わらせたいの！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0166",
   "jp": "{v:0027}彼らが{s:0004}を連れてきてくれました。{p}{v:0028}戴冠式の席で、グレッグ卿が{s:000A}に{n}斬りかかったことは、全くの狂言。{n}あの場にいた私が、証人です。{p}{v:0029}{s:0160}も{s:0166}も、{n}本当は戦う必要はないのです。{p}{v:002A}真に倒すべきは{s:000A}と、その背後で糸を引く者。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0167",
   "jp": "{v:002B}そうですね。{n}早く元の平和な世界を取り戻しましょう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0168",
   "jp": "{v:002C}ね、あの人に何か聞いておくことないの？{n}せっかくのチャンスだよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0169",
   "jp": "{s:0151}に質問することはありますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0170",
   "jp": "・なぜ協力的になったのか",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen100.0171",
   "jp": "・{s:0020}という男を知っているか",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen100.0172",
   "jp": "・{s:0008}を知っているか",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen100.0173",
   "jp": "・{s:0025}を知っているか",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen100.0174",
   "jp": "・聞くことはない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen100.0175",
   "jp": "{v:002D}僕は国王に忠誠を誓う騎士だ。{n}偽王にではなく、ね。{p}{v:002E}これが答えじゃ不満かい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0176",
   "jp": "{v:002F}{s:0020}？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0177",
   "jp": "{v:0030}シャドー・ナイツの男だ。{n}知っているか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0178",
   "jp": "‥‥{v:0031}知ってる。{n}本来は知らないふりをしなければいけない{n}存在だけどね。{p}{v:0032}彼がどうかしたのかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0179",
   "jp": "{v:0033}実は、わたしたちの知り合いを人質にして‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0180",
   "jp": "{v:0034}彼女の居場所を知りたいんです！{FFF9}{FFFB}{n}{v:0035}{s:0007}さんの居場所を知りませんか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0181",
   "jp": "‥‥{v:0036}人質か。{p}{v:0050}残念ながら僕は知らないよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0182",
   "jp": "‥‥{v:0037}そうですか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0183",
   "jp": "{v:0038}だけど、{s:0020}についてなら少し助言してあげよう。{p}{v:0039}{s:015C}は知っているね？{n}あそこで何度か見かけたことがあるよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0184",
   "jp": "‥‥{v:003A}あの温泉街だ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0185",
   "jp": "{v:0039}{s:015C}は知っているね？{n}あそこで何度か見かけたことがあるよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0186",
   "jp": "{v:003B}ただ温泉に来てただけかも知れないけど。{n}だとしたらかなりの温泉好きなんだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0187",
   "jp": "{v:003C}{s:0008}は僕たちインペリアル・ナイツの中では{n}新人だけど、責任感はあるし、行動力もある。{n}立派なナイトだよ。{p}{v:003D}彼がどうしたんだい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0188",
   "jp": "{v:003E}コイツが言いたいのはね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0189",
   "jp": "{v:003F}しっ！{p}{v:0040}それ以上はなしだ。{n}ほら、{s:011E}が怖い顔でにらんでるよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0190",
   "jp": "{v:0041}知ってはいるけど、今は王宮にはいないよ。{n}彼はここのところ姿を見せていない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0191",
   "jp": "{v:0042}どんな人だったの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0192",
   "jp": "{v:0043}それほど話したことはないけど、{n}自分にも他人にも厳しくて、{n}どこか近寄り難い人だったね。{p}{v:0044}ああ、そう言えば見かけよりも本当は歳を{n}取っているらしいよ。{p}{v:0045}彼が宮廷魔術師になった時から、{n}外見が変わっていないそうだ。{n}何か魔法で歳を取らなくしているみたいだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0193",
   "jp": "{v:0043}それほど話したことはないけど、{n}自分にも他人にも厳しくて、{n}どこか近寄り難い人だったね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0194",
   "jp": "{v:0047}他に何かあるのかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0195",
   "jp": "{v:0048}それでは、僕は{s:00EA}に事情を話して、{n}これからの行動を{s:011E}と決めなければ{n}ならないから。{p}{v:0049}これで失礼するよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0196",
   "jp": "{v:004A}ありがとうございます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0197",
   "jp": "{v:004B}あ、それから１つだけ。{p}{v:004C}早く{s:0008}のところに行ってあげた方がいい。{p}{v:004D}あっちには頑固にも{s:000A}の味方をする、{n}{s:0154}‥‥{s:0153}将軍が出撃しているからね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0198",
   "jp": "{v:004E}インペリアル・ナイト同士の戦いか‥‥。{p}{v:004F}{s:0008}、大変そうだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0199",
   "jp": "{v:0000}君たち、戻ってくれたか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0200",
   "jp": "{v:0001}状況は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0201",
   "jp": "{v:0002}ここに群れていた{s:00F5}に変化が見られたので、{n}すぐに部隊を集結させておいたのだ。{p}{v:0003}すると{s:00F5}は徐々に姿を消したのだが、{n}ここで足止めをくらっていた間に、{n}{s:0160}軍が対岸まで来ていたのだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0202",
   "jp": "{v:0004}{s:011E}！{n}{s:0151}将軍が１人で橋を渡ってきます！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0203",
   "jp": "{v:0005}１人で？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0204",
   "jp": "{v:0006}と、止まれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0205",
   "jp": "{v:0007}慌てるな。{n}話し合いに来た。{n}そちらの代表を呼んでもらおうか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0206",
   "jp": "{v:0008}この隊を指揮しているのは私だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0207",
   "jp": "{v:0009}これは{s:011E}。{n}お久しゅうございます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0208",
   "jp": "{v:000A}挨拶は後にして、手短に用件を済ませようか。{n}{s:00EA}たちが神経質になっているのでな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0209",
   "jp": "‥‥{v:000B}では単刀直入に伝えましょう。{p}{v:000C}我が隊は貴殿らと戦う気はございません。{n}逆に貴殿の配下に加えていただきたい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0210",
   "jp": "‥‥{v:000D}なっ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0211",
   "jp": "{v:000E}信じていただけませんかな？{p}{v:000F}私はインペリアル・ナイツとして国王陛下の{n}身近にいた者です。{n}しかし最近の陛下は、すっかり変わってしまわれた。{p}{v:0010}そんな折り、あの陛下は真っ赤な偽者であると{n}貴殿らは反乱を起こされた。{p}{v:0011}それだけならまだしも、{n}{s:014F}様までが貴殿らを支持している。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0212",
   "jp": "{v:0012}母が実の子を見間違えるはずがありません。{n}私は真実が貴殿らにあると判断し、{n}インペリアル・ナイツとしての使命を果たすべく、{n}ここへ参上しました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0213",
   "jp": "{v:0013}それでは協力していただけるのですね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0214",
   "jp": "{v:0014}{s:014F}様‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0215",
   "jp": "{v:0015}これは{s:014F}様‥‥。{p}{v:0016}失礼を承知で、おうかがいしたいことがございます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0216",
   "jp": "{v:0017}なんでしょう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0217",
   "jp": "{v:0018}本当に陛下は偽者なのですね？{n}世を乱す王を討つため、{n}嘘をおっしゃっているわけではないのですね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0218",
   "jp": "{v:0019}いろいろと心配をかけたようですね。{n}しかしもう心配はいりません。{p}{v:001A}今王位についている者は幼少の頃すり替えられた偽者。{n}本当の息子は、今{s:0008}将軍と{n}行動を共にしています。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0219",
   "jp": "{v:001B}先ほどの無礼をお許し下さい。{p}{v:001C}私、{s:001C}。{n}騎士の名に賭けて、忠誠を尽くすのは{n}真の王のみでございます。{p}{v:001D}あなた様の協力をさせていただきたく存じます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0220",
   "jp": "{v:001E}{s:011E}。{n}私は彼を信じても良いと思います。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0221",
   "jp": "{v:001F}しかし、{s:014F}様‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0222",
   "jp": "{v:0020}インペリアル・ナイツが、{n}スパイじみた作戦をとると思いますか？{p}{v:0021}それに彼の忠誠は、私もよく知っております。{n}心配はありません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0223",
   "jp": "{v:0022}わかりました。{n}彼を信用しましょう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0224",
   "jp": "{v:0023}ありがとうございます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0225",
   "jp": "彼の言葉が気になる。{n}{s:0008}は大丈夫だろうか‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0226",
   "jp": "{s:0151}が我々についてくれるとは‥‥。{n}勝機も見えてきましたね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0227",
   "jp": "あの{s:00F5}に手間取っていた間に{n}{s:000A}がナイツをよこしたのですね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0228",
   "jp": "こっちは何とかなりそうだが、{n}{s:0008}様は大丈夫だろうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0229",
   "jp": "いよいよ本格的な戦いになるぞ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0230",
   "jp": "これで我が軍の兵力が、倍になったな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0231",
   "jp": "相手は{s:0151}様か‥‥。{n}だが、負けられぬ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0232",
   "jp": "{s:0151}様の姿を確認した時、{n}思わず死を覚悟したよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0233",
   "jp": "{s:014F}様、危険です。{n}ここは我々に任せて、下がって下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0234",
   "jp": "いや～。{n}正直言って、ほっとしたよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0235",
   "jp": "ダグラス様だって、元ナイツメンバーだ。{n}そう簡単に、負けてたまるか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0236",
   "jp": "こんな事になるなんて、驚いたわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0237",
   "jp": "いよいよね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0238",
   "jp": "我々はただ{s:0151}様についていくだけです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0239",
   "jp": "偽王{s:000A}を討つため、{n}我々も戦います！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0240",
   "jp": "ひょっとしてあなた方ですかな？{n}{s:0151}将軍を退けた方は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0241",
   "jp": "スイッチがある。{n}押してみますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0242",
   "jp": "　{n}　　　　　驚いていただけました？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0243",
   "jp": "いらっしゃいませ。{n}当ホテルをご利用になられますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0244",
   "jp": "以前、ウチの女子社員にひどい事しましたから‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0245",
   "jp": "１泊、{FFEB}エルムになりますが？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0246",
   "jp": "お客さん‥‥[01BE]{n}お金が足りないみたいですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0247",
   "jp": "またのお越しをお待ちしております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0248",
   "jp": "{v:0000}やぁ、いらっしゃい。{n}ここには、いろんな装備があるよ～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0249",
   "jp": "{v:0002}さて、何の用かな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0250",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen100.0251",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen100.0252",
   "jp": "まだ用事はあるかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0253",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen100.0254",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen100.0255",
   "jp": "{v:000B}またおいで～。{n}待ってるよ～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0256",
   "jp": "{v:001A}おう、いらっしゃい。{n}ここは道具を売ってる店だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0257",
   "jp": "{v:001B}買いに来たのか？{n}それとも何か売る気か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0258",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen100.0259",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen100.0260",
   "jp": "まだ何か用か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0261",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen100.0262",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen100.0263",
   "jp": "{v:0025}じゃあな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0264",
   "jp": "ダメですよ、話しかけちゃ。{n}知らないふりをするのもマナーですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0265",
   "jp": "申し訳ありません、お客様。{n}妖精が当店を卒業してしまったため、{n}『妖精喫茶』のサービスは終了しました。{p}今までご利用いただき、{n}どうもありがとうございました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0266",
   "jp": "暖炉に火を付けますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0267",
   "jp": "ちょ、ちょっと！{n}何する気！？{n}やめてください！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0268",
   "jp": "中に人がいるようだが、火を付けますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0269",
   "jp": "{FFF0}ぎゃーーーーっ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0270",
   "jp": "‥‥‥ほっ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0271",
   "jp": "せっかく休ませてもらえるんだから、{n}ちゃんと休もうよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen100.0272",
   "jp": "{s:014F}様に誘われているのに、{n}無視したら失礼だよ。",
   "en": "",
   "term": "end"
  }
 ]
}
