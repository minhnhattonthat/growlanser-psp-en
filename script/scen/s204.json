  },
  {
   "id": "scen204.0003",
   "jp": "{v:0008}もぉ～～！{n}ドジなんだからぁ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen204.0004",
   "jp": "{v:0054}きゃあっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen204.0005",
   "jp": "{v:0055}ああっ！ルイセちゃんが！{n}もぅっ！敵討ちよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen204.0006",
   "jp": "１匹倒したけど、{n}予選突破は無理だね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen204.0007",
   "jp": "よ～し、これで１匹！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen204.0008",
   "jp": "２匹倒せたけど、{n}予選突破は無理だね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen204.0009",
   "jp": "２匹目ゲット！{n}この調子でどんどん行こう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen204.0010",
   "jp": "やったね★{n}これで３匹目。{n}もう予選突破できたも同然だね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen204.0011",
   "jp": "すご～い！{n}アタシ達だけで、４匹も倒したよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen204.0012",
   "jp": "ありゃりゃ？{n}全部、アタシ達だけで倒しちゃったね★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen204.0013",
   "jp": "あぁ！{n}１匹、倒されちゃったよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen204.0014",
   "jp": "あ～あ。{n}２匹目も倒されちゃった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen204.0015",
   "jp": "アンタ、もうちょっとがんばりなさいよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen204.0016",
   "jp": "よ、４匹目‥‥。{n}ダ、ダメだわ、これは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen204.0017",
   "jp": "く～っ！{n}１匹も倒せないなんて、アンタ、何やってるのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen204.0018",
   "jp": "おおっ～と！{n}２組のグループがゲルを２匹ずつ倒しています！{n}つまりこの勝負は引き分け！{p}しかし予選を抜けられるグループは１組のみ。{n}この２組には、さらに勝負をしてもらいましょう！{p}まず、負けたグループは退場して下さい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen204.0019",
   "jp": "さぁ、この２組に勝敗を付けてもらいましょう！{n}勝負は簡単。{p}１匹だけ出るゲルを、どちらが早く倒すか？{n}ゲルが出る場所は会場中央！{n}みなさん、ご注目下さい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen204.0020",
   "jp": "ゲルが現れました！{n}さぁ、目が離せない展開になってきました！{n}試合、再開です！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen204.0021",
   "jp": "悔し～！{n}負けちゃったよ～！",
   "en": "",
   "term": "end"
  }
 ]
