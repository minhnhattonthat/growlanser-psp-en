  },
  {
   "id": "scen119.0079",
   "jp": "{v:0027}リシャール‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen119.0080",
   "jp": "{v:0028}よくもヴェンツェル様の居城に、{n}土足で踏み込んでくれたな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen119.0081",
   "jp": "{v:0029}話を聞いてよ！{p}{v:002A}アンタがいれば、世界を救えるんだよ！？{n}アタシ達に協力してよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen119.0082",
   "jp": "{v:002B}世界を救うだと？{p}{v:002C}ハッ！{n}笑わせるな。{n}今のままでもヴェンツェル様が救って下さる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen119.0083",
   "jp": "{v:002D}でも、それは人間を支配しながらでしょ？{n}世界は誰のものでもないよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen119.0084",
   "jp": "‥‥{v:002E}黙れ！{n}お前たちと話していると気分が悪くなる！{p}{v:002F}これ以上の会話は無意味だ。{n}ここで殺してやる！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen119.0085",
   "jp": "{v:0067}リシャール様、しっかりなさってください！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen119.0086",
   "jp": "‥{v:0066}私は‥‥私は‥‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen119.0087",
   "jp": "{FFEE}{v:0069}　　　　おまえも裏切るか、リシャールよ。{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen119.0088",
   "jp": "{v:006A}この声！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen119.0089",
   "jp": "{v:006B}ヴェンツェル！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen119.0090",
   "jp": "{FFEE}{v:006C}　　　　命を助けてやった恩を忘れたか？{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen119.0091",
   "jp": "{v:006D}う‥うるさい！{n}私は、お前などに屈せぬ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen119.0092",
   "jp": "{FFEE}{v:006E}　　　　勇ましいことだな。{FFF9}{FFFB}{n}{v:006F}　　　　だが裏切り者を生かしておくほど、{n}　　　　私は寛容ではない。{FFF9}{FFFB}{n}{v:0070}　　　　死ぬがいい！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen119.0093",
   "jp": "{v:0072}リシャール様！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen119.0094",
   "jp": "{v:0000}リシャール様‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen119.0095",
   "jp": "‥{v:0001}そんな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen119.0096",
   "jp": "{v:0002}どうすんのよ！{n}リシャールがいなかったら‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen119.0097",
   "jp": "‥‥{v:0003}{s:0000}がやるしかないようだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen119.0098",
   "jp": "{v:0004}だって、こいつだけじゃ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen119.0099",
   "jp": "{v:0005}それしか方法がねぇんだろ？{n}だったら、やるしかない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen119.0100",
   "jp": "{v:0006}冷たいようだが、{n}この世界を救うにはそれしかない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen119.0101",
   "jp": "{v:0007}冷たいようだが、彼がやらねば、{n}我々はヴェンツェルに降伏するしかない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen119.0102",
   "jp": "{v:0008}もしダメだったら、{n}ヴェンツェルに降参するしかないよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen119.0103",
   "jp": "{v:0009}このままだと、ヴェンツェルの支配を{n}受け入れるしかないのですね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen119.0104",
   "jp": "{v:000A}ここまで来て、{n}ヴェンツェルに降伏するしかないのですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen119.0105",
   "jp": "{v:000B}もしこいつがやらなけりゃ、{n}ヴェンツェルの支配を待つだけだ。{p}{v:000C}冷たいが、他に方法はない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen119.0106",
   "jp": "‥‥{v:000D}すまないが、１人にしてくれ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen119.0107",
   "jp": "う～ん、{n}エレベータの中はテレポートできないみたい‥‥。",
   "en": "",
   "term": "end"
  }
 ]
