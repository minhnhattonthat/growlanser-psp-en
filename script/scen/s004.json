  },
  {
   "id": "scen004.0012",
   "jp": "入隊希望者",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen004.0013",
   "jp": "警備兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen004.0014",
   "jp": "王都ローザリア",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0015",
   "jp": "{v:0000}うちの子を‥うちの子を返しておくれよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0016",
   "jp": "{v:0001}そんなことを言われてもな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0017",
   "jp": "{v:0002}どうしたんだろう‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0018",
   "jp": "{v:0003}あの‥どうしたんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0019",
   "jp": "{v:0004}聞いとくれよ！{n}この城の馬鹿な騎士が、ヴェンツェルを怒らせたから、{n}私の息子が死んだんだよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0020",
   "jp": "{v:0005}息子さん？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0021",
   "jp": "{v:0006}ああ、彼はこの街の警備兵だったんだ。{n}それで、先日、ゲヴェル型モンスターが{n}この街を襲撃したとき、亡くなったんだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0022",
   "jp": "{v:0007}英雄気取りの馬鹿な騎士がいなけりゃ‥‥息子も‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0023",
   "jp": "{v:0008}あの人の言ってた騎士って、ひょっとして‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0024",
   "jp": "{v:0009}あまり、お気になさらないで下さい。{n}あなた方は精一杯のことをしているのですから‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0025",
   "jp": "開門！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0026",
   "jp": "どうぞ、お入り下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0027",
   "jp": "{v:004C}いらっしゃいませ。{n}スキマ屋へようこそ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0028",
   "jp": "{v:0054}これからもスキマ屋をよろしくね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0029",
   "jp": "‥‥ローランディアは、のどかでいいよね。{p}バーンシュタインやランザックは、{n}どうも俺の性に合わないよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0030",
   "jp": "君たちの活躍は、よく哮になってるよ。{n}もう英雄として大評判だよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0031",
   "jp": "やっと平和が訪れたのね。{n}でも、この胸騒ぎは何かしら‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0032",
   "jp": "はぁ‥‥。子供の頃が懐かしいわね‥‥。{n}岬ではるか遠くを飛ぶフェザリアンを見た日も、{n}こんな晴れた空だったわ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0033",
   "jp": "城門は堅く閉ざされている‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0034",
   "jp": "　{FE1E}‥{FE1E}‥{FE1E}‥{FE1E}売れねぇなぁ{FE1E}‥{FE1E}‥。{FFFB}{n}　‥‥誰も来ねぇし‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0035",
   "jp": "　　特売品多数！{n}　　　アイテムショップ・ココ",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0036",
   "jp": "　　特売品多数！{n}　　　　スキマ屋",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0037",
   "jp": "マンホールの底には、何もないようだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0038",
   "jp": "店の前にあるマンホールだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0039",
   "jp": "マンホールがまるい形をしているのは、{n}向きがずれても落ちないためだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0040",
   "jp": "オイラ、すっごい魔法使いになるんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0041",
   "jp": "こいつ、またホラ吹いてるよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0042",
   "jp": "ホラじゃないよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0043",
   "jp": "うぅ‥‥。{n}なんか寂しいよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0044",
   "jp": "僕たち、デート中なんだ。{n}邪魔しないでくれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0045",
   "jp": "僕の彼女、ここを散歩するのが好きだったんだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0046",
   "jp": "私たち、デート中なの。{n}邪魔しないで！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0047",
   "jp": "あぁ‥‥。{n}これから私はどうしたらいいの‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0048",
   "jp": "妖精ちゃん。{n}あなたも彼と一緒に頑張ってね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0049",
   "jp": "{v:0034}本日はお買い求めですか？{n}それともご売却ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0050",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen004.0051",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen004.0052",
   "jp": "他にも何かおありでしょうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0053",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen004.0054",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen004.0055",
   "jp": "{v:003E}ありがとうございました！{n}またどうぞ、お越し下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0056",
   "jp": "{v:000C}いらっしゃいませ。{n}当店では、様々な装備品を取り扱っております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0057",
   "jp": "{v:000E}お買い求めですか？{n}それともご売却ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0058",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen004.0059",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen004.0060",
   "jp": "他にもご用はおありですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0061",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen004.0062",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen004.0063",
   "jp": "{v:0018}またどうぞ、お越し下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0064",
   "jp": "やっと商店街へ買い出しに行って来たよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0065",
   "jp": "ごめ～ん。{n}今、手が放せないの。{n}しばらくしたら、また来て。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0066",
   "jp": "あら、私を訪ねてくれたの？{p}そう言えば、スキマ屋には行ってみた？{n}あそこのおじさん、商売熱心だから、{n}たまに新しい物が入ってたりするわよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0067",
   "jp": "デリス村の村長は私の叔父なのよ。{n}今でこそ、ぼ～っとして見えてるけど{n}昔はけっこう切れ者だったらしいわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0068",
   "jp": "‥‥なんか、ず～っと物陰に隠れていると{n}眠くなっちゃうなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0069",
   "jp": "へぇ～。{n}こんな所に出るんだ‥‥。{n}面白いね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0070",
   "jp": "うす汚れたマンホールだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0071",
   "jp": "新しいマンホールだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0072",
   "jp": "　{n}　　　　　南大通り商店街、営業中！！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0073",
   "jp": "今では兵隊さんが品物を買いに来て、大忙しだ。{n}ああ、忙しい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0074",
   "jp": "今はちょっと忙しいの。{n}悪いけど、また後にしてくれないかしら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0075",
   "jp": "よく来てくれたね。{n}せっかくだから、お店に寄っていって頂戴。{p}この扉の奥よ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0076",
   "jp": "よく、ここへ来る方法がわかったな‥‥。{n}ここに気づいたのは、お前が初めてだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0077",
   "jp": "{v:0019}おう、いらっしゃい。{n}ここは装備品を売ってる店だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0078",
   "jp": "{v:001B}買いに来たのか？{n}それとも何か売る気か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0079",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen004.0080",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen004.0081",
   "jp": "まだ何か用か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0082",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen004.0083",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen004.0084",
   "jp": "{v:0025}じゃあな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0085",
   "jp": "お店の営業が始まってからずいぶん経つのに、{n}何となく賑やかさにかけるのよね～。{n}やっぱり、戦争があったせいね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0086",
   "jp": "やあ、君たち。{n}頑張って僕らを守ってくれよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0087",
   "jp": "何か新しい遊びはないかなぁ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0088",
   "jp": "　不審な人物を見かけたら、{n}　すぐに警備兵に！{n}　　　～　王都ローザリア警備隊長　～",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0089",
   "jp": "このマンホールをくぐると地底都市が！！{FFFB}{n}‥‥ということは絶対にない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0090",
   "jp": "　　　　　　魔法学院合格率６０％！{n}　　　　実績に裏付けされた信頼の進学塾{n}　　　　　　　『ＬＬＭ魔法教室』",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0091",
   "jp": "今日に限って、鉄格子が外れない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0092",
   "jp": "誰か、俺に魔法を教えてくれぇ～！{n}しかも親切で分かりやすくないと嫌だ～！{p}‥‥あ、あとタダで教えてくれないと困る。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0093",
   "jp": "また、街の中で戦闘だって！{p}家の中にもどれって言われても、{n}俺の家は東側だから、戦場になってるんだよ！{p}まったく、近頃はどうなってるんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0094",
   "jp": "今日の筆記試験、けっこう出来たとおもうわ。{n}問題は実技ね。{n}近々、試験があるはずだから‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0095",
   "jp": "あなたに教えることは、もうなさそうね。{p}だけどこのおじいさんは、{n}まだまだ勉強が必要みたい[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0096",
   "jp": "‥‥ふむふむ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0097",
   "jp": "能力の説明で、まだお知りになりたい事は{n}ありますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0098",
   "jp": "だいたいはわかったんじゃが‥‥。{n}１つ聞いてもいいかのぉ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0099",
   "jp": "何でしょう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0100",
   "jp": "わしも経験をつめば、剣とかを振り回して、{n}きめぽぉずをとるんじゃろうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0101",
   "jp": "え‥‥[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0102",
   "jp": "わしも経験をつめば、{n}きめぽぉずをとるんじゃろうか？{n}そこがいちばん知りたいのぉ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0103",
   "jp": "お兄ちゃん、こっちは西門だよ？{n}待ち合わせは東の門だって言ってたよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0104",
   "jp": "最近ヴェンツェルの部下どもが、{n}この辺りにも現れるようになっています。{p}街の人たちに被害は出ていませんが、{n}多くの兵が命を落としました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0105",
   "jp": "岬へ行かれるのですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0106",
   "jp": "{v:0008}これを見てください！{n}全部入隊希望者ですよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0107",
   "jp": "仲間と力を合わせて頑張って下さい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0108",
   "jp": "ここのところ、化け物が出没するので、{n}巡回をしているところです。{p}化け物を操っているらしい、{n}怪しい魔法使いの姿は何度も見かけるのですが、{n}兵が詰めかける頃には消え失せてしまうのです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0109",
   "jp": "‥‥やっぱりヴェンツェルみたいね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0110",
   "jp": "奴のせいで、{n}城にいる仲間の多くが、死んでしまった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0111",
   "jp": "ここはローランディア王国の王都、ローザリアです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0112",
   "jp": "街の外に出るのですか？{n}どうか気を付けて。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0113",
   "jp": "一時も気を抜けないな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0114",
   "jp": "‥‥結構、手続きって面倒なんだな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0115",
   "jp": "{v:0009}俺もちっとは腕に自信があるからよ、{n}せめて入隊して、人々を守る兵士になるんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0116",
   "jp": "俺はやるぜ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0117",
   "jp": "{v:000A}俺たちは絶対に負けねぇぜ！{n}だから、アンタらも頼むぜ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0118",
   "jp": "今日中に俺の番になるのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0119",
   "jp": "　{n}　　『出かけるときは、戸締まりを忘れずに！』{n}　　　　　　　～ローザリア警備隊～",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0120",
   "jp": "{v:0030}ここで待ってればいいんだよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0121",
   "jp": "{v:0031}確かそう言ってたよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0122",
   "jp": "{v:0032}アタシ、パーティーなんて初めてだよ！{n}なんだか、緊張する～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0123",
   "jp": "{v:0033}わたしだって同じだよ～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0124",
   "jp": "{v:0034}しかし、いいタイミングだな。{n}そろそろ外へ出たかったところだぜ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0125",
   "jp": "{v:0035}待たせましたね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0126",
   "jp": "{v:0036}では参りましょうか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0127",
   "jp": "{v:0037}お気をつけて！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0128",
   "jp": "{v:0038}それじゃ、わたしが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0129",
   "jp": "{v:006C}ヴェンツェルの奴、離れた場所の人を{n}テレポートできるのか‥‥。{n}やっかいだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0130",
   "jp": "‥‥{v:006D}どうしよう。{n}彼とお兄ちゃんが力を合わせないと{n}いけないのに‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0131",
   "jp": "{v:006E}本当よねぇ‥‥。{p}{v:006F}今のままヴェンツェルを倒しても、{n}世界の危機は去らないんだもんねぇ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0132",
   "jp": "‥‥{v:0070}諦めずに頑張るしかねぇな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0133",
   "jp": "{v:0071}そうですね！{n}僕たちが諦めたら、本当におしまいですからね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0134",
   "jp": "{v:0072}そうだ。{n}諦めは考えず、今は出来るだけのことをしよう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0135",
   "jp": "{v:0073}そうですね。{n}まだチャンスがなくなった訳じゃありませんから！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0136",
   "jp": "{v:0074}大丈夫。{n}まだチャンスがなくなっちまったわけじゃない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0137",
   "jp": "{v:0075}その通り。諦めるのはいつでも出来る。{p}{v:0076}今はやるだけやろう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0138",
   "jp": "{v:0087}うん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0139",
   "jp": "{v:0079}でも、リシャールを説得出来なかったときの対策を{n}練っておいた方がいいんじゃない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0140",
   "jp": "{v:007A}そうだね。{n}いろいろ方法を探るのも無駄にはならないよね。{p}{v:007B}それに、アリオストさんのお母さんも、{n}協力してくれるみたいだし。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0141",
   "jp": "{v:007C}俺たちだけで悩むことはねぇ。{n}この世界の全員が一丸になれば、{n}きっと活路が見いだせるさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0142",
   "jp": "{v:007D}その意気よ！{n}みんな、がんばろーね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0143",
   "jp": "{v:007E}お母さん、大丈夫だった？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0144",
   "jp": "{v:007F}ええ。{n}お前たちのおかげで、大事にいたりませんでした。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0145",
   "jp": "{v:0080}私たちにもっと力があれば、{n}あなた達のお手をわずらわせることも{n}なかったのですが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0146",
   "jp": "何と言いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0147",
   "jp": "・恥じることはない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen004.0148",
   "jp": "・これも仕事だ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen004.0149",
   "jp": "・協力は惜しまない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen004.0150",
   "jp": "{v:0081}そうそう！{n}今はみんなが協力しなきゃいけないときだもんね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0151",
   "jp": "{v:0082}そうだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0152",
   "jp": "{v:0083}後のことは私に任せて、{n}あなた達は一刻も早くヴェンツェルを倒して下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0153",
   "jp": "{v:0000}つ、強すぎる‥‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0154",
   "jp": "{v:0001}さすがはインペリアル・ナイツ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0155",
   "jp": "{v:0002}諦めてはいけません！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0156",
   "jp": "{v:0003}サンドラ様！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0157",
   "jp": "{v:0004}諦めは敗北を意味します。{n}全力を尽くしましょう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0158",
   "jp": "{v:0005}くっくっくっ。{n}健気じゃないか！{n}なぁ、アーネスト？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0159",
   "jp": "‥‥{v:0006}はい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0160",
   "jp": "{v:0007}我々に勝てると思っている口振りだ。{p}{v:0008}では、その希望を絶望に変えてやるとしよう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0161",
   "jp": "{v:000A}ちょっと、あいつらって！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0162",
   "jp": "{v:000B}そんな‥リシャールと‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0163",
   "jp": "{v:000C}ライエル！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0164",
   "jp": "{v:000D}エリオット君の偽者と、{n}インペリアル・ナイトの人だ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0165",
   "jp": "{v:000E}何だと？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0166",
   "jp": "{v:000F}ん？{p}{v:0010}懐かしい顔があるな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0167",
   "jp": "{v:0011}ここで何をしているのだ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0168",
   "jp": "{v:0012}ここで何をしているのですか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0169",
   "jp": "{v:0013}ちょっと！{n}ここで何をしてるのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0170",
   "jp": "{v:0014}見てわからぬか？{p}{v:0015}邪魔なローランディアの連中を皆殺しにするのだよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0171",
   "jp": "{v:0016}どうして？{n}どうしてそんなことをするの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0172",
   "jp": "{v:0017}ヴェンツェル様の邪魔になるからさ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0173",
   "jp": "{v:0018}ヴェンツェルだと！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0174",
   "jp": "{v:0019}さあ、お前たちも殺してやろう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0175",
   "jp": "ふぅ‥‥。{n}商品が無事でよかった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0176",
   "jp": "な、なんでナイツがこんな所に‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0177",
   "jp": "し、死ぬかと思った‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0178",
   "jp": "何があったの？{n}どうしてインペリアル・ナイツが{n}ローザリアなんかに？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0179",
   "jp": "あぁ‥‥。{n}どうして、こんな事になるの‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0180",
   "jp": "これほど己の無力さを感じた事はない‥‥。{n}もっと腕をみがかねば‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0181",
   "jp": "あなた方の援護がなければ、{n}ここは守りきれなかったでしょう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0182",
   "jp": "あれがインペリアル・ナイツ‥‥。{n}あれほど強いとは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0183",
   "jp": "あなた方のおかげで助かりました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0184",
   "jp": "{v:0054}街の人に被害は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0185",
   "jp": "{v:0055}大丈夫だったよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0186",
   "jp": "{v:0056}よかったね★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0187",
   "jp": "{v:0057}全くなかったとは言えないけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0188",
   "jp": "{v:0058}アタシ達がもっと早く来ていれば‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0189",
   "jp": "{v:0059}俺が心配なのはお前の方だ。{n}大丈夫なのかよ、そんな体で？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0190",
   "jp": "{v:005A}そうか。そこまでの覚悟があるなら、もう止めねぇよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0191",
   "jp": "{v:005B}お兄ちゃん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0192",
   "jp": "{v:005C}やはり辛いか‥‥。{n}だがやれるだけやってみてくれ。{n}その後は、俺たちが何とかしよう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0193",
   "jp": "{v:005D}そうとなれば、時間は無駄に出来ないね。{n}すぐにでも行動しようよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0194",
   "jp": "でも、お兄ちゃん。{n}絶対に無理はしないで。{n}早いうちに保養所で診てもらった方がよくない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0195",
   "jp": "‥‥う‥うぅ‥‥‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0196",
   "jp": "{FFF5}お、お兄ちゃん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0197",
   "jp": "すまん‥‥。{n}守りきれなかった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0198",
   "jp": "そんな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0199",
   "jp": "{v:0044}お兄ちゃん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0200",
   "jp": "‥‥{v:0045}やっぱり来たのか‥‥。{p}{v:0046}で、どうするんだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0201",
   "jp": "ナイツが攻めてきたという事で、{n}この辺りは立入禁止になっております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0202",
   "jp": "あやうく腰を抜かすところでした。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0203",
   "jp": "こ、怖かった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0204",
   "jp": "化け物をあんなに間近に見るのは初めてだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0205",
   "jp": "ここは私たちが守ります！{n}この命に代えても！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0206",
   "jp": "後のことは我々にお任せ下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0207",
   "jp": "何とか追い払えましたね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0208",
   "jp": "鍵がかけられている‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0209",
   "jp": "{v:0033}いらっしゃいませ。{n}この店では、様々なグッズをお買い求めいただけます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0210",
   "jp": "{v:000D}いらっしゃいませ。{n}当店では、様々なグッズを取り扱っております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0211",
   "jp": "　{n}『{FFEF}大きなコイン{FFF1}』を手に入れた！{FFFB}{n}と思ったら、ただのマンホールだった！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0212",
   "jp": "マンホールのふたは、雨の日によく滑る。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0213",
   "jp": "マンホールのふたは{n}４０キログラムと、かなり重い。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0214",
   "jp": "　　　スターロード武器・防具店{n}　　　　　　　ローザリア本店",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0215",
   "jp": "お母さんたちを連れて、バーンシュタインまで{n}テレポートしなくちゃいけないんでしょ？{n}今は少しでも休みたいんだけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0216",
   "jp": "そうそう！{n}街の入り口まででしょ？{n}買い物でもしながら歩いていこうよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen004.0217",
   "jp": "マスターをどこへ連れ出す気よ！",
   "en": "",
   "term": "end"
  }
 ]
}
