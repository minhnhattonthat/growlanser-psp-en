  {
   "id": "scen029.0013",
   "jp": "{v:0018}待ってよ～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0014",
   "jp": "{v:0019}ミーシャ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0015",
   "jp": "{v:001A}温泉に行くんだって？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0016",
   "jp": "{FB00}{v:001B}どうして知ってるの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0017",
   "jp": "{v:001C}闘技大会で優勝したって聞いたよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0018",
   "jp": "{v:001D}結構広まってるのね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0019",
   "jp": "{v:001E}だってお兄さまのことだもん★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0020",
   "jp": "{FB00}{v:001F}ハ‥ハハ‥‥[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0021",
   "jp": "{v:0020}で、ご一緒していいでしょ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0022",
   "jp": "{v:0021}え～っ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0023",
   "jp": "{v:0022}５名様までＯＫって聞いたけど。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0024",
   "jp": "{v:0023}うそっ！？{p}{v:0024}ちょっと、アンタ！{n}旅券見せなさいよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0025",
   "jp": "‥‥{v:0025}本当だ。{n}５名までって書いてある。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0026",
   "jp": "{v:0026}おじさまに聞いたんだ{FFF0}♥{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0027",
   "jp": "{v:0027}誰よ『おじさま』って？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0028",
   "jp": "{v:0028}あ、マクスウェル学院長のことだよ。{p}{v:0029}ミーシャの身元引受人なの。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0029",
   "jp": "{v:002A}ね～、いいでしょ？{n}アタシも連れてってよ～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0030",
   "jp": "{v:002B}どうするの、お兄ちゃん？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0031",
   "jp": "ミーシャを連れて行きますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0032",
   "jp": "・ミーシャの好きにさせる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen029.0033",
   "jp": "・断る",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen029.0034",
   "jp": "・喜んで連れていく",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen029.0035",
   "jp": "{v:002D}そんなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0036",
   "jp": "{v:002E}お兄ちゃん、わたしからもお願い。{n}連れて行ってあげてよ。{p}{v:002F}女の子がわたしだけだと、ちょっと‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0037",
   "jp": "{v:0030}そうよねぇ。{n}お風呂って、男女別なんでしょ？{n}その方がルイセちゃんも楽しめると思うけど。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0038",
   "jp": "{v:0031}妹のためにも連れてってやれよ。{n}それに旅は賑やかな方がいい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0039",
   "jp": "{v:0032}ほら、賛成多数だからね。{n}１人だけ反対してもダメだよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0040",
   "jp": "{v:0033}みんな、ありがとぉ★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0041",
   "jp": "{v:002C}やったぁ♪{n}お兄さま、だ～い好き★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0042",
   "jp": "{v:0034}よかったね、ミーシャ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0043",
   "jp": "{v:0035}うん！{n}向こうに行ったら、お背中、流しっこしようね♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0044",
   "jp": "　{n}　　　　　　{FFEF}ミーシャが仲間になった！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0045",
   "jp": "せっかくの休暇なのにさあ、{n}土砂崩れでラシェルに帰れないんだよ‥‥。{p}この前も追試で帰れなかったし‥‥。{n}やばいなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0046",
   "jp": "土砂崩れも片づいたし、{n}追試もあと少しだし‥‥。{n}これでようやくラシェルに帰れそうだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0047",
   "jp": "やっとラシェルへ帰れると思ったのに、{n}追試を受けなきゃいけなくなった‥‥。{p}しかも１０科目‥‥。{n}どうしよう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0048",
   "jp": "やっと土砂崩れが片づいたよ！{n}これでラシェルへ帰れるぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0049",
   "jp": "この学院に入って３年ちょっとになるけど、{n}学生って気楽よね。{n}卒業なんかしたくないな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0050",
   "jp": "魔法学院・学食",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0051",
   "jp": "どの階に行きますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen029.0052",
   "jp": "・屋上",
   "en": "",
