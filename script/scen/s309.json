  },
  {
   "id": "scen309.0001",
   "jp": "ルイセ",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen309.0002",
   "jp": "{v:0089}お兄ちゃん、お兄ちゃん、お兄ちゃ～ん！！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0003",
   "jp": "{v:008A}どうしたのよ、ルイセちゃん？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0004",
   "jp": "{FFF5}{v:008B}う～っ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0005",
   "jp": "どうしますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0006",
   "jp": "・わけを聞く",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen309.0007",
   "jp": "・頭をなでる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen309.0008",
   "jp": "{FFF5}{v:008C}あのね‥‥怖い夢見ちゃったの‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0009",
   "jp": "{FFF5}{v:008D}う～、お兄ちゃんだ‥‥。{n}{FFF6}‥‥よかったよぉ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0010",
   "jp": "{v:008E}ちゃんと話してよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0011",
   "jp": "{FFF5}‥‥{v:008F}うん。{n}お兄ちゃんがいなくなる夢、見ちゃったの‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0012",
   "jp": "{v:0090}コイツがいなくなる夢？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0013",
   "jp": "{FFF5}{v:0091}あのね、天気が良かったから、{n}木陰に寝ころんでたら、うたたねしちゃってね‥‥。{p}{v:0092}最初はミーシャとか、ウォレスさんとかも{n}一緒にいたんだけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0014",
   "jp": "{v:0093}何だか話が長くなりそうな予感‥‥。{p}{v:0094}取り乱してるせいかしら‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0015",
   "jp": "{v:0095}そこに強い風が吹いてきてね、{n}目にゴミが入りそうだったから‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0016",
   "jp": "{v:0096}あー、ね、ちょっとこっち来て♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0017",
   "jp": "{v:0099}あによ！{n}アタシは、あのマスタードクッキー{n}食べさせられたんだからね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0018",
   "jp": "もう、何してんのよ！{n}いいから、こっち来なさい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0019",
   "jp": "{v:0097}それで目を開けると、{n}前にいたはずのウォレスさんがいなくてね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0020",
   "jp": "{v:0098}キシシッ★{n}早くこっち向かないかなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0021",
   "jp": "{v:009A}びっくりして横を見ると、ミーシャもいなくて、{n}お兄ちゃんやティピもいないの！{n}それでわたし、１人ぼっちになっちゃって。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0022",
   "jp": "{v:009B}本当に怖くなっちゃったんだから！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0023",
   "jp": "{v:009C}！？{FFF9}{FFFB}{n}{v:009D}お兄ちゃん！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0024",
   "jp": "{v:009E}お兄ちゃん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0025",
   "jp": "{v:009F}お兄ちゃん！{n}どこ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0026",
   "jp": "{v:00A0}ティピ？{n}お兄ちゃ～ん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0027",
   "jp": "{v:00A1}ふぇ～ん！{n}お兄ちゃん、どこ行っちゃったのぉ～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0028",
   "jp": "{v:00A2}やば‥‥やりすぎたみたい‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0029",
   "jp": "{v:00A3}お兄ちゃん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0030",
   "jp": "{FFF5}{v:00A4}もう！{n}本当にびっくりしちゃったんだからね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0031",
   "jp": "何といいわけしますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0032",
   "jp": "・かくれんぼだと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen309.0033",
   "jp": "・判断能力のテストだと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen309.0034",
   "jp": "・イタズラだと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen309.0035",
   "jp": "{v:00A5}何だ、そうだったんだ‥‥。{p}{v:00A6}あんな夢見た後だから、{n}ちょっとびっくりしちゃった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0036",
   "jp": "{v:00A7}ちょっとじゃなかったみたいだけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0037",
   "jp": "{v:00A8}もう、ティピったら！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0038",
   "jp": "{v:00A9}何だ、そうだったんだ‥‥。{p}{v:00AA}それじゃ、わたし不合格だね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0039",
   "jp": "{FB00}‥‥{FE1E}{v:00AB}ちょっとは疑いなさいよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0040",
   "jp": "{FFF5}{v:00AC}もう、お兄ちゃんったら‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0041",
   "jp": "{v:00AD}ん～？{p}{v:00AE}どうしてそこで喜ぶかなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0042",
   "jp": "{v:00AF}だって、お兄ちゃんに遊んで貰えたんだもん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0043",
   "jp": "{FB00}{v:00B0}は、ははは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0044",
   "jp": "{v:00B1}安心したら、お腹空いちゃった★{n}わたし、何か食べてくるね♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0045",
   "jp": "{v:00B2}幸せな娘よねぇ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0046",
   "jp": "あっ、お兄ちゃん。{n}おなか空いてない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0047",
   "jp": "突然どうしたの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0048",
   "jp": "さっき、商店街を歩いてたら、{n}おいしそうなクッキーの{n}においがしたの。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0049",
   "jp": "クッキーか～。{n}じゅる‥‥。{n}そう聞いたらおなかがすいてきた。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0050",
   "jp": "初めてわたしがクッキーを作った時を{n}思い出しちゃった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0051",
   "jp": "へぇ、そんな事あったんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0052",
   "jp": "あの時は大変だったんだよ。{n}お兄ちゃんに作ってあげようと思ってたのに、{n}なかなかうまい具合に焼けなくて‥‥。{p}{FFF5}そのうち日が暮れちゃって、{n}最後にはわたしが泣いちゃったんだよね‥‥。{p}{FC00}でも、お兄ちゃんが最後までわたしに{n}つき合ってくれたから、クッキーが焼けたんだよ。{p}あの時のクッキー‥‥おいしかったなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0053",
   "jp": "う～ん、その場にいたら、食べられたのに‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0054",
   "jp": "じゃあ、これからお家に帰って作っちゃおう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0055",
   "jp": "どうしますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0056",
   "jp": "・楽しみだと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen309.0057",
   "jp": "・ティピが喜ぶと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen309.0058",
   "jp": "・今日はいいと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen309.0059",
   "jp": "お兄ちゃんが喜んでくれるなら{n}はりきって作っちゃう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0060",
   "jp": "アンタ、よくわかってるじゃない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0061",
   "jp": "じゃあ、がんばるね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0062",
   "jp": "え、いらないの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0063",
   "jp": "アンタ、なんてこと言うのよ！{p}{FC00}ルイセちゃん、作って、作って！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0064",
   "jp": "うん、がんばるね、ティピ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0065",
   "jp": "じゃあ、わたし、お家に戻ってるね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0066",
   "jp": "楽しみにしてるからね～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0067",
   "jp": "うふふ、クッキー、クッキー{FFF0}♥{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0068",
   "jp": "お兄ちゃん、クッキーできたよ。{n}食べてみて。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0069",
   "jp": "食べますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0070",
   "jp": "はい、お兄ちゃん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0071",
   "jp": "どれどれ、アタシも‥‥。{p}もぐもぐ‥‥{p}おいし～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0072",
   "jp": "でしょ？{n}自信あったんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0073",
   "jp": "ルイセちゃん、お菓子づくりの才能あるよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0074",
   "jp": "じゃあ、次はスペシャルクッキー！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0075",
   "jp": "えっ、どんなの？{n}早く食べさせてよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0076",
   "jp": "だ～め、まずお兄ちゃんから！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0077",
   "jp": "‥‥何でよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0078",
   "jp": "お兄ちゃん、食べてくれる？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0079",
   "jp": "どう答えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0080",
   "jp": "・食べる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen309.0081",
   "jp": "・食べない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen309.0082",
   "jp": "・様子を見る",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen309.0083",
   "jp": "はい、じゃあ一つ食べて！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0084",
   "jp": "えっ、ひょっとして‥‥バレちゃった？[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0085",
   "jp": "どうしたの？{n}早く食べてよ。{p}{FC02}ひょっとして‥‥バレちゃった？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0086",
   "jp": "いっただき～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0087",
   "jp": "あっ、ティピ！{n}ダメ～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0088",
   "jp": "{v:007E}はむっ{FFF9}{FFFB}‥‥{n}{v:007F}もぐもぐ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0089",
   "jp": "どひ～！{n}{FE1E}鼻が‥{FE1E}鼻が‥‥{FE1E}つーんってくるよぉ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0090",
   "jp": "‥‥うぅ‥‥失敗だぁ‥‥。{p}せっかくマスタードクッキーで、{n}お兄ちゃんを泣かせられると思ったのに‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0091",
   "jp": "ル{FE1E}イ{FE1E}セ{FE1E}ちゃ～ん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0092",
   "jp": "さ、さよなら～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0093",
   "jp": "泣かせるって‥‥。{n}プロミス・ペンダントの約束ね。{n}{FB00}こんなことでかなうのかしら[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0094",
   "jp": "なんで‥‥？{n}一生懸命作ったのに‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0095",
   "jp": "アンタね、意地悪もたいがいにしなさいよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0096",
   "jp": "あっ、お兄ちゃん。{n}ミーシャとはぐれちゃって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0097",
   "jp": "どうしますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0098",
   "jp": "・ミーシャの所に連れて行く",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen309.0099",
   "jp": "・自分で探させる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen309.0100",
   "jp": "えっ、お兄ちゃんわたしを探しに来てくれたの？{n}ありがとう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0101",
   "jp": "ミーシャ‥‥。{n}どこ行っちゃったんだろう‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0102",
   "jp": "どうしてアンタはそーゆー意地悪するのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0103",
   "jp": "えっ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0104",
   "jp": "あっ、ルイセちゃん！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0105",
   "jp": "ミーシャ、どこ行ってたの？{n}心配したんだから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0106",
   "jp": "ごめ～ん[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0107",
   "jp": "会えて良かったね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0108",
   "jp": "うん。{n}ありがとう、ティピ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0109",
   "jp": "じゃあ、ミーシャ、行こうよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0110",
   "jp": "うん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0111",
   "jp": "お兄ちゃん、ティピ、後でね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0112",
   "jp": "お兄さま、またまた後で。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen309.0113",
   "jp": "今度ははぐれないようにね。",
   "en": "",
   "term": "end"
  },
