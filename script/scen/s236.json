 "entries": [
  {
   "id": "scen236.0000",
   "jp": "",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen236.0001",
   "jp": "アイリーン",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen236.0002",
   "jp": "部下",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen236.0003",
   "jp": "盗賊",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen236.0004",
   "jp": "ニック",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen236.0005",
   "jp": "{FFEE}ルイセ、ミーシャ、副学院長を守って戦え！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0006",
   "jp": "{v:0039}あいつらの役目はもう終わった。{n}始末は任せる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0007",
   "jp": "{v:003A}はっ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0008",
   "jp": "‥‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0009",
   "jp": "‥‥{v:003B}た、助けてくれ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0010",
   "jp": "{v:003C}お前はよくやってくれたぞ。{n}さすがワシの傑作だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0011",
   "jp": "‥‥{v:003D}おじさま‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0012",
   "jp": "{v:003E}感情の希薄なあの女より、よほど人間らしいわい。{p}{v:003F}だが、その感情が今後は邪魔になるのだ！{n}いますぐ破棄してくれる！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0013",
   "jp": "{FFF3}{v:0040}‥‥‥っ！！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0014",
   "jp": "{v:0041}そうか。{p}{v:0042}今まで俺たちの行動を読んでいたのは、{n}ティピじゃなくミーシャの見たことを{n}傍受していたからか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0015",
   "jp": "{v:0043}アタシじゃなかったんだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0016",
   "jp": "{v:0044}今頃気づいたか。{p}{v:0045}お前たちの行動を監視させるためにミーシャを{n}近づかせた。{n}それももう必要ない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0017",
   "jp": "{v:0098}しっかりして、アイリーンさん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0018",
   "jp": "{v:0094}アイリーンさん、しっかりしてよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0019",
   "jp": "‥‥{v:004D}アタシ‥‥人じゃない‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0020",
   "jp": "{v:004E}こんな時、どうすればいいんだろう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0021",
   "jp": "{v:0073}ふん、お前の力はこの程度か！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0022",
   "jp": "{v:0046}はっ、マクスウェル様！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0023",
   "jp": "{v:0047}おお、丁度いい！{p}{v:0048}ん？{n}グレンガルはどうした？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0024",
   "jp": "{v:0049}はっ？{n}御一緒だったのでは？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0025",
   "jp": "{v:004A}ぬぅ、グレンガルめ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0026",
   "jp": "{v:004B}グレンガル？{n}あの男とどんな関係が？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0027",
   "jp": "{v:004C}学院長が黒幕だったようだな。{n}戦争を隠れ蓑にして、己の好きなように{n}やっていたんだろ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0028",
   "jp": "{v:004F}何してるのよ、ミーシャ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0029",
   "jp": "{v:0050}ティピちゃん‥‥お兄さま‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0030",
   "jp": "ミーシャにかける言葉は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0031",
   "jp": "・元気になるよう励ます",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen236.0032",
   "jp": "・ミーシャは仲間だ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen236.0033",
   "jp": "・憎しみは学院長にぶつけるように言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen236.0034",
   "jp": "・今は戦わせる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen236.0035",
   "jp": "{v:006C}お兄さま‥‥。{p}{v:006D}うれしいけど‥‥やっぱりダメ‥‥。{n}アタシ‥‥闘えないよぉ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0036",
   "jp": "‥‥{v:006E}仕方ないわね。{n}アタシ達だけで戦いましょ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0037",
   "jp": "‥‥{v:0051}なかま‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0038",
   "jp": "{v:0052}そうよ！{n}アタシだって、作られた存在だよ？{p}{v:0053}だけど、コイツやルイセちゃんやウォレスさん、{n}みんな優しくしてくれるじゃない！？{p}{v:0054}アンタは１人じゃないんだよ、ミーシャ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0039",
   "jp": "‥{v:0055}１人じゃ‥‥ない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0040",
   "jp": "{v:0056}あいつのやっていることは、絶対いけないことだよ？{n}それを止められるのはアタシ達だけじゃない！{p}{v:0057}そうでしょ、ミーシャ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0041",
   "jp": "{v:0058}で、でも‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0042",
   "jp": "{v:0059}せっかくこの世に生を受けたんでしょ！{n}こんなところで死んじゃってもいいの！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0043",
   "jp": "‥‥{v:005A}し、死‥ぬ‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0044",
   "jp": "{v:005B}死んじゃったら、もう遊べないんだよ？{n}みんなとお話だって出来なくなっちゃうんだよ？{p}{v:005C}それでもいいの？嫌でしょ？{n}それにこのままじゃ、ルイセちゃんだって、{n}狙われるんだよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0045",
   "jp": "{v:005D}このままじゃ、ルイセちゃんも‥‥？{p}{FC00}‥‥{v:005E}そうか、‥そうだよね。{n}まだアタシは戦う意味があるんだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0046",
   "jp": "{v:005F}ミーシャ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0047",
   "jp": "{v:0060}お兄さま、アタシ、戦う！{n}自分のために、そして大切な人を守るために！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0048",
   "jp": "‥‥{v:0061}学院長に‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0049",
   "jp": "{v:0062}アンタだって被害者だもん。{n}怒ったっていいんだよ？{p}{v:0063}悪いのはあいつなんだから！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0050",
   "jp": "{v:0064}でも‥でも‥‥。{n}アタシ‥こんな状態じゃ闘えないよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0051",
   "jp": "{v:0065}で、でも‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0052",
   "jp": "{v:0066}せっかくこの世に生を受けたんでしょ！{n}こんなところで死んじゃってもいいの！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0053",
   "jp": "‥‥{v:0067}死‥ぬ‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0054",
   "jp": "{v:0068}死んじゃったら、もう遊べないんだよ？{n}みんなとお話だって出来なくなっちゃうんだよ？{p}{v:0069}それでもいいの？{n}嫌でしょ？{n}だったら戦ってよ、ミーシャ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0055",
   "jp": "{v:006A}う、うん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0056",
   "jp": "{v:006F}うぅ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0057",
   "jp": "{v:0070}お前だけは絶対に我が物とするのだ！{n}覚悟しろ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0058",
   "jp": "{v:0071}うわぁっ！{n}は、早く助けてくれぇ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0059",
   "jp": "{v:0072}ちょっと、副学院長がヤバイわよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0060",
   "jp": "{v:0083}きゃああっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0061",
   "jp": "{v:0084}ルイセちゃん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0062",
   "jp": "{v:0085}ふははははっ！{p}{v:0086}さぁ、貴重な実験体を手に入れたぞ！{n}ワシがグローシュを得るのも時間の問題だ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0063",
   "jp": "‥‥{v:0087}そんな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0064",
   "jp": "{v:0088}あぁ‥‥。{p}{v:0089}みんな‥‥今までありがとう‥‥。{n}そして‥‥さようなら‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0065",
   "jp": "‥‥{v:008A}そんな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0066",
   "jp": "{v:0081}うぎゃぁっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0067",
   "jp": "{v:0082}ああ、やられちゃったじゃない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0068",
   "jp": "{v:00AC}うぐっ！{p}‥‥{v:00AD}くそっ！　ドジったぜ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0069",
   "jp": "{v:00AE}それ以上は無理しないで！{n}アイリーンさんのためにも！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0070",
   "jp": "{v:00AF}すまない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0071",
   "jp": "{v:008B}絶対許さないんだから！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0072",
   "jp": "‥‥{v:008C}ミーシャをもてあそんで、絶対に許さない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0073",
   "jp": "{v:008D}俺はお前のような奴が一番嫌いなんだよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0074",
   "jp": "{v:0091}ほう‥‥。{n}創造主に刃向かうというのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0075",
   "jp": "‥‥{v:0092}いくらアタシを作ったのがおじさまでも、{n}アタシはアタシよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0076",
   "jp": "{v:0093}この、人形がっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0077",
   "jp": "{v:008E}僕は研究者として、あなたを尊敬していました。{n}しかし、人としてあなたを許すことは出来ません！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0078",
   "jp": "{v:008F}尊い命を軽んじる人は許せません！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0079",
   "jp": "{v:0090}ふん！{n}死ぬがいい、愚民ども！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0080",
   "jp": "{v:0095}アイリーンさん、今助けるからね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0081",
   "jp": "{v:0096}しっかりしろ。{n}今助ける！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0082",
   "jp": "{v:0097}しっかりしてください。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0083",
   "jp": "{v:00A4}アイリーン！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0084",
   "jp": "{v:00A5}あなたは、アイリーンさんの‥‥！{n}どうしてここへ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0085",
   "jp": "{v:00A6}グローシアンが事件に巻き込まれていると知って、{n}じっとしていられなかったんだ。{p}{v:00A7}そして学院に行ったら、{n}君たちがこっちへ向かったと聞いてね。{n}それよりアイリーンは？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0086",
   "jp": "‥‥{v:00A8}誰‥呼んでる‥声‥なつかしい‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0087",
   "jp": "‥‥{v:00A9}アイリーン‥‥うおぉぉぉっ！{n}俺のアイリーンをぉぉっ！！{p}{v:00AA}頼む、俺にも戦わせてくれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0088",
   "jp": "{v:007E}ば‥ばかな‥‥このワシが‥‥。{p}{v:00DA}グレンガルめ‥最後にきて‥裏切りおって‥‥{FFF9}{FFFB}{n}{v:00DB}ぐはっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0089",
   "jp": "{v:007F}マスター！{p}{v:0080}マスターの敵は私が倒す！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0090",
   "jp": "{v:0076}マ‥‥マスター‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0091",
   "jp": "‥‥{v:0077}死んだか。{n}いや、無に返ったというべきか。{p}{v:0078}まあよい。{n}道具など新しく作ればいいだけだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0092",
   "jp": "‥‥{v:0079}道具‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0093",
   "jp": "{v:007A}アタシは‥アタシは道具じゃない！{p}{v:007B}自分で考えて、自分で動ける！{n}道具なんかじゃないよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0094",
   "jp": "{v:00DC}ミーシャ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0095",
   "jp": "{v:007C}アタシは道具なんかじゃない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0096",
   "jp": "こんな奴と組むんじゃなかったぜ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0097",
   "jp": "俺もここまでか‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0098",
   "jp": "うぐぐ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0099",
   "jp": "おのれ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0100",
   "jp": "嫌な予感がしてたんだ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0101",
   "jp": "死ぬのはいやだ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0102",
   "jp": "{v:0075}使えぬ奴らだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0103",
   "jp": "{v:00B0}終わったわね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0104",
   "jp": "次は何をすればいい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0105",
   "jp": "ニックに指示を出しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen236.0106",
   "jp": "・ルイセの護衛",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen236.0107",
