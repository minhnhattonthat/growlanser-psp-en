   "en": "",
   "term": "null"
  },
  {
   "id": "scen227.0005",
   "jp": "{FFEE}アイリーンと村人を救え！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0006",
   "jp": "お前らは、野郎の足止めをしろ！{n}女の始末は、俺がやる！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0007",
   "jp": "へい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0008",
   "jp": "あと、ついでだ！{n}邪魔する奴は、みんな殺してしまえ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0009",
   "jp": "へっへっ！{n}了解でさぁ～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0010",
   "jp": "{v:001E}もう終わりだ。{n}大人しくしやがれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0011",
   "jp": "{v:001F}なにいきがってんだよ、このゲス野郎が。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0012",
   "jp": "{v:0020}誰だ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0013",
   "jp": "{v:0021}貴様、カレンを襲っただけじゃあきたらず、{n}妹の恩人にまで手をかけるつもりか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0014",
   "jp": "{v:0022}あれは！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0015",
   "jp": "{v:0023}兄さん！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0016",
   "jp": "{v:0024}ゼノスさん！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0017",
   "jp": "{v:0025}ええい！{n}お前も八つ裂きにしてやるわ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0018",
   "jp": "{v:0026}大丈夫、アイリーンさん！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0019",
   "jp": "{v:0027}大丈夫ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0020",
   "jp": "{v:0028}大丈夫か！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0021",
   "jp": "{v:0029}大丈夫ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0022",
   "jp": "{v:002A}あ、あなた方は‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0023",
   "jp": "{v:002D}話はあと、あと！{n}今はあいつらをやっつけなくちゃね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0024",
   "jp": "{v:002B}アイリーンさん、大丈夫？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0025",
   "jp": "{v:002C}カ、カレンさん！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0026",
   "jp": "{v:002F}兄さん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0027",
   "jp": "{v:0030}よぉ、カレン、元気だったか？{n}とにかく話はこいつらを倒した後だ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0028",
   "jp": "{v:002E}よぉ、また会ったな。{n}だが詳しい話は後だ。{n}今はこいつらを倒す！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0029",
   "jp": "{v:0031}ゲッ！？{n}貴様らは‥‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0030",
   "jp": "{v:0032}どうしてアンタはそう悪さばっかりするのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0031",
   "jp": "{v:0033}うるせぇ！{n}こっちにも仕事ってもんがあるんだよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0032",
   "jp": "{v:0034}うぐっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0033",
   "jp": "{v:0035}きゃあっ！{n}ニック！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0034",
   "jp": "{v:0036}だ、大丈夫だ‥まだ、やれる‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0035",
   "jp": "{v:0037}無理しちゃダメだよ！{n}アイリーンさんはアタシ達が助けるから、休んでて！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0036",
   "jp": "{v:0038}す、すまない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0037",
   "jp": "あぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0038",
   "jp": "あぁっ！{n}アイリーンさん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0039",
   "jp": "商品には、指一本ふれさせんぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0040",
   "jp": "もっとたくさん稼いで‥‥ハーレ‥ム‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0041",
   "jp": "どうしてこんな事に‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0042",
   "jp": "だ、誰か、助けて！！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0043",
   "jp": "ひどい‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0044",
   "jp": "キャアーッ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0045",
   "jp": "うっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0046",
   "jp": "バカバカバカーッ！{n}村の人たちが、みんな殺されちゃったじゃない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0047",
   "jp": "{v:0039}ぐはっ！{n}ま‥またしても‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0048",
   "jp": "{v:003A}ええい、くそっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0049",
   "jp": "{v:0039}ぐはっ！{n}ま‥またしても‥‥。{p}{v:003A}ええい、くそっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0050",
   "jp": "{v:003B}あ！{n}待ちなさいよ！{p}‥{FE1E}‥{FE1E}{v:003C}逃げ足だけは速いんだから‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0051",
   "jp": "いやーっ！{n}こんな所に！！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0052",
   "jp": "へっへっへ‥‥。{n}ここから現れるとは、思いもしなかっただろう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0053",
   "jp": "と、思ったら、なんでここにいるんだぁ～！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0054",
   "jp": "そんなことはどうでもいい！{n}とにかく、例の女を殺せ！{n}邪魔する奴は、好きにしろ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0055",
   "jp": "へ、へい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen227.0056",
   "jp": "あいかわらず、小ずるい手の好きな奴だな！",
   "en": "",
   "term": "end"
  }
 ]
}
