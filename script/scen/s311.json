  },
  {
   "id": "scen311.0001",
   "jp": "ミーシャ",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen311.0002",
   "jp": "{v:0159}実は、お兄さまに渡したい物があるの{FFF0}♥{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0003",
   "jp": "どう対応しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0004",
   "jp": "・何を渡したいのか聞く",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen311.0005",
   "jp": "・特に欲しい物はないと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen311.0006",
   "jp": "・楽しみだと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen311.0007",
   "jp": "{v:015A}それはですねぇ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0008",
   "jp": "{v:015B}アンタ、そんなこと言わずに貰ってあげなさいよ！{p}{FC00}{v:015C}で、何をあげるわけ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0009",
   "jp": "{v:015D}じゃーーんっ！！{n}これです！{p}{v:015E}このセーター、お兄さまのために{n}一生懸命編みました♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0010",
   "jp": "{v:015F}えへへ、結構うまくできてるでしょ？{n}アタシの自信作なんだよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0011",
   "jp": "{FFF3}{v:0160}‥‥‥‥。{p}{FFF4}{v:0161}ねぇミーシャ？{n}ひとこと、言っていい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0012",
   "jp": "{v:0162}はい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0013",
   "jp": "{FB00}{v:0163}冬って‥‥まだ先よ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0014",
   "jp": "{v:0164}‥‥あ゛‥‥。{p}{FC00}{v:0175}それじゃお兄さま、{n}冬になったらアタシとペアルックしましょうね★{p}{FC04}{v:0176}あは～っ、言っちゃった～♪{n}ハズかしぃ～～★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0015",
   "jp": "{v:00C1}フン、フン、フフン♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0016",
   "jp": "{v:00C2}うふふっ♪{n}これをプレゼントしたら{n}お兄さま、何て言ってくれるかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0017",
   "jp": "{v:00C3}誉めてくれるかな？{n}びっくりして、声も出ない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0018",
   "jp": "{v:00C4}でも、でも、でもぉ！{n}これでアタシのこと見直してくれて、{n}２人の仲は急接近ってなことになってぇ、{n}『好きだよ、結婚しよう』なんて言われちゃったり！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0019",
   "jp": "{v:00C5}そしたらアタシ、きっといい奥さんになるんだ！{n}そんでそんで、愛しい彼の帰りを娘と一緒に待つの！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0020",
   "jp": "{v:00C6}あ、お兄さまって、{n}男の子と、女の子と、どっちが欲しいんだろ？{n}たくましい人だから、やっぱり男の子かな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0021",
   "jp": "{v:00C7}どっちでもいいや！{n}アタシ、がんばっちゃうもん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0022",
   "jp": "{v:003F}あ、お兄さま★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0023",
   "jp": "{v:0040}何してたの、ミーシャ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0024",
   "jp": "{v:0041}えへへ‥‥。{n}メガネ落っことしてツルが取れたんで、直してたの。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0025",
   "jp": "何と答えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0026",
   "jp": "・おっちょこちょいだなと笑う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen311.0027",
   "jp": "・誰かにぶつかったのかと聞く",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen311.0028",
   "jp": "・なおしてやると言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen311.0029",
   "jp": "{FB00}{v:0042}えへへ‥‥[01BE]{n}どうしてもおっちょこちょいが治らなくて。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0030",
   "jp": "{v:0043}どうしてわかったんですか？{n}お兄さまって、凄い‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0031",
   "jp": "{v:0044}わぁ、お兄さまありがとうございますぅ！{n}あ、でも今直しちゃった‥‥。{p}{v:0045}じゃ、もう一度壊しますね♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0032",
   "jp": "{FFEC}　　{v:0046}スカポーーーン！{FFED}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0033",
   "jp": "{FFF5}{v:0047}いったぁ～い‥‥[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0034",
   "jp": "{v:0048}馬鹿なこと言ってるからよっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0035",
   "jp": "{v:0049}ホントに、よくそれで魔法学院に入れたわね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0036",
   "jp": "{v:004A}アタシ、{n}両親を亡くしておじさまに引き取られたんです。{n}それで‥‥えへへへ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0037",
   "jp": "どう対応しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0038",
   "jp": "・笑う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen311.0039",
   "jp": "・猛勉強して試験に通ったのかと納得する",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen311.0040",
   "jp": "・うなずく",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen311.0041",
   "jp": "{FB00}{v:004B}試験は受けてないです‥‥[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0042",
   "jp": "{FB00}{v:004C}どうりで、アンタみたいなドジが入れたワケだわ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0043",
   "jp": "{v:004D}ひど～い！{n}アタシだって一生懸命やってるよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0044",
   "jp": "{v:004E}どのくらい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0045",
   "jp": "{v:004F}えーと‥‥。{n}{FC04}試験の前日は寝ないで勉強してる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0046",
   "jp": "{v:0050}一生懸命って、{n}普段から勉強してる人が言うセリフだけど‥‥。{p}{v:0051}所詮アンタはそんなもんよね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0047",
   "jp": "{FFF5}{v:0052}お兄さまぁ、{n}ティピちゃんがいじめるぅ～[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0048",
   "jp": "どうしますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0049",
   "jp": "・からかいすぎだとティピをたしなめる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen311.0050",
   "jp": "・ティピの言葉にうなずく",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen311.0051",
   "jp": "・気にするなとなぐさめる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen311.0052",
   "jp": "{v:0053}だぁって、{n}コイツったらいじめたくなるんだもの‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0053",
   "jp": "{FFF5}{v:0054}うう、アタシって不幸‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0054",
   "jp": "{FFF5}{v:0055}うう、お兄さまもヒドイですぅ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0055",
   "jp": "{FB00}{v:0056}アンタ、結構ヒドイわね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0056",
   "jp": "{v:0057}うん！{n}お兄さまがそう言うなら、全然気にしない♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0057",
   "jp": "{v:0058}自分だけいい子ぶっちゃって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0058",
   "jp": "{v:0059}ま、いいけどさ。{n}アタシに突っ込まれたくなかったら、{n}少しは勉強しなさいよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0059",
   "jp": "{FB00}{v:005A}う゛‥‥。{p}{v:005B}そ、それじゃお兄さま‥‥。{FFF9}{FFFB}{n}{v:005C}またねぇ～[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0060",
   "jp": "はふう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0061",
   "jp": "な～に、溜め息なんかついてんのよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0062",
   "jp": "あ‥‥ティピちゃん、お兄さま‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0063",
   "jp": "{FFF5}アタシ‥‥勉強できなくて‥‥。{n}学院では下から数えた方が早いし‥‥。{p}アタシもそれでいいと思ってたんだ。{p}でも‥‥お兄さまと会ってからは変わったの。{FFFB}{n}この人の迷惑にならないように、{n}一生懸命頑張ろう‥‥って。{p}だから、おじさまやルイセちゃんに無理を言って{n}特別に教えて貰ってたんですけど‥‥。{p}はあ‥‥やっぱりダメなのかな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0064",
   "jp": "何と声をかけますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0065",
   "jp": "・はげます",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen311.0066",
   "jp": "・意気込みをほめる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen311.0067",
   "jp": "・前からだめ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen311.0068",
   "jp": "{FFF5}お兄さま‥‥。{p}わかりました！{FFFB}{n}アタシ、さっきも言ったけど‥‥。{n}{FE1E}お兄さまのために、絶対頑張りますね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0069",
   "jp": "そう‥ですよね‥‥。{n}何事にも意気込みが必要ですよね。{p}お兄さま、見てて下さいね！{n}{FE1E}アタシ、頑張っちゃいますから！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0070",
   "jp": "{FFF5}うっ‥‥。{n}{FE1E}お兄さままで、そんなこと言うんですかぁ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0071",
   "jp": "‥‥もしかして‥‥。{n}{FE1E}アタシを勇気づけるためにわざと‥‥？{p}{FC04}お兄さま！{FFFB}{n}アタシお兄さまのお心遣いを無駄にしません！{n}{FE1E}頑張ります！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0072",
   "jp": "{FB00}{FFF3}‥‥{FE1E}{FFF4}凄い解釈の仕方ね‥‥[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0073",
   "jp": "でも、その割にはあまり成果が出てないような‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0074",
   "jp": "{FB00}う‥‥[01BE]{n}{FE1E}これでも一生懸命なんだから‥‥。{p}{FC00}時間はかかるかも知れないけど‥‥。{n}必ずお兄さまのお役に立って見せますから！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0075",
   "jp": "さあミーシャ！　{FE1E}今から猛勉強よ！{FFFB}{n}{FC00}じゃ、お兄さま♪　またね★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0076",
   "jp": "{FB00}どうなることやら‥‥[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0077",
   "jp": "ミーシャ、なに寝てんのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0078",
   "jp": "あれ？{n}お兄さま、ティピ？{n}おはようございます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0079",
   "jp": "猛勉強すんじゃなかったの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0080",
   "jp": "え～と、わからないところがあって{n}図書室にいたんだけど、さっきお兄さまと話して{n}はりきって飛び出してきちゃって‥‥。{p}それでアリオスト先輩に教えてもらおうと{n}ここまで来て、ちらっとのぞいてみたら{n}忙しそうだったから少し待とうかなって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0081",
   "jp": "{FB00}それで、寝ちゃったわけ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0082",
   "jp": "もうぐっすりと！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0083",
   "jp": "どうしますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0084",
   "jp": "・寝る子は育つ、と言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen311.0085",
   "jp": "・ますますダメになると言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen311.0086",
   "jp": "・良かったなと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen311.0087",
   "jp": "ええ、がんばっちゃいます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0088",
   "jp": "{FB00}な、何をがんばるのよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0089",
   "jp": "はげましてくれるのは嬉しいけど、{n}もうちょっと優しい言葉の方が{n}うれしいかな‥‥。{p}‥‥{FC00}なんて。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0090",
   "jp": "{FB00}め、めげないわね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0091",
   "jp": "ええ、お昼寝は気持ちいいですから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0092",
   "jp": "{FB00}こいつら‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0093",
   "jp": "さて、今度こそお勉強しなくっちゃ。{n}お兄さま、また後で！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0094",
   "jp": "どうしますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0095",
   "jp": "・素直に喜ぶ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen311.0096",
   "jp": "・珍しいと誉める",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen311.0097",
   "jp": "・どこにあるのかたずねる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen311.0098",
   "jp": "{v:01E7}えへへ♪{n}お兄さまに食べてもらおうと、{n}腕によりをかけて作ったですぅ{FFF0}♥{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0099",
   "jp": "{v:01E8}で、肝心のケーキはどこにあるの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0100",
   "jp": "{v:01E7}えへへ♪{n}お兄さまに食べて貰おうと、{n}腕によりをかけて作ったですぅ{FFF0}♥{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0101",
   "jp": "{v:01EA}で、肝心のケーキはどこにあるの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen311.0102",
   "jp": "{v:01EB}え？{n}ここにありますけど？",
