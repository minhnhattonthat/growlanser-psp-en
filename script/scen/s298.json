 "entries": [
  {
   "id": "scen298.0000",
   "jp": "",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen298.0001",
   "jp": "他の仲間のところにも行ってみたらどうだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen298.0002",
   "jp": "私のところへ来ていただけるのは{n}うれしいのですが、{n}他の仲間への気遣いもお忘れなきよう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen298.0003",
   "jp": "ふっ、お前たちと共に休暇を{n}過ごすことになるとはな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen298.0004",
   "jp": "いい天気だな。{n}こんな日は外にいるだけで体が休まる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen298.0005",
   "jp": "剣でもなんでも、{n}心に余裕がないとダメだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen298.0006",
   "jp": "マイ＝ロード‥‥。{n}共に休暇を過ごす幸せ、噛みしめております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen298.0007",
   "jp": "良いお日和です。{n}こんな日は外にいるだけで心が休まります。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen298.0008",
   "jp": "差し出がましいようですが、{n}休暇の時は身体だけでなく、心もお休め下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen298.0009",
   "jp": "どこ行こうか？",
   "en": "",
   "term": "end"
  }
 ]
}
