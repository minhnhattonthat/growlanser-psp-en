  {
   "id": "scen211.0001",
   "jp": "レティシア姫",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen211.0002",
   "jp": "騎士",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen211.0003",
   "jp": "{FFEE}レティシア姫を守れ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen211.0004",
   "jp": "あの‥‥、{n}私はどうすればいいでしょう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen211.0005",
   "jp": "レティシア姫に、何と指示を出しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen211.0006",
   "jp": "・その場にとどまり自由",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen211.0007",
   "jp": "・その場にとどまり防御",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen211.0008",
   "jp": "・西へ下がらせる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen211.0009",
   "jp": "・自由行動",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen211.0010",
   "jp": "{v:0037}きゃああっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen211.0011",
   "jp": "‥‥{v:0038}そんな！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen211.0012",
   "jp": "{v:0022}邪魔だ！{n}どけ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen211.0013",
   "jp": "{v:0023}なによ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen211.0014",
   "jp": "{v:0025}えっ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen211.0015",
   "jp": "{v:0024}邪魔は貴様の方だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen211.0016",
   "jp": "{v:0026}なんでよぉ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen211.0017",
   "jp": "{v:0027}うぐっ！{p}{v:0028}ま、またしても‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen211.0018",
   "jp": "{v:0029}なんてざまだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen211.0019",
   "jp": "{v:002A}か、頭‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen211.0020",
   "jp": "{v:002B}お前は下がっていろ。{n}後は俺がしとめてやる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen211.0021",
   "jp": "{v:002C}ん、何事だ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen211.0022",
   "jp": "{v:002D}はっ！{n}ライエル様！{n}あれを！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen211.0023",
   "jp": "{v:002E}何と無礼な‥‥。{p}{FC00}{v:002F}フッ。{n}我々の前で狼藉を働いたことを後悔させてくれよう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen211.0024",
   "jp": "{v:0030}なんだ、お前らは？{n}先にお前から血祭りに上げてやろうか！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen211.0025",
   "jp": "{v:0031}無知とは恐ろしいものだな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen211.0026",
   "jp": "{v:0032}どうやら死にたいらしいな！？{p}{v:0033}うりゃあっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen211.0027",
   "jp": "{v:0034}か、頭！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen211.0028",
   "jp": "{v:0035}頭が一撃で‥‥化け物だ！{p}{v:0036}ひ、引け！{n}退却！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen211.0029",
   "jp": "楽な仕事だと思ったのに‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen211.0030",
   "jp": "ぐをぉっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen211.0031",
   "jp": "ぐふっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen211.0032",
   "jp": "つ、つよい‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen211.0033",
   "jp": "だ‥だめッス‥‥",
   "en": "",
   "term": "end"
  }
 ]
}
