  },
  {
   "id": "scen260.0001",
   "jp": "{FFEE}兵士と市民を守れ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen260.0002",
   "jp": "うわあっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen260.0003",
   "jp": "す、すまない‥‥{n}父ちゃんは‥‥もう‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen260.0004",
   "jp": "ああ‥そんな‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen260.0005",
   "jp": "まだ‥死にたく‥‥な‥‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen260.0006",
   "jp": "く、くそ‥‥！{n}まだ、やれ‥‥る‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen260.0007",
   "jp": "こんなところで死ぬなんて‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen260.0008",
   "jp": "お‥俺の‥人生は‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen260.0009",
   "jp": "ああ‥‥守りきれなかった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen260.0010",
   "jp": "ふん！{n}生意気な真似をしおって！{n}これで終わりだと思うなよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen260.0011",
   "jp": "{v:003D}今ので最後ね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen260.0012",
   "jp": "{v:0039}殺せ！{n}殺すのだ！{p}{v:003A}ランザックの次は、この国の兵力を奪うのだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen260.0013",
   "jp": "{v:003B}兵力を奪う？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen260.0014",
   "jp": "{v:003C}後はお前たちに任せる！{n}好きに暴れるがいい！",
   "en": "",
   "term": "end"
  }
 ]
