   "unref": true
  },
  {
   "id": "scen028.0371",
   "jp": "ここはおじさまの研究室だよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen028.0372",
   "jp": "ここはマクスウェル学院長の研究室だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen028.0373",
   "jp": "ここはマクスウェル学院長の研究室だよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen028.0374",
   "jp": "ここはブラッドレー副学院長の研究室だよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen028.0375",
   "jp": "ここはブラッドレー副学院長の研究室だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen028.0376",
   "jp": "{v:0009}ちょっと違うみたいだけど。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen028.0377",
   "jp": "あのね、お兄ちゃん。{n}学院の施設内で大きな魔法を使うと、{n}怒られちゃうんだ‥‥。",
   "en": "",
   "term": "end"
  }
 ]
