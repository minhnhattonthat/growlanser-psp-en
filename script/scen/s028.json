  },
  {
   "id": "scen028.0290",
   "jp": "{v:000E}失礼します。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen028.0291",
   "jp": "ご用件は済みましたか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen028.0292",
   "jp": "どうぞお入りください。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen028.0293",
   "jp": "{v:0016}どのようなご用でしょうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen028.0294",
   "jp": "{v:004A}重要書類の閲覧許可が欲しいのですが。",
   "en": "",
   "term": "end"
  },
  {
