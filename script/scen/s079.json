 "entries": [
  {
   "id": "scen079.0000",
   "jp": "",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen079.0001",
   "jp": "案内標識",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen079.0002",
   "jp": "警備兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen079.0003",
   "jp": "ティピ",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen079.0004",
   "jp": "ルイセ",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen079.0005",
   "jp": "男",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen079.0006",
   "jp": "女",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen079.0007",
   "jp": "鉱夫",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen079.0008",
   "jp": "{v:0008}例の２人組はここにいるのでしょうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0009",
   "jp": "{v:0009}おじさんの言ってた、２人組ってここにいるのかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0010",
   "jp": "{v:000A}行ってみりゃわかるだろ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0011",
   "jp": "　　{FFF0}安全第一{FFF1}{n}　　　　{FFEE}頂上{FFF1}　：　{FFEF}魔水晶採掘場{FFF1}{n}　　　　{FFEE}右{FFF1}　　：　{FFEF}旧坑道{FFF1}（封鎖中）{n}　　　　　　　　　　許可なき者の立入を禁ず",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0012",
   "jp": "{v:0033}おいおい、早くしねぇと薬の効果が切れるだろ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0013",
   "jp": "こら、どこへ行くつもりだ！{n}とっとと、戻れ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0014",
   "jp": "申し訳ありません。{n}現在は封鎖されています。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0015",
   "jp": "{v:002C}やったね。{n}全然気づかれないよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0016",
   "jp": "{v:002D}シッ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0017",
   "jp": "{v:002E}おい、何か言ったか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0018",
   "jp": "{v:002F}何も言ってないぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0019",
   "jp": "{v:0030}気のせいか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0020",
   "jp": "だめだよ。{n}警備員の目が厳しくて、とても入れない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0021",
   "jp": "調査隊を送ってすぐに崩落事故があったんだ。{n}関係者以外は入れちゃもらえないだろうな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0022",
   "jp": "{v:0019}怪しいな。{n}こっちを見るなり追い払いやがった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0023",
   "jp": "{v:001A}怪しいよね～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0024",
   "jp": "{v:001B}見つからないように近づければいいんだけどね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0025",
   "jp": "{v:001C}夜にこっそり来るとか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0026",
   "jp": "{v:001D}かえって怪しまれるだけだ。{n}他の手段を考えた方がいい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0027",
   "jp": "{v:001F}う～ん、こうも邪険に扱われると、{n}よけい中が知りたくなる～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0028",
   "jp": "{v:0020}だが見つかっただけで追い返されちまう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0029",
   "jp": "{v:0021}こっそり入れればいいんだけどね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0030",
   "jp": "{v:0022}普通のやり方じゃ、無理みたい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0031",
   "jp": "{v:0024}透明人間にでもなれれば気づかれないかも‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0032",
   "jp": "{v:0025}そういえば、学院で透明になる薬を研究してる人が{n}いるよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0033",
   "jp": "{v:0027}見つからないように入れればいいんだけどね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0034",
   "jp": "{v:0028}確か、見えなくなる薬を研究してる人が{n}いたような‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0035",
   "jp": "{v:0016}ここは２０年前から閉鎖されている。{n}俺たちが警備しているから大丈夫だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0036",
   "jp": "{v:0017}調査なら上でやるんだな。{n}さあ、帰れ、帰れ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0037",
   "jp": "{v:0018}何よ、あの態度！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0038",
   "jp": "{v:0026}また来やがったか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0039",
   "jp": "{v:0088}さあ、帰れ、帰れ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0040",
   "jp": "{v:002A}本当に消えた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0041",
   "jp": "{v:002B}今のうちに通り抜けよう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0042",
   "jp": "おい、場所を考えろ。{n}あいつらに見つかっちまうぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0043",
   "jp": "{v:001E}調査なら上でやるんだな。{n}さあ、帰れ、帰れ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0044",
   "jp": "‥‥{v:0059}許せねぇ！{n}ヴェンツェルの奴、絶対に許せねぇ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0045",
   "jp": "‥‥{v:000B}まだ我々にたてつく奴が残っていたのか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0046",
   "jp": "{v:005A}おとなしくヴェンツェル様に従えばよいものを‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0047",
   "jp": "{v:000C}まさか‥‥！？{p}{v:000D}父さん、母さん！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0048",
   "jp": "{v:000E}エリオット！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0049",
   "jp": "‥‥{v:000F}なぜここに‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0050",
   "jp": "{v:0010}まさか、２人がこんなことをするなんて‥‥。{p}{FC02}{v:0011}もうやめて下さい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0051",
   "jp": "‥‥{v:0012}私たちはヴェンツェル様の部下なのだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0052",
   "jp": "{v:0013}そんな‥‥。{n}父さん‥‥母さん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0053",
   "jp": "{v:0014}私のことを母と呼ぶのはやめてもらおうか。{n}お前の母親役はもう終わったのだからね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0054",
   "jp": "{v:0015}お前が育つまでの１４年間。{n}私たちは親代わりをするという任務を果たした。{p}{v:0016}任務が終われば、もう親子ごっこは終わりだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0055",
   "jp": "{FFF3}‥‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0056",
   "jp": "{v:0017}ヴェンツェル様の敵は実力で排除する！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0057",
   "jp": "‥‥{v:0018}えっ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0058",
   "jp": "{v:0019}どうしたの、ルイセちゃん？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0059",
   "jp": "{v:001A}この声、聞き覚えない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0060",
   "jp": "・ヴェンツェルの部下",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen079.0061",
   "jp": "・エリオットの育ての親",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen079.0062",
   "jp": "・わからない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen079.0063",
   "jp": "{v:001E}そんなの、当たり前でしょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0064",
   "jp": "{v:001F}あの人たち、{n}エリオット君の育ての親だよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0065",
   "jp": "{v:0020}そう言えば‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0066",
   "jp": "{v:0021}間違いないよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0067",
   "jp": "{v:0022}あの人たち、{n}エリオット君の育ての親だよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0068",
   "jp": "{v:0023}その様だな。{n}俺も覚えてるぜ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0069",
   "jp": "{v:0024}今のお前たちはヴェンツェル様に敵対するものだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0070",
   "jp": "{v:005B}敵は実力で排除する！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0071",
   "jp": "まさか旧坑道で盗掘が行われていたとは‥‥。{n}それに見張りをしていた奴もグルだったなんて‥‥。{p}何でそんなことに気づかなかったんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0072",
   "jp": "あなた達のおかげで、{n}またここに立つことが出来ますよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0073",
   "jp": "{v:0010}ここは現在採掘が行われてる部分だ。{p}{v:0011}旧坑道はもっと下の方にあるが、{n}現在は閉鎖されているよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0074",
   "jp": "{v:0012}ここで採れる魔水晶はとても純度が高いんだ。{n}おかげで採掘も難しいよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0075",
   "jp": "{v:0013}この山全体が１つの水晶だなんて信じられるか？{n}でも本当なんだぞ。{n}学者さん達がちゃんと調査したんだからな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0076",
   "jp": "旧坑道からときおり聞こえてきたあの声や音は{n}盗掘者の仕業だったのか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0077",
   "jp": "そういえば、ここを占拠してた二人組だけど、{n}俺たちには手出ししなかったなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0078",
   "jp": "{v:0014}ああ、やっぱりここは怖いなぁ‥‥。{n}だって幽霊が出るんだぜ？{p}{v:0015}旧坑道の奥から声が聞こえたり‥‥ああ、怖い！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0079",
   "jp": "{v:0089}あ、効果が切れちゃった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0080",
   "jp": "{v:0034}さて、この中に幽霊が出ると言う話だが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0081",
   "jp": "{FFF3}‥{FE14}‥{FE14}{FFF4}{v:0035}やっぱりやめにしない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0082",
   "jp": "{v:0036}どうしたの、ルイセちゃん？{n}ひょっとして、幽霊、怖い？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0083",
   "jp": "{v:0037}やっぱり、怖いよぉ～。{n}だって、死んでる人でしょ？{n}それなのに、出てくるなんて‥‥。{p}{FFF5}‥‥{v:0038}うぅ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0084",
   "jp": "{v:0039}バカ言うな。{n}この世の中に幽霊なんているはずねぇだろ？{n}お前もそう思うよな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0085",
   "jp": "幽霊はいると思いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0086",
   "jp": "・存在しない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen079.0087",
   "jp": "・見たことがある",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen079.0088",
   "jp": "・黙っている",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen079.0089",
   "jp": "{v:003A}だろ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0090",
   "jp": "{v:003B}何言ってんのよ！{n}アタシたち、幽霊にあったじゃない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0091",
   "jp": "{v:003C}え～っ、本当なのお兄ちゃん！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0092",
   "jp": "{v:003D}お兄さまって凄～い！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0093",
   "jp": "{v:003E}そうよね、直接会っちゃったもんね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0094",
   "jp": "{FFF5}{v:003F}え～っ、やぁだぁ～‥‥。{n}本当なのお兄ちゃん！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0095",
   "jp": "{v:0040}本当だもん♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0096",
   "jp": "{v:0041}お兄さまって凄～い！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0097",
   "jp": "{v:0042}何だ、お前も怖いのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0098",
   "jp": "{FB00}{v:0043}だってぇ‥‥ねぇ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0099",
   "jp": "{v:0044}本当にいるかどうかは別として、{n}魔水晶の横流しと幽霊騒ぎ‥‥。{n}どうも怪しいな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0100",
   "jp": "{v:0045}とにかく調べてみればハッキリするわよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0101",
   "jp": "{v:0046}それより天井が崩れないかが心配だよ～！{n}だって一度崩れてるんでしょ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0102",
   "jp": "{v:0047}あ、そうだったっけ‥‥。{p}{v:0048}ティピ、お願い。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0103",
   "jp": "{v:0049}え～と‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0104",
   "jp": "{v:004A}結構しっかりしてるわね。{n}全然崩れそうな心配はないわよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0105",
   "jp": "{v:004B}普通の鉱山と違って、{n}この山全体が１個の水晶だからな。{n}そう簡単に、崩れることはねぇさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0106",
   "jp": "{v:0087}もう透明薬はないんだぞ？{n}このまま進むしかねぇだろ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0107",
   "jp": "{v:004E}水晶が崩れた跡みたい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0108",
   "jp": "{v:004F}調査団が遭った崩落事故の現場じゃねぇか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0109",
   "jp": "{v:0050}でも誰かがきれいに片づけたみたいだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0110",
   "jp": "{v:0051}ますます怪しいな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0111",
   "jp": "{v:0069}ねぇねぇ、あそこも水晶の破片が山になってるよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0112",
   "jp": "{v:006A}行ってみようよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0113",
   "jp": "{v:0053}さっさと詰め込むんだ！{n}人目がないうちに外へ運び出すぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0114",
   "jp": "{v:0054}何だか俺たちのことを探ってる奴らが{n}いるらしいからな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0115",
   "jp": "{v:0055}そろそろ控えた方がいいかも知れん。{n}グレンガルのダンナは、{n}もう買ってくれないみたいだしな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0116",
   "jp": "{v:0056}やっぱり、こういうことか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0117",
   "jp": "{v:0057}誰だ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0118",
   "jp": "{v:0058}アンタ達の悪事、しっかりと押さえたわよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0119",
   "jp": "{v:0059}侵入者！？{p}{v:005A}見張りは何をしているんだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0120",
   "jp": "{v:005B}さぁ、観念するんだな！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0121",
   "jp": "{v:005C}ええい！{n}ここまできて、捕まってたまるか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0122",
   "jp": "{v:005D}アタシ達から逃げられると思ってんの！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0123",
   "jp": "ちょっと！{n}最後まで調べてからにしなさいよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0124",
   "jp": "{v:006B}水晶が崩れた跡みたい。{n}ここでも崩落事故があったのかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0125",
   "jp": "{v:006C}う～ん‥‥。{n}そう簡単には、壊れそうもないんだけどなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0126",
   "jp": "{v:006D}ここの水晶も、あの人たちが運び出していたみたい。{n}途中まできれいに片づけられてるし‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0127",
   "jp": "{v:006E}まだ奥があるみたい。{n}力を入れれば、崩して通れそうだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0128",
   "jp": "{v:006F}ちょっとどいてろ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0129",
   "jp": "{FFF0}○{FFEE}ボタン連打に集中しろ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0130",
   "jp": "{FFF0}集中失敗！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0131",
   "jp": "{FFEE}{FFEB}回目開始{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0132",
   "jp": "{v:0070}どりゃあっ！{FFF2}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0133",
   "jp": "{v:0071}わぁ、ウォレスさん、すご～い！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0134",
   "jp": "{v:0072}奥にも道が続いているみたい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0135",
   "jp": "{v:0073}行ってみようぜ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0136",
   "jp": "{v:0074}えっ！？{n}入るの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0137",
   "jp": "{v:0075}あたりまえでしょ！{n}何のためにここまで来たと思ってんのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0138",
   "jp": "{v:0076}だ、だって、また崩れてきたら‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0139",
   "jp": "{v:0077}さ、行くわよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0140",
   "jp": "{FFF5}{v:0078}ふぇ～ん、恐いよぉ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0141",
   "jp": "{v:0079}水晶鉱山の規模と進んだ距離から考えて、{n}ここら辺がちょうど中心だな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0142",
   "jp": "{v:007A}さすが！{n}昔ここの警備をしていただけのことはあるね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0143",
   "jp": "{v:007B}あらためて言われると、自分の歳を実感するぜ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0144",
   "jp": "{v:007C}何コレ？{n}人型に水晶がへこんでるよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0145",
   "jp": "{v:007D}こんなに大きいんじゃ、巨人だね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0146",
   "jp": "‥‥{v:007E}これ、お兄ちゃんの見た怪物じゃないの！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0147",
   "jp": "{v:007F}間違いないな。{p}{v:0080}２０年前、奴はここから出てきた。{n}そして鉱夫や俺の部下たちを惨殺したんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0148",
   "jp": "{v:0081}どうしてここに居たんだろ？{n}それともここで生まれたのかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0149",
   "jp": "{v:0082}それは今のところ、何とも言えんな。{n}だが、水晶鉱山から奴が出てきたことだけは{n}間違いねぇ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0150",
   "jp": "{v:0083}ひょっとして、ここみたいな水晶鉱山が{n}他にもあるのかな？{n}そんで、その中にも怪物がいるとか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0151",
   "jp": "{v:0084}それもわからんな‥‥。{n}だが、もしそうだとしたら、水晶鉱山を見つけても、{n}うかつに掘るのは危険だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0152",
   "jp": "{v:0085}それじゃ、早く教えてあげなくちゃ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0153",
   "jp": "{v:0086}とにかく国王に報告だな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0154",
   "jp": "{FFEC}{v:0031}ティピちゃーん、キーック{FFED}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0155",
   "jp": "％×＆★！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0156",
   "jp": "{v:0032}お約束はしないの！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen079.0157",
   "jp": "せっかくここまで来たんだ。{n}徹底的に調査していこうぜ？",
   "en": "",
   "term": "end"
  }
 ]
}
