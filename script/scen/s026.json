  },
  {
   "id": "scen026.0001",
   "jp": "魔法学院生徒",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen026.0002",
   "jp": "教授",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen026.0003",
   "jp": "警備兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen026.0004",
   "jp": "ヴェンツェル",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen026.0005",
   "jp": "ウォレス",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen026.0006",
   "jp": "アリオスト",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen026.0007",
   "jp": "ミーシャ",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen026.0008",
   "jp": "ティピ",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen026.0009",
   "jp": "フェザリアン",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen026.0010",
   "jp": "バーンシュタイン兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen026.0011",
   "jp": "魔法学院",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0012",
   "jp": "ここは研究に向いてていいよね～。{n}グローシアン遺跡やフェザリアン遺跡が{n}そばにあるし、水晶鉱山もそこそこ近いし。{p}それにローランディアとバーンシュタインの{n}国境沿いでもあるから、学院の立地条件としては{n}まさに最高って感じだな～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0013",
   "jp": "私は薬学を専攻しているから、{n}メディス村とラシェルにしか、用はないけどね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0014",
   "jp": "この前、効能の研究だって、{n}コムスプリングスへ遊びに行ってなかったっけ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0015",
   "jp": "失礼ね！{n}温泉だって、立派な研究対象よ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0016",
   "jp": "机にかじりつくだけが学問ではないと思うの。{n}やっぱり外に出ていろいろな経験を積まないと。{n}でも、この学院ってば勉強ばっかりで‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0017",
   "jp": "って言うかさ～。{n}魔法の才能がある人間を押し込めて、{n}管理してるんじゃないの？{p}教授とかもさ～、アブナイ奴いるからな～。{n}ま、俺は魔法の勉強が出来ればいいや。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0018",
   "jp": "やっとの思いで、学院に入ったのはいいけど、{n}勉強、勉強の毎日だ‥‥。{n}ああ、青春の日々が過ぎてゆく～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0019",
   "jp": "ん？{n}最近、よく見かける顔だな。{n}まさかここの学生じゃないよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0020",
   "jp": "くっ、来るならこい！{n}‥‥って、カンジかなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0021",
   "jp": "だらしないわねぇ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0022",
   "jp": "一体どうなるんだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0023",
   "jp": "さっき、インペリアル・ナイトの人も{n}奥へ向かったよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0024",
   "jp": "俺って卒業できるのかな～？{n}村では一番だったけど、入ってみると{n}すごい奴ばっかりだし。{p}‥‥すっかり自信なくしたよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0025",
   "jp": "俺って卒業できるのかな～？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0026",
   "jp": "魔法学院で培ってきた力が{n}人々の役に立てばいいんだけど。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0027",
   "jp": "あ～あ‥‥もっと魔水晶が手に入らないかな。{n}水晶鉱山がもっと発見されれば、{n}こんな悩みは解消されるんだけどな～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0028",
   "jp": "私たち、これからどうなるのかしら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0029",
   "jp": "‥‥こ、こわくないぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0030",
   "jp": "ボクは戦うぞ！{n}いまやらずに、いつこの力を使うっていうんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0031",
   "jp": "こんな時に、自分の力不足がくやまれるよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0032",
   "jp": "元々別の世界を、無理矢理重ねている世界だからな。{n}このような状況も予想はされるのだが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0033",
   "jp": "ふう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0034",
   "jp": "まさか、世界が分かれるなんて事は‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0035",
   "jp": "怖いわ、私‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0036",
   "jp": "人間の力なんて、ちっぽけなものね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0037",
   "jp": "お願い、誰か世界を救って！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0038",
   "jp": "来る！{n}来るぞ！{n}敵が来るぞぉ～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0039",
   "jp": "いつでも来い！{n}僕の魔法で吹き飛ばしてやる！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0040",
   "jp": "え～ん[01BE]{n}怖いよぉ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0041",
   "jp": "もぉ、やだぁ‥‥[01BE]{n}ど～して、こんなメにあうのよぉ‥‥[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0042",
   "jp": "泣き言いってんじゃないわよ！{n}私たちの学院は、私たちが守るんでしょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0043",
   "jp": "{v:0000}ねぇ、ねぇ、知ってる？{n}うちの教授が言ってたんだけど、{n}最近、時空歪み計が異常な値を検出してるんだって。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0044",
   "jp": "{v:0001}おい、それってヤバイんじゃないの？{n}下手すると時空分裂の兆候かも‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0045",
   "jp": "{v:0002}うん。{n}教授もそれを心配してるのよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0046",
   "jp": "{v:0003}詳しく話を聞いてみたいな。{p}{v:0004}教授は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0047",
   "jp": "{v:005B}屋上の歪み計にかかりっきり。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0048",
   "jp": "あの事件以来、ここは封鎖されているんだ。{n}入ることは出来ないよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0049",
   "jp": "鍵がかかっている。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0050",
   "jp": "内側からカギをかけられているようだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0051",
   "jp": "今、この僕ができることってなんだろう？{n}何か１つでも、あればいいのに‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0052",
   "jp": "アリオストの研究室",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0053",
   "jp": "ここって、いろんな物があるんですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0054",
   "jp": "面白いですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0055",
   "jp": "薬草の本もあるのかしら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0056",
   "jp": "多目的ホール",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0057",
   "jp": "‥‥{v:004F}ふぅっ。{n}終わった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0058",
   "jp": "{v:0050}それにしても、奴がここを狙うとはな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0059",
   "jp": "{v:0051}気になることも言っていたね。{n}『人は殺しても研究には手をつけるな』とか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0060",
   "jp": "{v:0052}なんでだろ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0061",
   "jp": "{v:0053}う～ん、考えてみると{n}研究を欲しがっているような‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0062",
   "jp": "バーンシュタインへ報告",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0063",
   "jp": "{v:0054}バーンシュタインの王都を襲ったときも、{n}兵士を倒すのが目的だったみたいだし。{n}街の人には攻撃してなかったよね？{p}{v:0055}だったらどうしてここの学生を襲ったのかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0064",
   "jp": "{v:0056}ここの魔法使いだって、{n}考え方によっては戦力だからな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0065",
   "jp": "{v:0057}つまり、{n}自分を狙う戦力だけを目標にしてるってこと？{p}{v:0058}支配者として、労働力には手を出さない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0066",
   "jp": "{v:0059}クゥ～～～ッ！！{n}やっぱり、ムカツク～ッ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0067",
   "jp": "{v:005A}さて、これからどうするか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0068",
   "jp": "ヴェンツェルの真意は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0069",
   "jp": "{v:004D}きゃあっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0070",
   "jp": "{v:004E}そんな‥‥学生たちが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0071",
   "jp": "{v:0034}ダメだ‥‥僕の魔法じゃ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0072",
   "jp": "{v:0035}諦めたら、そこで終わりです。{n}希望を捨てないで、がんばりましょう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0073",
   "jp": "{v:0036}は、はい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0074",
   "jp": "{FFF3}‥‥{FFF4}{v:0037}とはいえ、多勢に無勢。{n}つらいですね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0075",
   "jp": "{v:0038}あきらめちゃダメ！{n}私たちが食い止めないと、この学院はおしまいよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0076",
   "jp": "{v:0039}そ、そうだな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0077",
   "jp": "{v:003A}多くの知識を持つことは、決して悪いことではない。{n}だが支配する側から見れば、{n}それは困ったことなのだよ。{p}{v:003B}よってこの学院の関係者は抹殺する！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0078",
   "jp": "{v:003C}みんな！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0079",
   "jp": "{v:003D}そんな事させないから！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0080",
   "jp": "{v:003E}よくも、アタシの学校を‥‥！{FFF9}{FFFB}{n}{v:003F}よくも、アタシの友達を‥‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0081",
   "jp": "‥‥{v:0040}忌々しい、英雄気取りがっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0082",
   "jp": "{v:0041}別に気取っているわけじゃない。{p}{v:0042}ここは僕の職場だ。{n}暴れてほしくないだけだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0083",
   "jp": "{v:0043}おまけに口も達者か‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0084",
   "jp": "{v:0044}やれやれ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0085",
   "jp": "{v:0045}だったらお前を倒して、{n}名実ともに英雄になってやらぁ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0086",
   "jp": "君たちがいてくれて助かったよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0087",
   "jp": "ありがとう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0088",
   "jp": "ありがとうございます。{n}おかげで助かりました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0089",
   "jp": "た、助かった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0090",
   "jp": "何とか生き残れたのね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0091",
   "jp": "‥‥まだ足が震えていますぅ‥‥[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0092",
   "jp": "もう襲ってきたりしないよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0093",
   "jp": "{v:0000}まだ、大丈夫みたいね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0094",
   "jp": "{v:0001}あ、みんな！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0095",
   "jp": "{v:0002}あの声を聞いて、{n}急いでここへ駆けつけてきたんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0096",
   "jp": "{v:0003}私も近くまで来ていたので。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0097",
   "jp": "{v:0004}それにしても遅いな？{n}テレポートを使えば、一瞬だろ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0098",
   "jp": "{v:0005}まさか、我々をここにおびき寄せるための‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0099",
   "jp": "{v:0006}{FFEE}　貴様ら、今度は何をした！{n}　それともまだパワーストーンを持っていたのか！？{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0100",
   "jp": "{v:0007}何のことを言ってるんだろう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0101",
   "jp": "{FFEE}{v:0008}　　だが私のテレポート能力を奪ったからといって{n}　　いい気になるなよ！{n}　　こちらにはグローシアンの兵器があるのだ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0102",
   "jp": "{v:0009}奴のテレポート能力がなくなった！？{n}おい、何をやったんだ、ウォレス？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0103",
   "jp": "{v:000A}いや、俺たちは何も‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0104",
   "jp": "{v:000B}それに『グローシアンの兵器』って何だろう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0105",
   "jp": "{v:000C}ん？{n}アレは何だ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0106",
   "jp": "{v:000D}おい、いったい何が見えるんだ？{n}説明してくれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0107",
   "jp": "{v:000E}空飛ぶ遺跡だ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0108",
   "jp": "{v:000F}遺跡？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0109",
   "jp": "{v:0010}下半分がフェザリアン特有の造形だ。{n}上半分がグローシアンの物だね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0110",
   "jp": "{v:0011}なんだかチグハグ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0111",
   "jp": "{v:0012}それが奴の言う兵器か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0112",
   "jp": "{v:0013}ああ、たぶん。{p}{v:0014}飛行速度はずいぶん遅いけど‥‥驚いたな。{n}あれが伝承にしか残らない、{n}グローシアンの浮遊城か‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0113",
   "jp": "{v:0015}しかし問題は、あの城にどうやって攻撃をかけるかだ。{n}我々にはあそこへ行く手段がない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0114",
   "jp": "{v:0016}アリオストさんの発明であそこへ行けないかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0115",
   "jp": "{v:0017}無理じゃない。{n}無理じゃないけど、実用的じゃないよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0116",
   "jp": "{v:0018}え～、どうして？{n}だって、前にやったみたく、ルイセちゃんがあそこへ{n}行って、みんなをテレポートさせればいいじゃない！{p}{v:0019}ね、ルイセちゃん？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0117",
   "jp": "{v:001A}ん～‥‥やっぱり無理かも。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0118",
   "jp": "{v:001B}どーして！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0119",
   "jp": "{v:001C}あれ、動いてるモン。{p}{v:001D}わたしのテレポートって、{n}絶対的な地形じゃないと出来ないし、{n}出現する場所に物がないことが条件だから‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0120",
   "jp": "{v:001E}それじゃ、あそこへテレポートしようとしたら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0121",
   "jp": "{v:001F}空中に現れて、後は落ちるだけだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0122",
   "jp": "{v:0020}う～！{n}じゃ、どうすればいいのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0123",
   "jp": "{v:0021}ここにおったか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0124",
   "jp": "{v:0022}あ、フェザリアンの女王様‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0125",
   "jp": "{v:0023}それに、母さん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0126",
   "jp": "{v:0024}困っているみたいですね、アリオスト。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0127",
   "jp": "{v:0025}はい。{n}正直に言って、打つ手がありません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0128",
   "jp": "{v:0026}そうであろうな。{n}人間では、あの城を止めることは叶わぬ。{n}しかし、そう悲観するでない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0129",
   "jp": "{v:0027}えっ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0130",
   "jp": "{v:0028}あの城が浮いている原理は、{n}我々フェザリアンが過去に確立した技術です。{p}{v:0029}そして我々が今住んでいるあの島も、{n}同じ技術で浮いています。{p}{v:002A}その技術とは、{n}この世界に、ある種の力を与え続けることで、{n}特定の装置に浮力を与える物。{p}{v:002B}その力を止めてしまえば、{n}あの城は浮いていられなくなります。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0131",
   "jp": "{v:002C}ちょっと待ってよ、母さん！{n}その話からすると、その方法を使ったら‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0132",
   "jp": "{v:002D}我々のフェザーランドも、浮いてはいられぬな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0133",
   "jp": "{v:002E}でも、それしか方法はないのですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0134",
   "jp": "{v:002F}母さん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0135",
   "jp": "{v:0030}はるか昔、我々フェザリアンも、{n}この大地で生活していた民だった。{p}{v:0031}だが人間との思想の違いから、大地を捨て、{n}フェザーランドに移り住むこととなった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0136",
   "jp": "{v:0032}しかし、そなたらがフェザーランドに来てから、{n}我々は今まで見ようとはしなかった{n}人間を見る機会を得られた。{p}{v:0033}そして人間の素晴らしさに、気づくことができたのだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0137",
   "jp": "{v:0034}それって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0138",
   "jp": "{v:0035}けしてあきらめない、前向きな姿。{n}私があの人を愛した理由。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0139",
   "jp": "{v:0036}どうやら我々は理解しようともせずに、{n}相容れない存在と見ていたようだ。{p}{v:0037}しかしジーナが、そしてそなたらが、{n}我々の目を開かせてくれたのだ。{n}人間からは、多くの学ぶべき事があるとな。{p}{v:0042}そして人間もそれを証明して見せてくれた。{n}よもや、テレポート能力まで奪い去ってしまうとはな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0140",
   "jp": "{v:0043}えっ？{FFF9}{FFFB}{n}{v:0044}アタシ達、何もしてないケド‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0141",
   "jp": "{v:0045}いいえ。{n}人間がヴェンツェルのテレポートを奪ったのです。{p}{v:00A9}皆の諦めない気持ちが１つになったとき、{n}意志の力が奇跡を起こしました。{n}まるでパワーストーンのように‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0142",
   "jp": "{v:0046}あのときの感じ‥‥、{FFF9}{FFFB}{n}{v:0047}あれがそうだったんだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0143",
   "jp": "{v:0038}今までの我々は、ただ何もせず運命を受け入れる{n}だけの種族であった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0144",
   "jp": "{v:0039}だが今こそ、我々も力を貸そう！{n}平和な世界のために！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0145",
   "jp": "{v:003A}全員、地上へ避難してください！{n}まもなく浮遊システムが中和されます。{p}{v:003B}くりかえします。{n}全員、地上へ避難してください！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0146",
   "jp": "{v:003C}やった！{n}城が落ちて行く！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0147",
   "jp": "{v:003D}ヴェンツェルを倒せるのは、そなたらだけ。{n}後はそなたらの出番だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0148",
   "jp": "{v:003E}頼みますよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0149",
   "jp": "{v:003F}フェザリアンが自らの島を捨ててまで{n}作ってくれたチャンスだ。{n}無駄には出来ない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0150",
   "jp": "{v:0040}ああ、これが最後の戦いだ！{n}やってやろうぜ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0151",
   "jp": "{v:0041}よぉし！{n}みんな、がんばろー！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0152",
   "jp": "時空制御塔へ",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0153",
   "jp": "私の手が必要か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0154",
   "jp": "でもこれ以上は多すぎるよ。{n}誰かを仲間から外さないと。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0155",
   "jp": "誰をメンバーから外しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0156",
   "jp": "・{s:FFED}",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen026.0157",
   "jp": "・{s:FFEE}",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen026.0158",
   "jp": "{s:FFED}の装備を回収しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0159",
   "jp": "　{n}　　　　　　{FFEF}ジュリアンが仲間になった！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0160",
   "jp": "期待してくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0161",
   "jp": "あの塔の墜落現場に{n}部下を率いて向かうつもりだ。{p}現地で合流しよう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0162",
   "jp": "君たちが戦う間、{n}我々が市民の安全を守る。{n}絶対にヴェンツェルを倒してくれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0163",
   "jp": "あの塔の落ちていった方角から察すると、{n}ラージン砦の西あたりだね。{p}さっそく向かうとしよう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0164",
   "jp": "がんばって下さい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0165",
   "jp": "ご武運を！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0166",
   "jp": "我々に出来るのはここまでじゃ。{n}後はそなた達に託すことしか出来ぬ。{n}頼むぞよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0167",
   "jp": "がんばるのですよ、アリオスト。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0168",
   "jp": "我々の未来はあなた達にゆだねられました。{n}がんばって下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0169",
   "jp": "がんばってくれよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0170",
   "jp": "あ、お兄さま。{n}アタシの力が必要なんですね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0171",
   "jp": "どうするの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0172",
   "jp": "・ミーシャをメンバーに加える",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen026.0173",
   "jp": "・今はメンバーに加えない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen026.0174",
   "jp": "{s:FFEE}の装備を回収しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0175",
   "jp": "　{n}　　　　　　{FFEF}ミーシャが仲間になった！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0176",
   "jp": "アタシ、がんばっちゃうね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0177",
   "jp": "そうですか‥‥。{n}ちょっとガッカリ‥‥。{p}{FC00}でも、でも！{n}ご用があったら、いつでもどうぞ！{n}アタシ、がんばりますから！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0178",
   "jp": "ん？{n}僕の力が必要なのかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0179",
   "jp": "アリオストを仲間に加えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0180",
   "jp": "　{n}　　　　　{FFEF}アリオストが仲間になった！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0181",
   "jp": "ありがとう、がんばるよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0182",
   "jp": "そうかい。{n}僕の力が必要になったら、{n}いつでも声をかけてくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0183",
   "jp": "あのね、お兄ちゃん。{n}学院の施設内で大きな魔法を使うと、{n}怒られちゃうんだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen026.0184",
   "jp": "お兄ちゃん！{n}何やってるのよ！{n}すぐ先で、生徒が襲われているんだよ！",
   "en": "",
   "term": "end"
  }
 ]
}
