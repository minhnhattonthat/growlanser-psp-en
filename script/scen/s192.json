  {
   "id": "scen192.0100",
   "jp": "　{n}　　　　　携帯集魔柱が設置してある。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen192.0101",
   "jp": "こら、外へ出たら連絡が取れなくなるでしょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen192.0102",
   "jp": "みんなを置いて、どこへ行こうってのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen192.0103",
   "jp": "今日はここで一日過ごすんでしょ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen192.0104",
   "jp": "さて、解散しましょ～か。{n}集合時間に遅れないようにね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen192.0105",
   "jp": "アタシたちも行こっか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen192.0106",
   "jp": "お兄さま、ケーキ作ったのに‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen192.0107",
   "jp": "ちょっとアンタ、いくら相手がミーシャでも{n}それはないでしょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen192.0108",
   "jp": "さて、みんなそろったよね？{n}じゃあ、戻ろうか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen192.0109",
   "jp": "みんな、心配かけてごめんなさい。{n}アタシはもう大丈夫。{p}お兄さま、アタシでお役に立てるなら{n}いつでも言って下さいね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen192.0110",
   "jp": "良かった、良かった。{n}じゃあ、戻ろうか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen192.0111",
   "jp": "{s:0000}。{n}しっかりやれよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen192.0112",
   "jp": "ミーシャ君‥‥どこにいるんだろうね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen192.0113",
   "jp": "私が力になれれば良いのですが‥‥。",
   "en": "",
