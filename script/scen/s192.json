  {
   "id": "scen192.0100",
   "jp": "　{n}　　　　　携帯集魔柱が設置してある。",
   "en": "　{n}　　　　　A Portable Mana Pillar has been set{n}up here.",
   "term": "end"
  },
  {
   "id": "scen192.0101",
   "jp": "こら、外へ出たら連絡が取れなくなるでしょ！",
   "en": "Hey! If you go outside, they won't be able to reach you!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen192.0102",
   "jp": "みんなを置いて、どこへ行こうってのよ！",
   "en": "Where do you think you're going, leaving{n}everyone behind?!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen192.0103",
   "jp": "今日はここで一日過ごすんでしょ？",
   "en": "We're spending the whole day here, remember?",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen192.0104",
   "jp": "さて、解散しましょ～か。{n}集合時間に遅れないようにね。",
   "en": "Okay, let's split up! Don't be late meeting back here.",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen192.0105",
   "jp": "アタシたちも行こっか？",
   "en": "Shall we get going, too?",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen192.0106",
   "jp": "お兄さま、ケーキ作ったのに‥‥。",
   "en": "But Big Brother, I baked you a cake...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen192.0107",
   "jp": "ちょっとアンタ、いくら相手がミーシャでも{n}それはないでしょ！",
   "en": "Hey, you! Even if it is Misha, that's no way to{n}treat her!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen192.0108",
   "jp": "さて、みんなそろったよね？{n}じゃあ、戻ろうか。",
   "en": "Okay, everyone's here, right? Let's head back.",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen192.0109",
   "jp": "みんな、心配かけてごめんなさい。{n}アタシはもう大丈夫。{p}お兄さま、アタシでお役に立てるなら{n}いつでも言って下さいね。",
   "en": "Everyone, I'm sorry I worried you. I'm all right now.{p}Big Brother, if there's anything I can do to help, please{n}let me know.",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen192.0110",
   "jp": "良かった、良かった。{n}じゃあ、戻ろうか。",
   "en": "Good, good. Let's head back, then.",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen192.0111",
   "jp": "{s:0000}。{n}しっかりやれよ。",
   "en": "{s:0000}. Don't let us down.",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen192.0112",
   "jp": "ミーシャ君‥‥どこにいるんだろうね？",
   "en": "Misha-kun... Where could she be?",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen192.0113",
   "jp": "私が力になれれば良いのですが‥‥。",
   "en": "I wish there were something I could do to help...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen192.0114",
   "jp": "ミーシャ‥‥。{n}大丈夫かな？",
   "en": "Misha... Is she all right?",
