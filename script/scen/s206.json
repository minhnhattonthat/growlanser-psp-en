  {
   "id": "scen206.0001",
   "jp": "アナウンス",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen206.0002",
   "jp": "準決勝戦開始",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen206.0003",
   "jp": "２回戦開始",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen206.0004",
   "jp": "{v:0008}もぉ～～！{n}ドジなんだからぁ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen206.0005",
   "jp": "{v:0054}きゃあっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen206.0006",
   "jp": "{v:0055}ああっ！ルイセちゃんが！{n}もぅっ！敵討ちよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen206.0007",
   "jp": "この俺の攻撃に、どこまで耐えられるかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen206.0008",
   "jp": "く、くそ‥‥。{n}やるじゃねぇか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen206.0009",
   "jp": "まさか、俺たちが負けるとは‥‥。{n}強えな、お前ら‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen206.0010",
   "jp": "やるじゃねぇか‥‥。{n}だが、まだまだだな！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen206.0011",
   "jp": "後は任せたぜ。{n}俺の分まで、頼む‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen206.0012",
   "jp": "任せておけ！{n}後は俺一人で十分だ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen206.0013",
   "jp": "くそっ！{n}まだまだ俺は戦えるぞ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen206.0014",
   "jp": "それ以上は無理だ、ニック。{n}後は俺に任せて退くんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen206.0015",
   "jp": "すまない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen206.0016",
   "jp": "お前たち、なかなかやるな。{n}久しぶりに強い奴と戦えて、面白かったぜ‥‥。{n}決勝戦、がんばれよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen206.0017",
   "jp": "後は俺に任せて、お前は下がるんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen206.0018",
   "jp": "すまない、ニック。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen206.0019",
   "jp": "俺の力、見せてやる！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen206.0020",
   "jp": "お前の力、見せてもらおう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen206.0021",
   "jp": "し、しまった‥‥。{n}この傷では、もう無理か‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen206.0022",
   "jp": "勝負あり！{p}なんと、この勝負を制したチームは{n}王都ローザリアの兄妹チーム！{n}見事、準決勝へのキップを手にしました！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen206.0023",
   "jp": "勝負あり！{p}なんと、この勝負を制したチームは{n}王都ローザリアの兄妹チーム！{p}見事、あのニックを倒し、{n}決勝へのキップを手にしました！",
   "en": "",
   "term": "end"
  }
 ]
}
