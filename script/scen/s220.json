  },
  {
   "id": "scen220.0001",
   "jp": "眼帯の男",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen220.0002",
   "jp": "ぐぅ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen220.0003",
   "jp": "{v:0059}お前たちの目的は何だ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen220.0004",
   "jp": "{v:005A}目的？{p}‥‥{v:005B}フン！{n}今戦争を止められるわけにはいかねぇんだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen220.0005",
   "jp": "‥‥{v:005C}えっ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen220.0006",
   "jp": "{v:005D}さて、おしゃべりは終わりだ。{n}いつまでもお前たちに構ってるほど暇じゃないんだ。{p}{v:005E}じゃあな！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen220.0007",
   "jp": "{v:005F}無理だよ！{n}グローシアンじゃないあなたが、{n}この森を出られるわけない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen220.0008",
   "jp": "{v:0060}ハン！{n}こっちにはこれがある。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen220.0009",
   "jp": "{v:0061}グローシュ結晶！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen220.0010",
   "jp": "{v:0062}魔水晶から抽出したものだ。{n}これがありゃ、迷うことはないんだよ。{p}{v:0063}俺の名はグレンガル。{n}また会おう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen220.0011",
   "jp": "つ、強えぇ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen220.0012",
   "jp": "バ、バカな‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen220.0013",
   "jp": "‥‥{v:004D}こいつら、ランザックの兵じゃねぇぞ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen220.0014",
   "jp": "{v:004E}えっ？{n}でも、あの格好は‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen220.0015",
   "jp": "‥‥{v:004F}偽装だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen220.0016",
   "jp": "{v:0050}それに、あの人‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen220.0017",
   "jp": "{v:0051}あっ！{p}{v:0052}確か、盗賊の‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen220.0018",
   "jp": "{v:0053}だよね！？{p}{FC03}{v:0054}でも、あの人、インペリアル・ナイトに{n}殺されたはずじゃ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen220.0019",
   "jp": "{v:0055}ほほぅ。{n}お前ら、俺の弟を知っていたか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen220.0020",
   "jp": "{v:0056}弟！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen220.0021",
   "jp": "{v:0057}ゴチャゴチャと話す気はねぇ！{p}{v:0058}やっちまえ！",
   "en": "",
   "term": "end"
  }
 ]
}
