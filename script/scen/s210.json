  },
  {
   "id": "scen210.0050",
   "jp": "ロックがはずれた！",
   "en": "The lock has been released!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen210.0051",
   "jp": "{FFF0}エラー{FFF1}",
   "en": "{FFF0}Error{FFF1}",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen210.0052",
   "jp": "{FFEE}正しいコードを入力してください{FFF1}",
   "en": "{FFEE}Please enter the correct code.{FFF1}",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen210.0053",
   "jp": "ちょっと待ってくれ！{n}僕はこのマジックタイム停止装置を制御するだけで{n}手一杯なんだ。{p}誰か１人はここに残って、扉の解除を試してくれ！",
   "en": "Wait a moment! I've got my hands full just controlling{n}this Magic Time Stopper.{p}One of you needs to stay here and try to unlock{n}the door!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen210.0054",
   "jp": "{v:003E}も、もうダメだ‥‥。",
   "en": "{v:003E}I... I can't go on...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen210.0055",
   "jp": "{v:003F}そんな！{n}しっかりしてよ、アリオストさん！{n}アリオストさーーん！",
   "en": "{v:003F}No! Hang in there, Ariost-san! Ariost-saaan!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen210.0056",
   "jp": "　{n}　　　　　　６５０エルムを手に入れた！",
   "en": "　{n}　　　　　　Received 650 Elm!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen210.0057",
   "jp": "『{FFEF}かなづち{FFF1}』を見つけたが、{n}これ以上、持つことはできない‥‥。",
   "en": "Found '{FFEF}Hammer{FFF1}', but you can't carry any more...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen210.0058",
   "jp": "　{n}　　　　　『{FFEF}かなづち{FFF1}』を手に入れた！",
   "en": "　{n}　　　　　Obtained '{FFEF}Hammer{FFF1}'!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen210.0059",
   "jp": "『{FFEF}ブラスターハンド{FFF1}』を見つけたが、{n}これ以上、持つことはできない‥‥。",
   "en": "Found '{FFEF}Blaster Hand{FFF1}', but you can't carry any more...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen210.0060",
   "jp": "　{n}　　　『{FFEF}ブラスターハンド{FFF1}』を手に入れた！",
   "en": "　{n}　　　Obtained '{FFEF}Blaster Hand{FFF1}'!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen210.0061",
   "jp": "{v:0042}これでもう大丈夫だね？",
   "en": "{v:0042}We're safe now, right?",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen210.0062",
   "jp": "{v:0043}なかなか、きわどい戦いだったな。",
   "en": "{v:0043}That fight was a close one.",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen210.0063",
   "jp": "石板の上に文字が刻んである。読みますか？",
   "en": "Words are carved into the stone tablet. Read them?",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen210.0064",
   "jp": "　　南国の空の下{n}　　　　葉の茂る木々に実るバナナ{n}　　　　　　ハイビスカスの花が揺れる",
   "en": "　　Beneath a tropical sky{n}Bananas ripen on leafy trees{n}Hibiscus flowers sway",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen210.0065",
   "jp": "　{n}　　　　　　短い物から長い物へ",
   "en": "　{n}　　　　　　From shortest to longest.",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen210.0066",
   "jp": "　{n}　　　　　　不純な光は除外される",
   "en": "　{n}　　　　　　Impure light is excluded.",
