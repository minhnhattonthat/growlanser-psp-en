  },
  {
   "id": "scen210.0037",
   "jp": "・白",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen210.0038",
   "jp": "２番目のボタンは？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen210.0039",
   "jp": "・赤",
   "en": "",
