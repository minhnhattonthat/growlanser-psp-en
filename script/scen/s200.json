  },
  {
   "id": "scen200.0001",
   "jp": "{FFEE}謎の兵士からサンドラを救え！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen200.0002",
   "jp": "{v:000C}おい！{n}奴はお前たちで歯の立つ相手ではないぞ。{p}{v:000D}私が直接戦う！{n}お前たちは援護を頼む！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen200.0003",
   "jp": "{v:000E}みんなが戦いやすいように、使う魔法を選びましょう。{p}{v:000F}一番優先して欲しい魔法を選びなさい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen200.0004",
   "jp": "優先して欲しい魔法はどれですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen200.0005",
   "jp": "・攻撃魔法",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen200.0006",
   "jp": "・援護魔法",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen200.0007",
   "jp": "・回復魔法",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen200.0008",
   "jp": "・最低限の回復行動のみ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen200.0009",
   "jp": "{v:0010}わかりました。{n}そうしましょう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen200.0010",
   "jp": "{v:0011}マスター、もうちょっと我慢してね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen200.0011",
   "jp": "{v:0012}お母さん、もうちょっとの辛抱よ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen200.0012",
   "jp": "{v:0013}サンドラ様、後少し待ってください！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen200.0013",
   "jp": "{v:0014}後少し、辛抱してください！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen200.0014",
   "jp": "{v:0015}わたしだって、怒るんだよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen200.0015",
   "jp": "{v:0018}ん？{n}この感触は‥‥もしや‥‥。{FFF9}{FFFB}{n}{v:0019}俺の腕と目を奪った奴か！？{p}{v:001A}それにしては弱すぎるような‥‥。{n}別人か！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen200.0016",
   "jp": "{v:0016}お前の相手など、私一人で十分だ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen200.0017",
   "jp": "！！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen200.0018",
   "jp": "{v:0017}ああ、お母さん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen200.0019",
   "jp": "あぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen200.0020",
   "jp": "いやー！{n}マスター！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen200.0021",
   "jp": "{v:001B}うおぉ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen200.0022",
   "jp": "{v:001C}うひゃっ！？{n}溶けちゃったよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen200.0023",
   "jp": "{v:001D}！？{p}{v:001E}この消え方‥‥フレッシュゴーレム？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen200.0024",
   "jp": "{v:001F}やったぁ★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen200.0025",
   "jp": "さぁ、次はどうすればいい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen200.0026",
   "jp": "ジュリアンにどう指示しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen200.0027",
   "jp": "・自由に戦わせる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen200.0028",
   "jp": "・攻撃目標を指定",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen200.0029",
   "jp": "{v:0031}では、自由にやらせてもらう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen200.0030",
   "jp": "{v:002E}わかった！",
   "en": "",
   "term": "end"
  }
 ]
}
