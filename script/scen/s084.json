 "entries": [
  {
   "id": "scen084.0000",
   "jp": "",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen084.0001",
   "jp": "バーンシュタイン兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen084.0002",
   "jp": "壁の口",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen084.0003",
   "jp": "北の沼地",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0004",
   "jp": "{v:0012}またここに来るとはな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0005",
   "jp": "ちょっと待った！{p}これからゲヴェルのところに向かおうってんだ、{n}パーティーは５人いた方がいい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0006",
   "jp": "そうだね。{n}戻って、メンバーを集めてきましょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0007",
   "jp": "{v:0000}沼地ってここだよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0008",
   "jp": "{v:0001}この岩場の裂け目から、{n}ゲヴェルの波動を感じる‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0009",
   "jp": "{v:0002}いよいよだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0010",
   "jp": "ゲヴェルを倒せ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0011",
   "jp": "{v:0066}う～ん、いい天気♪{n}アタシ達、勝ったんだね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0012",
   "jp": "{v:0067}そうだな。{n}ルイセの能力があったしな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0013",
   "jp": "{v:0068}違うよ。{n}みんなが最後まであきらめなかったから、{n}勝てたんだよ。{p}{v:0069}ね？{n}お兄ちゃん？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0014",
   "jp": "なんと答えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0015",
   "jp": "・みんなの力の勝利",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0016",
   "jp": "・ルイセに賛同する",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0017",
   "jp": "・ルイセのおかげ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0018",
   "jp": "・自分のおかげ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0019",
   "jp": "・返事をする気力がない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0020",
   "jp": "{v:006A}ああ、何だかいいわよねぇ、こういうのって！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0021",
   "jp": "{v:006B}そ、そんな、お兄ちゃん！！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0022",
   "jp": "{v:008F}照れない、照れない。{n}ルイセちゃんのグローシュがなかったら、{n}どうなってたか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0023",
   "jp": "{v:006C}ティピちゃーん、きーっく！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0024",
   "jp": "％×＆★！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0025",
   "jp": "{v:006D}もぉ、こりないなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0026",
   "jp": "{v:006E}ん？{n}黙りこんじゃって、つれないわねぇ‥‥。{p}{v:006F}何か気がかりなことでもあるの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0027",
   "jp": "{v:0070}ティピ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0028",
   "jp": "{FB00}‥‥{v:0071}あ‥‥。{p}‥{v:0072}あはははっ！{n}今のナシね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0029",
   "jp": "{v:0073}ま、これで世の中も平和になるってもんだな。{n}これからどうする？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0030",
   "jp": "{v:0074}う～んと‥‥あっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0031",
   "jp": "{v:0075}ライエル？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0032",
   "jp": "{v:0076}ライエル将軍！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0033",
   "jp": "{v:0077}ご無事でしたか、陛下！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0034",
   "jp": "{v:0078}ええ。{n}これで人々も安心して暮らせるでしょう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0035",
   "jp": "{v:0079}ん？　どうしたのだ、こんなところで‥‥。{p}{v:007A}まさか、もう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0036",
   "jp": "{v:007B}うん。{n}ゲヴェルは倒しましたよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0037",
   "jp": "{v:007C}遅かったか‥‥。{p}{v:007D}加勢は多い方がいいのではと思い、{n}やってきたのだが、どうやら遅かったようだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0038",
   "jp": "{v:007E}もうちょっと早く来てくれればよかったのに！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0039",
   "jp": "{v:007F}すまない。{n}王都に攻め込む敵を一掃するのに手間取ったのでな。{p}{v:0080}ところで、これからみなさんはどうなされますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0040",
   "jp": "{v:0081}僕は、一度村に帰りますよ。{n}村の人々は、僕の家族も同然ですから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0041",
   "jp": "アリオストの装備を回収しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0042",
   "jp": "{v:0082}そろそろ王としての責務を果たさないと{n}いけませんから、城に戻りますよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0043",
   "jp": "エリオットの装備を回収しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0044",
   "jp": "{v:0083}本来のナイツの仕事があるからな。{n}城に戻らざるをえん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0045",
   "jp": "ジュリアンの装備を回収しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0046",
   "jp": "{v:0084}お父さんの容態も気になるので、保養施設に戻ります。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0047",
   "jp": "カレンの装備を回収しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0048",
   "jp": "‥‥{v:0085}コイツらとは一緒にいられねぇ。{n}騙されていたとはいえ、{n}ローランディア王国には迷惑かけちまったからな。{p}{v:0086}かといって、バーンシュタイン王国にもいられねぇ。{n}とりあえず、自分の家に戻るさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0049",
   "jp": "ゼノスの装備を回収しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0050",
   "jp": "{v:0087}アタシは‥‥帰るところがないの。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0051",
   "jp": "{v:0088}それじゃ、一緒においでよ！{n}わたしの家にお泊まりしようよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0052",
   "jp": "{v:0089}きゃーー★{n}ルイセちゃん、ルイセちゃん♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0053",
   "jp": "{v:008A}では、私も戻るとしよう。{n}いろいろと世話になった。{n}また会おう、ローランディア王国の騎士よ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0054",
   "jp": "{v:008B}アタシたちも帰りましょ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0055",
   "jp": "{v:008C}お母さんも心配してるしね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0056",
   "jp": "{v:008D}よっしゃ、帰るか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0057",
   "jp": "ゲヴェルを倒した！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0058",
   "jp": "‥‥{v:001D}よし。{n}これで完成ね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0059",
   "jp": "{v:001E}あっ！{n}アイツは！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0060",
   "jp": "{v:001F}やっぱり、来たわね‥‥。{n}ここで張っていれば、現れると思ったわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0061",
   "jp": "{v:0020}またアタシたちの妨害をしようっての！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0062",
   "jp": "{FFF6}‥‥{v:0021}ふふっ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0063",
   "jp": "{v:0022}相手は１人だよ！{n}今なら‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0064",
   "jp": "{v:0023}待て、ティピ。{n}あいつには戦う意思はなさそうだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0065",
   "jp": "‥‥{v:0024}えっ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0066",
   "jp": "{FFF6}{v:0025}少し話をしましょうか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0067",
   "jp": "{v:0026}あなたは人々の戦いをどう思うの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0068",
   "jp": "・避けられない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0069",
   "jp": "・おろかなことだ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0070",
   "jp": "・止めねばならない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0071",
   "jp": "{v:0027}つまり、諦めているってこと？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0072",
   "jp": "{v:0028}いいえ、あきらめていたら、{n}私たちは行動していないでしょう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0073",
   "jp": "{v:0029}避けられないことだと、現実を知っているから、{n}それを何とかしようとあがくんだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0074",
   "jp": "{v:002A}そうね。{n}だけどそうやって嘆くだけなの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0075",
   "jp": "{v:002B}いいえ、嘆くだけなら、{n}私たちは行動していないでしょう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0076",
   "jp": "{v:002C}おろかな行為だとしても、現実を見つめて、{n}それを何とかしようとあがくんだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0077",
   "jp": "{FFF6}{v:002D}そうね。{n}あなたたちの行動を見ていれば、よくわかるわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0078",
   "jp": "{v:002E}いったい、何が言いたいのよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0079",
   "jp": "{v:002F}私たちは、こっちの世界の人が、{n}旧世界と呼ぶ元の世界から来たことは話したわね？{p}{FFF6}{v:0030}私たちがこっちに着いた時、{n}そこはグローシアンとフェザリアンの戦争の{n}末期だったわ。{p}{FFF7}{v:0031}フェザリアンは地上を捨て、グローシアンは{n}生物兵器ゲヴェルを使い反逆する人間を虐殺する、{n}そんな時代だった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0080",
   "jp": "‥‥{v:0032}ひどい‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0081",
   "jp": "{v:0033}私たちのチームのリーダーであった{n}メルフィの両親は、フェザリアンであったがために{n}グローシアンたちによって殺されたわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0082",
   "jp": "{v:006B}はい、ジャスティンさんもそう言っていました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0083",
   "jp": "{v:0034}それで、グローシアンを憎むように‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0084",
   "jp": "{v:0035}自分たちの仲間を殺されても、{n}私たちはグローシアンに頼るしかなかった。{n}それは、自分たちの故郷に帰る方法を探すためよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0085",
   "jp": "{v:0036}帰る方法を持たずに来たわけじゃないだろう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0086",
   "jp": "{v:0037}こちらの世界に来るまでは闇‥‥、{n}デュンケルスの存在は知らなかったからよ。{n}通常の方法で帰ることは出来なかったのよ‥‥！{p}{FFF6}{v:0038}だから当時一番研究をするのに向いた環境‥‥{n}グローシアンの元で、デュンケルスに対処する方法を{n}調べるしかなかった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0087",
   "jp": "{v:0039}それをヴェンツェルたちに奪われたのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0088",
   "jp": "{v:003A}ゲヴェル細胞と融合し、{n}時空干渉能力を持つことで、{n}同時にデュンケルスが無害になるということをね。{p}{FFF6}{v:003B}ヴェンツェルは人間や、{n}同じグローシアンの部下で実験すると、{n}今度は自分の身体でそれを試した。{p}{v:003C}だけどヴェンツェルの身体はゲヴェル細胞が{n}急激に侵食を行い、精神を奪われた。{p}{v:003D}これを止めるために何人もの{n}グローシアンが死んだわ。{p}{FFF7}{v:003E}でもこの研究により、急激な侵食を行わなければ、{n}確実に融合できることが分かった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0089",
   "jp": "{v:003F}どう言う意味？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0090",
   "jp": "{v:0040}私たちが、グローシアン支配時代から今まで、{n}どうやって生きてきたと思う？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0091",
   "jp": "・歳を取らない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0092",
   "jp": "・眠っていた",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0093",
   "jp": "・想像もつかない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0094",
   "jp": "{FFF6}{v:0041}そんなことはないわよ。人間だもの。{n}答えはね、眠っていたから。{p}{FFF7}{v:0042}何百年もかけて、{n}眠りながらゲヴェル細胞と融合していったの。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0095",
   "jp": "{v:0043}そう、その通り。{n}何百年もかけて、眠りながらゲヴェル細胞と{n}融合していったの。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0096",
   "jp": "{FFF6}{v:0044}そう‥‥。{n}答えはね、眠っていたから。{p}{FFF7}{v:0045}何百年もかけて、{n}眠りながらゲヴェル細胞と融合していったの。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0097",
   "jp": "{FFF6}{v:0046}自らの身体をグローシュの結晶である魔水晶に{n}閉じ込めて、死に近い状態で眠りながら、{n}徐々に身体を慣れさせていった。{p}{FFF7}{FC02}{v:0047}おかげで、あなたやリシャールほどの力は{n}得られなかったけど、時空干渉能力と{n}デュンケルスへの耐性は得られたわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0098",
   "jp": "{v:0048}それじゃ、その方法を使えば、{n}みんな怪物化しなくて済むの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0099",
   "jp": "{v:0049}そのために数百年も眠る必要があるんだろ？{n}まったく実用的じゃないな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0100",
   "jp": "{FFF6}{v:004A}そうね。{n}だから、時空融合を解けば、{n}人々はモンスター化してこの世界は終わるわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0101",
   "jp": "{v:004B}この世界の人を見捨てるの！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0102",
   "jp": "{v:004C}ジャスティンはそれをやろうとしているわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0103",
   "jp": "{v:004D}どうして！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0104",
   "jp": "{v:004E}ジャスティンはこの世界の人が故郷に{n}攻め込む事を防ごうとしている。{n}どんな小さな可能性でもなくそうとしている。{p}{v:004F}またヴェンツェルみたいな野心家が生まれないとも{n}限らないから、この世界の人間を全て滅ぼそうと{n}考えているのよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0105",
   "jp": "‥‥{v:0050}ヴェンツェルが死んだ今、{n}侵略を企む奴なんて、もういないのにな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0106",
   "jp": "{FFF6}{v:0051}そうなの。{n}だから私はジャスティンの考えについて{n}いけなくなった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0107",
   "jp": "なんと答えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0108",
   "jp": "・ヤツを止めよう",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0109",
   "jp": "・ヤツは帰りたいだけでは？",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0110",
   "jp": "{v:0052}うん！{n}この世界の人を助けないと！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0111",
   "jp": "{v:0053}帰りたい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0112",
   "jp": "{v:0054}そうなのかもしれない。{p}{FC02}{v:0055}だけど、自分が故郷に帰るためにこの世界の人々、{n}全員を危険にさらすわけにはいかないわ。{p}{FC03}{v:0077}それに、私たちのいた時代から{n}もう数百年も経っている‥‥、{n}今更帰ったって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0113",
   "jp": "{v:0056}私は、ジャスティンのやり方についていけない。{n}お願い、ジャスティンを止めるのに、力を貸して！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0114",
   "jp": "{v:0057}ありがとう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0115",
   "jp": "{v:0058}貸すも何も、俺たちだって奴を止めないと、{n}自分たちが危ないわけだからな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0116",
   "jp": "{v:0059}りがいのいっち、ってヤツよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0117",
   "jp": "{v:005B}えぇぇっ！？{n}どうして？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0118",
   "jp": "{v:005C}そうだよ、お兄ちゃん！{n}私たち、ジャスティンさんを止めないと{n}死んじゃうんだよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0119",
   "jp": "{v:005D}そうよ！{n}りがいのいっち、ってヤツでしょ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0120",
   "jp": "{v:006C}それじゃ、まずはキミの身体を治すことが先決ね。{n}さあ、奥に行きましょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0121",
   "jp": "{v:006D}奥に？{n}やっぱりこの中にはお兄ちゃんを{n}助ける方法があるの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0122",
   "jp": "{v:006E}ええ。{n}私ならそれを作ることが出来るわ。{n}というわけで、私を連れて行ってちょうだい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0123",
   "jp": "　{n}　　　　　{FFEF}アメリアが仲間になった！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0124",
   "jp": "{FFF6}{v:006A}それじゃ、これからよろしく頼むね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0125",
   "jp": "{v:006F}それじゃ、パーティーを編成し直そうぜ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0126",
   "jp": "{v:006A}それじゃ、これからよろしく頼むね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0127",
   "jp": "奥へ行くのね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0128",
   "jp": "アメリアをパーティーに加えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0129",
   "jp": "誰をメンバーから外しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0130",
   "jp": "・{s:FFED}",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0131",
   "jp": "・{s:FFEE}",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0132",
   "jp": "{s:FFED}の装備を回収しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0133",
   "jp": "　{n}　　　　　　{FFEF}アメリアが仲間になった！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0134",
   "jp": "{v:0064}あ、やっぱりアタシが必要？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0135",
   "jp": "{v:0063}ん？　やっぱり僕に来て欲しいのかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0136",
   "jp": "{v:0065}私も連れていってくれるんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0137",
   "jp": "{v:0066}僕を連れていってくれるんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0138",
   "jp": "{v:0067}パーティー構成は慎重に行うべきだと思う。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0139",
   "jp": "ジュリアンをパーティーに加えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0140",
   "jp": "{v:0070}このメンバーでいいの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0141",
   "jp": "アタシは学院に戻って、{n}何かお兄さまのお力になれることがないか{n}探してみますね★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0142",
   "jp": "僕はいったん魔法学院に戻るよ。{n}色々と残してきた研究もあるしね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0143",
   "jp": "私はバーンシュタインに戻る。{n}陛下や国民たちのことも心配だからな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0144",
   "jp": "{v:0071}それじゃ、出発しましょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0145",
   "jp": "じゃ、だれを連れていくの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0146",
   "jp": "現在、調査中です。{n}しばらくしてから、お越し下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0147",
   "jp": "外には出てきませんが、内部でまた動きがある様です。{n}腕試しもかねて、調査なさいますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0148",
   "jp": "ところで、準備はよろしいのですか？{n}一度降りると、なかなか帰ってこられませんよ。{n}それでも行くと言うのなら、お気をつけて、どうぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0149",
   "jp": "お気をつけて、どうぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0150",
   "jp": "みんなを放って、どこ行く気よ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0151",
   "jp": "アメリアさんを連れて行かないと{n}意味ないでしょうが！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0152",
   "jp": "ちょっと待って！{n}アメリアさんを放って行っていいの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0153",
   "jp": "{v:0003}あの影は！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0154",
   "jp": "{v:0004}やっぱりここなのね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0155",
   "jp": "‥‥‥{v:0005}ダメ。{p}{v:0006}ゲヴェルの思念波が強すぎて、{n}完全に遮断できない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0156",
   "jp": "{v:0007}ルイセちゃんの能力でもダメなのか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0157",
   "jp": "{v:0008}さすが本体の近くだと勝手が違うか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0158",
   "jp": "{v:0009}簡単だ。{n}全部ブチ殺せばいい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0159",
   "jp": "‥‥{v:000A}力ずくで通るのみ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0160",
   "jp": "{v:000B}でも、引くことは出来ませんね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0161",
   "jp": "{v:000C}ここで怯んではいられませんね。{n}がんばりましょう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0162",
   "jp": "{v:000E}なんだ？{n}行き止まりか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0163",
   "jp": "{v:000F}う～ん‥‥。{n}何か仕掛けがあるのかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0164",
   "jp": "{v:0010}うわぁっ！{n}ナニ、コレェ！？{n}こっち見てるぅ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0165",
   "jp": "{v:0017}リシャールの言っていたものはどれなんだ？{n}ここ全体がゲヴェルの体内なんだろ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0166",
   "jp": "{v:0018}ねぇ、アンタさ、ここに入ってから、{n}何か身体に変化は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0167",
   "jp": "・良い気がする",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0168",
   "jp": "・変わらない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0169",
   "jp": "{v:0019}えっ、本当！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0170",
   "jp": "{v:001A}よし、それじゃ、{n}もっと奥まで行ってみようぜ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0171",
   "jp": "{v:001B}そうかぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0172",
   "jp": "{v:001C}だったら、もっと奥まで行ってみようぜ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0173",
   "jp": "もう移動できないようだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0174",
   "jp": "この穴は活動を再開しているようだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0175",
   "jp": "　{n}　　　　　　　　開かない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0176",
   "jp": "～フライシェベルグ～第１階層",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0177",
   "jp": "　{n}　　　　　　　開かない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0178",
   "jp": "『{FFEF}トリニトレイト{FFF1}』を見つけたが、{n}これ以上、持つことはできない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0179",
   "jp": "　{n}　　　　『{FFEF}トリニトレイト{FFF1}』を手に入れた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0180",
   "jp": "『{FFEF}秘伝書{FFF1}』を見つけたが、{n}これ以上、持つことはできない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0181",
   "jp": "　{n}　　　　　　『{FFEF}秘伝書{FFF1}』を手に入れた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0182",
   "jp": "『{FFEF}シャドーブレイド{FFF1}』を見つけたが、{n}これ以上、持つことはできない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0183",
   "jp": "　{n}　　　『{FFEF}シャドーブレイド{FFF1}』を手に入れた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0184",
   "jp": "『{FFEF}天女の羽衣{FFF1}』を見つけたが、{n}これ以上、持つことはできない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0185",
   "jp": "　{n}　　　　　『{FFEF}天女の羽衣{FFF1}』を手に入れた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0186",
   "jp": "～フライシェベルグ～第２階層",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0187",
   "jp": "こちらからは開かない。{n}一方通行のようだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0188",
   "jp": "　{n}　　　　鍵を{FFEF}４つ{FFF1}手に入れた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0189",
   "jp": "{v:0012}鍵？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0190",
   "jp": "　{n}　　　　　　{v:0013}‥鍵‥鍵‥数‥少ない‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0191",
   "jp": "　{n}　　　　　　{v:0014}‥部屋‥部屋‥数‥多い‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0192",
   "jp": "　{n}　　　　　　{v:0015}‥鍵‥鍵‥使う‥減る‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0193",
   "jp": "　{n}　　　　　　{v:0016}‥部屋‥部屋‥仕掛け‥楽‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0194",
   "jp": "{v:0017}ん～？{n}何の事かしら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0195",
   "jp": "{v:0011}敵よ！{n}みんな、がんばって！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0196",
   "jp": "床に鍵穴のような物が{FFEF}２つ{FFF1}開いている。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0197",
   "jp": "鍵を２つ使いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0198",
   "jp": "　{n}　　　　　　　鍵を持っていない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0199",
   "jp": "　{n}　　　　　　　　鍵が足りない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0200",
   "jp": "『{FFEF}エストック{FFF1}』を見つけたが、{n}これ以上、持つことはできない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0201",
   "jp": "　{n}　　　　　『{FFEF}エストック{FFF1}』を手に入れた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0202",
   "jp": "床に鍵穴のような物が{FFEF}１つ{FFF1}開いている。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0203",
   "jp": "鍵を１つ使いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0204",
   "jp": "敵よ！{n}みんな、頑張って！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0205",
   "jp": "鍵穴が上下に２つある。{n}鍵を使いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0206",
   "jp": "・上の鍵穴へ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0207",
   "jp": "・下の鍵穴へ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0208",
   "jp": "・上下、２つの鍵穴へ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0209",
   "jp": "・使わない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0210",
   "jp": "床に鍵穴が１つある。",
   "en": "",
   "term": "end"
  },
