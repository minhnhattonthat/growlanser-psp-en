 "entries": [
  {
   "id": "scen175.0000",
   "jp": "",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen175.0001",
   "jp": "バーンシュタイン兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen175.0002",
   "jp": "魔術師",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen175.0003",
   "jp": "看守",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen175.0004",
   "jp": "調理人",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen175.0005",
   "jp": "王母アンジェラ",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen175.0006",
   "jp": "{s:0160}王城",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0007",
   "jp": "おい、どこへ行くんだ？{n}これからの方針を立てるために、{n}まずは{s:0004}王と相談をすべきだろう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0008",
   "jp": "アンタ、どこへ行こうって言うのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0009",
   "jp": "陛下のことをよろしくお願いします！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0010",
   "jp": "陛下が中でお待ちです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0011",
   "jp": "そんな事をしてる暇はないでしょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0012",
   "jp": "{s:000A}様、{n}この武器をお持ちください。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0013",
   "jp": "　{n}　　シルバーランスをこれ以上持てなかった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0014",
   "jp": "すまない、{s:0154}。{n}その武器は、これ以上持てないようだ。{n}気持ちだけありがたく受け取っておこう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0015",
   "jp": "そうでしたか‥‥。{n}それは残念ですが、仕方ありませんね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0016",
   "jp": "　{n}　　　　　『{FFEF}シルバーランス{FFF1}』を手に入れた。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0017",
   "jp": "‥‥これは、私が愛用していた武器‥‥。{p}{FFF6}驚いた。{n}とっくに廃棄されたものだと思っていたよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0018",
   "jp": "この武器は、かつて{s:000A}様が{n}国民たちのために力をふるった証‥‥。{n}{FFFB}それを、やすやすと廃棄できる訳がありません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0019",
   "jp": "ふっ‥‥。{n}それを再び手にするというのは、責任重大だな。{p}ありがとう、大事に使わせてもらうよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0020",
   "jp": "{FFF6}{s:0154}、お前の心遣いに改めて感謝する。{n}私は、本当に良い友人を持った。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0021",
   "jp": "{FFF6}勿体なきお言葉‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0022",
   "jp": "では、行ってくる！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0023",
   "jp": "皆様のご武運をお祈りします。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0024",
   "jp": "何の罪もない人々を襲おうとするとは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0025",
   "jp": "{s:0160}城は、{n}私が命に変えても死守してみせます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0026",
   "jp": "{s:000A}様のこと、感謝している。{p}お前は、我が友を救ってくれた恩人だ。{n}この恩、一生忘れることはないだろう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0027",
   "jp": "私はナイツの誇りにかけて、{s:00AE}を守ってみせる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0028",
   "jp": "牢の中にいる{s:000A}様が、{n}日に日に衰弱されている。{n}そのお姿を見るのが、私には辛い‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0029",
   "jp": "{s:0161}城の下から{s:0119}を解放したと{n}思われる３人組のことだが‥‥。{p}そいつらは、{s:0119}がそこに眠っていることを{n}どこで知ったのだろうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0030",
   "jp": "あの衝撃‥‥‥。{n}ただの地震ではないな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0031",
   "jp": "{s:000A}様、どうぞこの防具をお持ちください。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0032",
   "jp": "　{n}　　　　ナイツの鎧をこれ以上持てなかった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0033",
   "jp": "すまない、{s:0151}。{n}その防具は、これ以上持てないようだ。{n}気持ちだけありがたく受け取っておこう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0034",
   "jp": "‥‥そうですか。{n}残念ですが、そういう理由なら彼も納得するでしょう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0035",
   "jp": "ん‥‥？{n}それはどういう意味だ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0036",
   "jp": "　{n}　　　　　　『{FFEF}ナイツの鎧{FFF1}』を手に入れた。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0037",
   "jp": "ありがとう、{s:0151}。{n}大事に使わせてもらうよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0038",
   "jp": "そう言って頂けると幸いです。{n}きっと、彼も喜んでいるはずですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0039",
   "jp": "なんと言いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0040",
   "jp": "・{s:0153}が用意した",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen175.0041",
   "jp": "・言わぬが花",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen175.0042",
   "jp": "・黙っている",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen175.0043",
   "jp": "さすが、鋭いですね。{p}{FC00}{s:000A}様の大事な門出に、{n}武器と防具をそれぞれ用意しようと提案したのは{n}{s:0154}なんですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0044",
   "jp": "ゴ‥‥ゴホン！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0045",
   "jp": "{FFF6}ふっ‥‥。{n}なるほど、そういう事か。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0046",
   "jp": "ありがとう、これは大事に使わせてもらうよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0047",
   "jp": "‥‥その心遣いに感謝しよう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0048",
   "jp": "皆様、お気をつけて。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0049",
   "jp": "{s:0160}王都以外の闇落としも、{n}絶対に阻止しなければならないね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0050",
   "jp": "{s:000A}様の実力は保証するよ。{n}なんと言っても、僕らインペリアル・ナイツの{n}指揮をとっていたお方だからね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0051",
   "jp": "どんなものが相手だろうと、僕はこの国‥‥、{n}いや、この大陸の平和を守ってみせるよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0052",
   "jp": "{s:000A}様の衰弱が激しくなっている。{n}{FFFB}だけど、どうすればいいのか{n}僕たちには手立てが分からないんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0053",
   "jp": "{s:0154}も言ってる通り、{n}謎の３人組の{s:012A}的が気になるね。{p}１人のフェザリアンが荷担しているらしい、{n}というのも引っかかるな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0054",
   "jp": "嫌な予感がするな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0055",
   "jp": "くっ‥‥、{s:0136}相手に直接{n}立ち向かうことが出来れば‥‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0056",
   "jp": "{s:0153}のあんな嬉しそうな顔は、{n}久しぶりに見た気がするな。{n}お前たちのおかげだ、礼を言うよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0057",
   "jp": "これ以上、国民に不安を与えてはおけぬ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0058",
   "jp": "ラシェルの一報は受けている。{n}まさか、こんな事態になるなんてな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0059",
   "jp": "{s:0024}‥‥。{n}惜しい方を亡くしたものだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0060",
   "jp": "何が起こったんだ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0061",
   "jp": "私の力が必要か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0062",
   "jp": "でもこれ以上は多すぎるよ。{n}誰かを仲間から外さないと。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0063",
   "jp": "誰をメンバーから外しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0064",
   "jp": "・{s:FFED}",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen175.0065",
   "jp": "・{s:FFEE}",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen175.0066",
   "jp": "{s:FFED}の装備を回収しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0067",
   "jp": "　{n}　　　　{FFEF}{s:0008}が仲間になった！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0068",
   "jp": "頼りにしてくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0069",
   "jp": "早く平和を取り戻したい‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0070",
   "jp": "全員そろったようですね。{n}では、今後の方針について作戦を立てましょう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0071",
   "jp": "早速だけど、皆に話したいことがあるの。{n}いいかしら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0072",
   "jp": "{s:0136}のことか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0073",
   "jp": "ええ。{p}{FFF6}現在、{s:0136}は機能を取り戻した{n}時空制御塔を拠点としているわ。{n}{FFFB}{FFF7}その理由が、何だか分かる？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0074",
   "jp": "時空制御塔を拠点とする理由は、何だと思いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0075",
   "jp": "・移動が楽だから",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen175.0076",
   "jp": "・敵からの攻撃を受けない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen175.0077",
   "jp": "・各地に闇落としが出来る",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen175.0078",
   "jp": "・わかりません",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen175.0079",
   "jp": "{FFF6}まぁ‥‥、確かに楽ではあるけどね。{n}{FFFB}{FC02}{FFF7}でも、もっと別の理由よ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0080",
   "jp": "確かにそれもあるけど、{n}もっと別の理由よ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0081",
   "jp": "正解、その通りよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0082",
   "jp": "もしかして、時空の歪みを大きくさせるためか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0083",
   "jp": "ええ、その通りよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0084",
   "jp": "{s:0136}が闇落としを行うことによって、{n}時空の歪みはどんどん大きくなっていくわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0085",
   "jp": "そうやって時空の完全分離を促進しつつ、{n}この世界の人たちを滅ぼそうとしてるわけ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0086",
   "jp": "卑劣な男め‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0087",
   "jp": "ホント、なんて男なの！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0088",
   "jp": "そんなやつ、塔から引きずり下ろして{n}アタシのキックでボコボコにしてやるんだから！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0089",
   "jp": "彼の思惑通りにさせる訳にはいきませんね。{n}これ以上の犠牲者は、絶対に出させません！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0090",
   "jp": "さいわい、塔はまだ機能が完全回復してないわ。{n}‥‥けれど、それも時間の問題ね。{p}私の計算だと、そろそろ塔が動き始める頃よ。{n}早急に手を打って、{n}{s:0136}の計画を阻止しないといけないわ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0091",
   "jp": "でも、いつ、どこに闇が落とされるかなんて{n}分からないのに、どうやって対処すればいいのよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0092",
   "jp": "方法はあるわ。{n}{FFFB}魔法学院の屋上にある時空観測計で、{n}歪みの数値が大きい場所を特定すればいいのよ。{p}とにかく、今は現状把握が第一ね。{n}その後の対策については、魔法学院で考えましょう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0093",
   "jp": "お兄ちゃん、早く魔法学院に行こう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0094",
   "jp": "おい、私も連れていけ。{p}さっそく恩を返すチャンスが来たと言うことだ。{n}インペリアル・ナイトマスターの力、伊達ではないぞ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0095",
   "jp": "そうですね、{s:000A}の実力は折紙つきです。{n}きっと、みなさんの役に立ってくれるでしょう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0096",
   "jp": "うん、わかった。{n}よろしくね、{s:000A}！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0097",
   "jp": "　{n}　　　　{FFEF}{s:000A}が仲間になった！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0098",
   "jp": "みなさん、頑張ってください！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0099",
   "jp": "闇落としを阻止せよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0100",
   "jp": "ついに、{s:0136}の攻撃が始まったようですね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0101",
   "jp": "みなさんなら、他の場所も必ず{n}闇から救ってくれると信じています！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0102",
   "jp": "{s:000A}のこと、よろしくおねがいしますね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0103",
   "jp": "これ以上の被害は、{n}絶対に出すわけにはいきません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0104",
   "jp": "先ほど{s:014B}様から連絡があって、{n}お話はうかがってます。{p}{s:000A}は地下牢にいますから、{n}どうぞ行ってください。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0105",
   "jp": "‥‥手がかりは見つかりましたか？{n}{FFFB}どうぞ、お気をつけて。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0106",
   "jp": "保養地ラシェルで、闇落としという事件が{n}発生したと聞きました。{p}{FC02}信じたくない話ですが、これは我々にとっても{n}深刻な問題です。{p}人々の平和のために、一刻も早い対処をせねば{n}なりませんね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0107",
   "jp": "まさか、{s:0119}が{s:0161}城の下にも{n}眠っていたなんて‥‥。ショックですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0108",
   "jp": "せっかく、祝賀会の最中でしたのに‥‥。{n}なにがあったんでしょうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0109",
   "jp": "私は持ち場を離れるわけにはいきませんので、{n}よろしくお願いします。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0110",
   "jp": "私語は禁じられているので‥‥。{n}申し訳ございません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0111",
   "jp": "私はフライシュベルグの前で待ってるわ。{n}状況がどうなるか分からないから、{n}早く戻って来てね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0112",
   "jp": "陛下のお友達の方ですね。{n}ごゆっくりしていって下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0113",
   "jp": "この城のいたる所には{n}魔法を防ぐような仕掛けがしてあります。{p}回復魔法などなら大丈夫ですが、{n}強い魔力を感知すると、{n}かき消されてしまうことがあります。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0114",
   "jp": "‥‥出番を待っている。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0115",
   "jp": "何かあったら、{n}謁見の間へ駆けつけられるように、{n}ここに詰めているのよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0116",
   "jp": "‥‥精神を集中しているんだ。{n}話しかけないでくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0117",
   "jp": "ここの待機は当番制なんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0118",
   "jp": "ここは{s:005C}の待機室ですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0119",
   "jp": "もう少しで交替か‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0120",
   "jp": "{v:0040}お帰りなさい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0121",
   "jp": "{v:0041}久しぶりの外の空気はうまかっただろう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0122",
   "jp": "{v:0042}ああ、{s:0160}は良い国だ。{n}我が命をかけて守るに値する、{n}良い国だとわかったよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0123",
   "jp": "翌朝",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0124",
   "jp": "{v:0016}{s:000A}さん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0125",
   "jp": "{v:0017}君たちに礼を言おう。{n}おかげで牢を出ることが出来た。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0126",
   "jp": "{v:0018}うんうん、良かったね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0127",
   "jp": "{v:0019}そんなキミに、{n}もう１つ願いがあるんだが‥‥聞いてくれるか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0128",
   "jp": "{v:001A}とりあえず話だけは聞くけど、{n}ムリなことだったら聞くだけムダになるよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0129",
   "jp": "{v:001B}ムリなことではない。{n}しばらく牢に入っていたのでな、{n}久々に街を歩いてみたいのだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0130",
   "jp": "{v:001C}街を‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0131",
   "jp": "{v:001D}私が外出できるのは、君たちに協力するときだけだ。{n}自由に外出するわけにはいかないからな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0132",
   "jp": "{v:001E}お兄ちゃん、どうする？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0133",
   "jp": "なんと答えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0134",
   "jp": "・断る",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen175.0135",
   "jp": "・協力する",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen175.0136",
   "jp": "{FFF6}‥‥{v:001F}そうか‥‥。{n}仕方ないな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0137",
   "jp": "{v:0020}そんな、お兄ちゃん。{n}考え直してあげてよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0138",
   "jp": "{v:0021}ありがとう。{n}恩に着る。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0139",
   "jp": "{v:0022}あまり大勢で歩くのも何だから、{n}お兄ちゃんと２人で行ってきて。{n}わたしたち、ここで待ってるから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0140",
   "jp": "{v:0023}一応、アタシはついて行くね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0141",
   "jp": "　{n}　　　　　　{FFEF}{s:000A}が同行者になった！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0142",
   "jp": "そういえば、これからの方針について{n}{s:0004}王が相談したいと言っていたぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0143",
   "jp": "そうだな。{n}１度、みんなで話し合ったほうが{n}いいだろう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0144",
   "jp": "あまり大勢で歩くのも何だし、{n}{s:000A}さんと２人で行ってきなよ。{n}わたしたちはここで待ってるね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0145",
   "jp": "お前にも良い息抜きになるだろう。{n}俺たちのことは気にせず、行ってこい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0146",
   "jp": "いってらっしゃい、お兄さま！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0147",
   "jp": "せっかくだし、ゆっくりしてくるといいよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0148",
   "jp": "つかのまの休息、楽しんできてくださいね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0149",
   "jp": "この機会に、おまえも{s:0160}という国を{n}よく見てくるといい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0150",
   "jp": "指輪があれば、キミも{s:000A}も大丈夫。{n}体のことは気にせず、羽を伸ばしてきなさい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0151",
   "jp": "お気をつけて。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0152",
   "jp": "ここはお客様用の待合室です。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0153",
   "jp": "ここは普通の図書室です。{n}{s:005C}やこの国の学者が利用したりします。{p}今はがらがらですけどね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0154",
   "jp": "異常はありません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0155",
   "jp": "あっ、待ってください！{n}{FFFB}みなさんお疲れでしょうから、{n}良かったら今晩は泊まっていってください。{p}明日になれば、{s:000A}も牢を出れますし。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0156",
   "jp": "そうだな‥‥。{n}{FFFB}せっかくだし、ご厚意に甘えて{n}今夜はここで１泊させてもらおう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0157",
   "jp": "すまないが、僕は学院の方に戻らせてもらうよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0158",
   "jp": "どうしたの、{s:0003}さん？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0159",
   "jp": "グローシュと相対する闇の存在デュンケルス‥‥。{n}{FFFB}これについて、今は分かってないことが多すぎる。{p}だから、僕はデュンケルスについて詳しく{n}調べてみようと思うんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0160",
   "jp": "デュンケルスについて調べる？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0161",
   "jp": "ああ。{n}{FFFB}デュンケルスの特性など詳しいことが分かれば、{n}今後、君たちの行動の役に立つだろう？{p}例えば、{n}デュンケルスを引き寄せるような機械があれば、{n}人々が触れる前に除去できる‥‥、とかね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0162",
   "jp": "なるほど！{n}期待してるね、{s:0003}さん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0163",
   "jp": "ありがたいことに、{n}{s:0006}君も手伝いを名乗り出てくれたからね。{n}期待に応えられるよう、一緒に頑張るよ。{p}{FC00}キミたちも頑張ってくれ、応援している。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0164",
   "jp": "　{n}　　　　　{s:0003}の装備を回収した。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0165",
   "jp": "あ、お兄さま‥‥。{p}ごめんなさい、アタシ‥‥{n}{FFFB}{FFF6}お兄さまにお別れを言わなくちゃいけないんです！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0166",
   "jp": "ど、どうしたのよ、急に？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0167",
   "jp": "でもアタシ、お兄さまと離れ離れになっても、{n}ずっとお兄さまのこと‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0168",
   "jp": "だから、一体どうしたのよ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0169",
   "jp": "{FFF6}アタシ、きっと星空を眺めるたびに{n}お兄さまのことを想って{n}寂しさで涙するんだわ‥‥。{p}{FFF7}{FC05}ああ、お兄さま‥‥。{n}{FFFB}{FFF6}あなたは今、{n}どこで何をしていらっしゃるの‥‥！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0170",
   "jp": "{FFEC}　　人の話を聞け！{FFED}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0171",
   "jp": "ふみぃ‥‥。痛いぃ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0172",
   "jp": "そんなこと聞いてないわよ！{n}で、何でお別れなの！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0173",
   "jp": "実は{s:0003}先輩が、デュンケルスの特性について{n}もっと詳しいことを調べてみるって言ってて。{n}私は、それのお手伝いをしようと思うんです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0174",
   "jp": "デュンケルスの特性？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0175",
   "jp": "デュンケルスの特性が分かれば、{n}お兄さまたちの行動のお役に立てるかなって★{p}{FC00}例えば、デュンケルスを引き寄せるような{n}機械があれば、人々が触れる前に{n}除去できるかもですし。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0176",
   "jp": "なるほど、それはいい考えね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0177",
   "jp": "‥‥ってコレ、{n}{s:0003}先輩の言葉なんですけどね[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0178",
   "jp": "{FB00}どーせ、そんなことだろうと思ったわ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0179",
   "jp": "お兄さまのお手伝い、出来なくてごめんなさい！{n}{FFFB}{FC00}でも、お兄さまたちのこと応援してますから！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0180",
   "jp": "うん、{s:0006}も頑張りなさいよね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0181",
   "jp": "　{n}　　　　　{s:0006}の装備を回収した。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0182",
   "jp": "陛下、私は謁見の間にて待機しております。{n}何かありましたら、お呼びください。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0183",
   "jp": "ご苦労様でした、{s:0008}。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0184",
   "jp": "それでは、失礼いたします。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0185",
   "jp": "　{n}　　　　　{s:0008}の装備を回収した。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0186",
   "jp": "みなさんの部屋はもう用意してありますから、{n}どうぞこちらへ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0187",
   "jp": "‥‥{v:0000}お前たちか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0188",
   "jp": "・大丈夫か？",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen175.0189",
   "jp": "・元気そうだな",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen175.0190",
   "jp": "・つらそうだな",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen175.0191",
   "jp": "‥‥{v:0001}この姿を見て、大丈夫だと思うか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0192",
   "jp": "‥‥{v:0002}この姿を見て、そう見えるなら、{n}病院に行った方がいいぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0193",
   "jp": "‥‥{v:0003}当たり前だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0194",
   "jp": "{v:0004}お前も{s:0119}様に作られた存在なら、{n}この苦しみはわかるだろう。{n}ずっと絶食しているようなものだからな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0195",
   "jp": "{v:0005}{s:000A}さん。{n}あなたやお兄ちゃんを助けるには、{n}どうすればいいんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0196",
   "jp": "{v:0006}そんな方法があるなら、とっくに試しているさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0197",
   "jp": "‥‥{v:0007}うぅ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0198",
   "jp": "{v:0008}だが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0199",
   "jp": "{v:0009}だが‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0200",
   "jp": "{FFF6}{v:000A}城の北の方に何かを感じる。{n}もし、あそこに行ければ、{n}今よりだいぶマシになれそうな気がする。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0201",
   "jp": "{v:000B}ここから北か‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0202",
   "jp": "・北にはグローシュが多い",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen175.0203",
   "jp": "・わからない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen175.0204",
   "jp": "・{s:0119}の造った居城だ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen175.0205",
   "jp": "{v:000C}それはそうだけど、{n}{s:0119}はグローシュが苦手なんでしょ？{n}違うんじゃないかなぁ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0206",
   "jp": "{v:000D}う～ん、ここから北だと‥‥、{n}{s:0119}と戦ったところくらいだよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0207",
   "jp": "{v:000E}それか！{n}たしかに、あそこなら{s:0119}の波動が{n}残っているかもしれないな！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0208",
   "jp": "{v:000F}そうだね！{n}行ってみようよ！{p}{v:0010}{s:000A}さん、待っていてくださいね！{n}すぐに行ってきます！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0209",
   "jp": "{FFF6}‥‥{v:0011}ふん‥‥期待しないで待っているよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0210",
   "jp": "フライシェベルグ探索",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0211",
   "jp": "‥‥{v:0000}ん？{n}‥‥お前たち‥‥その波動は‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0212",
   "jp": "{v:0001}{s:0009}さんが、{n}{s:0119}波動の出る指輪を作ってくれたんだよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0213",
   "jp": "‥‥{FFF6}{v:0002}ふぅ‥‥。{n}これが生き返った心地というやつだろうな‥‥。{p}{FFF7}{v:0003}命を救われたこの恩は{n}一生忘れることはないだろう。{p}{v:0004}この牢から出られるのなら、{n}お前たちに力をかせるのだが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0214",
   "jp": "{v:0005}では、ここから出られるようにしましょう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0215",
   "jp": "{v:0006}エ、{s:0004}君‥‥じゃなかった、{n}{s:0004}王‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0216",
   "jp": "{v:0007}色々と考えてみたんです。{p}{v:0008}{s:000A}が王位についていた頃の{n}{s:0160}がどうだったのかとか。{p}{v:0009}彼は悪政を強いたこともありません。{p}{v:000A}インペリアル・ナイツを束ねるマスターとしても、{n}その名に負けぬ立派な人だということは{n}誰もが知っていること。{p}{v:000B}そこで僕は{s:000A}をインペリアル・ナイトの{n}１人として、迎えたいと思います。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0217",
   "jp": "{v:000C}おい、いいのか？{n}仮にも私は{s:0166}に{n}戦争をしかけたのだぞ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0218",
   "jp": "{v:000D}たしかに{s:0166}と戦争になったことなども{n}ありますが、今ではそれが{s:0119}の仕業だと、{n}関係者の誰もが知っています。{p}{FC02}{v:000E}僕は{s:0160}の王として、{n}{s:000A}に命じます。{p}{v:000F}{s:0160}と、この世界のために、{n}この者たちに協力しなさい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0219",
   "jp": "{FFF6}‥‥‥{v:0010}ふっ。{n}王としての風格が出てきたか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0220",
   "jp": "{v:0011}はっ。{n}{s:0004}王のご命令のままに。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0221",
   "jp": "{v:0012}よかったね、{s:000A}さん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0222",
   "jp": "{v:0013}他の者への説明などしなければなりませんから、{n}実際に{s:000A}が牢を出られるのは{n}明日以降になります。{p}{v:0014}ですが、彼の力が必要なら、{n}いつでもこの城に来てください。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0223",
   "jp": "{v:0015}これで一段落だな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0224",
   "jp": "新たな仲間{s:000A}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0225",
   "jp": "これからよろしく頼むよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0226",
   "jp": "‥‥{v:00A3}{s:000A}、大丈夫？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0227",
   "jp": "‥‥{v:00A4}{s:0119}が死んだようだな‥‥。{n}まるで自分の身体じゃないように、{n}力が入らん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0228",
   "jp": "{v:00A5}{s:000A}さん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0229",
   "jp": "{v:00A6}少し、その男と２人にしてくれるか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0230",
   "jp": "‥‥{v:00A7}あ、うん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0231",
   "jp": "{v:00A8}アタシも、行ってたほうが良いよね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0232",
   "jp": "{v:00A9}言いたいことの察しは付いているか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0233",
   "jp": "・はい",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen175.0234",
   "jp": "・いいえ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen175.0235",
   "jp": "{FFF6}{v:00AA}そうか‥‥。{n}覚悟は出来ているか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0236",
   "jp": "{v:00AB}わからぬか‥‥。{n}ならばハッキリ言おう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0237",
   "jp": "{v:00AC}私のこの姿を見ておけ。{n}これがお前の未来の姿だ。{p}{v:00AD}自分の命の源である{s:0119}を倒したのだ。{n}お前も遠からず、こうなる‥‥。{p}{FFF6}{v:00AE}作られた存在である我々には、{n}それに抗う手段はない‥‥。{n}奇跡でも起きぬ限りはな‥‥。{p}{v:00AF}覚悟はしていたが‥‥いざその時が来ると、{n}堪えるぞ‥‥。{p}{FFF7}{v:00B0}だが、もう時間は戻せん。{n}覚悟しておけ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0238",
   "jp": "{v:00B1}あ、もういいの？{n}それじゃ、行こうか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0239",
   "jp": "覚悟しておけ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0240",
   "jp": "ここでは魔法の研究などをしている。{n}あまり邪魔などなさらぬよう、お願いします。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0241",
   "jp": "魔法を研究しているのは{n}魔法学院だけではありませんわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0242",
   "jp": "時には文献をあさり、{n}様々な事件のきっかけを探すのですわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0243",
   "jp": "勇ましき、小さき者の可能性を信じ、{n}ここに力を封ず。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0244",
   "jp": "　{n}　　　　『{FFEF}{s:000E}の可能性７{FFF1}』を手に入れた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0245",
   "jp": "料理は盛りつけまでが芸術なんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0246",
   "jp": "ふんふん♪{n}オイラは～、お城の～♪{n}おかかえ、コック～♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0247",
   "jp": "早く焼けないかしら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0248",
   "jp": "{s:0004}をよろしくお願いします。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0249",
   "jp": "他人の国へ来ているんだぞ。{n}礼儀を重んじるのも騎士のつとめだ。{p}テレポートを使いたいなら、{n}城の外へ出てからにしろ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen175.0250",
   "jp": "　{n}　　　　不思議な力でかき消された‥‥。",
   "en": "",
   "term": "end"
  }
 ]
}
