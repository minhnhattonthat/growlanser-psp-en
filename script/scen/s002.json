  },
  {
   "id": "scen002.0010",
   "jp": "ティピ",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen002.0011",
   "jp": "張り紙",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen002.0012",
   "jp": "行商人",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen002.0013",
   "jp": "ＬＬＭ魔法教室講師",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen002.0014",
   "jp": "レティシア姫",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen002.0015",
   "jp": "ローランディア兵隊長",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen002.0016",
   "jp": "ローランディア兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen002.0017",
   "jp": "オズワルド",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen002.0018",
   "jp": "エリオット",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen002.0019",
   "jp": "あれ？{n}ねぇ、あの人って確か‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0020",
   "jp": "ん‥‥？{FFFB}{n}おお、キミたちは！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0021",
   "jp": "フェザリアン研究家のダニーさんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0022",
   "jp": "あの時はありがとうございました。{n}今日は、{s:0158}に何かご用ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0023",
   "jp": "実は、最近{s:0166}国内で{n}フェザリアンを見かけるという哮を聞いてね。{p}気になって来てみたんだが、{n}キミたち、何か情報を知らないかい？{n}哮によると、長髪の若い女性らしいのだが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0024",
   "jp": "それって、{s:00C3}たちに襲われてた{n}フェザリアンさんのことかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0025",
   "jp": "おお、知っているのかね！{n}{FFFB}で、そのフェザリアンはいったいどこに？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0026",
   "jp": "アタシたちが出会ったのは、{n}確かグランシルの南の方だったよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0027",
   "jp": "グランシルの南だな！{p}さっそく行ってみるよ！{n}情報をありがとう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0028",
   "jp": "‥‥教えちまってよかったのか？{n}彼女は、人間を嫌ってるんだろう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0029",
   "jp": "{FB00}あう‥‥やっぱり、マズかった‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0030",
   "jp": "・マズイだろう",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen002.0031",
   "jp": "・別にマズくないだろう",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen002.0032",
   "jp": "・自分たちも行ってみよう",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen002.0033",
   "jp": "あうぅぅ～‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0034",
   "jp": "ねえ、お兄ちゃん。{n}わたしたちも行ってみようよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0035",
   "jp": "だ‥‥だよね、だよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0036",
   "jp": "それが良いかもしれないな。{n}人間とフェザリアンの間に{n}これ以上問題が起こったら大変だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0037",
   "jp": "くせ者？{n}それらしい者は見かけていないが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0038",
   "jp": "{v:0000}おお、姫を救出できたのか！{n}国王がお待ちだ！{n}早く中へ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0039",
   "jp": "お気をつけて！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0040",
   "jp": "これは{s:014B}様！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0041",
   "jp": "この者たちを王にお{s:012A}通りさせたいのです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0042",
   "jp": "承知しました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0043",
   "jp": "開門！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0044",
   "jp": "ここから先は用のない者は入れないよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0045",
   "jp": "どうぞ、お入り下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0046",
   "jp": "{v:004C}いらっしゃいませ。{n}スキマ屋へようこそ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0047",
   "jp": "{v:0054}これからもスキマ屋をよろしくね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0048",
   "jp": "ついに君も騎士になったか‥‥。{p}ま、君の功績を考えれば当然って感じだな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0049",
   "jp": "捕虜の命は君たちにかかっているんだ！{n}何としても頼んだよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0050",
   "jp": "‥‥{s:0166}は、のどかでいいよね。{p}{s:0160}や{s:0161}は、{n}どうも俺の性に合わないよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0051",
   "jp": "あれ？君たちの連れの人は‥‥{s:014B}様！？{p}そうか、薬を見つけられたのか。{n}それはよかった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0052",
   "jp": "こののどかな国を守るためにも、{n}君たちも頑張ってくれよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0053",
   "jp": "‥‥って思っていたけど、{n}{s:014B}様は城内で襲われたんだろ？{n}おお、怖い。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0054",
   "jp": "{s:014B}様！？{p}お元気になられたのですね、よかった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0055",
   "jp": "すぐ北に大きな城門があるだろ？{n}あれが{s:0166}の王城の門だよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0056",
   "jp": "そういえば、君仕官したんだって？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0057",
   "jp": "それにしても、あれだけの警備なのに、{n}賊はどうやって侵入したんだろう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0058",
   "jp": "いつになったら、平和になるのかしらね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0059",
   "jp": "ほんと、いい天気ね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0060",
   "jp": "{v:000D}いらっしゃいませ。{n}当店では、様々なグッズを取り扱っております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0061",
   "jp": "{v:000E}お買い求めですか？{n}それともご売却ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0062",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen002.0063",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen002.0064",
   "jp": "他にもご用はおありですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0065",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen002.0066",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen002.0067",
   "jp": "{v:0018}またどうぞ、お越し下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0068",
   "jp": "この頃さ、やけに事件が多くない？{n}{s:014B}様のことといい、戦争のことといい‥‥。{p}どうなっちゃうのかしらね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0069",
   "jp": "はぁ‥‥{s:00BD}の頃が懐かしいわね‥‥。{n}岬ではるか遠くを飛ぶフェザリアンを見た日も、{n}こんな晴れた空だったわ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0070",
   "jp": "城門は堅く閉ざされている‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0071",
   "jp": "　{FE1E}‥{FE1E}‥{FE1E}‥{FE1E}売れねぇなぁ{FE1E}‥{FE1E}‥。{FFFB}{n}　‥‥誰も来ねぇし‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0072",
   "jp": "　　特売品多数！{n}　　　アイテムショップ・ココ",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0073",
   "jp": "　　特売品多数！{n}　　　　スキマ屋",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0074",
   "jp": "マンホールの底には、何もないようだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0075",
   "jp": "店の前にあるマンホールだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0076",
   "jp": "マンホールがまるい形をしているのは、{n}向きがずれても落ちないためだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0077",
   "jp": "オイラ、すっごい魔法使いになるんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0078",
   "jp": "こいつ、またホラ吹いてるよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0079",
   "jp": "ホラじゃないよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0080",
   "jp": "うぅ‥‥。{n}なんか寂しいよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0081",
   "jp": "僕たち、デート中なんだ。{n}邪魔しないでくれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0082",
   "jp": "僕の彼女、ここを散歩するのが好きだったんだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0083",
   "jp": "私たち、デート中なの。{n}邪魔しないで！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0084",
   "jp": "あぁ‥‥。{n}これから私はどうしたらいいの‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0085",
   "jp": "{s:014B}様がお倒れになったらしいわね。{n}大したことじゃないといいのだけれど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0086",
   "jp": "あっ！？{n}{s:014B}様、お元気になられたのですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0087",
   "jp": "妖精ちゃん。{n}あなたも彼と一緒に頑張ってね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0088",
   "jp": "かわいい妖精ちゃん、お元気？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0089",
   "jp": "えへへ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0090",
   "jp": "やっと商店街の営業が始まったよ。{n}後で買い物にでも行こうかな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0091",
   "jp": "‥‥なんて、のんびりしてられないか。{n}今、隣国との戦争まっただ中だもんな‥‥。{p}ったく、なんてことしてくれたんだ。{n}この国のお偉いさんはさ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0092",
   "jp": "‥‥留守のようだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0093",
   "jp": "あら、私を訪ねてくれたの？{p}そう言えば、スキマ屋には行ってみた？{n}あそこのおじさん、商売熱心だから、{n}たまに新しい物が入ってたりするわよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0094",
   "jp": "{s:0159}村の{s:00A3}は私の叔父なのよ。{n}今でこそ、ぼ～っとして見えてるけど{n}昔はけっこう切れ者だったらしいわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0095",
   "jp": "あなたもお城に仕官したからには、{n}しっかりこの国を守ってよね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0096",
   "jp": "‥‥イマイチ信じられないけどね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0097",
   "jp": "‥‥話しかけちゃダメだよ。{n}オニに見つかっちゃうじゃない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0098",
   "jp": "へぇ～。{n}こんな所に出るんだ‥‥。{n}面白いね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0099",
   "jp": "アンタねぇ。{n}王都をウロウロしても、仕方ないでしょ？{n}さっさと家に戻りなさいよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0100",
   "jp": "さっきの男、宿の中に入ったのかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0101",
   "jp": "何を騒いでるんだい？{n}ここには、さっきから誰も入ってないよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0102",
   "jp": "じゃ、急いで他を探そう！{n}逃げられちゃうよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0103",
   "jp": "だからここにはいないんだってば！{n}早くしないと、逃げられちゃうでしょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0104",
   "jp": "みんなの所に戻ろう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0105",
   "jp": "うす汚れたマンホールだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0106",
   "jp": "新しいマンホールだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0107",
   "jp": "　{n}　　　　　南大通り商店街、営業中！！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0108",
   "jp": "今では兵隊さんが品物を買いに来て、大忙しだ。{n}ああ、忙しい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0109",
   "jp": "今ではお店にも品数が増えて大忙しだ。{n}ああ、忙しい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0110",
   "jp": "今はちょっと忙しいの。{n}悪いけど、また後にしてくれないかしら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0111",
   "jp": "覆面をした男？{n}アンタ達の探してる男かどうかわからないけど、{n}怪しい男ならここをまっすぐ走っていったよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0112",
   "jp": "あたしゃ戦争なんか嫌いだね。{n}だってさ、ひょっとしたら家の息子も駆り出される{n}かもしれないだろ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0113",
   "jp": "頑張るんだよっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0114",
   "jp": "{v:0034}本日はお買い求めですか？{n}それともご売却ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0115",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen002.0116",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen002.0117",
   "jp": "他にも何かおありでしょうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0118",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen002.0119",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen002.0120",
   "jp": "よく、ここへ来る方法がわかったな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0121",
   "jp": "{v:0019}おう、いらっしゃい。{n}ここは装備品を売ってる店だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0122",
   "jp": "{v:001B}買いに来たのか？{n}それとも何か売る気か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0123",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen002.0124",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen002.0125",
   "jp": "まだ何か用か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0126",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen002.0127",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen002.0128",
   "jp": "{v:0025}じゃあな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0129",
   "jp": "おお、あなたが{s:0019}ですか！{n}いやぁ、お美しい‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0130",
   "jp": "いやぁ、意外といい買い物をさせて貰ったよ。{n}これでようやく私も仕事が出来る。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0131",
   "jp": "お店の営業が始まってからずいぶん経つのに、{n}何となく賑やかさにかけるのよね～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0132",
   "jp": "これも、戦争のせいかしらね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0133",
   "jp": "おお、これはこれは{s:0019}。{n}ご機嫌うるわしゅう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0134",
   "jp": "{s:00CB}？{n}何で、私がこの顔を隠さなくちゃいけないんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0135",
   "jp": "やあ、君たち。{n}頑張って僕らを守ってくれよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0136",
   "jp": "ここは南大通り商店街です。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0137",
   "jp": "何か新しい遊びはないかなぁ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0138",
   "jp": "　第２４回フリーマーケットの案内{n}　　～詳しくはグランシル市にて～",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0139",
   "jp": "このマンホールをくぐると地底都市が！！{FFFB}{n}‥‥ということは絶対にない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0140",
   "jp": "　　　　　　魔法学院合格率６０％！{n}　　　　実績に裏付けされた信頼の進学塾{n}　　　　　　　『ＬＬＭ魔法教室』",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0141",
   "jp": "俺なんかが戦場に行ったりしたら、{n}真っ先にやられるタイプだな‥‥はは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0142",
   "jp": "はっはっは‥‥。{n}試験に続き、実技もボロボロだったよ‥‥。{n}こうなったら、誰かに頼み込んで教わるしかないなぁ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0143",
   "jp": "あ～あ‥‥私の力も何かに役立てられないかな～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0144",
   "jp": "実技も上々の結果よ♪{n}さ～ってと、{n}あとは、残った時間でやりたいことをやろうっと♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0145",
   "jp": "あなたに教えることは、もうなさそうね。{p}だけどこのおじいさんは、{n}まだまだ勉強が必要みたい[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0146",
   "jp": "‥‥ふむふむ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0147",
   "jp": "能力の説明で、まだお知りになりたい事は{n}ありますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0148",
   "jp": "だいたいはわかったんじゃが‥‥。{n}１つ聞いてもいいかのぉ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0149",
   "jp": "何でしょう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0150",
   "jp": "わしも経験をつめば、剣とかを振り回して、{n}きめぽぉずをとるんじゃろうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0151",
   "jp": "え‥‥[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0152",
   "jp": "わしも経験をつめば、{n}きめぽぉずをとるんじゃろうか？{n}そこがいちばん知りたいのぉ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0153",
   "jp": "{v:004E}おお、お前たち久しぶりだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0154",
   "jp": "{v:0050}{s:0005}さん。{n}お久しぶりです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0155",
   "jp": "{v:0051}{s:0007}さんはどうしているの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0156",
   "jp": "{v:0052}今は保養所で養生しているよ。{n}徐々に回復している。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0157",
   "jp": "{v:0053}そう。よかった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0158",
   "jp": "{v:0054}{s:0007}の見舞いに来てくれたみたいだな。{n}礼を言うよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0159",
   "jp": "{v:0055}そんな、お礼だなんて。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0160",
   "jp": "おっ、{s:0000}か？{n}久しぶりだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0161",
   "jp": "あ、闘技場で会った‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0162",
   "jp": "その前にも、妹の{s:0007}さんが、{n}{s:00C3}に襲われていたのを{n}一緒に助けたことがあったんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0163",
   "jp": "あ、前に言ってた‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0164",
   "jp": "あの時は世話になったな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0165",
   "jp": "{s:0007}さんは元気？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0166",
   "jp": "‥‥実は、あの後、また{s:00C3}に襲われてな。{n}今はラシェルに入院している。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0167",
   "jp": "そういえば、{s:0007}さん、{n}入院してたけど、何かあったの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0168",
   "jp": "‥‥実は、あの後、また{s:00C3}に襲われてな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0169",
   "jp": "幸い、ラシェルに入院できて、{n}今は快復に向かっている。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0170",
   "jp": "‥‥よかった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0171",
   "jp": "{v:0056}ところでどうしたんだ、血相変えて？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0172",
   "jp": "{v:0057}そうそう！{n}ねぇ、{s:0005}。{n}こっちに怪しい男が逃げてこなかった？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0173",
   "jp": "{v:0058}怪しい男？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0174",
   "jp": "{v:0059}覆面をかぶった人なんだけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0175",
   "jp": "{v:005A}覆面‥‥知らないなぁ。{p}{v:005B}そいつが何かやったのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0176",
   "jp": "{v:005C}実は友達を襲ってきたのよ！{n}それで追いかけてきたんだけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0177",
   "jp": "{v:005D}ひょっとして、賞金首のお尋ね者とかか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0178",
   "jp": "{v:005E}わかんないけど‥‥賞金なら、出るかも‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0179",
   "jp": "{v:005F}そうか。{n}{s:0007}の入院で金が必要なんだ。{n}ひとつ、捕まえてみるか！{p}{v:0060}それじゃな！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0180",
   "jp": "{v:0061}大変ねぇ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0181",
   "jp": "{v:0062}それにしても、逃げ足の速い奴ね！{n}もうこの街にはいないってことかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0182",
   "jp": "{v:0063}とりあえずみんなのところに戻ろうよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0183",
   "jp": "王都{s:0158}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0184",
   "jp": "アンタねぇ。{n}外に出てどうするのよ？{n}さっさと家に戻りなさいよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0185",
   "jp": "もし外へ逃げられたなら、探しようがないよ‥‥。{n}一度、戻ろうよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0186",
   "jp": "もっと街の中を調べようよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0187",
   "jp": "あっ、{s:0019}？{n}自分は姫のためなら、命も捨てる覚悟です！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0188",
   "jp": "ふふふ‥‥、ありがとう。{n}これからも、お仕事がんばって下さいね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0189",
   "jp": "私は門番でしかないから、{n}ここを動けないのが悔しいです‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0190",
   "jp": "私は門番でしかないから、{n}ここを動けないのが悔しいよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0191",
   "jp": "また岬へ行くのかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0192",
   "jp": "{v:000E}やっと帰ってきましたね。{n}もう二度と戻れないかもしれないと、{n}考えたこともありました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0193",
   "jp": "{v:000F}そんな弱気になっちゃダメだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0194",
   "jp": "{v:0010}そうだな。{n}諦めたらそこで終わりだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0195",
   "jp": "{v:0011}はい、そうですね。{p}{FC00}{v:0012}ところで１つ聞きたいことがあるのですが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0196",
   "jp": "{v:0013}みなさんが危険を冒してまで私を助けてくれたのは、{n}父上に命じられたからですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0197",
   "jp": "{s:0019}を救出に向かった理由はなんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0198",
   "jp": "・{s:0013}に命じられたから",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen002.0199",
   "jp": "・国の主を助けるのは、国民の義務だから",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen002.0200",
   "jp": "・友達を助けるのは当然のことだから",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen002.0201",
   "jp": "‥‥{v:0014}そうですか。{n}そうですよね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0202",
   "jp": "{v:0015}そうそう。{n}王様やお姫様あっての{s:0166}王国だもんね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0203",
   "jp": "‥‥{v:0016}そうですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0204",
   "jp": "{v:0017}友達‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0205",
   "jp": "{v:0018}姫様もお友達だと思ってって言いましたよね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0206",
   "jp": "{v:0019}もし任務を与えられなかったとしても、{n}アタシたちきっと助けにいったよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0207",
   "jp": "{FFF6}{v:001A}ありがとう。{n}本当にありがとう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0208",
   "jp": "{v:001B}さ、国王がお待ちかねだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0209",
   "jp": "{v:001C}はい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0210",
   "jp": "姫のこと、よろしく頼むぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0211",
   "jp": "おお！{n}姫、ご無事で！{p}姫が助かったのは、君たちのおかげだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0212",
   "jp": "まだ騎士として慣れないこともあるでしょうが、{n}仲間と力を合わせて頑張って下さい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0213",
   "jp": "君たちが頼みのつなだ！{n}必ず捕虜になった人たちを助け出してくれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0214",
   "jp": "ここは王都{s:0158}{s:005D}詰め所だよ。{n}悪い人たちを見かけたら、おじさんに教えてくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0215",
   "jp": "ひ、姫！{n}ご無事でなによりです！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0216",
   "jp": "街の外に出るのか？{n}気を付けて行くんだぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0217",
   "jp": "申し送り中なんだよ。{n}仕事の邪魔をしないでくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0218",
   "jp": "ゆっくり休んだことだし、{n}また見張りをがんばるぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0219",
   "jp": "気を引きしめて警備しないと。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0220",
   "jp": "　{n}　　『出かけるときは、戸締まりを忘れずに！』{n}　　　　　　　～{s:0158}警備隊～",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0221",
   "jp": "{v:0048}大丈夫？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0222",
   "jp": "{v:0049}ええ。{n}おかげで助かりました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0223",
   "jp": "{v:004A}何落ちついてんのよ！{n}さっきの覆面野郎を追いかけなきゃ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0224",
   "jp": "{v:004B}俺と{s:0006}はここで２人の護衛をする。{n}お前と{s:0001}で追跡しろ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0225",
   "jp": "{v:004C}う‥うん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0226",
   "jp": "{v:004D}それじゃ、行ってくるね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0227",
   "jp": "{v:001D}ちょっと待って！{n}あそこ見て！{n}あそこ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0228",
   "jp": "{v:001E}あ、{s:0004}君？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0229",
   "jp": "‥‥{v:001F}彼は‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0230",
   "jp": "{v:0020}今度は逃がさねぇぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0231",
   "jp": "{v:0021}どうして僕を狙うのですか！{n}お金なんて持ってませんよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0232",
   "jp": "{v:0022}別にお前から金を取ろうなんて思っちゃいねぇよ！{n}お前を殺せという依頼があったから‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0233",
   "jp": "‥‥{v:0023}あまり喋るな！{n}なぜお前たちを雇っていると思う？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0234",
   "jp": "{v:0024}す、すいません‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0235",
   "jp": "{v:0025}い、今のうちに‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0236",
   "jp": "{v:0026}このガキ、待ちやがれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0237",
   "jp": "{v:0027}待つのはそっちよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0238",
   "jp": "{v:0029}こりずに悪事を働いているようだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0239",
   "jp": "{v:002A}ゲッ！{n}貴様ら、どうしてここに！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0240",
   "jp": "{v:002B}これ以上、王都での不埒な振る舞いは{n}おやめなさい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0241",
   "jp": "‥‥{v:002C}ん‥‥？{n}{s:0019}‥‥？{FFF9}{FFFB}{n}{v:002D}それに奴らは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0242",
   "jp": "{v:002E}うるせぇ！{n}まとめて殺してやらぁ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0243",
   "jp": "ここは私たちに任せて！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0244",
   "jp": "似ている‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0245",
   "jp": "ありがとうございます！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0246",
   "jp": "ふぅ‥‥。{n}商品が無事でよかった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0247",
   "jp": "え、衛兵は何をやってるんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0248",
   "jp": "見つかったら、どうしようかと思っちゃった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0249",
   "jp": "留守のようだ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0250",
   "jp": "{v:0064}ダメ。{n}逃げられちゃったみたい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0251",
   "jp": "{v:0065}仕方ねぇな。{n}とりあえずこっちが無事だったんだ。{n}それで良しとしようぜ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0252",
   "jp": "{v:0066}‥‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0253",
   "jp": "{v:0067}どうしたんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0254",
   "jp": "‥{v:0068}あの‥何か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0255",
   "jp": "{v:0069}どうしてあなたが、ここにいるのです？{n}いったい、いつから？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0256",
   "jp": "{v:006A}えっ？{n}ここにいるわけは、両親に{s:0166}城へ{n}参るように言われたためですが‥‥。{p}{FC03}{v:006B}その‥‥紹介状をなくしてしまって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0257",
   "jp": "{v:006C}あなたは何者なのです？{n}正直に言いなさい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0258",
   "jp": "{v:006D}姫！？{p}{v:006E}どうなされました？{n}彼を見てから、どこかおかしいですよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0259",
   "jp": "{v:006F}{s:0004}が、どうかしたの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0260",
   "jp": "{v:0070}似ている‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0261",
   "jp": "{v:0071}えっ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0262",
   "jp": "{v:0072}似ているのです。{n}{s:0160}王国の王子‥‥{n}‥‥いいえ、新しい王、{s:000A}に。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0263",
   "jp": "{s:0004}と{s:000A}王との関係を{n}どう思いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0264",
   "jp": "・他人のそら似",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen002.0265",
   "jp": "・双子",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen002.0266",
   "jp": "・同一人物",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen002.0267",
   "jp": "・彼が本物、むこうは影武者",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen002.0268",
   "jp": "・むこうが本物、彼は影武者",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen002.0269",
   "jp": "・全然似ていない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen002.0270",
   "jp": "{v:0074}そら似、ねぇ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0271",
   "jp": "{v:0075}それにしては似すぎています。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0272",
   "jp": "{v:0076}そっか、双子なら似ていてもおかしくないよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0273",
   "jp": "{v:0077}しかし、{s:000A}王に{n}双子の兄弟がいるという話は聞いたことがありません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0274",
   "jp": "{v:0078}それじゃ、どうして似てるのかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0275",
   "jp": "{v:0079}わかりません‥‥。{n}だから悩むのです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0276",
   "jp": "{v:007B}私は{s:0160}王国内で、{n}彼の戴冠式に出席してきました。{p}{v:007C}本人がほぼ同時に２ヶ所に存在することは{n}出来ないと思います。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0277",
   "jp": "{v:007E}でも戴冠式を偽者に任せるかなぁ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0278",
   "jp": "{v:007F}私もそう思います。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0279",
   "jp": "{v:0080}なるほど！{n}影武者だったら納得できるわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0280",
   "jp": "{v:0081}それで必要なくなったから捨てられたの？{n}ちょっと可哀想‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0281",
   "jp": "{v:0082}似てないかなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0282",
   "jp": "{v:0083}{s:0001}ちゃんはどう思う？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0283",
   "jp": "{v:0084}闘技大会の時、てっきり本人だと思ってた‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0284",
   "jp": "{v:0085}とにかく、こいつが{s:0160}王国の{n}{s:000A}新王に似ているってことは事実なわけだ。{p}{v:0086}それにこいつは元々城に行くように指示されていた。{n}さらに何者かに命を狙われている。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0285",
   "jp": "{v:0087}命を狙われるようなこと、何かしたの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0286",
   "jp": "{FC07}{FA60}{FFFA}{v:0088}いえ‥‥。{n}そのような心当たりはないのですが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0287",
   "jp": "{v:0089}あ、そのブレスレットは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0288",
   "jp": "{v:008A}えっ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0289",
   "jp": "{v:008B}間違いありません。{n}全く同じブレスレットを、{s:000A}王も{n}していました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0290",
   "jp": "{v:008C}ああ、もう！{n}何がどうして、どうなってるのよぉっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0291",
   "jp": "{v:008D}この件は尾を引きそうだな。{p}{v:008E}話の続きをするんなら、{n}とりあえず城に入るってのはどうだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0292",
   "jp": "　{n}　　　　　{FFEF}{s:0004}が仲間になった！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0293",
   "jp": "し、死ぬかと思った‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0294",
   "jp": "す、すごかった‥‥。{n}何かのアトラクション？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0295",
   "jp": "か、彼が‥‥。{n}どうして、こんな事に‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0296",
   "jp": "び、びっくりしたぁ～～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0297",
   "jp": "あれ‥‥。{n}弟はどこに行ったの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0298",
   "jp": "すっげ～！{n}お兄ちゃん達って強いんだね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0299",
   "jp": "あれ？{n}お兄ちゃんとはぐれちゃった？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0300",
   "jp": "イヤな予感がしたから、家に帰っていたの。{n}おかげで巻き込まれずにすんだわ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0301",
   "jp": "姫をよろしく頼みます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0302",
   "jp": "まさかまた賊に入られるとは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0303",
   "jp": "{v:0033}いらっしゃいませ。{n}この店では、様々なグッズをお買い求めいただけます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0304",
   "jp": "{v:003E}ありがとうございました！{n}またどうぞ、お越し下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0305",
   "jp": "{v:000C}いらっしゃいませ。{n}当店では、様々な装備品を取り扱っております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0306",
   "jp": "　{n}『{FFEF}大きなコイン{FFF1}』を手に入れた！{FFFB}{n}と思ったら、ただのマンホールだった！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0307",
   "jp": "マンホールのふたは、雨の日によく滑る。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0308",
   "jp": "マンホールのふたは{n}４０キログラムと、かなり重い。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0309",
   "jp": "　　　スターロード武器・防具店{n}　　　　　　　{s:0158}本店",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0310",
   "jp": "外が騒がしかったけど、なにかあったのかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0311",
   "jp": "ごめ～ん。{n}今、手が放せないの。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0312",
   "jp": "さっき窓から、みんなを見てたのよ。{n}無事で良かったわね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0313",
   "jp": "私のいない間に、騒ぎがあったみたいね。{n}王都の中で騒動起こすなんて、{n}非常識な人もいたものね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0314",
   "jp": "‥‥ずっとここに隠れていれば安心だね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0315",
   "jp": "一度お城へ行った方がいいと思うんだけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0316",
   "jp": "どこへ行こうというのです？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0317",
   "jp": "{FFEC}{s:000E}ちゃーん、きーっく{FFED}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0318",
   "jp": "マスターを連れだして、どこへ行くつもりよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0319",
   "jp": "‥‥なるほど、こういうことをしていたのですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0320",
   "jp": "‥‥‥{FB00}あ‥‥[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0321",
   "jp": "マスターをどこへ連れ出す気よ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0322",
   "jp": "そんなに遠くへは行っていないと思うよ。{n}探すなら、街の中を探さないと‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen002.0323",
   "jp": "ねぇ、一度お城に戻ろうよ。",
   "en": "",
   "term": "end"
  }
 ]
}
