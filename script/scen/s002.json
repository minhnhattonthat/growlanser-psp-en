  },
  {
   "id": "scen002.0003",
   "jp": "宮廷魔術師サンドラ",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen002.0004",
   "jp": "オヤジ",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen002.0005",
   "jp": "市民",
   "en": "",
