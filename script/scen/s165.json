  },
  {
   "id": "scen165.0011",
   "jp": "ラシェル",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0012",
   "jp": "お兄ちゃん、ここラシェルだよ！{p}ラシェルはカレンさんに頼んでるから、{n}わたしたちは別の場所へ急ごう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0013",
   "jp": "お兄ちゃん、ここラシェルだよ！{p}ラシェルはアイリーンさんに頼んでるから、{n}わたしたちは別の場所へ急ごう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0014",
   "jp": "お兄ちゃんのこと疑いたくないけど、{n}まさか、ここに立てる気なんてないよね‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0015",
   "jp": "　{n}　　　　　　携帯集魔柱を設置した！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0016",
   "jp": "お兄ちゃん！{n}ここはわたしたちの担当じゃないってば！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0017",
   "jp": "お兄ちゃん、もしかしてふざけるの‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0018",
   "jp": "{FFF6}‥‥ううう‥‥。{n}{FC02}{FFF7}お兄ちゃんのバカぁ！！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0019",
   "jp": "おい、いい加減にしろ！{n}これは遊びじゃないんだぞ、分かってるのか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0020",
   "jp": "{FFF6}ここまでくると、真性のバカとしか{n}言いようがないな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0021",
   "jp": "みなさん、どうしてここに‥‥！？{p}ここは、私の担当場所だったと{n}思うのですが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0022",
   "jp": "みなさん、どうしてここに！？{p}ここは、私の担当場所だったと{n}思うのですが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0023",
   "jp": "それが、こいつが勝手に{n}ココに来て立てちゃったのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0024",
   "jp": "じゃあ、私の携帯集魔柱をお返します！{p}まだ間に合うかもしれませんから、{n}これを持って他の場所へ急いでください！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0025",
   "jp": "では、私の携帯集魔柱をお返します！{p}まだ間に合うかもしれませんから、{n}これを持って他の場所へ急いでください！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0026",
   "jp": "　{n}　　　カレンから携帯集魔柱を受け取った。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0027",
   "jp": "私は、しばらくここで様子を見ています！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0028",
   "jp": "　{n}　　アイリーンから携帯集魔柱を受け取った。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0029",
   "jp": "１度、魔法学院に戻って{n}状況を確認した方がよさそうだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0030",
   "jp": "　{n}　　　　　携帯集魔柱が設置してある。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0031",
   "jp": "俺は客でも患者でも、医者でもない。{n}それじゃ何だって？{p}ここがこれだけ整備されているのは、{n}俺たちが影ながら働いているからだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0032",
   "jp": "保養所を襲った男だが、聞けば前に{n}保養所へ出入りしていたらしいじゃないか！{p}ひどい話だよ、まったく！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0033",
   "jp": "ブローニュ村も被害に遭ったんだって！？{n}くそっ、なんでこんなことするんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0034",
   "jp": "この闇、保養所が襲われた時と同じだ！{n}ちくしょう、またあの男なのか！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0035",
   "jp": "俺たちは、いつまで闇に怯えながら{n}暮らせばいいんだ‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0036",
   "jp": "ここはいいところですなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0037",
   "jp": "はて？{n}保養所のほうが騒がしいようじゃが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0038",
   "jp": "まだ悪夢を見ている気分ですじゃ‥‥。{p}保養施設の人々は、いつも笑顔じゃった。{n}だが、その笑顔も今は悲しみで曇っておる‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0039",
   "jp": "いつまでも、落ち込んでるワケにはいかんのぉ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0040",
   "jp": "あの悪夢が、{n}再び訪れようとしておるのか‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0041",
   "jp": "今は辛い時かもしれん‥‥。{p}それでも、前を向いて歩き続けなければならん。{n}それが人生じゃよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0042",
   "jp": "最近の子供は‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0043",
   "jp": "村人が化け物にされた時のことを思い出すと、{n}今も怖くて怖くて‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0044",
   "jp": "お兄ちゃんたち、{n}ボクのプロポーズをジャマしないでよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0045",
   "jp": "ねぇ、いいだろ？{n}ぜったい、しあわせにするからさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0046",
   "jp": "ボクたちのであいは、ぐうぜんじゃないとおもうんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0047",
   "jp": "おお、マイ・エンジェル！{n}キミはカミがボクのためにつかわしたテンシだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0048",
   "jp": "‥‥月並みなセリフね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0049",
   "jp": "‥‥ちょっとは考えちゃうかも{FFF0}♥{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0050",
   "jp": "‥‥でも、結婚するなら、お金持ちじゃないとね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0051",
   "jp": "保養所にご用ですか？{p}東にある宿屋の前を通って、北に行けばすぐですよ。{n}一本道ですから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0052",
   "jp": "保養所で犠牲になった方たちに、{n}毎日お祈りをささげてるんです‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0053",
   "jp": "あの時と同じ、不気味な闇が‥‥。{n}ど、どうすればいいのでしょう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0054",
   "jp": "闇の脅威にさらされているのは、{n}私たちだけではないんですよね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0055",
   "jp": "ここラシェルは、大陸でも有名な保養地なんですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0056",
   "jp": "た、助けてください！{n}保養所が、大変なことに‥‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0057",
   "jp": "保養所を襲った男性ですが、{n}私、前に保養所で見たことあるんです。{p}その時は、こんなことする人には{n}見えなかったのに‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0058",
   "jp": "助けてください！{n}またラシェルに闇が‥‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0059",
   "jp": "いつまでこんな日々が続くんでしょう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0060",
   "jp": "{v:0000}やぁ、いらっしゃい。{n}ここには、いろんな装備があるよ～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0061",
   "jp": "{v:0002}さて、何の用かな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0062",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen165.0063",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen165.0064",
   "jp": "まだ用事はあるかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0065",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen165.0066",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen165.0067",
   "jp": "{v:000B}またおいで～。待ってるよ～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0068",
   "jp": "私は、しばらくここで様子を見ています！{n}みなさんは急いで他へ向かってください。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0069",
   "jp": "なんだね？{n}非番の日くらいゆっくりさせてくれ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0070",
   "jp": "外が騒がしくて、ゆっくり寝れないよ‥‥。{n}まったく、お祭りでもやってるのかね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0071",
   "jp": "悪いがまだ寝させてくれないか‥‥。{n}例の事件で怪我人が連続で運び込まれてきて、{n}徹夜続きなんだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0072",
   "jp": "‥‥ん‥‥？{p}なんだ、まだ夜じゃないか。{n}まだ寝ていたいんだ、起こさないでくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0073",
   "jp": "‥‥なんだ、もう朝なのか？{p}ついさっきまで外が真っ暗だと思ってたのに、{n}夜が明けるのが早いな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0074",
   "jp": "　{n}　　　　　鍵がかかっていて開かない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0075",
   "jp": "今はそれどころじゃないでしょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0076",
   "jp": "うわ～、この妖精さんちっちゃいね～★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0077",
   "jp": "アンタもちっちゃいじゃない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0078",
   "jp": "ちょっと！{n}れでぃーに失礼じゃない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0079",
   "jp": "はいはい‥‥ゴメンなさいね‥‥[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0080",
   "jp": "黒いの、またお空から落ちてくるの？{n}そうすると、みんなどうなっちゃうの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0081",
   "jp": "また、あいつの襲撃なのか？{n}くそっ、あの男はどこにいるんだ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0082",
   "jp": "あの患者が、元気になれるとは‥‥。{n}奇跡が起こったとしか言いようがない。{n}これで無事にヴァルミエへ帰れただろう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0083",
   "jp": "保養所の前に犬がじっと待っているのを{n}知っているかね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0084",
   "jp": "治療中の女の子が飼っている犬でね、{n}飼い主の帰りをずっと待っているようだ。{p}その子の容態は決して良くはないが‥‥。{n}ひょっとすると、また元のように{n}元気に戻れるかもしれん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0085",
   "jp": "治療中の女の子が飼っている犬でね、{n}飼い主の帰りをずっと待っているようだ。{n}だが、その子はもう‥‥。{p}もっと生きようとする強い意志があれば、{n}何とかなるかもしれないが‥‥。{n}きっと今まで辛いことが多かったのだろう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0086",
   "jp": "保養所で亡くなった女の子が飼っていた犬でね、{n}もう会うこともできない飼い主の帰りを{n}ずっと待っているようだ。{p}あの犬の背中を見ていると、{n}もっと患者にしてやれる事があったのではないか？{n}という思いが、胸をしめつけるのだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0087",
   "jp": "キミも見ただろう？{n}目の前で、人間が怪物に変わる光景を。{n}ショックで、ずっと頭から離れなくてね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0088",
   "jp": "ケガをしたら、いつでも保養所に来なさい。{n}くれぐれも、無理をしすぎてはいけないよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0089",
   "jp": "メディスから来たそこのご夫婦、{n}とっても仲がいいのよね。{n}あてられちゃうわ[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0090",
   "jp": "あんな事件があって、落ち込んでたけど‥‥。{n}そこのご夫婦を見ていると、励まされるわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0091",
   "jp": "また例の闇が{n}落ちてくるんでしょうか‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0092",
   "jp": "２度もラシェルが襲われずにすんで、{n}ホッとしています。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0093",
   "jp": "くぅ～ん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0094",
   "jp": "お互い、この歳まで生きられるとは{n}思わなかったのう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0095",
   "jp": "そうですねぇ。{n}でも、あなたと一緒ならいつまでも{n}生きられそうな気がするわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0096",
   "jp": "なにがあっても、ワシはお前さんとずっと一緒じゃぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0097",
   "jp": "ええ、あなたと一緒なら闇も怖くないですよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0098",
   "jp": "当店をご利用でしたら、{n}こちらで記帳なさって下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0099",
   "jp": "いらっしゃいませ。{n}１泊、{FFEB}エルムになりますが？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0100",
   "jp": "ありがとうございました。{n}気を付けて行ってらっしゃいませ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0101",
   "jp": "お客さん‥‥[01BE]{n}お金が足りないみたいですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0102",
   "jp": "またのお越しをお待ちしております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0103",
   "jp": "‥‥ふぅっ。{n}ボクは劇団『三国大陸』の団長をやっているんだ。{p}ここラシェルなら仕事があるだろうと思って、{n}探しに来たんだけど‥‥。{n}『うるさい芝居はダメだ』って、怒られちゃってさ。{p}仕事を取ってくるって大見得切っちゃった手前、{n}団員に何て言ったらいいのか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0104",
   "jp": "ん？　僕たち劇団『三国大陸』に出演の依頼かい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0105",
   "jp": "よし！　公演料は激安の８００エルムでいいぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0106",
   "jp": "・やっぱりやめる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen165.0107",
   "jp": "・公演を依頼する",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen165.0108",
   "jp": "やった！{n}よし！{n}他の団員に連絡だ！{p}場所は？{FFFB}{n}{s:0010}だね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0109",
   "jp": "なんだ、払う気がないのに、{n}ぬか喜びさせないでくれよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0110",
   "jp": "ふぅっ‥‥。{n}他の団員に何て言おうか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0111",
   "jp": "あの絵の前にいる人、すごく面白いのよ！{n}いっぱい笑っちゃった！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0112",
   "jp": "ここはのんびりしていていいわ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0113",
   "jp": "ここも安全ではなくなったわ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0114",
   "jp": "{v:0008}お父さん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0115",
   "jp": "‥‥{v:006B}親父ぃ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0116",
   "jp": "アンタ、こんな時だっていうのに{n}どこに行く気なのよ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0117",
   "jp": "　{n}　　傷が深く、今にも呼吸が絶えそうだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0118",
   "jp": "{v:004F}しっかりして、お父さん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0119",
   "jp": "{v:0050}親父、しっかりしろよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0120",
   "jp": "‥‥{v:0052}ちょっと無理をしすぎたようだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0121",
   "jp": "{v:0053}ベルガーさん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0122",
   "jp": "‥‥{v:0069}シエラ‥‥来てくれたのか‥‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0123",
   "jp": "{v:006A}隊長‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0124",
   "jp": "‥‥{v:006C}お父さん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0125",
   "jp": "{v:0020}闇落としか‥‥。{n}とんでもない事をしやがる‥‥。{p}{v:0021}それにしても、ヴェンツェルの言っていた{n}アレは本当だったのか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0126",
   "jp": "{v:0022}だけど、どうしてそんなことをするの？{n}罪もない人を怪物にしちゃうなんて‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0127",
   "jp": "{v:0023}これは放っておけないぜ。{n}もっと詳しいことを調べた方がいい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0128",
   "jp": "・魔法学院だ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen165.0129",
   "jp": "・サンドラだ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen165.0130",
   "jp": "・ヴェンツェルだ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen165.0131",
   "jp": "{v:0024}きっと、あれ以上はわからないよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0132",
   "jp": "{v:0026}闇の粒子、デュンケルスのことを知っていた、{n}ヴェンツェルに聞くしかないだろうな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0133",
   "jp": "{v:0025}お母さんだって、こんな事わからないよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0134",
   "jp": "{v:0027}そうだな。{n}闇の粒子、デュンケルスのことを知っていた、{n}ヴェンツェルに聞くしかないだろうな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0135",
   "jp": "闇落としの恐怖",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0136",
   "jp": "‥‥{v:0077}つ、強い‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0137",
   "jp": "{v:0003}弱った時空干渉能力の波動を狙ってみれば、{n}まさかお前だったとはな、ベルガー。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0138",
   "jp": "{v:0002}弱った‥波動‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0139",
   "jp": "{v:0004}偶然ではあったが、いずれ殺さねばならない相手だ。{n}ここで殺してやる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0140",
   "jp": "‥‥{v:0007}くっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0141",
   "jp": "{v:000A}ベルガー隊長！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0142",
   "jp": "‥{v:0078}みんなか‥‥。{n}気をつけろ！{n}‥手強いぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0143",
   "jp": "{v:0005}えっ！？{n}あれって、ユング？{n}でもゲヴェルはもういないはずじゃ‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0144",
   "jp": "{v:0006}あ、あの男は！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0145",
   "jp": "{v:0007}来たか‥‥。{n}これで役者はそろった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0146",
   "jp": "{v:0008}さあ、死にたまえ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0147",
   "jp": "なんだか保養所の辺りから{n}騒がしい声が聞こえるけど、{n}大きな地震があったせいかしらねぇ‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0148",
   "jp": "そこの花畑は私が手入れしてるんですよ。{n}喜んでくれる人も多いし、{n}とってもやりがいがあります。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0149",
   "jp": "外が暗いようですね。{n}何事もなければいいですけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0150",
   "jp": "さて、そろそろ花も育った頃だし、{n}保養所の方に持って行ってあげようかしらね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0151",
   "jp": "保養所の方が騒がしいけど、{n}なにか事件でもあったのかしら‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0152",
   "jp": "毎日、お花を保養所に届けているのよ。{n}みんなが、少しでも明るい気持ちになれたらと思って。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0153",
   "jp": "今日も保養所にお花を届けようと思ってたら、{n}突然、周囲が真っ暗になったんだけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0154",
   "jp": "‥‥ちょっといいか？{n}実はもう１つ、気になることがあるんだが。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0155",
   "jp": "えっ、どうしたの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0156",
   "jp": "メルフィのことだ。{p}いくら人間嫌いだと言っても、{n}ジャスティンの闇落としに荷担するのは、{n}度が過ぎていると思わないか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0157",
   "jp": "うん‥‥。{p}それにフェザリアンって、{n}規律を乱さないために個人では{n}行動しないんですよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0158",
   "jp": "でもメルフィさんの場合、{n}他のフェザリアンとは一緒にいないよね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0159",
   "jp": "ああ、どうしてもそこが引っかかるんだ。{n}一応、メルフィのことも調べておいたほうが{n}いいかもしれんぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0160",
   "jp": "でも、どうやって調べるの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0161",
   "jp": "・魔法学院で調べる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen165.0162",
   "jp": "・研究家に聞く",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen165.0163",
   "jp": "・フェザリアンに聞く",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen165.0164",
   "jp": "フェザリアンのことを魔法学院で？{n}アンタ、思考パターンがおかしいんじゃないの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0165",
   "jp": "やっぱりフェザリアンのことは、{n}フェザリアンに聞くのが１番早いだろう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0166",
   "jp": "研究家って、ダニーさんのこと？{p}うーん‥‥、いくらあの人でも、{n}メルフィさん個人のことまで知ってるとは{n}思えないよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0167",
   "jp": "ああ。{n}やっぱりフェザリアンのことは、{n}フェザリアンに聞くのが１番早いだろう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0168",
   "jp": "それじゃ、デュンケルスのことと一緒に調べましょ！{n}どっちから調べるかは、アンタに任せるわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen165.0169",
   "jp": "アンタ、こんな時だっていうのに{n}どこ行く気なのよ！？",
   "en": "",
   "term": "end"
  }
 ]
}
