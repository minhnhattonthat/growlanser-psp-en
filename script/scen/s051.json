 "entries": [
  {
   "id": "scen051.0000",
   "jp": "",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen051.0001",
   "jp": "バーンシュタイン兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen051.0002",
   "jp": "旅人",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen051.0003",
   "jp": "市民",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen051.0004",
   "jp": "オヤジ",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen051.0005",
   "jp": "店員",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen051.0006",
   "jp": "ガラシールズ",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0007",
   "jp": "どうやってジュリアンと連絡をつけますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0008",
   "jp": "・強行突入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen051.0009",
   "jp": "・エリオットだけ行かせる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen051.0010",
   "jp": "・ティピを行かせる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen051.0011",
   "jp": "{v:0000}あなた方のことは、ジュリアン将軍から{n}うかがっております。{n}どうぞ、お通り下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0012",
   "jp": "ここは砂漠のオアシス、ガラシールズ。{n}今は我々バーンシュタイン軍が占領している。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0013",
   "jp": "ここはバーンシュタインと比べて暑いな。{n}この格好で見回りをしているから、{n}たまに仲間が倒れるよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0014",
   "jp": "ランザックは、グローシュが少ないと聞いていたが、{n}こうして見てみると、確かにその通りだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0015",
   "jp": "今、この奥で兵隊たちが集まってるよ。{n}今度は何の相談してるんだ‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0016",
   "jp": "私は色んな国の武官を見てきましたが‥‥。{n}やはりインペリアル・ナイツだけは特別ですな。{p}武力だけでなく、知力や気品も{n}かねそなえているのですからね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0017",
   "jp": "いや～。{n}アッという間に占領されたもんだから、{n}ビックリしたよ、まったく。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0018",
   "jp": "はあ‥‥。{n}ジュリアン様‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0019",
   "jp": "ようこそ！{n}スキマ屋ガラシールズ支店です。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0020",
   "jp": "買い物をしますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0021",
   "jp": "また来てね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0022",
   "jp": "なかなかいいスキマが見つからなくてね‥‥。{n}ここは仮店舗なんですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0023",
   "jp": "{v:003F}まぁ、いらっしゃい。{n}このお店は、どんな装備品でもそろってるわよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0024",
   "jp": "{v:0041}それで、買いに来たの？{n}売りに来たの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0025",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen051.0026",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen051.0027",
   "jp": "で、他にも何かある？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0028",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen051.0029",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen051.0030",
   "jp": "{v:004B}また来てよね。{n}素敵な笑顔で待ってるから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0031",
   "jp": "{v:0033}いらっしゃいませ。{n}この店では、様々なグッズをお買い求めいただけます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0032",
   "jp": "{v:0034}本日はお買い求めですか？{n}それともご売却ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0033",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen051.0034",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen051.0035",
   "jp": "他にも何かおありでしょうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0036",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen051.0037",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen051.0038",
   "jp": "{v:003E}ありがとうございました！{n}またどうぞ、お越し下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0039",
   "jp": "バーンシュタインの兵隊さんたちが、{n}ガラシールズを去るようなこと言ってたけど、{n}占領されている間も、普通に生活できてたよ。{p}ジュリアン将軍とやら、{n}敵ながら我々を信頼させる力を持っているようだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0040",
   "jp": "まさかあれほど手際よく占領されるとは思わなかった。{n}あれがインペリアル・ナイトの力なのか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0041",
   "jp": "{v:0000}あなた方のことはジュリアン将軍から{n}うかがっております。{n}どうぞ、お通り下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0042",
   "jp": "ジュリアン将軍でしたら、{n}この奥にいらっしゃいます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0043",
   "jp": "アンタ、１人でどこ行くのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0044",
   "jp": "{v:0010}どうだった？{n}ランザック軍の了承はとれたか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0045",
   "jp": "{v:0011}ああ、もうここを動いても大丈夫だ。{p}{v:0012}それで、お前の方は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0046",
   "jp": "{v:0013}ちょうどこれから士官クラスの者に説明するところだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0047",
   "jp": "{v:0014}これからぁ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0048",
   "jp": "{v:0015}そう言うな。{n}エリオット、いや陛下が一緒にいた方が、{n}説得力があると思ってな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0049",
   "jp": "{v:0016}これから皆に重要な発表をする。{n}心して聞いて欲しい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0050",
   "jp": "{v:0017}まず、このお方を紹介する。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0051",
   "jp": "{v:0018}あ、あの‥どうも‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0052",
   "jp": "‥{v:0019}陛下‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0053",
   "jp": "‥‥{v:001A}あの傲慢な陛下が、どうして‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0054",
   "jp": "{v:001B}似ていると思うだろう？{n}それもそのはず、このお方が正式な王位継承者なのだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0055",
   "jp": "{v:001C}何だと！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0056",
   "jp": "{v:001D}今王位についているのは真っ赤な偽者！{n}このお方こそが本当の王なのだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0057",
   "jp": "{v:001E}まさか、そんな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0058",
   "jp": "{v:001F}すでに我が父ダグラス卿が、アンジェラ様とともに{n}王都へ向かう準備をしている。{p}{v:0020}そこで私も簒奪者を討つために王都へ向かうつもりだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0059",
   "jp": "{v:0021}あ、あの‥‥。{n}僕は今まで自分が王となる人間だなんて、{n}知らないで育ってきました。{p}{FC02}{v:0022}ですが今の王は世界征服を企む悪者の手先なのです！{n}このままではバーンシュタイン王国だけでなく、{n}世界中にゲヴェルの魔手が及ぶでしょう。{p}{v:0023}僕はそれをくい止めたい！{n}この大陸の人々を救いたい！{p}{v:0024}お願いです。{n}みなさんの力を貸して下さい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0060",
   "jp": "{v:0025}いかに相手が偽王であろうとも、{n}これからの戦に勝てねば、我々は、{n}国に弓引く反逆者として闇に葬り去られるだろう。{p}{v:0026}つまり、王位奪還をなしえるためには、{n}偽王が率いる同胞たちを倒さねばならないのだ！{p}‥‥{v:0027}無理強いはしない。{n}今の話を信じ、なおかつ協力してくれる者だけ{n}残ってくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0061",
   "jp": "{v:0028}どうしたものか‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0062",
   "jp": "{v:0029}決まってるだろ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0063",
   "jp": "{v:002A}うむ、‥‥そうだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0064",
   "jp": "{v:002B}どうした？{n}反逆者になりたくない者は今のうちに本国へ戻れ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0065",
   "jp": "{v:002C}お前たち‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0066",
   "jp": "{v:002D}我々は将軍に忠誠を誓っております。{n}将軍がその方を信じるのであれば、{n}それは我々が信じたも同然です。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0067",
   "jp": "{v:002E}最後までお供させて下さい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0068",
   "jp": "‥‥{v:002F}ありがとう、みんな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0069",
   "jp": "　{n}　　　『{FFEF}ティピの可能性４{FFF1}』を手に入れた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0070",
   "jp": "‥‥{v:0030}ねぇ、お兄ちゃん。{n}ジュリアンさん、すごいよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0071",
   "jp": "ジュリアンをどう思いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0072",
   "jp": "・普通",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen051.0073",
   "jp": "・まだまだ甘い",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen051.0074",
   "jp": "・ここまで信頼されるのはすごい",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen051.0075",
   "jp": "・いい将軍になった",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen051.0076",
   "jp": "‥‥{v:0033}そうだな。{n}将軍職、特にインペリアル・ナイトなら{n}当然ということか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0077",
   "jp": "{v:0034}これは手厳しい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0078",
   "jp": "‥‥{v:0031}そうか？{n}我が国の将軍、特にインペリアル・ナイトならば{n}当然だぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0079",
   "jp": "‥‥{v:0032}そうか。{n}お前にそう言われると嬉しいよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0080",
   "jp": "ジュリアンさんって、すごいなぁ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0081",
   "jp": "偽王リシャールを討つための戦いか‥‥。{n}それは自国の兵士同士で殺し合うということだ。{n}しかも家族を国に残したものもいるだろう‥‥。{p}いくらインペリアル・ナイトを信じるといっても、{n}その選択をしたのは彼ら自身。{n}もう後戻りは許されない。{p}それこそ、辛い選択だっただろうな‥‥。{n}敵の兵士だったとはいえ、{n}尊敬に値すると思わないか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0082",
   "jp": "ジュリアンさんって、本当に素晴らしい方ですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0083",
   "jp": "この結束の堅さが、軍の強さの秘密というわけか‥‥。{n}インペリアル・ナイツというのは{n}それだけ信頼が高いものなんだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0084",
   "jp": "みんなに断られたらって思うと、{n}ドキドキしちゃった★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0085",
   "jp": "失敗すれば、反逆者か‥‥。{n}責任重大だな。{p}{FC00}もっとも今は悩むより、進軍の用意をすべきだな。{n}‥‥忙しくなりそうだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0086",
   "jp": "できるだけ早く、ここを発たねば‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0087",
   "jp": "{v:0035}とにかく、これで出発できますね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0088",
   "jp": "{v:0036}その前に、陛下にお頼みしたい事があります。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0089",
   "jp": "{v:0037}へ、陛下だなんて‥‥。{p}‥‥{v:0038}いったい、何ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0090",
   "jp": "{v:0039}我が隊は見ての通りの少数です。{n}この兵力で、本国の差し向ける部隊と戦わなくては{n}なりません。{p}{v:003A}そこで陛下に我が隊に残っていただきたいのです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0091",
   "jp": "{v:003B}ぼ、僕が？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0092",
   "jp": "{v:003C}はい。{n}陛下に同行していただければ、{n}兵の士気も高まるでしょう。{p}{v:003D}その代わり、陛下のお命は、{n}私が命に代えても守ります。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0093",
   "jp": "{v:003E}わかりました。{n}僕に出来ることなら、いくらでもやらせて下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0094",
   "jp": "　{n}　　　　　{FFEE}エリオットが仲間から外れた！{p}　{n}　　　　　エリオットの装備を回収した！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0095",
   "jp": "{v:003F}申し訳ありません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0096",
   "jp": "{v:0040}いるだけでいいのですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0097",
   "jp": "{v:0041}はい、それだけで十分です。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0098",
   "jp": "{v:0042}実はもう１つありますが‥‥。{n}それはこの戦いに勝利した後でけっこうです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0099",
   "jp": "{v:0043}そうですか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0100",
   "jp": "{v:004B}それではみなさん、今までありがとうございました。{n}僕たちはこちらから王都へ向かいます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0101",
   "jp": "リシャール王が魔物の手先というのか‥‥。{n}確かにあの変貌ぶり、おかしいとは思っていたが‥‥。{p}俺は将軍やあの陛下のために命を捨てる覚悟はある。{n}だが家族のある者は、これからの戦い、{n}辛い思いをするだろうな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0102",
   "jp": "ジュリアン将軍は、いつも我々のために{n}最も危険な場所で戦ってくれた。{n}そんな方を裏切るなんて、俺にはできないよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0103",
   "jp": "あの少年‥‥、いや陛下の目を見ていて、{n}ジュリアン将軍の話が真実だと思ったよ。{p}たしかにリシャール王が魔物の手先という話は、{n}簡単に信じられる内容ではない。{n}だが、俺はこの戦いにかけることにする。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0104",
   "jp": "国に残した家族が心配だが‥‥。{n}この戦い、やめるわけにいかない。{p}せめて家族には、ダグラス領へ急いで避難するよう{n}手紙を出すとしよう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0105",
   "jp": "これから友と戦うこともあるだろう‥‥。{n}だが真実を知って、それに背を向けるなど{n}俺にはできない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0106",
   "jp": "士官クラスを集めて、{n}将軍は、いったい何をお話になるのだろう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0107",
   "jp": "まさかリシャール王が偽者だったなんて‥‥。{n}びっくりしたよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0108",
   "jp": "見張りの邪魔です！{n}話しかけないで下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0109",
   "jp": "あんた達、タダで泊まろうってのかい？{n}ちゃんとお金を払って泊まってくれよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0110",
   "jp": "いらっしゃいませ。{n}１泊、{FFEB}エルムになりますが？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0111",
   "jp": "ありがとうございました。{n}気を付けて行ってらっしゃいませ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0112",
   "jp": "お客さま‥‥[01BE]{n}お金が足りないみたいですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0113",
   "jp": "またのお越しをお待ちしております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0114",
   "jp": "{v:0044}このことをアルカディウス王に報告したら、{n}俺たちも手伝おうぜ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0115",
   "jp": "エリオットの王位奪還を手伝いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0116",
   "jp": "{v:0048}それなら父上の方の様子を見てくれないか？{p}{FC03}{v:0049}父はもう歳だ。{n}無理をしていなければいいが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0117",
   "jp": "{v:004A}お父さん思いなんだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0118",
   "jp": "{FFEC}{v:0045}アンタって男は～っ！{FFED}{n}人を困らせてどうすんの～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0119",
   "jp": "{v:0046}ごめんなさい、お兄ちゃんが変なこと言って‥‥。{p}{v:0047}報告が終わったら、ちゃんと手伝いに来ます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0120",
   "jp": "{v:004C}がんばれよ、エリオット。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0121",
   "jp": "{v:004D}がんばってね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0122",
   "jp": "{v:0000}おい、ちょっと待てよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0123",
   "jp": "{v:0001}ガラシールズは、ランザック軍と{n}バーンシュタイン軍がにらみ合ってる場所だろ？{p}{v:0002}俺たちローランディアの者が行って、{n}余計なことにならねぇか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0124",
   "jp": "{v:0003}う～ん‥‥そうかも。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0125",
   "jp": "{v:0004}バーンシュタイン軍だけなら、{n}僕が王のふりをすればいいのですが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0126",
   "jp": "{v:0005}どうする？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0127",
   "jp": "{v:0006}ナニ言い出すのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0128",
   "jp": "{v:0007}余計な波風立てない方法を考えてんだろうが！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0129",
   "jp": "‥‥{v:0008}ルイセちゃん、コイツ、蹴っていい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0130",
   "jp": "{FB00}‥‥{v:0009}え～と‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0131",
   "jp": "{v:000A}とうっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0132",
   "jp": "{v:000B}ランザックの兵隊さんに見つかったら、どうするの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0133",
   "jp": "{v:000C}あなたは僕に死ねと言ってるんですか！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0134",
   "jp": "{v:000D}なるほど。{n}コイツなら見つかりにくいし、{n}ジュリアンの事も知ってる。{p}{v:000E}適任だな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0135",
   "jp": "{v:000F}お兄ちゃん、頭いい～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0136",
   "jp": "{v:0010}それじゃ、アタシがジュリアンを呼んでくるから、{n}ここで待ってて！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0137",
   "jp": "{v:0011}しょうがないわね！{n}アタシが行ってくるわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0138",
   "jp": "{v:0012}ティピ、大丈夫？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0139",
   "jp": "{v:0013}アタシならちっちゃいし、飛べるから大丈夫！{p}{v:0014}それじゃ、ジュリアンを呼んでくるから、{n}ここで待ってて！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0140",
   "jp": "{v:0015}それにしても、上手くいくでしょうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0141",
   "jp": "{v:0016}それはティピのことか？{n}それとも王位を取り戻すことか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0142",
   "jp": "‥‥{v:0017}僕が王位についてからのことも含めてです。{p}{v:0018}僕が本物だとしても、これからのバーンシュタインを{n}まとめる器があるのでしょうか？{p}{v:0019}正直に答えて下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0143",
   "jp": "エリオットが王位を継ぐことをどう思いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0144",
   "jp": "・エリオットは王の器がある",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen051.0145",
   "jp": "・エリオットならやれる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen051.0146",
   "jp": "・心配するほどじゃない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen051.0147",
   "jp": "・たぶん大丈夫",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen051.0148",
   "jp": "・ちょっと心配",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen051.0149",
   "jp": "・無理",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen051.0150",
   "jp": "{v:001A}えぇっ！{n}そうですか！？{n}例えば、どんな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0151",
   "jp": "‥‥‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0152",
   "jp": "{v:001B}フォローの出来ないおだては、やめた方がいいぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0153",
   "jp": "{v:001C}で、でも、ほら！{n}そっくりさんに務まるくらいだから、{n}エリオット君にも出来るわよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0154",
   "jp": "‥‥{v:001D}ありがとうございます‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0155",
   "jp": "{v:001E}本当に大丈夫でしょうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0156",
   "jp": "{v:001F}要は自信を持つことだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0157",
   "jp": "{v:0020}自信‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0158",
   "jp": "{v:0021}そうよ、がんばらなきゃ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0159",
   "jp": "{v:0022}そうですね！{n}ありがとうございます！{n}やる気がわいてきました！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0160",
   "jp": "{v:0023}そうそう。{n}俺は今までいろんな指導者を見てきたが、{n}そう心配するほどじゃなかったぜ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0161",
   "jp": "{v:0024}そうなんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0162",
   "jp": "{v:0025}要は誠実に、他人を思いやる政治だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0163",
   "jp": "{v:0026}なるほど。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0164",
   "jp": "{v:0027}さすがにウォレスさんが言うと重みが違うね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0165",
   "jp": "{v:0028}よし！{n}僕、がんばります！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0166",
   "jp": "{v:0029}た、たぶん‥‥ですか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0167",
   "jp": "{v:002A}で、でも、ほら！{n}そっくりさんに務まるくらいだから、{n}エリオット君にも出来るわよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0168",
   "jp": "{v:002B}は、はぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0169",
   "jp": "{v:002C}ですよねぇ‥‥。{FFF9}{FFFB}{n}{v:002D}実際、自信ないんですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0170",
   "jp": "{v:002E}だからってそのままじゃ困るぞ。{n}お前にバーンシュタインの未来が{n}かかってるんだからな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0171",
   "jp": "{v:002F}もう、プレッシャーかけないでくださいよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0172",
   "jp": "{v:0030}そうはっきり言われると‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0173",
   "jp": "{v:0031}お、お兄ちゃん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0174",
   "jp": "{v:0032}そうだぞ。{n}こういう時は嘘でも『大丈夫』って{n}言ってやるもんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0175",
   "jp": "{v:0033}う、嘘‥ですか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0176",
   "jp": "‥‥{v:0034}あ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0177",
   "jp": "{v:0035}もう、ウォレスさんもお兄ちゃんも！{p}{FC00}{v:0036}と、とにかくがんばらなきゃ！{n}ね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0178",
   "jp": "{v:0037}は、はぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0179",
   "jp": "{v:0038}お待たせ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0180",
   "jp": "{v:0039}あ、お帰り。{n}早かったね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0181",
   "jp": "{v:003A}そりゃもう、大急ぎで行って来たんだから。{p}{v:003B}でね、後からすぐ来るから、{n}街の南の洞窟で待っててって。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0182",
   "jp": "{v:003C}洞窟の中か。{n}確かに人目に付かないだろうな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0183",
   "jp": "とりあえず、ランザック王と交渉をしてから{n}ここへ来ませんか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0184",
   "jp": "そうだな。{n}それにジュリアンが、俺たちの事を{n}兵士に説明する時間も必要だろう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0185",
   "jp": "せっかくアタシがジュリアンと約束して来たんだから、{n}早く洞窟へ行こうよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0186",
   "jp": "結局、ガラシールズはジュリアンたちに{n}占領されたままなのね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0187",
   "jp": "あれ？{n}ガラシールズってバーンシュタイン王国領だったっけ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0188",
   "jp": "どうやら俺たちが来ないうちに{n}占領されちまったらしいな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0189",
   "jp": "占領されたにしては、街の人たちに危害はないみたい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0190",
   "jp": "司令官が出来た奴なんだろうよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0191",
   "jp": "ここはバーンシュタイン軍に占領されている。{n}下手に出ていって、{n}街の人を戦闘に巻き込むマネはよせ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0192",
   "jp": "{v:0001}どうしてアタシ達のことが、わかったのかしら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0193",
   "jp": "{v:0002}そりゃ、お前、簡単だろ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0194",
   "jp": "{v:0003}え～、そうかなぁ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0195",
   "jp": "{v:0004}ねぇ、アンタはわかるの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0196",
   "jp": "・ティピがいるから",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen051.0197",
   "jp": "・エリオットがいるから",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen051.0198",
   "jp": "・わからない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen051.0199",
   "jp": "{v:0005}そうだよね。{n}やっぱり、ティピがいたからじゃないの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0200",
   "jp": "‥‥{v:0006}あ、そっか。{n}アタシの存在って目印になっちゃうのね。{n}気をつけなきゃ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0201",
   "jp": "{v:0007}今更？{n}もう遅いだろ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0202",
   "jp": "{v:0008}ぶ～っ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0203",
   "jp": "{v:000A}あ、そうか。{n}僕がリシャール王に似てるから‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0204",
   "jp": "{v:000B}っていうか、あっちがエリオットの{n}そっくりさんなんだけどね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0205",
   "jp": "{v:000C}お兄ちゃん、本当に分からないの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0206",
   "jp": "{FB00}{v:000D}アタシもわかんないケド‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen051.0207",
   "jp": "{FFF3}{FFF5}‥‥{v:004E}うぅ‥‥。",
   "en": "",
   "term": "end"
  },
  {
