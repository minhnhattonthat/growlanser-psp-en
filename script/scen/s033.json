  },
  {
   "id": "scen033.0027",
   "jp": "・やめる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen033.0028",
   "jp": "いらっしゃい！{n}栄養満点で頭もさえる『マホガク定食』はどうだい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen033.0029",
   "jp": "{FFEB}エルムだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen033.0030",
   "jp": "おう、どんどん食ってくれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen033.0031",
   "jp": "毎度あり！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen033.0032",
   "jp": "金が足りねぇよ‥‥[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen033.0033",
   "jp": "またな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen033.0034",
   "jp": "{v:0033}いらっしゃいませ。{n}この店では、様々なグッズをお買い求めいただけます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen033.0035",
   "jp": "{v:0034}本日はお買い求めですか？{n}それともご売却ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen033.0036",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen033.0037",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen033.0038",
   "jp": "他にも何かおありでしょうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen033.0039",
