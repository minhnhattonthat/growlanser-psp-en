  },
  {
   "id": "scen069.0001",
   "jp": "アイリーン",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen069.0002",
   "jp": "ブラッドレー副学院長",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen069.0003",
   "jp": "{v:00D1}あ、来た来た。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen069.0004",
   "jp": "{v:00D2}どうだった？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen069.0005",
   "jp": "{v:00D3}ローランディアでも、独自に調査してくれてたみたい。{n}すぐにここへ来てくれるってさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen069.0006",
   "jp": "{v:00D4}よし、それじゃ行こうか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen069.0007",
   "jp": "秘密研究所",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen069.0008",
   "jp": "{v:0000}こんなところに家があるよ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen069.0009",
   "jp": "{v:0001}あの人、ここへ入っていったのかしら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen069.0010",
   "jp": "{v:0002}鍵がかかってないよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen069.0011",
   "jp": "{v:0003}こんなところまで人が来るとは思えないからな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen069.0012",
   "jp": "{v:0004}洞窟の秘密通路が鍵みたいなもんだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen069.0013",
   "jp": "扉はかたく閉ざされている。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen069.0014",
   "jp": "モニター上には、{n}『ロック１解除中』と表示されている。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen069.0015",
   "jp": "モニター上に文字が浮かび上がっており、{n}『正しい答えを選べ』と書いてある。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen069.0016",
   "jp": "質問に答えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen069.0017",
   "jp": "魔法学院の４階は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen069.0018",
   "jp": "・薬剤研究フロア",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen069.0019",
   "jp": "・図書室",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen069.0020",
   "jp": "・講義室",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen069.0021",
   "jp": "魔法学院の学食にある４人卓の数は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen069.0022",
   "jp": "・４卓",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen069.0023",
   "jp": "・６卓",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen069.0024",
   "jp": "・８卓",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen069.0025",
   "jp": "魔法学院に立っている集魔柱は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen069.0026",
   "jp": "・６本",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen069.0027",
   "jp": "・７本",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen069.0028",
   "jp": "・８本",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen069.0029",
   "jp": "机の上には数冊の古書が無造作に置かれているが、{n}その上にもほこりが積もっている。{n}どうやら長い間使われていないようだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen069.0030",
   "jp": "一般魔導生命体論{n}高等魔導生命学概論{n}歴史に見るホムンクルス{p}どこでも手に入る、ありふれた本ばかりだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen069.0031",
   "jp": "季節と天体{n}一般次元時空論{n}日食・月食観測記録{p}どこでも手に入る、ありふれた本ばかりだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen069.0032",
   "jp": "前世界史{n}グローシアン遺跡について{n}水晶鉱山調査記録{p}どこでも手に入る、ありふれた本ばかりだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen069.0033",
   "jp": "不思議な光を放つ石の上には、{n}『ロック２解除中』と書いてある。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen069.0034",
   "jp": "不思議な光を放つ石の上には、{n}『３桁の暗証番号を入力せよ』と書いてある。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen069.0035",
   "jp": "暗証番号を入力しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen069.0036",
   "jp": "百の位の数は？",
   "en": "",
   "term": "end"
