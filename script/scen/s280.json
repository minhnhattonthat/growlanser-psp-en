   "term": "null"
  },
  {
   "id": "scen280.0001",
   "jp": "{FFEE}村人を救え！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0002",
   "jp": "{v:0028}どうしてこんなヒドイ事をするのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0003",
   "jp": "{v:0029}自分の利益のために、簡単に人を殺すし、{n}簡単に戦争を起こす。{n}この世界の連中に生きる価値はない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0004",
   "jp": "{v:002A}えぇっ！？{n}何を言ってンの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0005",
   "jp": "{v:002B}だからこの手で滅ぼしてやる‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0006",
   "jp": "{v:0129}滅びるがいい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0007",
   "jp": "{v:0043}あぁっ！",
   "en": "{v:0043}Aah!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen280.0008",
   "jp": "{v:0045}た、隊長！",
   "en": "{v:0045}C-Captain!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen280.0009",
   "jp": "{v:000B}よし、まずは１人‥‥。{n}あとは貴様だけだぞ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0010",
   "jp": "{v:000C}少し減ったようだな。ならば追加だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0011",
   "jp": "{v:002D}追加だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0012",
   "jp": "な、何、ナニ、なんなのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0013",
   "jp": "嘘‥‥人が‥ユングに‥‥。{n}それじゃ、ここのユングって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0014",
   "jp": "くそ！{n}一人も救えなかったか‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0015",
   "jp": "{v:000F}な、何、ナニ、なんなのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0016",
   "jp": "{v:0010}嘘‥‥人が‥ユングに‥‥。{n}それじゃ、ここのユングって‥‥。{p}{v:0011}そんな‥‥戦っても‥いいの‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0017",
   "jp": "{v:0012}どう見ても、もう人間じゃない！{n}こいつらを逃がしたら、他の人たちに被害が出る！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0018",
   "jp": "{v:0013}う‥‥うん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0019",
   "jp": "まだ邪魔をするつもりか！？{n}{FE14}ならば、次はお前たちが{n}闇落としの餌食になるがいい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0020",
   "jp": "くそっ、このままじゃ俺たちも危ないぞ！{n}何としてでも、あいつを止めるんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0021",
   "jp": "{FFEE}ジャスティンを攻撃して闇落としを妨害しろ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0022",
   "jp": "た、たすかったぁ‥‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0023",
   "jp": "うぅ、死ぬかと思った‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0024",
   "jp": "やった、これで助かる‥‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0025",
   "jp": "{v:0014}さすがゲヴェルを倒した連中。{n}簡単にはいかないか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0026",
   "jp": "{v:0015}だがベルガーを始末できたし、闇落としの実験は{n}成功した。今回はこれで良しとしよう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0027",
   "jp": "・お前の目的は何だ？",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen280.0028",
   "jp": "・黙っている",
   "en": "・Stay silent",
   "term": "end",
   "unref": true,
   "src": "ps1"
  },
  {
   "id": "scen280.0029",
   "jp": "{v:0016}そうだ、闇落としとは何だ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0030",
   "jp": "{v:0017}待て！{n}お前の目的は何だ？闇落としとは何だ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0031",
   "jp": "{v:0018}今見ただろう？{n}時空の歪みから闇の物質デュンケルスを呼びだす。{p}{v:002C}デュンケルスに触れた者は闇に侵食され、{n}身も心も化け物になる。{p}{v:0019}いずれこの世界は化け物だらけになるぞ‥‥？{n}くっくっくっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0032",
   "jp": "{v:001A}そんなの許さないよ！{n}アタシたちがやっつけちゃうんだから！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0033",
   "jp": "{v:001B}はっはっはっはっは、楽しみにしてるよ。{p}{v:001C}メルフィ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0034",
   "jp": "{v:001D}ああ‥‥逃げられちゃった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0035",
   "jp": "{v:001E}チッ！{n}とにかく今はこの化け物を何とかする方が先だ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0036",
   "jp": "{v:001F}もう、いないね‥‥怪物‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0037",
   "jp": "‥‥時空が充分に歪んだようだな‥‥。{n}{FFFB}あとは、裂け目から大量のデュンケルスを{n}引き出すだけだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0038",
   "jp": "ちょ、ちょっとヤバいよ！{n}あいつ、ここにデュンケルスを落とすつもりみたい！{n}早く妨害しないと！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0039",
   "jp": "‥‥時間だ。{n}闇に蝕まれ苦しみながら、果てるがいい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0040",
   "jp": "ＧＹＡＡＡ‥‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0041",
   "jp": "ＧＹＵＵ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0042",
   "jp": "ＧＧＧ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0043",
   "jp": "ＧＹＡＡ‥‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0044",
   "jp": "ＧＵＵ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0045",
   "jp": "バカバカ！{n}みんな死んじゃったじゃない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0046",
   "jp": "うあぁあ！{n}いや‥だ、助けて‥‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0047",
   "jp": "こ、こんなとこで‥‥{n}死にたく‥な‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen280.0048",
   "jp": "うああああっ‥‥！",
   "en": "",
   "term": "end"
  }
 ]
}
