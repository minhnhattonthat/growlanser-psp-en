  },
  {
   "id": "scen191.0002",
   "jp": "忠犬ペチ",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen191.0003",
   "jp": "患者",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen191.0004",
   "jp": "アイリーン",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen191.0005",
   "jp": "医者",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen191.0006",
   "jp": "そろそろ集合時間だね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0007",
   "jp": "{n}　　　　　　　鍵がかかっている。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0008",
   "jp": "　{n}　　　　　携帯集魔柱が設置してある。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0009",
   "jp": "俺は客でも患者でも、医者でもない。{n}それじゃ何だって？{p}ここがこれだけ整備されているのは、{n}俺たちが影ながら働いているからだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0010",
   "jp": "最近の子供は‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0011",
   "jp": "お兄ちゃん達、{n}僕のプロポーズをジャマしないでよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0012",
   "jp": "ねぇ、いいだろ？{n}ぜったい、しあわせにするからさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0013",
   "jp": "僕たちの出会いは、ぐうぜんじゃないと思うんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0014",
   "jp": "おお、マイ・エンジェル！{n}キミは神が僕のためにつかわした天使だ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0015",
   "jp": "‥‥月並みなセリフね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0016",
   "jp": "‥‥ちょっとは考えちゃうかも{FFF0}♥{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0017",
   "jp": "‥‥でも、結婚するなら、お金持ちじゃないとね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0018",
   "jp": "保養所にご用ですか？{p}東にある宿屋の前を通って、北に行けばすぐですよ。{n}一本道ですから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0019",
   "jp": "イベント番号は{FFEB}番。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0020",
   "jp": "休暇{FFEB}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0021",
   "jp": "カウンタ２は{FFEB}番。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0022",
   "jp": "仲間１はミーシャ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0023",
   "jp": "仲間１はアリオスト。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0024",
   "jp": "仲間１はカレン。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0025",
   "jp": "仲間１はエリオット。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0026",
   "jp": "仲間１はジュリアン。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0027",
   "jp": "仲間１はゼノス。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0028",
   "jp": "仲間２はミーシャ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0029",
   "jp": "仲間２はアリオスト。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0030",
   "jp": "仲間２はカレン。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0031",
   "jp": "仲間２はエリオット。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0032",
   "jp": "仲間２はジュリアン。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0033",
   "jp": "仲間２はゼノス。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0034",
   "jp": "セーブＯＮにする？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0035",
   "jp": "{n}　　　　　　　　　　準備中",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0036",
   "jp": "お天気、だ～い好き{FFF0}♥{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0037",
   "jp": "‥‥{v:00D3}あ。{p}{v:00D4}ねぇ、どうする？{n}カレンさん、思い詰めた顔してるけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0038",
   "jp": "そっとしておこうよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0039",
   "jp": "くぅ～ん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0040",
   "jp": "{FFF3}‥‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0041",
   "jp": "あれ‥‥？{n}メルフィさん、どこに行っちゃったんだろう？{n}せっかく部品を買ってきたのに‥‥。{p}{FC00}もしかしたら、もう退院したのかな？{n}{FFFB}メルフィさんがいそうな場所があったら、{n}改めて立ち寄ってみましょ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0042",
   "jp": "ごめんなさい、今、ちょっと手が放せないの。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0043",
   "jp": "おやおや、{n}私をたずねて来てくれたのかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0044",
   "jp": "お見舞いですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0045",
   "jp": "保養所内ではお静かにね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0046",
   "jp": "ヒマだな～。{n}お兄ちゃん、遊んでよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0047",
   "jp": "今日も天気だ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0048",
   "jp": "カレンさんってよく働く人ね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0049",
   "jp": "違う、これじゃない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0050",
   "jp": "いったいどれなの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0051",
   "jp": "お父さんをこんな村に住ませてあげたいわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0052",
   "jp": "こら、外へ出たら連絡が取れなくなるでしょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0053",
   "jp": "みんなを置いて、どこへ行こうってのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0054",
   "jp": "今日はここで一日過ごすんでしょ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0055",
   "jp": "さて、解散しましょ～か。{n}集合時間に遅れないようにね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0056",
   "jp": "アタシたちも行こっか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0057",
   "jp": "お兄ちゃん、アリオストさんのおかげで{n}ミーシャは立ち直ってくれたよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0058",
   "jp": "みんなそろったよね？{n}じゃあ、戻ろうか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0059",
   "jp": "私、保養所を手伝って来ます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0060",
   "jp": "俺も、保養所にいるぜ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0061",
   "jp": "保養所にいるぜ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0062",
   "jp": "‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0063",
   "jp": "じゃあ、夕方ここでな。{n}みんな、集合に遅れるんじゃねぇぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0064",
   "jp": "お兄ちゃん。{n}わたし、どうしてもミーシャの事が気になるの。{n}ちょっと行ってくる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen191.0065",
   "jp": "ルイセ君、僕も頼む。",
   "en": "",
   "term": "end"
  }
 ]
}
