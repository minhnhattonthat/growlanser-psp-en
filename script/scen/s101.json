  {
   "id": "scen101.0002",
   "jp": "市民",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen101.0003",
   "jp": "うわぁ～！{n}人がいっぱいいるよ～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0004",
   "jp": "何が売ってるのかなぁ♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0005",
   "jp": "ね、ちょっと遊んでいく？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0006",
   "jp": "わ～い♪{n}それじゃ、解散ね★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0007",
   "jp": "アタシ達も、行こうか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0008",
   "jp": "仕事があるから、遊んでいる暇はないな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0009",
   "jp": "ちぇっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0010",
   "jp": "えっ、もう帰っちゃうの？{n}それじゃ、みんなに集合をかけるけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0011",
   "jp": "みんなに集合をかけますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0012",
   "jp": "・まだ楽しむ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen101.0013",
   "jp": "・任務へ戻る",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen101.0014",
   "jp": "それじゃ、もっと楽しもうよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0015",
   "jp": "そうね。{n}任務があるんだもんね。{p}それじゃ、みんなを呼んでくるね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0016",
   "jp": "いらっしゃい。{n}ファッショナブルつけ物石だよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0017",
   "jp": "いらっしゃい。{n}この水晶、買っていかないかい？{p}魔水晶じゃないから、何の役にも立たないけど、{n}置物としては結構、綺麗だろ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0018",
   "jp": "いらっしゃい。{n}ここは薬屋じゃよ。{n}ま、買い取りもやっておるが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0019",
   "jp": "それで何のご用かのぉ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0020",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen101.0021",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen101.0022",
   "jp": "他にも用はあるかのぉ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0023",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen101.0024",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen101.0025",
   "jp": "また来ておくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0026",
   "jp": "いらっしゃいませ。{n}アクセサリーはいかがですか？{p}若手の細工師が練習のために造った物なので、{n}正規の商品より多少質は落ちますが、{n}その分、セットでお安くなっております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0027",
   "jp": "へぇ～★{n}本当にいろんな種類のが入ってるんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0028",
   "jp": "使っている宝石も、本物ですよ。{n}もちろん高級品ではありませんが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0029",
   "jp": "そういえば、ルイセちゃんが欲しがってたわね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0030",
   "jp": "１セット、１００エルムですが、{n}『アクセサリー・セット』を買いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0031",
   "jp": "・他の商品を見て回る",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen101.0032",
   "jp": "・すぐにでも買う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen101.0033",
   "jp": "またいらして下さいね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0034",
   "jp": "　{n}プレゼント『{FFEF}アクセサリー・セット{FFF1}』を購入した！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0035",
   "jp": "ありがとうございました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0036",
   "jp": "ルイセちゃん、喜ぶぞぉ！{n}さっそくプレゼントしてあげようよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0037",
   "jp": "‥‥お金が足りないみたいですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0038",
   "jp": "いらっしゃい。{n}いろんな武器があるぞ。{n}中古品だから安いよ。{p}ただし、刃はつぶしてあるから、{n}実戦には使えんがね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0039",
   "jp": "アタシ達には役に立たないね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0040",
   "jp": "いらっしゃい。{n}古本屋だよ。{p}うちの息子がちょっと前まで使ってた{n}参考書がいっぱいあるんだよ。{n}ちょっと難しすぎるかも知れないけどね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0041",
   "jp": "ねぇねぇ、この薬草の本なんか{n}カレンさんが欲しがりそうじゃない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0042",
   "jp": "１冊、５０エルムですが、{n}『薬草大辞典』を買いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0043",
   "jp": "・他の商品を見て回る",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen101.0044",
   "jp": "・すぐにでも買う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen101.0045",
   "jp": "また来て下さいね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0046",
   "jp": "　{n}プレゼント『{FFEF}薬草大辞典{FFF1}』を購入した！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0047",
   "jp": "きっと喜ぶぞぉ！{n}さっそくプレゼントしてあげようよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0048",
   "jp": "‥‥お金が足りないみたいですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0049",
   "jp": "いらっしゃい。{n}ここは花屋です。{p}切り花、鉢植え、{n}それに種や球根のセットもありますよ！{p}特にこのセットは、{n}北から南までのいろんな植物がそろえてあるのよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0050",
   "jp": "そういえば、ミーシャが{n}珍しい花を欲しがってたわね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0051",
   "jp": "１セット、５０エルムですが、{n}『種と球根のセット』を買いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0052",
