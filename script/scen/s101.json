   "id": "scen101.0062",
   "jp": "　{n}　　　プレゼント『{FFEF}耐熱容器{FFF1}』を購入した！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0063",
   "jp": "アリオストさん、きっと喜ぶぞぉ！{n}さっそくプレゼントしてあげようよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0064",
   "jp": "{v:0007}あ、お兄ちゃん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0065",
   "jp": "{v:0008}ねぇ、わたしにアクセサリーって似合うかな‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen101.0066",
   "jp": "・何でも似合うと答える",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen101.0067",
   "jp": "・まだちょっと早いと答える",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen101.0068",
   "jp": "・わからない",
