  {
   "id": "scen270.0001",
   "jp": "警報",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen270.0002",
   "jp": "{v:0015}アタシ達の邪魔をしないでよね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen270.0003",
   "jp": "{v:0016}お願い、そこを通して！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen270.0004",
   "jp": "{v:0017}おまえの負けだ、おとなしくくたばれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen270.0005",
   "jp": "{v:0018}もう、どうしてアタシたちの邪魔ばかりするのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen270.0006",
   "jp": "{v:0019}僕たちは諦めない！　最後の最後まで！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen270.0007",
   "jp": "{v:001B}あなたのせいで、罪もない人が何人も苦しんだ‥‥。{n}許せません！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen270.0008",
   "jp": "{v:001C}俺はお前みたいな奴が一番嫌いなんだよ。死にやがれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen270.0009",
   "jp": "{v:001A}僕たちの世界のすべての人たちの{n}運命がかかっているんだ！{n}絶対に負けられない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen270.0010",
   "jp": "{v:001D}この死にぞこないめ！{n}地獄に落ちろ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen270.0011",
   "jp": "{v:0022}何故だ‥何故‥‥。{n}体が‥‥うぐおぉぉぉっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen270.0012",
   "jp": "{v:001E}私は‥１人では死なん‥‥。{n}死ぬときはお前たちも道連れだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen270.0013",
   "jp": "{v:0034}歪み率が３５％を越えました‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen270.0014",
   "jp": "{v:0035}そんな、間に合わなかったなんて‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen270.0015",
   "jp": "{v:0011}歪み率が３３％を越えました。{p}{v:0033}歪み率が危険値に達しています。{n}速やかにパワーストーンを用い、{n}時空制御装置を緊急モードに移行してください。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen270.0016",
   "jp": "{v:0010}歪み率が３０％を越えました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen270.0017",
   "jp": "{v:000F}歪み率が２８％を越えました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen270.0018",
   "jp": "{v:000E}歪み率が２５％を越えました。",
   "en": "",
   "term": "end"
  }
 ]
}
