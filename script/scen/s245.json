  },
  {
   "id": "scen245.0002",
   "jp": "{FFEE}カレンと副学院長を守れ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0003",
   "jp": "{v:003B}どうやらその娘の命はいらないようですね？{p}{v:003C}ならば望みどおり殺してあげましょう！{p}‥‥{v:003D}ギプト・カレン・ダイ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0004",
   "jp": "{v:003E}今だ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0005",
   "jp": "{v:003F}な、何っ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0006",
   "jp": "{FFF3}‥{FE14}‥{FE14}{FFF4}{v:0040}私‥生きてる‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0007",
   "jp": "‥{v:0041}はは‥やった‥‥やったぞ、成功だ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0008",
   "jp": "{v:0042}お前の呪いはこの私が防いだ！{n}もう彼女を殺させはしない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0009",
   "jp": "{v:0044}おのれっ！{FFF9}{FFFB}{n}{v:0045}皆殺しにしろ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0010",
   "jp": "{FFEE}カレンと副学院長を守りながら戦え！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0011",
   "jp": "{v:0046}みんな、何をしているんだ？{n}このままじゃ殺されてしまうぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0012",
   "jp": "{v:0047}だ、だけど、カレンさんが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0013",
   "jp": "{v:0048}私を信用しろ！{n}彼女の呪いは私が解く！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0014",
   "jp": "‥‥{v:0049}わかった。それじゃ任せるぜ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0015",
   "jp": "{v:008A}カレン！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0016",
   "jp": "{v:008B}兄さん！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0017",
   "jp": "‥‥{v:008C}ええい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0018",
   "jp": "{v:008D}ゼノス？{p}{v:008E}もう大丈夫だよ！{n}カレンさんの呪いはもう解けたから！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0019",
   "jp": "{v:008F}カレンの呪いが‥‥。{p}{FC04}‥‥{v:0090}そうか‥‥そうか‥‥！{p}{FC00}{v:0091}やい、ガムラン！{n}よくも妹を酷い目にあわせてくれたな！{n}この礼は、きっちり返させてもらうぜ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0020",
   "jp": "‥‥{v:0092}ええい、貴様などもう要らん！{n}ここでまとめて殺してやる！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0021",
   "jp": "{v:0093}うぅっ！{n}た、助けてくれぇ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0022",
   "jp": "{v:0094}大変ッ！{n}この人、弱いんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0023",
   "jp": "{v:0095}うぅ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0024",
   "jp": "{v:0096}カレンさんが危ないよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0025",
   "jp": "‥{v:0097}ごめん‥みんな‥せっかく‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0026",
   "jp": "{v:0098}カレンさん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0027",
   "jp": "‥{v:0099}貴様だけは、絶対に許さねぇ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0028",
   "jp": "{v:009A}返り討ちにしてあげますよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0029",
   "jp": "グッ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0030",
   "jp": "クハッ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0031",
   "jp": "‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0032",
   "jp": "おのれ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0033",
   "jp": "力が‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0034",
   "jp": "ゲフッ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0035",
   "jp": "バカな‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0036",
   "jp": "うぅ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0037",
   "jp": "くっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0038",
   "jp": "{v:009B}おのれっ！{n}覚えていろ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen245.0039",
   "jp": "{v:009C}くっ！{n}逃げ足だけは速い奴だ。",
   "en": "",
