  {
   "id": "scen225.0001",
   "jp": "村人",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen225.0002",
   "jp": "ユング",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen225.0003",
   "jp": "{FFEE}村人を助け出せ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen225.0004",
   "jp": "‥‥{v:0063}う‥うぅ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen225.0005",
   "jp": "{v:0064}人間のどこにここまでの力が‥‥。{n}だがここでの目的は既に果たした‥‥。{n}お前たちは‥‥手遅れ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen225.0006",
   "jp": "{v:0065}これで最後‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen225.0007",
   "jp": "‥‥{v:0066}そうみたい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen225.0008",
   "jp": "{v:0067}どうやら、そうみたいだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen225.0009",
   "jp": "‥‥{v:0068}もう、いないみたいです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen225.0010",
   "jp": "う、うわっ！{n}く、来るなっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen225.0011",
   "jp": "{v:005E}ぐわぁっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen225.0012",
   "jp": "た、助けてくれ～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen225.0013",
   "jp": "{v:005F}ぎゃああっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen225.0014",
   "jp": "も、もう‥ダメ‥だ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen225.0015",
   "jp": "{v:0054}喰イコロス！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen225.0016",
   "jp": "う、ぐはっ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen225.0017",
   "jp": "{v:0007}バカバカバカ！{n}なにやってんのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen225.0018",
   "jp": "{v:0060}ああっ！{n}１人食べられちゃった！{p}{v:0061}やばいよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen225.0019",
   "jp": "{v:0055}人間風情がなかなかやるようだな。{p}{v:0056}ならばこれでどうだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen225.0020",
   "jp": "{v:0057}な、なんだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen225.0021",
   "jp": "{v:0058}まさか‥‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen225.0022",
   "jp": "{v:0059}さぁ、こいつらを食らうがよい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen225.0023",
   "jp": "{v:005A}ニンゲン、喰ウ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen225.0024",
   "jp": "{v:005B}大変！あの人たち、食べられちゃう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen225.0025",
   "jp": "{v:005C}はっ！　彼らがあぶない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen225.0026",
   "jp": "{v:005D}ああ、そんな‥‥。",
   "en": "",
   "term": "end"
  }
 ]
}
