  },
  {
   "id": "scen040.0001",
   "jp": "看護婦",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen040.0002",
   "jp": "医者",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen040.0003",
   "jp": "アルト",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen040.0004",
   "jp": "患者",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen040.0005",
   "jp": "婦長",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen040.0006",
   "jp": "ベルガー",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen040.0007",
   "jp": "ティピ",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen040.0008",
   "jp": "女王ステラ",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen040.0009",
   "jp": "フェザリアン",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen040.0010",
   "jp": "ラシェル保養施設",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0011",
   "jp": "{v:0000}あ、待ってました！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0012",
   "jp": "{v:0001}待っていましたよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0013",
   "jp": "{v:0003}お城から連絡がありまして、{n}入院の用意は出来ています。{n}{s:0001}さんを、こちらへ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0014",
   "jp": "‥‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0015",
   "jp": "{v:0004}あら、どうしたの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0016",
   "jp": "{v:0005}大丈夫だよ、{s:0001}ちゃん？{p}{FFF3}‥{FE1E}‥{FE1E}{FFF4}{v:0006}アンタも一緒に行くしかないわね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0017",
   "jp": "‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0018",
   "jp": "{v:0007}行って来いよ。{n}詳しい説明は俺がしておく。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0019",
   "jp": "{v:0008}それでは、こちらです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0020",
   "jp": "{v:0009}さ、{s:0001}さん。{n}ベッドに横になって。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0021",
   "jp": "{v:000A}ほら、{s:0001}ちゃん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0022",
   "jp": "{v:000B}ね、アンタから言ってみてよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0023",
   "jp": "・寝るように勧める",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen040.0024",
   "jp": "・大丈夫だと落ち着かせる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen040.0025",
   "jp": "・寝るように叱る",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen040.0026",
   "jp": "{v:000C}あら、いい子ね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0027",
   "jp": "{v:000D}本当に大丈夫だからね。{n}お兄ちゃんもここにいるから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0028",
   "jp": "{v:000E}ばかぁっ！{n}怯えさせてどーすんのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0029",
   "jp": "{FB00}{FFF3}‥{FE1E}‥{FE1E}{FFF4}{v:000F}ま、結果は結果だけどね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0030",
   "jp": "{v:0010}もう寝ちゃったわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0031",
   "jp": "{v:0011}そりゃ、王都からここまで歩いてきたんだもん。{n}疲れてて当たり前よね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0032",
   "jp": "{v:0012}私は看護の用意をして来ます。{n}あなたも後のことは私たちに任せて、{n}ロビーへ戻られたらいかがですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0033",
   "jp": "{v:0013}そうよね。{n}早く{s:0001}ちゃんを治す方法を探さないと。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0034",
   "jp": "{s:0001}さん‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0035",
   "jp": "用意はできています。{n}あとはそこの{s:0037}にお任せ下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0036",
   "jp": "さぁ、{s:0001}を診てもらおう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0037",
   "jp": "心配だな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0038",
   "jp": "{s:0001}さん、治るといいですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0039",
   "jp": "診てもらったらどうだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0040",
   "jp": "大丈夫かな、{s:0001}ちゃん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0041",
   "jp": "‥‥心配なのはわかるけどさ、{n}とりあえずみんなの所へ戻らない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0042",
   "jp": "こんな時に、どこへ行く気よ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0043",
   "jp": "ほら！{n}早く、{s:0001}ちゃんのことを診てもらわないと！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0044",
   "jp": "{v:0092}とにかく、ごめんなさい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0045",
   "jp": "‥‥ごめんなさい‥‥。{n}私、ちょっと‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0046",
   "jp": "‥‥あの‥‥私‥‥。{n}兄が‥‥本当の兄じゃないと知ってショックでした。{p}{FC00}けれど、もう大丈夫です。{n}兄とは今まで通りにやっていけると思います。{n}そして、あなたとも‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0047",
   "jp": "それでは、あらためまして。{FFFB}{n}これからも、よろしくお願いします。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0048",
   "jp": "{v:0000}あら、いらっしゃい。{n}どうしたのかしら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0049",
   "jp": "{s:0007}をパーティーに加えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0050",
   "jp": "誰をメンバーから外しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0051",
   "jp": "・{s:FFED}",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen040.0052",
   "jp": "・{s:FFEE}",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen040.0053",
   "jp": "{s:FFED}の装備を回収しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0054",
   "jp": "　{n}　　　　　　{FFEF}{s:0007}が仲間になった！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0055",
   "jp": "なんだね？{n}診察なら順番を待ちたまえ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0056",
   "jp": "お見舞いに来られたのですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0057",
   "jp": "え？{n}{s:0018}さんが元気になっただって？{n}そうか‥‥良かったね。{p}{s:0018}さんには、{n}ここに来てからお世話になりっぱなしだったからね。{p}彼女には‥‥、{n}ミラの分まで、幸せになって貰いたいからね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0058",
   "jp": "本当に‥‥良かったね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0059",
   "jp": "‥‥いったい、ミラはどこへ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0060",
   "jp": "‥‥ミラ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0061",
   "jp": "そうか、あの{s:003C}さんは{s:0007}さんの{s:002B}だったのか。{n}かなりの重傷らしく、面会も出来んのじゃ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0062",
   "jp": "あの{s:003C}さん、やっと回復したと思ったら、{n}死んでしまうなんてなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0063",
   "jp": "あの、記憶を無くした{s:003C}さんが{n}薪を割っているところを見たんじゃが‥‥。{p}それはもう、見事な手つきじゃった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0064",
   "jp": "何となく、僕の研究室に通じるものがあるよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0065",
   "jp": "この薬品の香り‥‥。{FFFB}{n}‥‥‥いいね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0066",
   "jp": "ここの雰囲気は嫌いじゃないけれど、{n}ここのお世話にはなりたくないなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0067",
   "jp": "あなたのお連れさん？{n}それなら、医局の方へ行きましたけど？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0068",
   "jp": "ここは走っちゃだめですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0069",
   "jp": "{n}　　　　　　　鍵がかかっている。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0070",
   "jp": "{n}　　　　　　　鍵がかかっている。{p}　　　　　　　　　　　　　　　　　{n}　　　　　が、中から声が聞こえる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0071",
   "jp": "あの記憶喪失の{s:003C}さん、長いよねー。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0072",
   "jp": "うん、アタシたちがここに来る前からいるんでしょう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0073",
   "jp": "ずいぶん前に迷い込んだらしいんだけど、{n}そんなに歳でもないのに{n}髪の毛が真っ白になってたんだって。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0074",
   "jp": "へ～、そうなんだ？{n}何か怖い{s:012A}にでもあったのかしらね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0075",
   "jp": "あの{s:003C}さん、よほどの事があったんでしょうね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0076",
   "jp": "あの記憶喪失の{s:003C}さん、{n}{s:0007}さんのお父さんだったんだって！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0077",
   "jp": "世の中不思議なこともあるのねぇ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0078",
   "jp": "具合はどうかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0079",
   "jp": "なんともない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0080",
   "jp": "だいぶ良くなったみたいだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0081",
   "jp": "もう、お外で遊んでもい～い？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0082",
   "jp": "ああ、いいよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0083",
   "jp": "やったぁ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0084",
   "jp": "ここにある薬品は、{n}西にある{s:015B}村で採れた薬草から{n}調合しているんですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0085",
   "jp": "婦長。{n}そこの瓶を取っていただけませんか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0086",
   "jp": "はい、これ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0087",
   "jp": "ありがとうございます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0088",
   "jp": "大変な仕事だけど、{n}{s:003C}さんが快復していくのを見ると嬉しくなるわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0089",
   "jp": "たまには{s:0159}村に帰らないと、{n}お父さんが寂しがりそう。{n}こっちに来ればいいのにな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0090",
   "jp": "{v:0014}戻ってきたか。{n}{s:0001}はどうだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0091",
   "jp": "{v:0015}疲れてたのかな、すぐに寝ちゃった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0092",
   "jp": "{v:0016}そうか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0093",
   "jp": "{v:0017}それじゃ、どこから調べますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0094",
   "jp": "{v:0018}それで、どこから調べるの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0095",
   "jp": "{v:0019}そうだよなぁ‥‥。{p}{v:001A}調べるったって、学院長の残した資料は{n}副学院長が調べてるだろうし、{n}城にある資料は{s:014B}様が調べてくれる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0096",
   "jp": "{v:001B}実際、どこから調べればいいのか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0097",
   "jp": "どうすれば{s:0001}ちゃんをもどせるのでしょう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0098",
   "jp": "‥‥{v:001C}ここか‥ここにいるんだな‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0099",
   "jp": "{v:001D}あ‥あれって‥やっぱり‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0100",
   "jp": "‥‥{v:001E}ああ。{n}１９年ぶりにやっと会えたぜ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0101",
   "jp": "{v:001F}あの娘はどこだ？{n}言わぬと‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0102",
   "jp": "{v:0020}ん？{n}こっちか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0103",
   "jp": "{v:0021}大変！{n}{s:0001}ちゃんが！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0104",
   "jp": "{v:0022}絶対にさせるかよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0105",
   "jp": "{v:0058}しっかりして、お父さん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0106",
   "jp": "{v:0059}こんなことでくたばるんじゃねぇよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0107",
   "jp": "{v:005A}すまんな、{s:0005}。{n}お前には迷惑をかけた‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0108",
   "jp": "{v:005B}事情はだいたいわかったよ。{n}だからしっかりしろよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0109",
   "jp": "‥‥{v:005C}{s:0028}隊長‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0110",
   "jp": "{v:005D}しばらく見ない間に老けたな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0111",
   "jp": "{v:005E}当たり前でしょう。{n}あれから２０年近く経ってるんですよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0112",
   "jp": "‥‥{v:005F}ふっ、そうだったな。{n}部隊はどうなってる？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0113",
   "jp": "{v:0060}{s:0157}が面倒を見てくれています。{n}今は{s:0161}の正規軍として、{n}がんばってるようです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0114",
   "jp": "{v:0061}そうか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0115",
   "jp": "{v:0062}お父さん、あまりしゃべらないで。{p}{v:0063}話なら、傷が治ってから、ゆっくり‥‥。{n}ね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0116",
   "jp": "{v:0064}あいつに似て、きれいになったな。{p}{v:0065}すまない、{s:0007}。{n}お前が物心つく前に‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0117",
   "jp": "{v:0066}さ、お父さん。{n}手当てをして、それから少し横になって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0118",
   "jp": "{v:0067}さ、お喋りはそれくらいにして。{n}まずは傷の手当てをして、{n}それから少し横になりましょうね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0119",
   "jp": "{v:0068}ふぅっ。{p}{v:0069}とりあえず、{s:0001}ちゃんも無事だったし一安心だね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0120",
   "jp": "{v:006A}しかし、驚いたぜ。{n}まさかこんな所に隊長がいたとは‥‥。{p}{v:006B}俺の{s:012A}がまともに見えりゃ、{n}すぐに気づいたかも知れねぇが。{p}{v:006C}それに、お前が隊長から作られ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0121",
   "jp": "{v:006D}{s:0002}さん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0122",
   "jp": "{v:006E}ウォ、{s:0002}さん、それは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0123",
   "jp": "{v:006F}お、おい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0124",
   "jp": "{v:0070}ちょ、ちょっと、{s:0002}さん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0125",
   "jp": "{v:0071}{s:0002}殿！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0126",
   "jp": "‥{v:0072}ああ、すまない。{n}お前の気持ちも考えず。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0127",
   "jp": "{s:0002}に何と言いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0128",
   "jp": "・気にしていない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen040.0129",
   "jp": "・本当のことだから仕方がない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen040.0130",
   "jp": "・沈黙を守る",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen040.0131",
   "jp": "{v:0073}本当にすまなかった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0132",
   "jp": "{v:0074}許してくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0133",
   "jp": "‥‥まさか親父がこんなところにいたなんてな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0134",
   "jp": "‥‥俺も、まさかお前が団長の息子だとは{n}思わなかったよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0135",
   "jp": "悪いが、俺は帰らせてもらう‥‥。{n}親父を頼む。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0136",
   "jp": "{v:0075}ねぇ、ねぇ！{n}{s:0001}ちゃんのところに行こうよ？{n}ね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0137",
   "jp": "{v:0076}俺たちはロビーにいるよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0138",
   "jp": "{s:0119}の開けた穴だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0139",
   "jp": "‥‥{s:0001}ちゃん、無事で良かったね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0140",
   "jp": "‥‥何も言わなくていいわよ。{p}わかってる。{n}グローシュを戻す方法を見つけないと、{n}本当に助けたことには、ならないもんね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0141",
   "jp": "‥‥{v:0042}{s:0001}ちゃん、全然{s:012A}を覚まさないね。{p}{v:0043}ひょっとして、このまま‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0142",
   "jp": "‥‥{v:0044}ごめん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0143",
   "jp": "{s:000E}に何と言いますか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0144",
   "jp": "・心配してくれた事に礼をいう",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen040.0145",
   "jp": "・大丈夫だと優しく言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen040.0146",
   "jp": "・罰として、つつく",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen040.0147",
   "jp": "・黙って、{s:000E}の頭をなでる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen040.0148",
   "jp": "・無視する",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen040.0149",
   "jp": "{v:0045}えへへ‥‥。{p}{FC00}{v:0046}{s:0001}ちゃん、絶対良くなるよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0150",
   "jp": "‥‥{v:0047}優しいんだね、アンタ‥。{p}{FC03}{v:0048}アタシがもっと大きかったら、{n}{s:0001}ちゃんの看病とかもできるのに‥‥。{n}何も出来ないなんて‥‥もどかしいよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0151",
   "jp": "{v:0049}アンッ★{n}つつかないでよ！{p}{FC03}{FFF3}‥‥{FFF4}{v:004A}でも、本当にごめんなさい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0152",
   "jp": "‥‥{v:004B}あ‥‥。{p}‥‥{v:004C}アタシがもし人間だったら‥、{n}アンタのこと、慰めてあげられるのに‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0153",
   "jp": "{v:004D}な、何でもない★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0154",
   "jp": "{v:004E}{s:0001}ちゃん、絶対良くなるよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0155",
   "jp": "{v:004F}{s:0001}ちゃん、絶対良くなるよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0156",
   "jp": "{v:0050}アタシね、{s:0001}ちゃんと一緒にいられて、{n}楽しかったよ。{n}アンタと一緒に旅してきた間も。{p}{v:0051}元々アタシは、アンタ達２人のお{s:012A}付役として{n}作られたホムンクルスだけど、{n}ちゃんとした存在として扱ってくれたし。{p}{v:0052}とっても嬉しかったんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0157",
   "jp": "{v:0053}だから、絶対に助けてあげたい。{n}もしアタシの命が必要だったら、{n}いつだってあげる覚悟はあるんだよ。{p}‥‥{v:0054}でも、そんな覚悟があったって‥‥{n}どうやったら‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0158",
   "jp": "‥‥‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0159",
   "jp": "‥‥{v:0055}アンタ、ひょっとして、泣いてるの？{p}‥{v:0056}ううん。{n}いいんだよ、泣いたって。{p}{v:0057}誰にも言ったりしないから。{n}秘密にしてあげるから‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0160",
   "jp": "‥{FE1E}‥{FE1E}‥{FE1E}‥{FE1E}{FFF6}‥{FE1E}。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0161",
   "jp": "‥{FE1E}‥{FE1E}‥。{FFFB}{n}‥‥{v:0058}あはは‥‥やったぁ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0162",
   "jp": "{FFF2}{v:0059}えっ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0163",
   "jp": "‥{v:005A}お兄ちゃん‥泣いてる‥‥。{n}‥‥わたしの‥勝ちだぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0164",
   "jp": "{v:005B}{s:0001}ちゃん！？{p}{v:005C}大丈夫なの、{s:0001}ちゃん？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0165",
   "jp": "‥‥{v:005D}まだちょっと、体がだるいけど。{n}でも頭の中はすっきりしてるよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0166",
   "jp": "{v:005E}よかった‥‥{s:0001}ちゃん、よかったぁ～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0167",
   "jp": "‥‥{v:008C}あ‥‥お兄ちゃん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0168",
   "jp": "{v:005F}ごめんね、お兄ちゃん。{n}‥{s:000E}。{n}みんなにも心配かけちゃったみたいだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0169",
   "jp": "{v:0060}したわよ、いっぱい！{n}いっぱい、いっぱい、心配したんだから！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0170",
   "jp": "{v:0061}うん‥‥。{n}ありがと。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0171",
   "jp": "‥‥{v:0062}ぐすっ。{n}でも、本当によかった。{p}{v:0063}ほら、いつまでそうしてんの！{n}みんなのところに行って、安心させてあげましょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0172",
   "jp": "{v:0064}そうだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0173",
   "jp": "‥‥{v:0065}あ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0174",
   "jp": "{v:0066}どうしたの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0175",
   "jp": "{v:0067}ペンダント‥‥割れちゃってる‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0176",
   "jp": "{v:0068}本当だ。{n}どうしたんだろ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0177",
   "jp": "{v:0069}きっと、願いごとが効いたんだよ。{n}だから、このペンダントの御利益が{n}終わっちゃったんだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0178",
   "jp": "{v:006A}ペンダント様々だね♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0179",
   "jp": "{v:006B}あと、お兄ちゃんの涙にもね♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0180",
   "jp": "{v:006C}あははっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0181",
   "jp": "‥‥この部屋は、わたしの思い出の場所になりそう{FFF0}♥{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0182",
   "jp": "こんな時にどこへ行こうってのよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0183",
   "jp": "今、医局は忙しいので、{n}入室はご遠慮願います。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0184",
   "jp": "{v:0000}まさか隊長が‥‥。{p}{v:0001}何より、無事で良かったぜ。{n}俺の{s:012A}的の半分はこれで果たした。{n}あとはヤツを倒すだけだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0185",
   "jp": "{v:0002}お兄さま‥‥。{n}元気を出してね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0186",
   "jp": "{v:0003}人は前向きに生きてこそ、存在意義をもてるんだ。{n}これが僕たちの村の信条さ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0187",
   "jp": "{v:0005}まさかお前が親父と同じだったとはな。{p}‥‥{v:0006}複雑な気持ちだぜ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0188",
   "jp": "{v:0007}絶対にあいつを倒しましょう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0189",
   "jp": "{v:0008}あ‥‥いや、何でもない。{p}{v:0009}私より、妹の側に行ってやるといい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0190",
   "jp": "親父は俺が７才の頃いなくなったんだ。{n}お袋は俺と{s:0007}を女手一つで育ててくれた。{p}{FC03}その無理がたたったのか、お袋は体をこわし、{n}俺が１５才の時に死んだ。{p}{FC00}俺は傭兵となり、{n}あっちこっちの戦場を駆けめぐりながら、{n}親父を捜した。{p}親父が傭兵をしていたことは、{n}お袋から聞いていたからな。{p}{FC02}何とか親父を見つけだし、{n}そして‥{FE14}‥{FE14}‥{FE14}一発、殴ってやろうと思ってた。{p}だってそうだろう？{n}親父がいなくならなきゃ、お袋も死なずにすんだ。{n}{s:0007}だって苦労することもなかった‥‥。{p}{FC03}それがどうだ‥‥。{n}やっと見つけたと思ったら‥‥。{FFFB}{n}{FC02}‥‥くそっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0191",
   "jp": "今、{s:0028}さんを治療しているところです。{n}お引き取り下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0192",
   "jp": "{v:00AF}お父さんは治療中です。{n}でもあなたが父と一緒だったなんて‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0193",
   "jp": "{v:0004}お父さんは治療中です。{n}それより{s:0001}ちゃんの所へ行ってあげなくて{n}いいんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0194",
   "jp": "‥‥私、ちょっと、ショックを受けてます。{n}まさかあの{s:003C}さんが、お父さんだったなんて。{p}お父さんはまだ私が２つか３つの頃に家を出て、{n}帰らなくなったと母から聞きました。{p}その母も私が１０才の時に亡くなり、{n}それからは、兄が私を育ててくれたんです。{p}兄が傭兵をはじめると言い出したときは、{n}すごく反対しました。{p}だって、お父さんも傭兵をしていて、{n}行方不明になったと聞かされていましたから。{p}もしお父さんが『{s:0028}』という自分の名前を{n}思い出してくれれば、もっと早く気づけたのですが、{n}私はお父さんの顔を覚えていなかったので‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0195",
   "jp": "いったい、さっきのは何だね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0196",
   "jp": "こ、怖かった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0197",
   "jp": "とりあえず、生きています‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0198",
   "jp": "あの、記憶を無くした{s:003C}さん、{n}怪物と戦ったんだと？{p}無事だといいが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0199",
   "jp": "ほとんどの{s:003C}さんが{n}逃げられて良かったです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0200",
   "jp": "あら、いらっしゃい。{n}どうしたのかしら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0201",
   "jp": "{v:006D}あぁっ！{n}{s:0001}ちゃん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0202",
   "jp": "{v:006E}ル、{s:0001}君！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0203",
   "jp": "{v:006F}{s:0001}ちゃん！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0204",
   "jp": "{v:0070}お、おい‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0205",
   "jp": "{v:0071}{s:0001}さん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0206",
   "jp": "{v:0072}{s:0001}‥‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0207",
   "jp": "‥‥{v:0073}みんな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0208",
   "jp": "{v:0074}おい、本当に{s:0001}なのか？{n}俺の{s:012A}が見えないからって、{n}かつごうってんじゃないだろうな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0209",
   "jp": "{v:0075}ごめんね、{s:0002}さん。{n}でも、もう大丈夫だから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0210",
   "jp": "{v:0076}{s:0001}！{p}{v:0077}やったな！{n}やりやがったな！{n}めでてぇじゃねぇか、コンチクショウ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0211",
   "jp": "{v:0078}すごいよね、これって奇跡だよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0212",
   "jp": "{v:0079}あのパワーストーンのおかげか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0213",
   "jp": "{v:007A}あのパワーストーンの力ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0214",
   "jp": "{v:007B}あのパワーストーンてやつのおかげか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0215",
   "jp": "{v:007C}ううん。{n}プロミス・ペンダントのおかげよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0216",
   "jp": "{v:007D}プロミス・ペンダント？{n}{s:012A}的を達成したときに願いが叶うって、アレか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0217",
   "jp": "‥‥{v:007E}あ。{n}そうか、そういうことか。{n}つまり‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0218",
   "jp": "{v:007F}そうそう★{n}コイツったらね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0219",
   "jp": "{s:000E}を止めますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0220",
   "jp": "‥{v:0080}モガモガ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0221",
   "jp": "{v:0081}ゲホ、ゲホッ！{n}アンタ、アタシを窒息させる気！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0222",
   "jp": "{FB00}{v:0082}今のは、{s:000E}が悪いよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0223",
   "jp": "{v:0083}コイツったら、つい泣いちゃってさ。{n}それで{s:0001}ちゃんの願いが叶ったんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0224",
   "jp": "{v:0084}ま、何にしてもよかったじゃねぇか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0225",
   "jp": "{v:0085}あの、今から魔法学院に行きたいの。{n}つきあってくれるかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0226",
   "jp": "{v:0086}えっ？{n}どうして？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0227",
   "jp": "{v:0087}もし本当にプロミス・ペンダントにグローシュを{n}取り戻す力があるんだったら、これを調べて貰えば、{n}{s:0018}さん達も治るかもって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0228",
   "jp": "{v:0088}{s:0018}さん、治るのですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0229",
   "jp": "{v:0089}彼女たちが治るのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0230",
   "jp": "{v:008A}わからないけど、可能性があるかもって。{n}だから学院に行って、このペンダントを{n}調べてもらいたいの。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0231",
   "jp": "{v:008B}なるほどな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0232",
   "jp": "学院でペンダントを調査",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0233",
   "jp": "‥‥{v:000A}ここで良いのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0234",
   "jp": "{v:000B}はい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0235",
   "jp": "{v:000C}あ、あれって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0236",
   "jp": "{v:000D}フェザリアンの女王？{p}{v:000E}だが、どうして地上に？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0237",
   "jp": "{v:000F}あ、いました。{n}あそこです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0238",
   "jp": "{v:0010}あの‥何か‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0239",
   "jp": "{v:0011}彼女はどうした？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0240",
   "jp": "{v:0012}へっ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0241",
   "jp": "{v:0013}あのグローシアンの娘はどうした？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0242",
   "jp": "{v:0014}{s:0001}なら、奥の部屋で寝ている。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0243",
   "jp": "{v:0015}グローシュは無事であるか？{p}{v:0016}{s:00EA}の情報によれば、{n}その者からグローシュが消えたということだが。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0244",
   "jp": "{v:0017}残念ながらその通りだ。{n}{s:0001}は{s:0025}の野郎にグローシュを奪われ、{n}今や生ける人形だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0245",
   "jp": "‥‥{v:0018}やはりな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0246",
   "jp": "{v:0019}それがどうしたのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0247",
   "jp": "{v:001A}{s:0119}を倒すには、{n}グローシアンの存在が不可欠であった。{n}それを‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0248",
   "jp": "{v:001B}だから、どうやったら{s:0001}を治せるか、{n}みんなで考えているところだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0249",
   "jp": "{v:001C}ねぇ、ねぇ！{n}あなた達の力なら、{s:0001}ちゃんを治せる？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0250",
   "jp": "{v:001D}我々の力を持ってしても、それは出来ぬ。{p}{v:001E}グローシアンの発生は自然の力。{n}それを取り戻すことが出来るなら、{n}人為的にグローシアンを作れる事を意味しておる。{p}{v:001F}当面の問題は、{s:0119}を止める手段が{n}失われたということだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0251",
   "jp": "{v:0020}どうしてそこまで{s:0119}にこだわるのですか？{n}あれは昔のグローシアンが作ったものでしょう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0252",
   "jp": "{v:0021}やけに{s:0119}にこだわるじゃねぇか。{n}あれは昔のグローシアンが造ったもんだろ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0253",
   "jp": "{v:0022}たしかにあの{s:0119}はグローシアンが作ったもの。{n}しかし、元々は我々が造ったものなのだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0254",
   "jp": "{v:0023}えぇーーーっ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0255",
   "jp": "{v:0024}詳しく説明しよう。{p}{v:0025}はるか昔、まだ我々が地上で生活をしていた頃。{n}この世界を支配しようとするグローシアンと、{n}戦いになったことがあった。{p}{v:0026}そこで体力的に劣る我々は技術力を使い、我々の{n}代わりにグローシアンと戦うための生物兵器を造った。{n}それが{s:0119}の始まりなのだ。{p}{v:0027}しかしその{s:0119}はすぐに捕らえられ、{n}逆に、グローシアンの兵器として{n}改造されてしまったのだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0256",
   "jp": "{v:0028}だからグローシアンには弱いんですか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0257",
   "jp": "{v:002A}あ、それで{s:0001}ちゃんとかに弱いんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0258",
   "jp": "{v:002B}だからグローシアンが弱点なのか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0259",
   "jp": "{v:002C}それでグローシュを持つ者には弱いのだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0260",
   "jp": "{v:002D}それでグローシュに弱くなっているのか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0261",
   "jp": "{v:0029}だからグローシュを持つ者の前では弱くなるんですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0262",
   "jp": "{v:002E}ああ、それで{s:0001}ちゃんとかに弱いんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0263",
   "jp": "{v:002F}さらに、我々が造った浮遊装置まで、{n}奪われたことがあった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0264",
   "jp": "{v:0030}だとしたら、フェザリアンはどうしたんだ？{n}唯一の武器である{s:0119}を奪われちまったんだろ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0265",
   "jp": "{v:0031}ゆえに、我々は人間との接触を避けるため、{n}地上での生活を捨てたのだ。{p}{v:0032}人間のどん欲さを忘れていた我々の、{n}そして{s:0119}を造ってしまった我々の落ち度だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0266",
   "jp": "{v:0033}元はと言えば、地上を支配しようとした{n}グローシアンが悪いんだろ？{n}欲を出しすぎた報いだぜ。{p}{v:0034}だがどうして俺たちにそこまで話してくれるんだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0267",
   "jp": "{v:0035}先ほど言ったであろう。{p}{v:0036}元々の{s:0119}を造ったのは、{n}紛れもなく我々フェザリアン。{n}今回の事件の原因の一端は、我々にもある。{p}{v:0037}実際はグローシアンが、{n}そしてグローシアンを生み出したそなたら人間が{n}起こしたことではある。{p}{v:0038}責任はそなたら自身でとってもらわねばならぬが、{n}情報を与えるぐらいは、しておくことにしたのだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0268",
   "jp": "{v:0039}もっと手を貸してくれればいいのに！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0269",
   "jp": "{v:003A}それは出来ぬ。{n}人間が起こした問題は、{n}人間によって収拾されるべきであろう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0270",
   "jp": "{v:003B}ぶぅ～っ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0271",
   "jp": "{v:003C}それじゃ、{s:0025}って名前に{n}聞き覚えはないか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0272",
   "jp": "{v:003D}{s:0025}？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0273",
   "jp": "{v:003E}覚えがあるんだな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0274",
   "jp": "‥‥{v:003F}確かに聞き覚えはあるが、{n}それ以上のことはわからぬ。{n}また新しいことがわかれば、助言をいたそう。では。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0275",
   "jp": "{v:0040}勝手な連中だな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0276",
   "jp": "お兄ちゃん！{n}ちゃんとみんなに挨拶させてよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0277",
   "jp": "‥‥{v:008D}あ、あの‥‥。{FFF9}{FFFB}{n}{v:008F}ごめんなさい。{n}私、ここに残ります。{p}{v:0091}父のこととか、心配なので‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen040.0278",
   "jp": "{s:0007}の装備を回収しますか？",
   "en": "",
   "term": "end"
  }
 ]
}
