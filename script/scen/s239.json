  },
  {
   "id": "scen239.0001",
   "jp": "覆面の男",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen239.0002",
   "jp": "{FFEE}王母を守りながら脱出しろ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0003",
   "jp": "{v:008C}ちょっと！{n}ぐずぐずしてると、焼け死んじゃうよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0004",
   "jp": "{v:004F}きゃああっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0005",
   "jp": "{v:0051}きゃあっ、お兄ちゃん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0006",
   "jp": "{v:0050}しまったっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0007",
   "jp": "{v:0052}いや～っ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0008",
   "jp": "{v:0053}し、しまった！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0009",
   "jp": "{v:0054}アンジェラ様、覚悟‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0010",
   "jp": "‥‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0011",
   "jp": "{v:0062}ああっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0012",
   "jp": "‥‥{v:0063}任務完了‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0013",
   "jp": "{v:0064}そんな、アンジェラ様が‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0014",
   "jp": "{v:0056}あとは任せましたよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0015",
   "jp": "{v:0057}逃げるのか、ガムラン！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0016",
   "jp": "{v:0058}貴様らごときに、{n}なぜこの私の手を汚す必要があるのです？{n}では、ごきげんよう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0017",
   "jp": "‥‥{v:0059}チッ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0018",
   "jp": "ぐはっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0019",
   "jp": "クッ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0020",
   "jp": "グオォォォーッ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0021",
   "jp": "グ、ガハッ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0022",
   "jp": "ゲフッ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0023",
   "jp": "うぐっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0024",
   "jp": "‥‥{v:0065}こんな気持ちじゃ、負けて当然か‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0025",
   "jp": "‥‥{v:0066}アンタ‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0026",
   "jp": "{v:0067}話は後だ。{n}さっさと敵を始末しちまえよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0027",
   "jp": "{v:005B}だったら余計に退けないよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0028",
   "jp": "{v:005C}アンジェラ様は守ります！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0029",
   "jp": "{v:005D}この状況で退けると思うか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0030",
   "jp": "‥‥{v:0061}お前、まさか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0031",
   "jp": "{v:005E}それは無理というものだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0032",
   "jp": "{v:005F}そんなことさせないモン！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0033",
   "jp": "‥‥{v:005A}邪魔をするな。{n}俺の標的は王母だけだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0034",
   "jp": "‥‥{v:0060}死にたいのか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0035",
   "jp": "{v:0068}ここにいるとヤバイ。{n}本陣に戻ろう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0036",
   "jp": "お待たせしました！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0037",
   "jp": "よし！{n}お前らも行け！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0038",
   "jp": "はっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0039",
   "jp": "むっ！{n}遅かったか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen239.0040",
   "jp": "まぁいい。{n}王母をしとめれば同じこと。{n}行くぞ！",
   "en": "",
   "term": "end"
  }
 ]
}
