  },
  {
   "id": "scen190.0012",
   "jp": "入隊希望者",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen190.0013",
   "jp": "王都ローザリア",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0014",
   "jp": "{v:000F}それじゃ、花火までは自由時間ね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0015",
   "jp": "{v:0010}それでいいだろう。{n}それじゃ、解散だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0016",
   "jp": "{v:0011}花火か‥‥。{n}うふふ、た・の・し・みぃ♥{p}{v:0111}そうだ、いいこと考えた！{p}‥‥{v:0012}あ、マスター？{n}うん、実は今夜の花火大会で‥‥{n}そう、塔の上で見せて欲しいんだ。{p}{v:0013}え？{n}ＯＫ？{n}マスターありがとう★{p}{v:0014}と、言うわけでぇ‥‥、{n}今夜の花火大会は特等席で見られるよ{FFF0}♥{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0017",
   "jp": "帰ってどうすんのよ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0018",
   "jp": "おや？{n}城内に戻られるのですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0019",
   "jp": "{v:0015}ん？{n}１人で行くの？　寂しいヤツねぇ‥‥。{FFF9}{p}{v:0016}誰かいい人いないの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0020",
   "jp": "{v:0017}しょうがないわね。{n}アタシが一緒にいってあげる！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0021",
   "jp": "開門！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0022",
   "jp": "{v:004C}いらっしゃいませ。{n}スキマ屋へようこそ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0023",
   "jp": "{v:0054}これからもスキマ屋をよろしくね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0024",
   "jp": "今日は建国祭か‥‥。{n}今年も開催できて良かったよ、うん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0025",
   "jp": "なんとか建国祭ができるのも{n}君たちのおかげだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0026",
   "jp": "いい天気。{n}これなら夜まで晴れてるわね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0027",
   "jp": "私、花火が大好きなの。{n}楽しみだわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0028",
   "jp": "城門は堅く閉ざされている‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0029",
   "jp": "　{FE1E}‥{FE1E}‥{FE1E}‥{FE1E}売れねぇなぁ{FE1E}‥{FE1E}‥。{FFFB}{n}　‥‥誰も来ねぇし‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0030",
   "jp": "　　特売品多数！{n}　　　アイテムショップ・ココ",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0031",
   "jp": "　　特売品多数！{n}　　　　スキマ屋",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0032",
   "jp": "マンホールの底には、何もないようだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0033",
   "jp": "店の前にあるマンホールだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0034",
   "jp": "マンホールがまるい形をしているのは、{n}向きがずれても落ちないためだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0035",
   "jp": "{v:002C}あ、お兄ちゃん。{n}どうしたの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0036",
   "jp": "ルイセを誘いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0037",
   "jp": "{v:002D}え、わたしを誘ってくれるの？{n}嬉しいな★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0038",
   "jp": "{v:002E}それじゃルイセちゃん、行こう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0039",
   "jp": "{v:002F}じゃあね、お兄ちゃん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0040",
   "jp": "{v:00AB}どうしたんだい？{n}僕に何か用かい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0041",
   "jp": "アリオストを誘いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0042",
   "jp": "{v:00AC}なるほど、君と一緒に花火を見るのも悪くなさそうだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0043",
   "jp": "それじゃ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0044",
   "jp": "{v:00BA}どうしました？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0045",
   "jp": "エリオットを誘いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0046",
   "jp": "{v:00BB}いいですね、行きましょう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0047",
   "jp": "{v:00BC}なにか用がありましたら、{n}声をかけてくださいね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0048",
   "jp": "今日、でっかい花火が上がるんだって。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0049",
   "jp": "早く見たいよな～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0050",
   "jp": "うぅ‥‥。{n}なんか寂しいよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0051",
   "jp": "僕たち、デート中なんだ。{n}邪魔しないでくれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0052",
   "jp": "僕の彼女、ここを散歩するのが好きだったんだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0053",
   "jp": "私たち、デート中なの。{n}邪魔しないで！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0054",
   "jp": "あぁ‥‥。{n}これから私はどうしたらいいの‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0055",
   "jp": "妖精ちゃん。{n}あなたも彼と一緒に頑張ってね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0056",
   "jp": "{v:000C}いらっしゃいませ。{n}当店では、様々な装備品を取り扱っております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0057",
   "jp": "{v:000E}お買い求めですか？{n}それともご売却ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0058",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen190.0059",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen190.0060",
   "jp": "他にもご用はおありですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0061",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen190.0062",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen190.0063",
   "jp": "{v:0018}またどうぞ、お越し下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0064",
   "jp": "やっと商店街へ買い出しに行って来たよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0065",
   "jp": "ごめ～ん。{n}今、手が放せないの。{n}しばらくしたら、また来て。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0066",
   "jp": "あら、私を訪ねてくれたの？{p}そう言えば、スキマ屋には行ってみた？{n}あそこのおじさん、商売熱心だから、{n}たまに新しい物が入ってたりするわよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0067",
   "jp": "デリス村の村長は私の叔父なのよ。{n}今でこそ、ぼ～っとして見えてるけど{n}昔はけっこう切れ者だったらしいわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0068",
   "jp": "‥‥なんか、ず～っと物陰に隠れていると{n}眠くなっちゃうなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0069",
   "jp": "へぇ～。{n}こんな所に出るんだ‥‥。{n}面白いね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0070",
   "jp": "うす汚れたマンホールだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0071",
   "jp": "新しいマンホールだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0072",
   "jp": "　{n}　　　　　南大通り商店街、営業中！！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0073",
   "jp": "今では兵隊さんが品物を買いに来て、大忙しだ。{n}ああ、忙しい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0074",
   "jp": "今はちょっと忙しいの。{n}悪いけど、また後にしてくれないかしら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0075",
   "jp": "{v:004B}あ、お兄さま、どうしたんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0076",
   "jp": "ミーシャを誘いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0077",
   "jp": "{v:004C}本当ですか？{n}嬉しいですぅ{FFF0}♥{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0078",
   "jp": "{v:004D}それじゃ、行こう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0079",
   "jp": "{v:004E}ふに？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0080",
   "jp": "{v:0065}あら、どうしたのですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0081",
   "jp": "カレンを誘いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0082",
   "jp": "{v:0066}ええ、よろこんで。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0083",
   "jp": "{v:0067}私をですか‥‥？{p}{v:0068}わかりました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0084",
   "jp": "{v:0069}それでは。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0085",
   "jp": "ごめんよ。{n}今日は建国祭で客がいっぱいなんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0086",
   "jp": "よく、ここへ来る方法がわかったな‥‥。{n}ここに気づいたのは、お前が初めてだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0087",
   "jp": "{v:0019}おう、いらっしゃい。{n}ここは装備品を売ってる店だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0088",
   "jp": "{v:001B}買いに来たのか？{n}それとも何か売る気か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0089",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen190.0090",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen190.0091",
   "jp": "まだ何か用か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0092",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen190.0093",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen190.0094",
   "jp": "{v:0025}じゃあな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0095",
   "jp": "建国祭をきっかけに{n}ここもにぎやかになるといいわね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0096",
   "jp": "やあ、君たち。{n}頑張って僕らを守ってくれよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0097",
   "jp": "花火か～。{n}新しい遊びのネタにならないかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0098",
   "jp": "　不審な人物を見かけたら、{n}　すぐに警備兵に！{n}　　　～　王都ローザリア警備隊長　～",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0099",
   "jp": "このマンホールをくぐると地底都市が！！{FFFB}{n}‥‥ということは絶対にない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0100",
   "jp": "　　　　　　魔法学院合格率６０％！{n}　　　　実績に裏付けされた信頼の進学塾{n}　　　　　　　『ＬＬＭ魔法教室』",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0101",
   "jp": "何やってんのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0102",
   "jp": "{v:009D}どうした？{n}俺に何か用か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0103",
   "jp": "ウォレスを誘いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0104",
   "jp": "{v:009E}花火と言われてもな‥‥。{p}{v:009F}まあいい、つき合おう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0105",
   "jp": "{v:00A0}そうか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0106",
   "jp": "誰か、花火がよく見える場所を知らないかな～？{n}静かでロマンチックで人の来ないところがいいな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0107",
   "jp": "花火なんてのんきだよな～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0108",
   "jp": "お母さんが、今日は遅くまで起きていてもいいって。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0109",
   "jp": "今、このおじいさんに花火の仕組みを教えていたの。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0110",
   "jp": "わしも打ち上げ花火のように{n}派手な魔法を使いたいのう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0111",
   "jp": "{v:00C9}どうしたんだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0112",
   "jp": "ゼノスを誘いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0113",
   "jp": "{v:00CA}俺と行こうってのか？{n}物好きなやつだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0114",
   "jp": "{v:00CB}行かないの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0115",
   "jp": "{v:00CC}へっ、行くに決まってるじゃねぇか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0116",
   "jp": "すまねぇ‥‥。{n}そんな気分じゃねぇんだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0117",
   "jp": "{v:00CD}またな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0118",
   "jp": "建国祭、楽しみですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0119",
   "jp": "{v:007F}どうなされましたか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0120",
   "jp": "ジュリアンを誘いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0121",
   "jp": "{v:0081}わ、私などでよろしいのですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0122",
   "jp": "{v:0083}それでは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0123",
   "jp": "{v:0080}どうしたのだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0124",
   "jp": "{v:0082}お前と一緒に見るのも、面白そうだな。{n}よし、行こう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0125",
   "jp": "{v:0084}そうか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0126",
   "jp": "{v:0008}これを見てください！{n}全部入隊希望者ですよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0127",
   "jp": "仲間と力を合わせて頑張って下さい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0128",
   "jp": "ここのところ、化け物が出没するので、{n}巡回をしているところです。{p}化け物を操っているらしい、{n}怪しい魔法使いの姿は何度も見かけるのですが、{n}兵が詰めかける頃には消え失せてしまうのです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0129",
   "jp": "‥‥やっぱりヴェンツェルみたいね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0130",
   "jp": "奴のせいで、{n}城にいる仲間の多くが、死んでしまった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0131",
   "jp": "建国祭だというのに今夜も仕事ですよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0132",
   "jp": "気を引きしめて警備しないと。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0133",
   "jp": "‥‥結構、手続きって面倒なんだな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0134",
   "jp": "{v:0009}俺もちっとは腕に自信があるからよ、{n}せめて入隊して、人々を守る兵士になるんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0135",
   "jp": "俺はやるぜ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0136",
   "jp": "{v:000A}俺たちは絶対に負けねぇぜ！{n}だから、アンタらも頼むぜ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0137",
   "jp": "今日中に俺の番になるのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0138",
   "jp": "　{n}　　『出かけるときは、戸締まりを忘れずに！』{n}　　　　　　　～ローザリア警備隊～",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0139",
   "jp": "{v:0033}いらっしゃいませ。{n}この店では、様々なグッズをお買い求めいただけます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen190.0140",
   "jp": "{v:0034}本日はお買い求めですか？{n}それともご売却ですか？",
   "en": "",
