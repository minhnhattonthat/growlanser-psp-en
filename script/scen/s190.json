  },
  {
   "id": "scen190.0009",
   "jp": "ＬＬＭ魔法教室講師",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen190.0010",
   "jp": "ローランディア兵隊長",
   "en": "",
