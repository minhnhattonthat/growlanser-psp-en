  },
  {
   "id": "scen212.0001",
   "jp": "{FFEE}クリアノ草を採取しろ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0002",
   "jp": "あぁ‥‥{n}クリアノ草を持っていたのに、{n}やられちゃうなんて‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0003",
   "jp": "なんだか倒しても倒しても{n}きりがないよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0004",
   "jp": "どういうことだ？{n}これじゃいくら倒しても、きりがねぇぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0005",
   "jp": "うん、アタシもそう思ってた。{n}だから、さっさと脱出しようよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0006",
   "jp": "うん、アタシもそう思ってた。{n}さっさとあの草を取って、脱出しようよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0007",
   "jp": "モンスターがあんまり減ってない気がするよ？{n}これじゃ、きりがないよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0008",
   "jp": "{v:0016}もういないみたいだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0009",
   "jp": "{v:002F}いつガスが噴き出すかわからんぞ。{n}無駄な戦いは避けて、出口へ急ごう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0010",
   "jp": "時間がない。{n}急いでクリアノ草を取って、脱出するぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0011",
   "jp": "{v:002B}これだね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0012",
   "jp": "{v:002C}よし、これだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0013",
   "jp": "{v:002D}取った！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0014",
   "jp": "{v:002E}取ったよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0015",
   "jp": "　{n}　　　　　『{FFEF}クリアノ草{FFF1}』を手に入れた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0016",
   "jp": "{FFEE}{s:FFED}を守って脱出しろ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0017",
   "jp": "クリアノ草を取らないと！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0018",
   "jp": "あ～、もう、何なのよ一体！{n}あったま来るわねぇ～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0019",
   "jp": "またモンスターが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0020",
   "jp": "くそっ！{n}まだモンスターがいたのか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0021",
   "jp": "まだモンスターがいたんだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0022",
   "jp": "{v:0029}こ、これ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0023",
   "jp": "{v:002A}しまった、ガスだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0024",
   "jp": "{FFF6}{v:0024}あまり時間をかけるな。{n}ガスが噴き出してくるまで時間がないぞ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0025",
   "jp": "{v:0025}えっ？{n}ミー‥シャ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0026",
   "jp": "{v:0026}ん？{n}何？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0027",
   "jp": "‥‥‥{v:0027}何でもない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0028",
   "jp": "{FFF6}{v:0028}急ぐのだ。{n}間もなくガスが噴き出すぞ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0029",
   "jp": "{FFF6}{FFF3}‥‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0030",
   "jp": "{v:0019}どうしたの、ミーシャ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0031",
   "jp": "{FFF6}{v:001A}気をつけろ‥‥そろそろガスが噴き出すぞ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0032",
   "jp": "{v:001B}えっ！{n}それ、本当なの、ミーシャ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0033",
   "jp": "‥‥{v:001C}ん？{n}なに？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0034",
   "jp": "{v:001D}う～！{n}この娘、変だよぉ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0035",
   "jp": "{v:001E}えーっ？{n}なに、なに？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen212.0036",
   "jp": "‥‥{v:001F}もう、いい‥‥。",
   "en": "",
   "term": "end"
  }
 ]
}
