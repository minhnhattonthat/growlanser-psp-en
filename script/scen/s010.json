 "entries": [
  {
   "id": "scen010.0000",
   "jp": "",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen010.0001",
   "jp": "ローランディア兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen010.0002",
   "jp": "料理人",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen010.0003",
   "jp": "文官",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen010.0004",
   "jp": "市民",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen010.0005",
   "jp": "ローランディア王城",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0006",
   "jp": "ローランディア王城へようこそ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0007",
   "jp": "サンドラ様のご子息、{n}{s:0000}様ですね。{n}どうぞ、お通り下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0008",
   "jp": "あのリシャール王、偽者なんだってな。{n}全てはその偽者が元凶か‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0009",
   "jp": "と言うことは‥‥、{n}そいつを倒せば、この戦争は終わる‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0010",
   "jp": "‥‥また君たちに任せるしかないとは、{n}自分がふがいないが仕方がない。{n}頼んだよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0011",
   "jp": "ありがとう。{p}突然何だと思っただろうけど、{n}まだお礼を言っていなかったからね。{n}この戦争が終結できたのも、全ては君たちのおかげだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0012",
   "jp": "そうそう。{n}君たちがいなければ、今回の勝利はなかったも同じだ。{p}私からも言わせて貰うよ‥‥。{n}ありがとう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0013",
   "jp": "‥‥頼んだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0014",
   "jp": "とうとう‥‥やりやがったな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0015",
   "jp": "武器の手入れはおこたるなよ。{n}これからの戦いは、{n}より一層激しいものになるだろうからな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0016",
   "jp": "う～ん‥‥今日は何にしようかな？{n}‥‥いいや、全部持ってっちゃえ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0017",
   "jp": "どうなるんだろうね‥‥これから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0018",
   "jp": "急いで追わないと！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0019",
   "jp": "おい！{n}娘は助けなくて良いのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0020",
   "jp": "国王陛下は現在ご多忙です。{n}申し訳ありませんが、お通しするわけにはいきません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0021",
   "jp": "どうぞ、お通り下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0022",
   "jp": "‥‥‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0023",
   "jp": "どうしたの？{n}なんだか慌しいようだけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0024",
   "jp": "ようやくまた平和だってグチることが出来るのね。{n}はあ‥‥良かった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0025",
   "jp": "そんな‥‥。{n}まだ、敵がいたなんて‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0026",
   "jp": "‥‥ん？{n}何かあったのかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0027",
   "jp": "やっと終わったね‥‥。{n}もう戦争なんてこりごりだよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0028",
   "jp": "{v:001C}あ、お兄ちゃん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0029",
   "jp": "{v:001D}ちょっと、どうしたのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0030",
   "jp": "・よろけただけ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen010.0031",
   "jp": "・何でもない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen010.0032",
   "jp": "・目が回った",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen010.0033",
   "jp": "・よくわからない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen010.0034",
   "jp": "{v:001E}よろけたぁ！？{n}休みボケじゃないの？{n}久々の任務だからって！{p}{v:001F}ほら、気を引き締めなさいよ！{n}パーティーに出るんでしょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0035",
   "jp": "{v:0020}ひょっとして、{n}ティピがパーティーに出たいだけじゃ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0036",
   "jp": "{FB00}{v:0021}えっ？{n}あ‥あははは‥‥。{p}{FC02}{v:0022}とにかく、行くの！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0037",
   "jp": "{v:0023}もう、紛らわしいことしないでよね！{n}せっかくのパーティーなんだから！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0038",
   "jp": "{v:0024}ティピって、パーティーの方が大事？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0039",
   "jp": "{v:0025}あったりまえでしょ！{n}ほら、きりきり歩く！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0040",
   "jp": "{v:0026}目が回った？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0041",
   "jp": "{v:0027}具合が悪いなら、休んでてもいいよ？{n}わたしがお母さん達を連れて行くから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0042",
   "jp": "{v:0028}え～っ！？{n}ダメだよ！{p}{v:0029}だって、コイツ、騎士なんだよ？{n}コイツが受けた任務なんだよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0043",
   "jp": "{v:002A}でも‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0044",
   "jp": "{v:002B}それにコイツがいかないと、{n}アタシまでお留守番になっちゃうじゃない！{n}アタシ、パーティー出たい～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0045",
   "jp": "{v:002C}おい、ティピ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0046",
   "jp": "{v:002D}行くったら、行くの！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0047",
   "jp": "{v:002E}だらしないなぁ！{n}ここのところ怠けてたからでしょ？{p}{FC02}{v:002F}ほら、きりきり歩く！{n}パーティーくらいなら体力も使わないでしょ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0048",
   "jp": "別につまみ食いをするつもりはないけど、{n}暇なときにここへ来るのが日課になってしまったよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0049",
   "jp": "{FFF0}料理の基本③{FFF1}{n}新鮮な卵ほど、表面がザラザラしているものだ。{n}古くなってくると表面がつるつるになってしまうよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0050",
   "jp": "それにしてもこの魚‥‥。{n}う～ん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0051",
   "jp": "隣の魚だけど、毎日新鮮なものになっているんだよ。{n}ずっと同じ魚を置いてあるわけじゃないのよ。{n}迷ったあげく、結局はソテーにしちゃうのよね[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0052",
   "jp": "ここから先は宝物庫です。{n}いくらあなた方といえど、通すことは出来ません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0053",
   "jp": "あっ、こんにちは。{n}お城での生活はひまですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0054",
   "jp": "おい、ちょっと待て。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0055",
   "jp": "‥‥うん？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0056",
   "jp": "ルイセは、ここで待っているんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0057",
   "jp": "ふえっ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0058",
   "jp": "ウォレスさん、どうして？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0059",
   "jp": "あんな事があったんだ。{n}ルイセをヴェンツェルに会わせるべきじゃ{n}ないだろう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0060",
   "jp": "あ、そうか。{n}念のため、だね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0061",
   "jp": "そういうことだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0062",
   "jp": "それじゃ、お兄さまとウォレスさんで{n}行ってきてよ。{n}アタシはここでルイセちゃんと残るから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0063",
   "jp": "それでは、ウォレスさんたちで{n}行ってきてください。{n}僕がルイセ君と残りますから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0064",
   "jp": "では、ウォレスさんたちだけで{n}行ってきてください。{n}私がルイセちゃんと残りますから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0065",
   "jp": "だったら、オレも残ってやるよ。{n}お前たちだけで行ってくるといい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0066",
   "jp": "なら、私がルイセを見ておこう。{n}お前たちだけで行ってくるといい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0067",
   "jp": "頼む。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0068",
   "jp": "お兄ちゃん、おかえり！{n}もう終わったの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0069",
   "jp": "うん、もう終わったから、{n}一緒にいようね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0070",
   "jp": "えへへっ★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0071",
   "jp": "それじゃ、出発しよう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0072",
   "jp": "どこに行く気だ？{n}ルイセを奴に会わせるべきじゃないだろう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0073",
   "jp": "ルイセのグローシュが奪われた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0074",
   "jp": "‥‥{v:0000}なんだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0075",
   "jp": "{v:0001}なんだ、じゃないでしょ！{n}ルイセちゃんを元に戻しなさいよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0076",
   "jp": "‥‥{v:0002}それは無理だ。{n}例え教えたとしても、お前たちに{n}出来ることなどない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0077",
   "jp": "{v:0003}何だと？{n}‥‥あまりふざけた態度を取ると‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0078",
   "jp": "{v:0004}脅されようが無理なものは、{n}無理と言うしかあるまい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0079",
   "jp": "‥‥{v:0005}くそ！{n}じゃあ、質問変更だ‥‥。{p}{v:0006}なぜルイセからグローシュを{n}抜き出したんだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0080",
   "jp": "{FFF6}{v:0007}それなら答えられるな‥‥。{p}{FFF7}{v:0008}それはな。{n}ワシ自身がグローシアンに戻るためだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0081",
   "jp": "{v:0009}ど、どういう意味！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0082",
   "jp": "・わからない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen010.0083",
   "jp": "・グローシアンになりたがっている",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen010.0084",
   "jp": "・元々グローシアンだった",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen010.0085",
   "jp": "{v:000A}言葉通りだよ‥‥。{n}ワシは元々グローシアンだったのだ。{n}訳あって今は力を失ってしまったがね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0086",
   "jp": "{v:000B}よく言葉を聞きたまえ。{n}ワシは元々グローシアンだったのだ。{n}訳あって今は力を失ってしまったがね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0087",
   "jp": "{v:000C}その通り。{n}ワシは元々グローシアンだったのだ。{n}訳あって今は力を失ってしまったがね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0088",
   "jp": "{v:000D}ヴェンツェルがグローシアンだと‥‥！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0089",
   "jp": "{v:000E}おかしいか？{n}‥‥ならばもっと驚く事実を教えてやろう。{p}{v:000F}ワシは数百年前、{n}グローシアン支配時代の最後の王だ。{p}{v:001E}誤解のないように言っておくが、{n}王の末裔などと言うものではないぞ。{p}{v:001F}ワシはあの頃に生まれ、{n}今まで生きてきたのだからな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0090",
   "jp": "{v:0010}そんな‥どうやって生きてきたのよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0091",
   "jp": "{FFF6}{v:0011}事故で死にかけてな。{n}カプセルの中で百年以上も眠りながら{n}時を越えたのだ。{p}{v:0012}おかげで家臣などとうに{n}死に絶えてしまったがな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0092",
   "jp": "{v:0013}その事故ってやつのせいで{n}グローシアンじゃなくなったのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0093",
   "jp": "{v:0014}その通り。{n}元々グローシアンだったのだからな。{p}{v:0020}グローシュさえ手に入れれば、{n}以前のような力が戻る。{p}{v:0015}だから純粋なグローシュを抜き出す方法を{n}研究したのだ。{p}{v:0021}グローシュさえあれば、ルイセに戻すことも{n}不可能ではない‥‥。{n}だが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0094",
   "jp": "{v:0016}くそ！{n}あの連中に奪われたのが痛いぜ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0095",
   "jp": "{v:0017}まずは奪われたグローシュでも探してはどうだ？{n}それまでルイセがもてば、だがな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0096",
   "jp": "・お前を許さない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen010.0097",
   "jp": "・ルイセは死なせない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen010.0098",
   "jp": "・今は黙っている",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen010.0099",
   "jp": "{v:0018}許さないなら、許さないでいい。{n}それでルイセが治るならな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0100",
   "jp": "‥‥{v:0019}くくく‥‥。{n}ここから応援させてもらうよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0101",
   "jp": "{v:001A}せいぜい頑張りたまえ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0102",
   "jp": "ほう‥‥、{n}ルイセのグローシュを戻したか‥‥。{p}だが、まだ全てが片付いた訳ではないだろう？{n}くくく‥‥、せいぜい頑張るがいい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0103",
   "jp": "アンタ、どこ行く気よ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0104",
   "jp": "ここで待ってればいいの？{n}‥‥何で待つんだろ‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0105",
   "jp": "行ってらっしゃい、お兄さま！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0106",
   "jp": "早く行ってくるといい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0107",
   "jp": "ここで待っていますね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0108",
   "jp": "さっさと行ってこい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0109",
   "jp": "行って来てください。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0110",
   "jp": "行って来るといい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0111",
   "jp": "ここは牢屋だぞ？{n}何か用なのか？{n}用がないのなら、上に戻りなさい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0112",
   "jp": "お話は聞いております。{n}どうぞお通りください。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0113",
   "jp": "{v:000A}休暇は終わりだ。{n}お前たちは次の任務についてもらう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0114",
   "jp": "　翌日　",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0115",
   "jp": "　{n}　　　扉には鍵がかかっていた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0116",
   "jp": "{v:000A}おお、そうだ。{n}お前たちに客が来ていたな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0117",
   "jp": "{v:000B}お客さん？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0118",
   "jp": "{v:000C}サンドラの研究塔に行っているようだが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0119",
   "jp": "{v:000D}あ、それって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0120",
   "jp": "{v:000E}早く行ってやるとよい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0121",
   "jp": "サンドラの研究塔に来客",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0122",
   "jp": "‥‥{v:000C}ところでカレンさんは？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0123",
   "jp": "‥‥{v:000D}あれ？{n}そう言えば休暇までは一緒だったけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0124",
   "jp": "{v:000E}用事でも出来たんじゃねぇか？{n}保養所か、実家か‥‥。{p}{v:000F}ま、そんなところだろ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0125",
   "jp": "{v:0010}黙っていなくなるなんて、困った人ね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0126",
   "jp": "{v:0017}頼んだぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0127",
   "jp": "{v:0014}がんばるのですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0128",
   "jp": "気を付けて行くがよい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0129",
   "jp": "{v:0001}おお、良いところに戻ってきたな。{p}{v:0002}今宵、国中をあげての建国記念祭を{n}することとなっておるのだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0130",
   "jp": "{v:0003}お祭り？{n}こんな時に？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0131",
   "jp": "{v:0004}私も今年の建国祭は控えようと思っておったのだ。{p}{v:0005}だが国民の方から願い出てきてな。{n}これも人々に活気が戻ったからであろう。{n}ひとえにお前たちの働きのおかげだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0132",
   "jp": "{v:0006}ここローザリアでは、花火大会を行います。{n}この運営も、街の者たちがやっているのです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0133",
   "jp": "{v:0007}花火！？{n}アタシ見たことない！{n}花火、見た～い★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0134",
   "jp": "{v:0008}だがな、俺たちはまだヴェンツェルを倒す手段すら{n}見つけていないんだぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0135",
   "jp": "{v:0009}そのことについては、我々の方でも、{n}文献などを調査させよう。{p}{v:000A}それよりも、お前たちにはずいぶんと苦労をかけた。{n}今宵はゆっくりと休み、鋭気を養ってはどうだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0136",
   "jp": "{v:000B}しかし‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0137",
   "jp": "{v:000C}焦る気持ちも分かるが、我々はまだ奴の居場所すら{n}わかっておらんのだ。{p}{v:000D}今宵ぐらい休んではどうだ？{n}これは任務として受けてくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0138",
   "jp": "{v:000E}お気遣い、ありがとうございます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0139",
   "jp": "{v:0002}おお、戻ったか。{n}だいたいの報告は聞いている。{p}{v:0003}それで、バーンシュタイン王国や魔法学院は{n}どうだったかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0140",
   "jp": "なんと報告しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0141",
   "jp": "・両方とも襲撃を受けている",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen010.0142",
   "jp": "・魔法学院に援軍を送った方がよい",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen010.0143",
   "jp": "・民間人に被害はないから安心してよい",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen010.0144",
   "jp": "・この国は大丈夫なのか？",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen010.0145",
   "jp": "{v:0004}やはりそうなのか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0146",
   "jp": "{v:0005}しかし、民間人が被害を受けていないことから、{n}奴の目的は我々の武力を削ぐことだと思われます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0147",
   "jp": "{v:0006}うむ、市民に被害がないことがせめてもの救いだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0148",
   "jp": "{v:0007}援軍？{n}あそこも狙われているのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0149",
   "jp": "{v:0008}バーンシュタインには軍隊がいますし、{n}インペリアル・ナイツもいます。{n}でも、魔法学院に兵士はいません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0150",
   "jp": "{v:0009}むぅ‥‥一般人は狙われていないように{n}思えたのだが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0151",
   "jp": "{v:000A}学院の生徒は、少なからず魔法が使えますから、{n}反対勢力になり得ると判断したのでしょう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0152",
   "jp": "{v:000B}わかった。{n}魔法学院にも兵を回すようにしよう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0153",
   "jp": "{v:000C}アンタ、どうしてこの状況で、{n}安心なんて言ってられるの！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0154",
   "jp": "{v:000D}ま、確かに狙われているのは兵士のようだが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0155",
   "jp": "{v:000E}ここも何度か攻撃を受けている。{n}今のところ、市民に被害はないが、{n}誰もが不安がっているのは確かだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0156",
   "jp": "{v:000F}さて、これからどうするつもりかね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0157",
   "jp": "{v:0010}ヴェンツェルの持つ、{n}超人的な回復力は奪いはしたが、{n}テレポートで逃げられる‥‥。{p}{v:0011}奴のテレポートを封じることが出来れば‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0158",
   "jp": "{v:0012}うん。{n}回復力を封じたことに比べれば、{n}テレポートを封じる方が楽かも‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0159",
   "jp": "{v:0013}問題はどうやって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0160",
   "jp": "{v:0014}あまり悠長には構えていられぬぞ。{p}{v:0015}最近は人々の不満も高まっていてな、{n}中にはすべての責任はお前たちにある、{n}とまで言い出す輩もおる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0161",
   "jp": "‥‥{v:0016}そんな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0162",
   "jp": "{v:0017}もちろん、そうでないことは、{n}我々が一番知っているが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0163",
   "jp": "‥‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0164",
   "jp": "{v:0018}ちょっと、アンタ？{n}大丈夫？{n}すっごく顔色悪いよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0165",
   "jp": "なんと答えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0166",
   "jp": "・大丈夫と答える",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen010.0167",
   "jp": "・ダメだと言って倒れる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen010.0168",
   "jp": "・答える元気もない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen010.0169",
   "jp": "{v:0019}本当！？{n}だって、そんなにふらついてるじゃ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0170",
   "jp": "{v:001A}あ、ちょっと！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0171",
   "jp": "{v:001B}ねぇ、聞こえてるの？{p}{v:001C}ああっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0172",
   "jp": "{v:001D}お、おい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0173",
   "jp": "{v:001E}お兄ちゃん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0174",
   "jp": "{v:0015}おお、話は聞いておるぞ。{n}大変なことになったな。{p}{v:0016}やっとゲヴェルを倒したと思えば、{n}さらに恐ろしい敵が現れるとは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0175",
   "jp": "{v:0017}フェザリアンの女王様からいろいろ話を聞いてきたよ！{n}ね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0176",
   "jp": "どのように説明しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0177",
   "jp": "・ヴェンツェルはゲヴェルとグローシアンの融合体",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen010.0178",
   "jp": "・ティピに説明を頼む",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen010.0179",
   "jp": "・ルイセに説明を頼む",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen010.0180",
   "jp": "{v:0018}何だとっ！？{n}あのゲヴェルと？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0181",
   "jp": "{v:0019}ゲヴェルの生命力と、グローシアンの魔力。{n}そして時空を操る能力までも持った存在。{n}それがヴェンツェルです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0182",
   "jp": "{v:001A}ゲヴェルの生命力と、グローシアンの魔力。{n}そして時空を操る能力までも持った存在。{n}それがヴェンツェルだったんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0183",
   "jp": "{v:001B}え～っ、アタシがぁ～！？{p}‥‥{v:001C}ルイセちゃん、パス！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0184",
   "jp": "{v:001D}もう、しょうがないなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0185",
   "jp": "{v:001E}ええと、ヴェンツェルはわたし達が倒したゲヴェルと、{n}グローシアンとを融合した存在なんです。{p}{v:001F}そして、時空を自由に操る能力まで持っている{n}らしいんです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0186",
   "jp": "{v:0020}時空を操る‥‥。{p}{v:0021}そんな奴をどうやって倒すのだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0187",
   "jp": "{v:0022}フェザリアンの所からもらってきた、{n}パワーストーンの制御装置を使うの！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0188",
   "jp": "{v:0023}パワーストーン？{n}あれを手に入れたのですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0189",
   "jp": "{v:0024}うん。{n}実はずっと前からお兄ちゃんが持っていたんだ。{p}{v:0025}それを使えば、ヴェンツェルを倒せるかも{n}知れないって。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0190",
   "jp": "{v:0026}そうですか‥‥。{FFF9}{FFFB}{n}{v:0027}ティピが言った反動とは、{n}パワーストーンの反動だったのですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0191",
   "jp": "{v:0028}そこで、我々が勝手に使って良いものか、{n}意見をうかがいたいのです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0192",
   "jp": "{v:0029}自然界への反動‥‥。{n}だがそれを使わねば、奴には勝てない‥‥。{p}{v:002A}奴を放っておいては、いずれ大陸は支配されてしまう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0193",
   "jp": "{v:002B}陛下、ご決断を。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0194",
   "jp": "{v:002C}‥‥うむぅ‥‥。{p}{v:002D}３日‥‥いや、せめて２日の猶予をくれ。{n}その間に、必ず結論を出す。{p}{v:003E}お前たちは、その間、身体を休めるとよかろう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0195",
   "jp": "{v:003F}では、お前たちに２日の休暇を与える。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0196",
   "jp": "{v:0001}今回の働きに対して与えられる休暇は２日だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0197",
   "jp": "{v:0000}おお、戻ったか！{n}とうとうゲヴェルを倒したようだな！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0198",
   "jp": "{v:0001}もう、すごかったんだから！{n}あいつの体の中みたいなところでね‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0199",
   "jp": "{v:0002}ティピ。{n}国王の前で、はしゃぎすぎですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0200",
   "jp": "{v:0003}よいよい。{n}それだけの偉業を成し遂げたのだからな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0201",
   "jp": "{v:0004}さぞ、大変な冒険だったのでしょうね。{n}今度、ゆっくり聞かせて下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0202",
   "jp": "{v:0005}はい。{n}よろこんで。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0203",
   "jp": "{v:0006}とにかく、疲れたであろう。{n}しばらくの間は任務のことは考えず、{n}ゆっくりと休むがよい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0204",
   "jp": "{v:0007}はっ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0205",
   "jp": "{v:0008}とはいっても、遊ばれては困りますよ。{n}あなた達には重要な仕事があります。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0206",
   "jp": "{v:0009}え～～！？{n}今、休んでいいって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0207",
   "jp": "{v:000A}心配は要りません。{n}休みながらでも出来ることです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0208",
   "jp": "{v:000B}それは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0209",
   "jp": "{v:000C}あなた達が倒したゲヴェルの記録を、{n}後世に残さねばなりません。{n}私の研究室でいろいろと話を聞かせてもらいます。{p}{v:000D}みやげ話だと思えばいいでしょう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0210",
   "jp": "‥‥{v:000E}ほっ★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0211",
   "jp": "{v:000F}ならば、その場に姫も同席させてやってくれ。{n}邪魔はせぬように言い聞かせておく。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0212",
   "jp": "{v:0010}もう、お父様ったら‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0213",
   "jp": "{v:0011}{FFEE}それからアタシたちは、マスターの研究しつで、{n}ぼーけんのないようを話しました。{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0214",
   "jp": "{v:0012}{FFEE}マスターのほかに、お姫さまや、{n}えらい人たちもいっぱいきたので、{n}さいしょはきんちょーしました。{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0215",
   "jp": "{v:0013}{FFEE}でもすぐに話がはずんで、{n}あっという間に時間がたちました。{n}まだぜんぶは話していないけど、{n}もう１０日ちかくなります。{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0216",
   "jp": "{v:0014}{FFEE}だけど、今日はお話はちゅーしです。{n}王さまに呼ばれたからです。{n}いったい、なんだろー？{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0217",
   "jp": "{v:0015}どのようなご用でしょうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0218",
   "jp": "{v:0016}うむ。{n}ゲヴェルの記録を作る作業は一時中断だ。{p}{v:0039}実はバーンシュタイン国王が主催して、ゲヴェルを{n}倒した祝賀会、及び親善パーティーが催される。{n}もちろん、お前たちも主賓として招かれている。{p}{v:0017}そこにサンドラと姫が参加するので、{n}２人をバーンシュタイン王都まで連れて行って{n}欲しいのだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0219",
   "jp": "{v:0018}やった♪{n}　　　パーティー★　　　　　　パーティー★{n}　　　　　　　　　ぱーてぃー★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0220",
   "jp": "‥‥{v:0019}ティピ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0221",
   "jp": "{v:001A}謹んで、お受けします。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0222",
   "jp": "{v:001B}では街の東門で待っていてくれ。{n}サンドラと姫を行かせる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0223",
   "jp": "{v:0000}ただいま戻りました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0224",
   "jp": "{v:0001}おお、戻ったか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0225",
   "jp": "{v:0002}偽の王様は、やっぱりゲヴェルの手下でした。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0226",
   "jp": "{v:0003}今はエリオットが王様になったから、もう安心ね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0227",
   "jp": "{v:0004}そうか、ご苦労であった。{n}後はゲヴェルそのものの居場所を探り、{n}とどめを刺すことだな。{p}{v:0005}しかし、今は休むといい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0228",
   "jp": "{v:0000}戻ったな。{n}いろいろと活躍しているようではないか。{p}{v:0001}お前たちのおかげで、ブロンソン将軍たちも{n}ジュリアン将軍と合流できたようだ。{n}今頃はバーンシュタイン王都へ向かって移動中だろう。{p}{v:0002}今の間に十分休んでくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0229",
   "jp": "{v:0002}今回の働きに対して与えられる休暇は３日だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0230",
   "jp": "{v:0000}今回の働きに対して与えられる休暇は１日だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0231",
   "jp": "バーンシュタイン国の王母アンジェラ様より{n}戴冠記念パーティーの招待状が届いているので{n}行き先に加えておく。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0232",
   "jp": "{v:0009}今日はどこへ行く？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0233",
   "jp": "今日はどこで休暇を過ごしますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0234",
   "jp": "・エリオット王戴冠記念パーティー（本日のみ）",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen010.0235",
   "jp": "・王都ローザリア",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen010.0236",
   "jp": "・保養地ラシェル",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen010.0237",
   "jp": "・魔法学院",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen010.0238",
   "jp": "・観光地コムスプリングス",
   "en": "",
   "term": "end",
