   "unref": true
  },
  {
   "id": "scen010.0246",
   "jp": "今日はどこで休暇を過ごしますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen010.0247",
   "jp": "・王都ローザリア",
   "en": "",
   "term": "end",
