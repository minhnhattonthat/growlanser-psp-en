  },
  {
   "id": "scen043.0012",
   "jp": "開催責任者",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen043.0013",
   "jp": "リシャール王子",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen043.0014",
   "jp": "大工",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen043.0015",
   "jp": "闘技場前広場",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0016",
   "jp": "さぁさぁ、賭けた賭けた！{p}エキスパートの部、１番人気は去年の優勝者{n}バズロックだ！{p}２番人気は、去年のフレッシュマン優勝者{n}ジュリアンだ！{p}フレッシュマンの部、１番人気は{n}このグランシル１番の凄腕、ゼノス！{p}だけど何が起こるか分からないのがフレッシュマン！{n}ダークホースもいっぱいいるよ！{p}さぁさぁ、己を信じて、でっかく賭けよう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0017",
   "jp": "これは何をしてるんだろう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0018",
   "jp": "ノミ屋だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0019",
   "jp": "{FB00}{FE1E}ノミ屋？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0020",
   "jp": "‥‥お前たちは知らなくてもいいことだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0021",
   "jp": "{v:003C}うわ～、大きいね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0022",
   "jp": "{v:003D}そりゃ、大陸中の猛者たちが集まるんだからな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0023",
   "jp": "{v:003E}ウォレスさんも出たことがあるの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0024",
   "jp": "{v:003F}かなり昔のことだがな。{n}あの頃は両目も右腕も自前だった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0025",
   "jp": "{v:0040}それで、出場した結果は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0026",
   "jp": "{v:0041}エキスパート部門で優勝を３回している‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0027",
   "jp": "{v:0042}ええっ！すごい！{n}どこからかスカウトされなかった？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0028",
   "jp": "{v:0043}バーンシュタイン王国やランザック王国なんか{n}すぐに飛んできたが、性に合わなくてな。{n}結局、傭兵団にいた。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0029",
   "jp": "{v:0044}もったいない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0030",
   "jp": "{v:0045}だが、後悔はしてないぜ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0031",
   "jp": "なんと、ニックが無名の選手、{n}{s:0000}に破れる！{n}大会は大荒れだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0032",
   "jp": "さあ、フレッシュマン部門、ニックやゼノスと並んで{n}ローザリアの{s:0000}が{n}勝ち上がっているぞ！{p}さあ、誰か{s:0000}に{n}賭けたか！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0033",
   "jp": "フレッシュマン部門、ゼノスが勝ち上がった！{n}ライバルとなるのはメディス村のニックか！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0034",
   "jp": "さあ、いよいよ予選も始まって{n}大会は盛り上がってるぞ！{p}ゼノス、ジュリアン、バズロックは順調に予選を通過。{n}誰が勝つかは神のみぞ知る！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0035",
   "jp": "エキスパートの部、１番人気は去年の優勝者{n}バズロックだ！{p}２番人気は、去年のフレッシュマン優勝者{n}ジュリアンだ！{p}フレッシュマンの部、１番人気は{n}このグランシル１番の凄腕、ゼノス！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0036",
   "jp": "フレッシュマン部門の会場は左、{n}エキスパート部門は右に進んで下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0037",
   "jp": "闘技大会に参加する場合は、{n}街の中にある運営事務局で{n}参加登録をしてきて下さい。{p}まもなく締め切るから、急いだ方がいいですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0038",
   "jp": "手堅くいけば‥‥、{n}{FE1E}‥{FE1E}‥{FE1E}やっぱり、ゼノスだろ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0039",
   "jp": "ワイは、大穴しか狙わへんのや！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0040",
   "jp": "ううっ、興奮しすぎて鼻血が‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0041",
   "jp": "血がたぎるのぉ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0042",
   "jp": "もう‥‥。{n}予選落ちするなんて、信じらんない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0043",
   "jp": "‥す、‥‥すまない‥‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0044",
   "jp": "もう、邪魔しないでよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0045",
   "jp": "あなた、がんばってねぇ{FFF0}♥{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0046",
   "jp": "任せておけ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0047",
   "jp": "おめでとう！{n}この調子でどんどん頑張ってね♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0048",
   "jp": "初参加？{n}応援してるわ{FFF0}♥{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0049",
   "jp": "フレッシュマンはゼノスが本命か‥‥。{n}お前は誰が勝つと思う？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0050",
   "jp": "誰が勝つと思いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0051",
   "jp": "・ゼノス",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen043.0052",
   "jp": "・{s:0000}",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen043.0053",
   "jp": "・わからない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen043.0054",
   "jp": "まあ、奴もなかなか強いけどな。{n}上には上がいるってもんよ！{p}‥‥えっ？{n}誰かって？{n}俺様に決まってるだろ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0055",
   "jp": "‥‥誰だ？{n}そりゃぁ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0056",
   "jp": "わかってねぇなぁ‥‥。{n}俺様に決まってるだろ？{p}だからよ、賭け金は全て俺に入れたぜ。{n}う～ん、何倍になって返ってくるか楽しみだぜ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0057",
   "jp": "う～ん、何倍になって返ってくるか楽しみだぜ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0058",
   "jp": "俺の闘技大会はもう終わったよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0059",
   "jp": "‥‥やっぱり基本は３点買いだな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0060",
   "jp": "あーあ、負けちゃった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0061",
   "jp": "この日のために一年を過ごして来たのよ。{n}悔いの残らないようにがんばらないと。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0062",
   "jp": "試合が始まってすぐに、{n}精神力が尽きてしまったわい‥‥。{n}歳かのう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0063",
   "jp": "わしは魔法の研究をしておってな‥‥。{n}試合では開発中のいろんな魔法を試させてもらおうと{n}思っておるのだ。{p}ふっふっふっ‥‥。{n}楽しみよのぉ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0064",
   "jp": "俺の素早いフットワークが通用しないとは‥‥。{n}‥‥恐るべし、闘技大会。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0065",
   "jp": "俺の素早いフットワークの前に、敵はいねぇぜ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0066",
   "jp": "参加者の方は中の受付へどうぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0067",
   "jp": "フレッシュマン出場者専用受付",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0068",
   "jp": "２人とも、がんばれよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0069",
   "jp": "外に出るなら、俺も一緒に行こう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0070",
   "jp": "そちらは参加者の控え室になります！{n}勝手に入らないで下さい！{p}もし、あなたが参加者なら、{n}こちらで受付を済ませていただかないと‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0071",
   "jp": "面倒くさいなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0072",
   "jp": "対戦表を作成しなければならないので、{n}ちゃんと受付を済ませて下さい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0073",
   "jp": "おめでとうございました。{n}次はフリーバトルにも参会して下さいね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0074",
   "jp": "がんばって下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0075",
   "jp": "{v:001D}大会参加者ですね。{n}横の階段を使って、控え室へ向かってください。{n}あなた達の控え室は向かって左側になります。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0076",
   "jp": "{v:001F}俺は参加できないから、観客席にいくぜ。{n}２人ともがんばれよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0077",
   "jp": "大会参加者ですね？{p}{s:0000}様‥‥{s:0000}様{FE14}‥{FE14}‥{p}あら？{n}あなたのお名前は登録されていませんね。{p}大会に参加なさるのでしたら、{n}市街地に戻ってすぐ右手のオフィスで{n}受付を済ませて下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0078",
   "jp": "大会参加者の方は、ここで休んでいくことができます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0079",
   "jp": "{FFEB}エルムになりますが？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0080",
   "jp": "ご利用、ありがとうございます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0081",
   "jp": "失礼ですが、お金が足りないようです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0082",
   "jp": "またのお越しをお待ちしております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0083",
   "jp": "戦いで傷ついたら、ここで休んでくといいぜ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0084",
   "jp": "負けちゃったわ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0085",
   "jp": "でも、準決勝まで進めたんだから{n}良しとしないとね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0086",
   "jp": "控え室にいると落ち着かなくて‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0087",
   "jp": "客席はこの奥の方だぜ？{FFFB}{n}って、君は参加者なのか。{n}がんばれよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0088",
   "jp": "闘技大会は終了しました。{n}ここへの立入はできません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0089",
   "jp": "ここから先は関係者以外、立入禁止です。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0090",
   "jp": "控え室",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0091",
   "jp": "{v:0025}予選通過おめでとう。{n}他の予選が終われば本戦が始まるから、{n}それまで休んでいなさい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0092",
   "jp": "適性テストに落ちたのかい？{p}‥‥そうだなぁ。{n}もう少し鍛えるか、戦い方を変えるかすれば{n}そんなに難しくはないと思うよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0093",
   "jp": "{v:0027}君たちの出番はまだだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0094",
   "jp": "{v:0080}がんばって来いよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0095",
   "jp": "あれ？{n}君たちも闘技大会に出場するのかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0096",
   "jp": "そうだよ★{n}こう見えても、結構強いんだからね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0097",
   "jp": "はっはっはっ。{p}でもフレッシュマンの参加者は、{n}適性テストに通らないと出場できないんだよ。{p}闘技大会は危険なものだから、{n}未熟なチームが出場しても大ケガをするだろ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0098",
   "jp": "適性テストって、どこでやってるの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0099",
   "jp": "普通の試合も適性テストもここで行うよ。{n}ちょうど今は適性テストの真っ最中さ。{n}君たちも受けるかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0100",
   "jp": "適性テストに出場しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0101",
   "jp": "適性テストを受ける気になったのかい？{n}今ならまだ間に合うよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0102",
   "jp": "{v:0028}ああ、ちょうど君たちの順番だよ。{n}悔いがないようにがんばってきなさい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0103",
   "jp": "{v:0029}準備はいいかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0104",
   "jp": "{v:002B}いよいよ決勝戦だね。{n}がんばれよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0105",
   "jp": "{v:002A}準決勝戦だね。{n}がんばってきなさい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0106",
   "jp": "{v:0081}早く済ませてきなさい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0107",
   "jp": "へへへ、優勝してランザックに帰るんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0108",
   "jp": "話しかけないでくれ。{n}集中しているんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0109",
   "jp": "優勝、おめでとう！{n}あのゼノスに勝つとは‥‥。{n}大した奴だよ、まったく。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0110",
   "jp": "俺はこれから準決勝なんだ。{n}相手はあのゼノス‥‥。{n}厳しい戦いになりそうだな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0111",
   "jp": "ダメだ‥‥。{n}ゼノスは強すぎる‥‥。{n}あれじゃ、負けても仕方がない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0112",
   "jp": "うう、武者震いがするぜ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0113",
   "jp": "よしてくれ！{n}なぐさめの言葉なんて！{p}いっそ、バカにされた方が‥‥{FFFB}{n}‥{FE1E}‥{FE1E}それはそれで嫌だな‥‥[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0114",
   "jp": "まわりの奴らを見てたら、{n}何かアタイの装備よりリッチでさ～。{n}どうしよっかなって思ってるわけ。{p}試合の合間に稼いで来ようかって思っても、{n}この辺、南の遺跡が一番稼げるじゃない？{n}でも、あそこ学院が管理してるでしょ？{p}学院関係者以外は許可が出るのが遅いらしいから{n}今から許可をもらってる余裕ないし～。{n}誰か、武器ぐらい貸してくれっての。{p}でもアタイが気に入るような{n}いけてる武器を持った奴、誰もいないんだよね～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0115",
   "jp": "南の遺跡に、こっそり入ってこようかな～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0116",
   "jp": "ふぉっふぉっふぉ、なぜにわしのような者が{n}フレッシュマンの部に参加するかわかるかのぉ？{p}‥‥もちろん、初参加だからじゃよ。{n}死ぬまでに一度は出てみたくてのぉ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0117",
   "jp": "戦いは力じゃない、{n}頭脳だって事を見せてやる！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0118",
   "jp": "ん？{n}君たちの控え室は反対側だぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0119",
   "jp": "{v:0036}ついに決勝まで進んだか。{n}俺がこれから勝てばお前たちと戦うことになる。{p}{v:0037}そろそろなれ合いはやめよう。{n}戦いでは、ためらった方が負けるからな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0120",
   "jp": "{v:0035}また勝ったか。{n}なかなかやるな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0121",
   "jp": "{v:0033}予選は勝ち抜いたようだな。{n}まずはおめでとう。{p}{v:0034}俺と戦いたかったら、{n}決勝まであがって来るんだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0122",
   "jp": "{v:002E}お？{n}お前たちか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0123",
   "jp": "{v:002F}あの、お手柔らかに‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0124",
   "jp": "{v:0030}悪いけど、そうはいかないな。{n}勝負は正々堂々、手加減抜きだぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0125",
   "jp": "{v:0031}こっちだって負けないからね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0126",
   "jp": "{v:0032}その意気だ。{n}お互い悔いの残らないようにやろうぜ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0127",
   "jp": "{v:0034}俺と戦いたかったら、{n}決勝まであがって来るんだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0128",
   "jp": "俺はメディス村から来たニック！{n}ここへは腕試しにやって来たんだ。{n}優勝は、俺が頂くぜ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0129",
   "jp": "‥‥俺か？{n}もう負けたんだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0130",
   "jp": "みんな強そうだなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0131",
   "jp": "あぁ、緊張する‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0132",
   "jp": "あ、あれがゼノスか‥‥。{n}ま、負けないぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0133",
   "jp": "ゼノスって、ワイルドでかっこいいわね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0134",
   "jp": "どんな奴が出てくるのか、楽しみだ。{n}ふふふ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0135",
   "jp": "あら、敵情視察かしら？{n}お疲れさま。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0136",
   "jp": "強くていい男って、なかなかいないものね‥‥。{n}みんなムキムキなんだもの。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0137",
   "jp": "私、強い男が好きなの。{n}だけど、線の細い感じの人が好みなのよね。{p}やっぱり強いだけじゃね‥‥。{n}男にはインペリアル・ナイツのような{n}美しさもないといけないわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0138",
   "jp": "昨年のジュリアンの戦いも凄かったが、{n}今年のフレッシュマンも凄い。{n}特にゼノスの戦いは、抜きんでておる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0139",
   "jp": "また去年のような白熱した試合が{n}見られるとよいが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0140",
   "jp": "はぁ‥‥。{n}リシャール様、素敵‥‥。{p}あんなに美しくて華奢なのに、{n}ナイト・マスターだなんて‥‥。{n}凄すぎ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0141",
   "jp": "今年はバーンシュタインの王子、リシャール様が{n}国賓として開会式のご挨拶をされるそうなのよ。{p}あぁ‥‥。{n}あの美しいお顔をまた拝見できるなんて‥‥。{n}私ってば、幸せ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0142",
   "jp": "やっぱりゼノスはすげぇなぁ。{n}他のヤツとは、技のキレが違うぜ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0143",
   "jp": "この待ち時間が長いんだよなぁ。{n}早く始まらないかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0144",
   "jp": "なかなかいい勝負の連続だな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0145",
   "jp": "お前たちも戦うのか？{n}頑張ってな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0146",
   "jp": "今、いいところなんだよ！{n}話しかけないでくれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0147",
   "jp": "そろそろ開会式が始まるんだ。{n}話しかけないでくれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0148",
   "jp": "弟は予選でもう負けたんだけど‥‥。{n}せっかくだから最後まで見ていくわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0149",
   "jp": "私の弟がフレッシュマンに参加したの。{n}せめて予選は通過してくれないと、{n}ちょっと恥ずかしいわ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0150",
   "jp": "いよいよ次は決勝だな。{n}コムスプリングスへ行くためにも、{n}がんばってくれよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0151",
   "jp": "順調に勝ち進んでいるようだな。{n}次の準決勝も、この調子でがんばれよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0152",
   "jp": "いい動きだったぞ。{n}次もがんばれよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0153",
   "jp": "とりあえず予選は突破したようだな。{n}次からは本戦だ。{n}気を抜くなよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0154",
   "jp": "適性テストが終わったようだな。{n}まぁ、お前たちならそれぐらい出来て当然だな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0155",
   "jp": "２人ともがんばれよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0156",
   "jp": "そろそろ次の試合が始まるから、{n}君たちは控え室に戻っているといいだろう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0157",
   "jp": "開会式",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0158",
   "jp": "{v:003B}これより本年度の闘技大会を執り行う！{p}{v:003C}今年は国賓としてバーンシュタイン王国の王子であり、{n}インペリアル・ナイト・マスターでもあられる、{n}リシャール殿下がお見えになられております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0159",
   "jp": "{v:003D}それではリシャール殿下、{n}一言いただきたいと思います。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0160",
   "jp": "{v:003E}我が国の民は知っていると思うが、{n}私も国ではナイト・マスターをつとめ、{n}剣術には興味があります。{p}{v:003F}みなさん。{n}悔いの残らぬよう、全力を出して戦ってください。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0161",
   "jp": "{v:0041}次に、前年度、フレッシュマンの部優勝者{n}ジュリアンより、選手宣誓です。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0162",
   "jp": "{v:0042}宣誓！{n}我々は己の持てる力を出し切り、{n}正々堂々と戦うことを誓う！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0163",
   "jp": "エキスパート出場者専用受付",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0164",
   "jp": "そちらはエキスパート参加者の控え室になります！{n}勝手に入らないで下さい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0165",
   "jp": "ここはエキスパート部門専用の選手受付です。{n}あなた方は、まだ利用できません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0166",
   "jp": "エキスパート部門の選手は、{n}ここで休んでいくことができます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0167",
   "jp": "今年こそ、バズロックに‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0168",
   "jp": "お前、フレッシュマンとして参加するのか？{n}俺も去年、フレッシュマンに出たぜ。{n}予選は通過できたが‥‥。{p}それ以上は聞かないでくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0169",
   "jp": "この日のために体調を整えてきたんだ。{n}負けるわけにはいかねぇ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0170",
   "jp": "あいかわらずバズロックは強えなぁ。{n}あっと言う間に、相手を倒しちゃうもんなぁ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0171",
   "jp": "俺が応援するのはもちろんバズロックさ！{n}奴に勝てる奴はいないだろうからな！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0172",
   "jp": "ここへは仕事で来たんだが‥‥。{n}とりあえず大会が終わるまでは、{n}それどころじゃねぇよな、やっぱり。{p}大会が終わって、おみやげでも選んで‥‥。{n}仕事はそれからだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0173",
   "jp": "ジュリアンだったかしら、彼。{n}素敵ね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0174",
   "jp": "今回のエキスパートには、{n}どんな人たちが参戦するのかしらね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0175",
   "jp": "バズロックも凄いが、ジュリアンもなかなかだな。{n}今回の試合は荒れそうだぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0176",
   "jp": "バーンシュタインから、{n}ジュリアンというのが参戦するそうだ。{n}どんな力を持っているんだろうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0177",
   "jp": "ふむ‥‥やはり人の戦いを見るのはためになる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0178",
   "jp": "今回は人の戦いを見、{n}己の修行の糧にしようと思ってな。{p}さて、どんな戦いが繰り広げられることやら‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0179",
   "jp": "ジュリアン様を見てたら、どきどきしてきたわ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0180",
   "jp": "今回の選手宣誓は行う人って、{n}かなりの美形って話なんだけど‥‥。{n}どんな人かしら{FFF0}♥{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0181",
   "jp": "ジュリアン様、すてきー{FFF0}♥{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0182",
   "jp": "こんな{FFEF}アセクサイ{FFF1}ことやるんですもの、{n}私の目にかなう男性なんかいるはずがないですわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0183",
   "jp": "なんかジュリアン人気はすごいのぉ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0184",
   "jp": "早く始まらんかのぉ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0185",
   "jp": "ここは関係者以外、立入禁止です。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0186",
   "jp": "そ、外にいた怪物はどうなった！？{n}もう大丈夫なのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0187",
   "jp": "キミたちのおかげで、闘技場の{n}奥に避難した人たちは無事だったよ。{n}どうもありがとう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen043.0188",
   "jp": "テレポート出来ない！{n}特殊な結界が張られているようだ。",
   "en": "",
   "term": "end"
  }
 ]
}
