  },
  {
   "id": "scen061.0001",
   "jp": "バーンシュタイン兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen061.0002",
   "jp": "男性市民",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen061.0003",
   "jp": "女性市民",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen061.0004",
   "jp": "魔術師",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen061.0005",
   "jp": "看守",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen061.0006",
   "jp": "調理人",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen061.0007",
   "jp": "王母アンジェラ",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen061.0008",
   "jp": "{s:0160}王城",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0009",
   "jp": "{s:000A}は地下牢にいるはずです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0010",
   "jp": "牢屋って地下だよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0011",
   "jp": "{v:0000}お帰りなさいませ、陛下。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0012",
   "jp": "{v:0001}重要な話があります。{n}インペリアル・ナイツを召集してください。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0013",
   "jp": "{v:0002}はい、かしこまりました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0014",
   "jp": "{v:0003}やぁ、みなさん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0015",
   "jp": "{v:0004}{s:0025}のことで、話があるんだ。{n}エリオ‥‥国王陛下は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0016",
   "jp": "{v:0005}謁見の間にいらっしゃいます。どうぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0017",
   "jp": "{v:0006}インペリアル・ナイツもいた方がいい。{n}{s:0153}は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0018",
   "jp": "{v:0007}インペリアル・ナイツの人にも{n}聞いてもらった方がいいと思うんだ。{n}{s:0008}達は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0019",
   "jp": "{v:0008}わかった。{n}僕が呼んでくるよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0020",
   "jp": "{v:002F}た、大変です！{n}化け物が街に！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0021",
   "jp": "{v:0030}大変！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0022",
   "jp": "アンタ、どこへ行こうって言うのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0023",
   "jp": "{v:0035}ん？{n}君たち‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0024",
   "jp": "{v:0036}戻ってきたのですか？{n}それで{s:0161}城は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0025",
   "jp": "{v:0037}それがヒドイのよ！{n}{s:0025}の奴、一瞬でお城を壊しちゃったのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0026",
   "jp": "{v:0038}一瞬で？{n}そんなバカな！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0027",
   "jp": "{v:0039}それより、フェザリアンの人が、{n}話があるから来て欲しいって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0028",
   "jp": "{v:003A}そうそう！{n}{s:0003}さんも絶対来るようにって。{n}それで迎えに来たの！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0029",
   "jp": "‥‥{v:003B}母さんのことで何かあったのかな？{p}{FC02}{v:003C}わかった。{n}僕も連れていってくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0030",
   "jp": "誰をメンバーから外しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0031",
   "jp": "・{s:FFED}",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen061.0032",
   "jp": "・{s:FFEE}",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen061.0033",
   "jp": "{s:FFED}の装備を回収しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0034",
   "jp": "{s:FFEE}の装備を回収しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0035",
   "jp": "　{n}　　　　　{FFEF}{s:0003}が仲間になった！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0036",
   "jp": "{v:003D}それじゃ、マスター！{n}行って来ます！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0037",
   "jp": "{v:0039}とっとと奴のいう通りにしろ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0038",
   "jp": "{v:003A}私たちにまで攻撃するって言ってるじゃない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0039",
   "jp": "{v:003B}お前たち、あれが敵のワナだとわからないのか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0040",
   "jp": "{v:003C}戦う力のある奴はいい！{n}だが、俺たちはどうなる？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0041",
   "jp": "{v:003D}そうよ！{n}私たちに死ねというの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0042",
   "jp": "{v:003E}みなさん、落ち着いて！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0043",
   "jp": "{v:003F}すごいことになってる‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0044",
   "jp": "{v:0040}どうなさいますか？{n}このままでは収まりがつきませんよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0045",
   "jp": "{v:0041}一番たちの悪いことがおこっちまったな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0046",
   "jp": "{v:0042}どうしたら納得してくれるのかしら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0047",
   "jp": "{v:0043}みなさん、聞いてください！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0048",
   "jp": "{v:0044}これからパワーストーンを渡しに行きます！{n}どうか落ち着いてください！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0049",
   "jp": "{v:0045}本当か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0050",
   "jp": "{v:0046}本当です！{n}みなさんの安全は、我々が守ります！{n}だから落ち着いてください！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0051",
   "jp": "{v:0047}そ、そういうことなら‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0052",
   "jp": "{v:0048}ごめんなさい、みなさん。{n}勝手なことを言ってしまって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0053",
   "jp": "{v:0049}仕方ねぇよ。{n}俺たちの敵は{s:0025}であって、{s:00AE}じゃない。{n}むしろ{s:00AE}を守るのが俺たちの役{s:012A}だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0054",
   "jp": "{v:004A}そうだよ。{n}だから気にしちゃだめだよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0055",
   "jp": "‥‥{v:004B}ありがとうございます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0056",
   "jp": "{v:004C}それじゃ、さっそくパワーストーンを届けにいくか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0057",
   "jp": "‥‥{v:004D}その役{s:012A}、私にお任せくださいませんか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0058",
   "jp": "{v:004E}えっ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0059",
   "jp": "{v:004F}陛下は私におっしゃいました。{n}『人々の生活を守れ』と。{n}これぞ名誉挽回の機会です。{p}{v:0050}それにあなた方が出てゆき、{n}{s:0025}にいらぬ警戒をさせたくはありません。{p}{v:0051}ここは、私めにお任せを。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0060",
   "jp": "‥‥{v:0052}わかりました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0061",
   "jp": "{v:0053}パワーストーンを。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0062",
   "jp": "{v:0054}どうした？{n}パワーストーンを渡してくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0063",
   "jp": "　{n}　　『{FFEF}パワーストーン{FFF1}』を{s:0153}に渡した！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0064",
   "jp": "{v:0055}それじゃ、わたしが近くまで送っていくね。{n}テレポートを使えば、一瞬だから‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0065",
   "jp": "{v:0056}かたじけない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0066",
   "jp": "{FFF3}‥{FE1E}‥{FE1E}‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0067",
   "jp": "{v:0007}あ、いや‥‥。{n}{s:0154}がどこにもいないんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0068",
   "jp": "{v:0008}どこにもいない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0069",
   "jp": "{v:0009}はい、陛下。{n}どこにも見あたらないのです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0070",
   "jp": "{v:000A}いないって‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0071",
   "jp": "{v:000B}そうなんだ、どこにも見あたらないんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0072",
   "jp": "{v:000C}そう言えば、牢屋にいた{s:000A}は{n}どうしちゃったの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0073",
   "jp": "{v:000D}えっ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0074",
   "jp": "{v:000E}地下牢にはいなかったし、{n}衛兵とおぼしき奴が死んでいた。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0075",
   "jp": "{v:000F}何だって？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0076",
   "jp": "{v:0010}{s:0025}を倒すのに{n}{s:000A}が必要だっていうのに！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0077",
   "jp": "‥‥{v:0011}何があったんだ、一体‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0078",
   "jp": "陛下、お気をつけて！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0079",
   "jp": "お帰りなさいませ、陛下！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0080",
   "jp": "陛下のことをよろしくお願いします！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0081",
   "jp": "陛下が中でお待ちです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0082",
   "jp": "{v:0000}ん？{n}何だ、この殺気は‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0083",
   "jp": "{v:0001}あ、あれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0084",
   "jp": "{v:0002}何故だ？{n}何故こうなるんだ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0085",
   "jp": "{v:0003}すまんな、{s:0152}。{p}{v:0004}だが、こうなってしまった以上、{n}俺は{s:000A}様と共に生きたいのだ。{n}わかってくれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0086",
   "jp": "{v:0005}いいや、わからないね！{n}この際だから言わせてもらうよ！{p}{v:0006}あの時は{s:000A}様が{s:0119}の手下だと{n}知らなかった。{n}だが、今回は違う！{p}{v:0007}この世を支配しようとする{s:0025}の{n}手先だと知って、それを止めるどころか、{n}荷担するなんて、絶対に間違ってる！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0087",
   "jp": "{v:0008}お前だけは分かってくれると思ったが‥‥。{p}{v:0009}残念だが、もう１つの命令を実行するしかないようだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0088",
   "jp": "{v:000A}{s:0154}？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0089",
   "jp": "‥‥{v:000B}仲間に出来ぬ場合は‥‥斬れ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0090",
   "jp": "{v:000C}{s:0154}‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0091",
   "jp": "‥‥{v:000D}さらばだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0092",
   "jp": "{v:000E}待って下さい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0093",
   "jp": "{v:000F}待て、２人とも！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0094",
   "jp": "{v:0010}ちょっと、待ちなさいよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0095",
   "jp": "{FFF3}‥‥{FFF4}{v:0011}邪魔が入ったな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0096",
   "jp": "何か言いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0097",
   "jp": "・我々に協力して欲しい",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen061.0098",
   "jp": "・お前は間違っている",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen061.0099",
   "jp": "・何もない。",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen061.0100",
   "jp": "{v:0012}協力だと？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0101",
   "jp": "{v:0013}そうよ！{n}今は争うときじゃないって知ってるでしょ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0102",
   "jp": "{FFF3}‥‥{v:0014}フン‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0103",
   "jp": "{v:0015}その様子からすると、自分でも間違いには{n}気づいているようだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0104",
   "jp": "{v:0016}今は争うときじゃないでしょ！{n}ねぇ！{n}アタシ達に協力してよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0105",
   "jp": "{v:0017}協力だと？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0106",
   "jp": "{v:0018}この世界は放っておいたら崩壊してしまう。{p}{v:0019}それを止められるのは{s:0025}だけだけど、{n}{s:000A}さんが協力してくれれば、{n}{s:0025}がいなくても世界は助かるの！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0107",
   "jp": "{v:001A}前回もそんな事を言っていたな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0108",
   "jp": "{v:001B}コイツと、{s:000A}、{n}両方とも{s:0119}って奴に作られた存在でしょ？{p}{v:001C}この２人の能力で、みんなをグローシアンにすれば、{n}もう一度パワーストーンが作れるの。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0109",
   "jp": "{v:001D}パワーストーンがあれば、時空制御装置を動かして、{n}この世界の崩壊を止められる。{n}{s:0025}の言いなりにならなくても済むの！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0110",
   "jp": "{FFF3}‥‥{FFF4}{v:001E}それで、{s:0025}を倒した後、{n}{s:000A}様は助かるのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0111",
   "jp": "‥‥{v:001F}そ‥それは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0112",
   "jp": "{FFF3}‥‥{FFF4}{v:0020}話にならんな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0113",
   "jp": "{v:0021}{s:0154}！{p}‥‥{v:0022}どうして‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0114",
   "jp": "{v:0034}何があったのですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0115",
   "jp": "{v:0023}{s:0004}陛下！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0116",
   "jp": "{v:0024}ほら、{s:000A}に付いてっちゃった{n}インペリアル・ナイトが来てたのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0117",
   "jp": "{v:0025}{s:0153}の事ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0118",
   "jp": "{v:0026}はい、陛下。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0119",
   "jp": "{v:0027}どうやら彼は、今でも{s:000A}を{n}第一に考えているみたいですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0120",
   "jp": "{v:0028}申し訳ありません、{s:0004}陛下。{n}私は{s:0154}を‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0121",
   "jp": "{v:0029}あなたのせいではありませんよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0122",
   "jp": "{v:002A}協力しなきゃいけないのに、{n}どうして戦わなくちゃいけないのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0123",
   "jp": "{v:002B}何とかして説得できればいいんだが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0124",
   "jp": "{v:002C}そうですね。{p}{v:002D}ところで、{s:0151}。{n}街の様子はどうですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0125",
   "jp": "{v:002E}はい。{n}一時のような混乱や悲壮感は{n}なくなりつつあります。{p}{v:002F}みなさんの活躍が、皆に活力を与えているようです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0126",
   "jp": "{FFF3}‥‥{FFF4}{v:0030}わたし達のしてきたこと、{n}無駄じゃなかったんだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0127",
   "jp": "{v:0031}ああ。{p}{v:0032}人は諦めなければ、強くなれる。{n}父の教えは間違えていなかった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0128",
   "jp": "{v:0033}うん♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0129",
   "jp": "みなさんの活躍が、{n}人々に活力を与えているようですね。{n}これからもがんばって下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0130",
   "jp": "やはり決着をつけねばならないのか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0131",
   "jp": "{FFEE}{v:0015}　　　　さて、これで心おきなく、{n}　　　　この村を破壊することができる！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0132",
   "jp": "{FFEF}{v:0016}　　　　　なに！？{n}　　　　　貴様、最初から‥‥！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0133",
   "jp": "{FFEE}{v:0017}約束など、対等の立場でなければなりたたんのだよ。{n}この私と、愚かな人間とで対等だと思っているのか！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0134",
   "jp": "{FFEF}{v:0018}　　　　　　　　貴様！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0135",
   "jp": "{FFEE}{v:0019}　　　　さぁ、私の力を味わいながら{n}　　　　死ぬがいい！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0136",
   "jp": "{v:001A}うわっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0137",
   "jp": "{v:001B}くそっ！{n}やっぱりこうなりやがったか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0138",
   "jp": "{v:001C}{s:0154}‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0139",
   "jp": "‥‥{v:001D}僕が、渡そうなんていわなければ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0140",
   "jp": "{v:001E}悔やんだってはじまんねぇ。{n}そんな時間があったら、奴を倒す手段を探そうぜ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0141",
   "jp": "そんな事をしてる暇はないでしょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0142",
   "jp": "{v:0009}やぁ、みなさん！{n}どうしたのですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0143",
   "jp": "{v:000A}話は全員がそろってからだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0144",
   "jp": "{v:000B}全員そろったようですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0145",
   "jp": "{v:000C}それじゃ、始めましょっか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0146",
   "jp": "{v:000D}{s:0025}の奴は、あの{s:0119}との融合体だ。{p}{v:000E}元々がグローシアンだったから、魔法も強力。{n}おまけに時空まで操れるときている。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0147",
   "jp": "{v:000F}グローシアンであり、{s:0119}でもあり、{n}時空も操る？{n}考えたくない強さだな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0148",
   "jp": "{v:0010}このままだと勝ち{s:012A}はないとわかったので、{n}わたし達、パワーストーンを使ったんです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0149",
   "jp": "{v:0011}パワーストーンとは？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0150",
   "jp": "{v:0012}ええと、因果律を{FB00}‥‥何だっけ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0151",
   "jp": "どう説明しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0152",
   "jp": "・人の意志の力を結晶化したもの",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen061.0153",
   "jp": "・不思議な宝石",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen061.0154",
   "jp": "・因果律を歪めて超常現象を起こすもの",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen061.0155",
   "jp": "{v:0013}それはそうなんだけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0156",
   "jp": "{v:0014}えっと、パワーストーンを使えば、因果律を歪めて、{n}超常現象を起こすことができるのです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0157",
   "jp": "{v:0015}はい？{n}アンタ、何がいいたいの？{p}{v:0016}{s:0001}ちゃん、ちゃんと教えてあげて！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0158",
   "jp": "{v:0017}えっと、パワーストーンを使えば、因果律を歪めて、{n}超常現象を起こすことができるのです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0159",
   "jp": "{v:0019}超常現象を起こす？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0160",
   "jp": "{v:001A}それを使って、{n}{s:0025}を倒せるはずだったんだが、{n}そこまでには至らなかった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0161",
   "jp": "{v:001B}至らなかったということは、{n}何らかの効果があったんだね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0162",
   "jp": "{v:001C}そうなの！{p}{v:001D}あいつの回復力って知ってる？{n}切った端から傷がつながっちゃうんだよ？{n}でもそれがなくなっちゃったの！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0163",
   "jp": "{v:001E}つまり、今の彼はけっして不死身じゃないの。{n}ダメージを与え続ければ、いずれは勝てる{n}‥‥はずだったんだけど。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0164",
   "jp": "{v:001F}だけど？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0165",
   "jp": "{v:0020}テレポートで逃げられちゃうの‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0166",
   "jp": "{v:0021}たぶん、時空を操る能力が生きているんだ。{n}だから瞬時にどこへでも逃げられる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0167",
   "jp": "{v:0022}そう悲観することはない。{p}{v:0023}我々でも倒せるという可能性が出たんだからね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0168",
   "jp": "{v:0024}何度逃げられても、いつかは倒せるはず。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0169",
   "jp": "{v:0025}そういうことだ。{p}{v:0026}とにかくこれを報告に来たんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0170",
   "jp": "{v:0027}あいつったら、ちっちゃい{s:0119}を兵隊に{n}使ってるけど、それは自分自身が{n}無敵じゃなくなっちゃったからだよね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0171",
   "jp": "{v:0028}小さな{s:0119}？{n}あの化け物か‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0172",
   "jp": "{v:0029}ああ。{n}魔法学院も襲われた。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0173",
   "jp": "{v:002A}学院もか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0174",
   "jp": "{v:002B}さて、後は魔法学院にも教えておかないとね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0175",
   "jp": "{v:002C}あそこも狙われそうですからね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0176",
   "jp": "{v:002E}いろいろと、ありがとう。{n}これで奴を倒す希望がわいてきたよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0177",
   "jp": "{v:0003}さっそく話ってのを始めようじゃねぇか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0178",
   "jp": "{v:0004}そうですね。{p}{v:0005}まず、今までの所をもう一度確認し、{n}それからしかるべき対応策を考えるということで。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0179",
   "jp": "{v:0006}ええと、まず私たちがパワーストーンで、{n}{s:0025}の超回復能力を防ぎました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0180",
   "jp": "{v:0007}後は、どうやって奴のテレポートを防ぐ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0181",
   "jp": "{FFEE}{v:0008}　　　　　　聞こえているか！{n}　　　　　　愚かな人間どもよ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0182",
   "jp": "{v:0009}この声は、奴か！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0183",
   "jp": "{FFEE}{v:000A}　　　愚かな人間どもよ！{n}　　　よく聞くがいい！{p}{v:000B}　　　私は今まで{s:005C}や魔法使い以外には{n}　　　攻撃を仕掛けなかった。{n}　　　それは来たるべき我が支配のためだ。{n}　　　だが一部の愚か者のために、{n}　　　私の気が変わりかけている。{p}{v:000C}　　　そうだ。{n}　　　これからは無差別に人間を殺す。{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0184",
   "jp": "{v:000D}なんだと！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0185",
   "jp": "{FFEE}{v:000E}　　それを望まないなら、すぐさま我に屈せよ！{p}{v:000F}　　だが、考えをまとめる時間も必要だろう。{n}そこで寛大な私は、数日だけ待ってやることにした。{p}{v:0010}　　まずは、パワーストーンを差し出せ！{n}　　それさえも拒むというなら、{n}　　この場で村１つを吹き飛ばしてやる！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0186",
   "jp": "{v:0011}奴め、どこかの村を人質に取っているのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0187",
   "jp": "{FFEE}{v:0012}　　　さあ、パワーストーンを持って、{n}　　　{s:015A}村まで来い。{n}　急いでこなければ、私の気が変わるかも知れんぞ？{p}　　　‥‥{v:0013}わっはっはっはっはっ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0188",
   "jp": "{v:0014}村のみんなが‥‥人質に？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0189",
   "jp": "{v:0015}{s:0003}さんの村が‥‥人質？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0190",
   "jp": "{v:0016}ねぇ、どうするのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0191",
   "jp": "{v:0017}どうするってもな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0192",
   "jp": "パワーストーンを渡しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0193",
   "jp": "・渡す",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen061.0194",
   "jp": "・渡さない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen061.0195",
   "jp": "・みんなに任せる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen061.0196",
   "jp": "{v:0018}そりゃ、もうパワーストーンにエネルギーは{n}残ってないけどさ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0197",
   "jp": "{v:0019}それで人々が助かるなら、私も渡すべきだと思います。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0198",
   "jp": "{v:001A}かといって、渡してしまうのはどうでしょう？{n}数十年たてば、エネルギーは補充できるんでしょ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0199",
   "jp": "{v:001B}そう言われると、う～ん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0200",
   "jp": "{v:001C}俺は渡さない方がいいと思うぜ。{n}奴が約束を守るとは思えねぇ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0201",
   "jp": "{v:001D}{s:0003}さんはどう思うの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0202",
   "jp": "{v:001E}確かに村の人々のことは心配です。{n}でも、そのために{s:0025}を倒す決定的手段を{n}手放してしまうというのは‥‥。{p}{v:001F}こんな時、フェザリアンなら、{n}確実に『渡さない』と言い張るでしょうね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0203",
   "jp": "{v:0020}{s:015A}のみんなが、どうなってもいいの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0204",
   "jp": "{v:0023}冷たいことをいうようだが、{n}ここで奴を倒す決定力を失うのはどうかと思う。{p}{v:0024}少数の者を救って、{n}多くを犠牲にさらすことにはなるまいか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0205",
   "jp": "{v:0025}ちょっと、責任逃れはなしじゃない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0206",
   "jp": "{v:0026}確かに難しい問題ですけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0207",
   "jp": "{v:0027}要は{s:0025}の野郎を{n}信じられるかどうかって事だな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0208",
   "jp": "{v:0028}俺なら渡さないね。{n}どうせ渡したところで、{n}村に手を出さない保証はねぇ。{p}{v:0029}そして何より、奴は{s:0001}からグローシュを{n}奪った張本人だ。{n}信じられねぇよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0209",
   "jp": "{v:002A}わたしは‥‥村のみんなを助けるためなら、{n}仕方ないんじゃないかって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0210",
   "jp": "{v:002B}冷たいようだが、私は渡さない方がいいと思う。{p}{v:002C}奴が村に手出ししないという確証がない以上、{n}切り札を渡すことには反対だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0211",
   "jp": "{v:002D}俺も同感だ。{n}渡すべきじゃないと思う。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0212",
   "jp": "{v:002E}２人はどう思いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0213",
   "jp": "{v:002F}渡すべきではないでしょうな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0214",
   "jp": "{v:0030}私も{s:0025}を信用できません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0215",
   "jp": "{v:0031}で、どうする、{s:0004}？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0216",
   "jp": "{v:0032}わかりました。{n}パワーストーンは渡しません。{p}{v:0033}代わりに我々で何とかする手段を‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0217",
   "jp": "{v:0034}大変です陛下！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0218",
   "jp": "{v:0035}どうしたのですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0219",
   "jp": "{v:0036}{s:00AE}が‥{s:00AE}が、{s:0025}に従えと、{n}城に詰め寄っております！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0220",
   "jp": "{v:0037}何だと！？{n}{s:0151}！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0221",
   "jp": "{v:0038}ああ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0222",
   "jp": "‥‥{s:0025}め‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0223",
   "jp": "{s:0154}は‥‥、{n}{s:0154}は無事なのか！？{p}この距離をすぐにでも越えて行けたら‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0224",
   "jp": "こんな時、何もできない自分がうらめしい‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0225",
   "jp": "事態はなかなか好転しないね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0226",
   "jp": "{s:0025}は、この国の民を、{n}そして我が友を‥‥。{p}奴だけは許しておけない。{n}‥‥絶対に！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0227",
   "jp": "‥‥{s:0025}め！{n}よくもやってくれたな‥‥。{p}それより、お前たちならすぐに{n}{s:015A}村へ向かえるだろう？{n}村の様子を見に行ってくれないか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0228",
   "jp": "私の力が必要か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0229",
   "jp": "でもこれ以上は多すぎるよ。{n}誰かを仲間から外さないと。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0230",
   "jp": "　{n}　　　　{FFEF}{s:0008}が仲間になった！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0231",
   "jp": "頼りにしてくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0232",
   "jp": "早く平和を取り戻したい‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0233",
   "jp": "これ以上、国民に不安を与えてはおけぬ。{n}早急に事態を解決せねば‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0234",
   "jp": "まさか‥‥。{n}こんな事になるとは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0235",
   "jp": "‥‥僕が渡そうなんて言わなければ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0236",
   "jp": "ねぇ、{s:0004}！{n}地下牢に{s:000A}がいないんだけど、{n}どうしちゃったの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0237",
   "jp": "衛兵とおぼしき奴も死んでいたぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0238",
   "jp": "えっ！{n}それは一体‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0239",
   "jp": "陛下！{n}お取り込み中のところ、申し訳ありません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0240",
   "jp": "どうしました？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0241",
   "jp": "実は、{s:0153}がどこにも見あたらないのです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0242",
   "jp": "えっ！？{n}{s:0153}まで？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0243",
   "jp": "‥‥？{n}他にも誰か‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0244",
   "jp": "地下牢にいた、{s:000A}もいないんです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0245",
   "jp": "何だって？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0246",
   "jp": "{s:0025}を倒すのに{n}{s:000A}が必要だっていうのに！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0247",
   "jp": "‥‥何があったのでしょう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0248",
   "jp": "私が調査して参ります。{n}よろしいでしょうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0249",
   "jp": "そうですね。{n}よろしくお願いします。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0250",
   "jp": "はっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0251",
   "jp": "嫌な予感がするぜ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0252",
   "jp": "何事もなければ良いのですが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0253",
   "jp": "{s:000A}と{s:0153}がいないそうですね。{n}先ほど{s:0151}から報告を受けました‥‥。{n}何事もなければ良いのですが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0254",
   "jp": "僕の力が必要ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0255",
   "jp": "　{n}　　　　{FFEF}{s:0004}が仲間になった！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0256",
   "jp": "はりきって行きましょう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0257",
   "jp": "どうすれば{s:0025}を{n}追いつめられるのでしょう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0258",
   "jp": "‥‥いったい、いつになったら{n}平和な世界が来るのでしょう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0259",
   "jp": "私は持ち場を離れるわけにはいきませんので、{n}よろしくお願いします。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0260",
   "jp": "私語は禁じられているので‥‥。{n}申し訳ございません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0261",
   "jp": "陛下のお友達の方ですね。{n}ごゆっくりしていって下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0262",
   "jp": "これは、{s:0004}陛下。{n}ご機嫌うるわしゅう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0263",
   "jp": "この城のいたる所には{n}魔法を防ぐような仕掛けがしてあります。{p}回復魔法などなら大丈夫ですが、{n}強い魔力を感知すると、{n}かき消されてしまうことがあります。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0264",
   "jp": "　{n}　　　　　　　鍵がかかっている！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0265",
   "jp": "‥‥出番を待っている。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0266",
   "jp": "何かあったら、{n}謁見の間へ駆けつけられるように、{n}ここに詰めているのよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0267",
   "jp": "‥‥精神を集中しているんだ。{n}話しかけないでくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0268",
   "jp": "ここの待機は当番制なんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0269",
   "jp": "ここは{s:005C}の待機室ですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0270",
   "jp": "もう少しで交替か‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0271",
   "jp": "ここはお客様用の待合室です。{n}といっても、あなた方には必要ありませんよね。{p}あなた方は特別待遇ですから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0272",
   "jp": "ここは普通の図書室です。{n}{s:005C}やこの国の学者が利用したりします。{p}今はがらがらですけどね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0273",
   "jp": "{FFF3}{FFF6}‥‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0274",
   "jp": "{v:003F}元気ないわね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0275",
   "jp": "{v:0040}{s:0119}が死んじまったせいだろうな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0276",
   "jp": "{v:0005}誰もいないよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0277",
   "jp": "{s:000A}がいない！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0278",
   "jp": "{v:0002}これは！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0279",
   "jp": "{v:0003}あ、誰か倒れてるよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0280",
   "jp": "‥‥{v:0004}ダメだよ。{n}もう死んじゃってる‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0281",
   "jp": "異常はありません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0282",
   "jp": "ここでは魔法の研究などをしている。{n}あまり邪魔などなさらぬよう、お願いします。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0283",
   "jp": "魔法を研究しているのは{n}魔法学院だけではありませんわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0284",
   "jp": "時には文献をあさり、{n}様々な事件のきっかけを探すのですわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0285",
   "jp": "勇ましき、小さき者の可能性を信じ、{n}ここに力を封ず。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0286",
   "jp": "　{n}　　　　『{FFEF}{s:000E}の可能性７{FFF1}』を手に入れた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0287",
   "jp": "料理は盛りつけまでが芸術なんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0288",
   "jp": "ふんふん♪{n}オイラは～、お城の～♪{n}おかかえ、コック～♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0289",
   "jp": "早く焼けないかしら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0290",
   "jp": "{s:0004}をよろしくお願いします。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0291",
   "jp": "他人の国へ来ているんだぞ。{n}礼儀を重んじるのも騎士のつとめだ。{p}テレポートを使いたいなら、{n}城の外へ出てからにしろ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen061.0292",
   "jp": "　{n}　　　　不思議な力でかき消された‥‥。",
   "en": "",
   "term": "end"
  }
 ]
}
