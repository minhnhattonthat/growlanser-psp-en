 "entries": [
  {
   "id": "scen098.0000",
   "jp": "",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen098.0001",
   "jp": "ローランディア兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen098.0002",
   "jp": "ローランディア兵隊長",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen098.0003",
   "jp": "バーンシュタイン兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen098.0004",
   "jp": "ノストリッジ平原駐留軍",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0005",
   "jp": "あとは、どうやってバーンシュタイン軍を{n}追い払うかだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0006",
   "jp": "{v:0000}おお、君たちが物資輸送を手伝ってくれたそうだな。{n}おかげで初めてちゃんとした補給を受けられたよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0007",
   "jp": "{v:0001}途中でシャドー・ナイトって奴が{n}邪魔してやがったんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0008",
   "jp": "{v:0002}シャドー・ナイトだと！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0009",
   "jp": "{v:0005}ええ。{n}たしかにそう記憶していますわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0010",
   "jp": "{v:0004}たしかに言っていたな。{n}シャドー・ナイトとか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0011",
   "jp": "{v:0003}うん、そんなこと言ってたね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0012",
   "jp": "{v:0006}そのシャドー・ナイトって、何なの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0013",
   "jp": "{v:0007}シャドー・ナイトは、{n}インペリアル・ナイトと全く逆の存在だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0014",
   "jp": "{v:0008}それってどういうこと？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0015",
   "jp": "{v:0009}国の象徴であり国民のあこがれである{n}インペリアル・ナイツ。{p}{v:000A}それとは逆に公には認められぬ、まさに影の実行部隊。{n}それがシャドー・ナイツだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0016",
   "jp": "{v:000B}影の実行部隊‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0017",
   "jp": "{v:000C}そうだ。{n}特殊な存在だけに、一般にはまったく知られていない。{p}{v:000D}われわれ軍部がこのことを知ったのも、{n}つい最近のことだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0018",
   "jp": "{v:0086}でも、今の奴、それほど強くなかったよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0019",
   "jp": "{v:000E}シャドー・ナイトの恐ろしさは、{n}一人一人の強さではない。{n}敵国内に忍び込み、妨害工作や暗殺を手がけることだ。{p}{v:000F}奴らの裏工作とインペリアル・ナイトの比肩なき強さ。{n}両者の連携の前に、{n}我々は苦しめられてきたということだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0020",
   "jp": "{v:0011}少なくともシャドー・ナイツの１人は{n}追い返しましたよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0021",
   "jp": "{v:0012}でも、今はシャドー・ナイトは{n}いなくなってしまいましたが。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0022",
   "jp": "{v:0010}でもアタシたちがやっつけちゃったけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0023",
   "jp": "{v:0013}ああ、そうだな。{n}だからこそ、今が正面のインペリアル・ナイトを{n}押し返すチャンスだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0024",
   "jp": "{v:0014}あの、オリビエ湖ってここから遠いんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0025",
   "jp": "{v:0015}オリビエ湖？{n}君たちはそこへ行きたいのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0026",
   "jp": "{v:0016}うん！{n}そこを調査するのが任務なんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0027",
   "jp": "{v:0017}ふむ‥‥。{p}{v:0018}オリビエ湖はそれほど遠くないのだが、{n}すぐには行けんぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0028",
   "jp": "{v:0019}たしか、ここからなら橋を越えてすぐだと思ったが？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0029",
   "jp": "{v:001A}その橋が渡れればの話だ。{p}{v:001B}バーンシュタイン軍は、橋を越えてこちら側まで{n}入り込んできている。{n}現在、総力をあげて押し返しているところだ。{p}{v:001C}何しろ今日は疲れただろう。{n}我が軍がバーンシュタイン軍を押し返すまで{n}休むといい。{p}{v:001D}といっても、テントしかないがな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0030",
   "jp": "お疲れさまです。{n}ベルナード将軍がお待ちです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0031",
   "jp": "お休みの用意が出来ています。{n}このテントをお使い下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0032",
   "jp": "あと一押しで、バーンシュタイン軍を{n}橋の向こうへ追いやれるのだが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0033",
   "jp": "いよいよ、俺の出番だぜ！{n}飯さえ食えりゃ、百人力よ！{n}お前たちには、ほんと感謝してるぜ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0034",
   "jp": "‥‥いよいよ出撃かぁ‥‥。{p}戦いなんて、しなくて済めば、{n}ソレが一番だと思わないかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0035",
   "jp": "何を腑抜けたこと、言ってんのよ！{n}負けたら、アンタのせいだからね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0036",
   "jp": "‥‥そりゃ、戦うときは真面目にやるけどさ。{n}僕だって死にたくはないからね。{n}けど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0037",
   "jp": "これで進軍できるわね！{n}私の魔法で、バーンシュタイン軍なんか{n}蹴散らしてあげるんだから！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0038",
   "jp": "おい、君‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0039",
   "jp": "ありがとうございます。{n}あなた達のおかげで、{n}この戦に勝つことが出来そうです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0040",
   "jp": "お疲れでしょうから、{n}今日はゆっくりとお休み下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0041",
   "jp": "テントで休みますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0042",
   "jp": "‥‥{v:0041}終わったみたいね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0043",
   "jp": "{v:0042}本当に君たちだけで{n}インペリアル・ナイトを追い払ってしまうとは‥‥。{p}{v:0043}まだ信じられん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0044",
   "jp": "{v:0044}だから、任せてって言ったでしょ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0045",
   "jp": "{v:0045}これで先まで進めるね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0046",
   "jp": "ありがとうございます。{n}きっと隊長もうかばれることでしょう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0047",
   "jp": "{v:0000}みんながんばってくれ。{n}ここが正念場だ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0048",
   "jp": "{v:0001}おおーっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0049",
   "jp": "{v:0002}くっ！{n}さすがにインペリアル・ナイトは強い‥‥。{n}ほとんどが奴１人に防がれているとは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0050",
   "jp": "{v:0003}どうしたんだろう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0051",
   "jp": "{v:0004}やっとここまで敵を押し返したというのに、{n}ここから先へ進めずにいるんだ。{p}{v:0005}敵のインペリアル・ナイトたった１人のせいでな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0052",
   "jp": "{v:0006}どうするの？{n}わたしたちの目的地もあと少しなんでしょ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0053",
   "jp": "戦線は膠着していますが、どうしますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0054",
   "jp": "・自分たちが戦う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen098.0055",
   "jp": "・今は戦わない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen098.0056",
   "jp": "・自分たちの出る幕じゃない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen098.0057",
   "jp": "{v:0007}先へ進むためには仕方ねぇよな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0058",
   "jp": "{v:0008}しかし、君たちだけでは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0059",
   "jp": "{v:0009}まぁ、見ててよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0060",
   "jp": "{v:000A}ちょっと手強そうだし、それなりの準備が必要よね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0061",
   "jp": "{v:000B}そうだ。{n}これ以上君たちに頼っては、{n}ローランディア軍の面目が立たん。{p}{v:000C}我々だけでここを切り抜けるんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0062",
   "jp": "{v:000D}おおーーっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0063",
   "jp": "{v:000E}何だ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0064",
   "jp": "・自分たちが戦う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen098.0065",
   "jp": "・何でもない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen098.0066",
   "jp": "{v:000F}先へ進むためには仕方ねぇよな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0067",
   "jp": "{v:0010}しかし、君たちだけでは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0068",
   "jp": "{v:0011}まぁ、見ててよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0069",
   "jp": "‥‥{v:0012}そうか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0070",
   "jp": "本当に信じられん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0071",
   "jp": "インペリアル・ナイト相手に、{n}この兵力で勝てるのか‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0072",
   "jp": "凄い‥‥。{n}ナイツ２人を追い払うなんて‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0073",
   "jp": "くそっ！{n}負けてたまるか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0074",
   "jp": "我がローランディアの騎士が{n}インペリアル・ナイツと互角に戦えるとは‥‥。{n}何だか自分のことのように嬉しいよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0075",
   "jp": "いったいどうすれば‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0076",
   "jp": "まさか、あのインペリアル・ナイツを{n}退かせる者がいようとは‥‥。{n}未だに信じられん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0077",
   "jp": "後は私たちに任せて、{n}君たちは君たちの任務に戻るといい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0078",
   "jp": "うん♪{n}将軍たちも頑張ってね★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0079",
   "jp": "いや～、君たちは本当に凄いな。{n}あのインペリアル・ナイトを退けるなんて‥‥。{p}私もその場面を見てみたかったな～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0080",
   "jp": "やっぱり凄く強かったな、インペリアル・ナイトって。{n}俺なんか腰が引けちゃって、何もできなかったよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0081",
   "jp": "私たちであのインペリアル・ナイトを退けたのよね！{p}う～ん‥‥気分爽快{FFF0}♥{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0082",
   "jp": "この辺りの敵を一掃することが出来ました。{n}これもあなた達のおかげですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0083",
   "jp": "これからも頑張って下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0084",
   "jp": "あなた達の戦いを見て士気の上がっている今なら、{n}バーンシュタイン兵を押し返す事ができるでしょう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0085",
   "jp": "化け物の次は支配階級グローシアンの末裔か‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0086",
   "jp": "バーンシュタインとの戦争は終わったが、{n}まだ事後処理があるからな。{n}しばらくこの陣をたたむことは出来んよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0087",
   "jp": "いや～、君たちは本当に凄いな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0088",
   "jp": "戦いに比べりゃ、事後処理の方が気が楽だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0089",
   "jp": "人間を相手にしなくていいなんて、{n}う～ん‥‥気分爽快{FFF0}♥{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0090",
   "jp": "ありがとうございます。{n}あなた達のおかげです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0091",
   "jp": "あなた達の戦いを見て、{n}自分の戦い方を見直しているところです‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0092",
   "jp": "一人で何処へ行く気よ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0093",
   "jp": "{v:0023}ワーッハハハッ！　本陣がこれほど手薄だとはな！{n}わざわざ遠回りをしてきた甲斐が{n}あったというものだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0094",
   "jp": "{v:0024}何だと！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0095",
   "jp": "{v:0025}物資不足で大きな行動を起こせなかったお前たちが{n}やっと物資を手に出来たんだ。{p}{v:0026}一斉に攻めるだろうと予想はしたが、{n}まさかここまでとはな！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0096",
   "jp": "{v:0027}くっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0097",
   "jp": "{v:0028}ベルナード将軍を倒せば、{n}ローランディア軍の士気は下がる！{n}奴を集中的にねらえ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0098",
   "jp": "{v:0029}はっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0099",
   "jp": "{v:002A}何だか大変なことになってる～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0100",
   "jp": "{v:002B}それにしてもタイミングが良すぎるな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0101",
   "jp": "{v:002C}兵隊がいなくなった時を狙って‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0102",
   "jp": "{v:002D}おおかた、あのモンスター使いが報告を入れたんで、{n}こっちが手薄になることを予測したんだろうよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0103",
   "jp": "{v:002E}自分が負けたことまでチャンスにしちゃうの？{n}それがシャドー・ナイト？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0104",
   "jp": "{FB00}{v:002F}さすが非情の裏工作部隊だぜ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0105",
   "jp": "{v:0030}感心してる場合じゃないよ！{n}アタシ達でベルナード将軍を守ってあげないと！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0106",
   "jp": "{v:001E}おはようございます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0107",
   "jp": "{v:001F}ずいぶんゆっくり眠れたようだな。{p}{v:0020}君たちのおかげで物資も届き、兵の士気が高まったよ。{n}昨夜から総力をあげてバーンシュタイン軍を{n}押し戻しているところだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0108",
   "jp": "{v:0021}それで兵隊がここに残ってないんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0109",
   "jp": "{v:0085}まもなく橋の向こうまで押し返すことが出来るだろう。{p}{v:0022}そうすれば君たちもオリビエ湖まで行くことが{n}出来るはずだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0110",
   "jp": "まさか、背後から襲ってくるとは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0111",
   "jp": "怖かった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0112",
   "jp": "‥‥やれやれ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0113",
   "jp": "何とか将軍を守り抜きましたね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0114",
   "jp": "危ないところだったね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0115",
   "jp": "どうしたんだい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0116",
   "jp": "{v:0040}大丈夫ですか！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0117",
   "jp": "{v:0041}ああ、ありがとう。{n}おかげで助かったよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0118",
   "jp": "{v:0042}せっかく士気が上がったって時に、{n}将軍に死なれるわけにはいかねぇからな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0119",
   "jp": "{v:0043}うむ、かたじけない。{p}{v:0044}しかし、今の連中は‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0120",
   "jp": "{v:0045}おそらくシャドー・ナイトの部下だろう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0121",
   "jp": "{v:0046}うむむ‥‥油断のならん連中だ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0122",
   "jp": "将軍！{n}我が方は優勢！{n}じりじりと敵兵を押しやっております！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0123",
   "jp": "{v:0048}おお、そうか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0124",
   "jp": "しかし、さすがに敵も橋から向こうへは引きません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0125",
   "jp": "{v:004A}そうか。{n}あと一歩だな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0126",
   "jp": "{v:004B}橋が渡れないと、オリビエ湖には行けないね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0127",
   "jp": "{v:004C}そうだな。{n}なんとかしてバーンシュタイン王国を{n}橋の向こうへ追いやる必要がある。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0128",
   "jp": "{v:004D}何か決め手になるようなことがあれば、{n}連中を国内から追い出せるのだが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0129",
   "jp": "お休みになられますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen098.0130",
   "jp": "いつでも声をかけて下さい。",
   "en": "",
   "term": "end"
  }
 ]
}
