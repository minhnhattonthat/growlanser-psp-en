 "entries": [
  {
   "id": "scen198.0000",
   "jp": "",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen198.0001",
   "jp": "{FFEE}敵を逃がすな！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0002",
   "jp": "{v:0010}ぼやぼやしてると、研究書を取り戻せないよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0003",
   "jp": "{v:001D}ああ、やばいよ！{n}逃げられちゃう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0004",
   "jp": "{v:001E}くっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0005",
   "jp": "{v:001F}ふん、ノロマな奴め！{n}そこで遊んでいるがいい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0006",
   "jp": "{v:0020}この研究書は確かにいただいたぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0007",
   "jp": "{v:004D}そんな‥‥。逃げられちゃうなんて‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0008",
   "jp": "{v:0011}お前は、あの時の！？{n}ええい！しつこい奴め！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0009",
   "jp": "{v:0012}泥棒のくせに何言ってんのよ！{n}マスターの研究書を返しなさいよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0010",
   "jp": "{v:0013}邪魔をすると容赦はせぬぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0011",
   "jp": "{v:0014}ムッカ～ッ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0012",
   "jp": "逃がさないから！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0013",
   "jp": "逃がすか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0014",
   "jp": "目障りだ！　死ねい！！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0015",
   "jp": "すまねぇ‥‥。{n}役に立てなかった‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0016",
   "jp": "　{n}　　　『{FFEF}サンドラの研究書{FFF1}』を取り戻した！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0017",
   "jp": "お、おのれ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0018",
   "jp": "ここまでか‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0019",
   "jp": "ざ、残念だったな‥‥。{n}俺は持ってないぜ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0020",
   "jp": "くそっ‥‥。{n}もう少しで逃げられたのに‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0021",
   "jp": "{v:000D}これは！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0022",
   "jp": "{v:000E}追っ手だ！{n}お前は我々の脱出を手伝ってくれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0023",
   "jp": "{v:000F}承知した！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0024",
   "jp": "ジュリアン？{n}どうしてここに？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0025",
   "jp": "心配になってきたのだが‥‥。{n}どうやら無用な気づかいだったようだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0026",
   "jp": "{v:0015}危なっかしい戦い方だな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0027",
   "jp": "{v:0016}ジュリアン？{n}どうしてここに？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0028",
   "jp": "{v:0017}そんな事はどうでもいい！{n}今はこいつらを倒すんだろ？{n}私も加勢する！{p}{v:0018}どうして欲しい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0029",
   "jp": "さぁ、次はどいつを狙えばいい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0030",
   "jp": "ジュリアンにどう指示しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0031",
   "jp": "・攻撃目標を指定",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen198.0032",
   "jp": "・自由に戦って欲しい",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen198.0033",
   "jp": "・その場で待機",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen198.0034",
   "jp": "{v:0019}こいつでいいんだな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen198.0035",
   "jp": "{v:001A}わかった！",
   "en": "",
   "term": "end"
  }
 ]
}
