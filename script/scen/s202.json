 "entries": [
  {
   "id": "scen202.0000",
   "jp": "",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen202.0001",
   "jp": "{FFEE}アリオストを救出せよ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen202.0002",
   "jp": "僕はどうしたらいいだろう？{n}できる限りの事はやってみるつもりだが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen202.0003",
   "jp": "{v:0019}１つ忠告がある。{n}この部屋には色の違う床があるだろ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen202.0004",
   "jp": "{v:001A}この床が腐っちゃってる部分ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen202.0005",
   "jp": "{v:001B}腐った床がどうかしたのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen202.0006",
   "jp": "{v:001C}そこだけは踏まないことだ。{p}{v:001D}この塔のエネルギーがもれているらしくて、{n}定期的に放電する。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen202.0007",
   "jp": "{v:001E}放電！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen202.0008",
   "jp": "{v:001F}下手に巻き込まれると、ダメージを受けるからね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen202.0009",
   "jp": "{v:0020}わ、わかりました！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen202.0010",
   "jp": "戦況が変わってきたようだね。{n}僕も行動を変えた方がいいかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen202.0011",
   "jp": "{v:0021}もうちょっとだから、がんばって！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen202.0012",
   "jp": "{v:0022}ああ、すまない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen202.0013",
   "jp": "{v:0023}今助けます！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen202.0014",
   "jp": "{v:0024}すまない、ルイセ君。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen202.0015",
   "jp": "{v:0025}待ってろ、今助ける！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen202.0016",
   "jp": "{v:0026}お願いします。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen202.0017",
   "jp": "{v:002A}うっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen202.0018",
   "jp": "{v:002B}バカ、何やってんの！{n}アリオストさんがやられちゃうじゃない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen202.0019",
   "jp": "{v:002C}ぐぅっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen202.0020",
   "jp": "{v:002D}ああ、アリオストさん！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen202.0021",
   "jp": "‥‥{v:002E}あと少しだったのに‥‥。{n}ゴメンよ‥父さん‥母さん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen202.0022",
   "jp": "{v:002F}やったぁ★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen202.0023",
   "jp": "アリオストへ、どう指示しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen202.0024",
   "jp": "・その場で防御",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen202.0025",
   "jp": "・自由に戦ってもらう",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen202.0026",
   "jp": "・{s:0000}のそばにいさせる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen202.0027",
   "jp": "・ルイセのそばにいさせる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen202.0028",
   "jp": "・ウォレスのそばにいさせる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen202.0029",
   "jp": "誰の事を言っているんだい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen202.0030",
   "jp": "わかった。{n}がんばるよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen202.0031",
   "jp": "{v:0027}ちょ、ちょっと、気をつけてよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen202.0032",
   "jp": "{v:0028}きゃあぁっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen202.0033",
   "jp": "{v:0029}ぬうぅっ！",
   "en": "",
   "term": "end"
  }
 ]
}
