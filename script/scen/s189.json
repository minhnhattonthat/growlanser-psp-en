  {
   "id": "scen189.0017",
   "jp": "そろそろ集合時間だね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen189.0018",
   "jp": "　{n}　　　　　携帯集魔柱が設置してある。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen189.0019",
   "jp": "今日は可愛いブローチを仕入れてますよ。{n}恋人へのプレゼントに喜ばれることうけあいです！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen189.0020",
   "jp": "どうだい、このブローチ。{n}安くしておくよ。{n}１００エルムだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen189.0021",
   "jp": "買っていきますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen189.0022",
   "jp": "ありがとうございました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen189.0023",
   "jp": "お金が足りないですよ‥‥[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen189.0024",
   "jp": "今日買わないとなくなっちゃいますよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen189.0025",
   "jp": "お買い上げ、{n}ありがとうございました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen189.0026",
   "jp": "いらっしゃいませ。{n}どうぞご覧になって下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen189.0027",
   "jp": "どっかにもっといいスキマはねぇかな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen189.0028",
   "jp": "どこかに面白い店はないかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen189.0029",
   "jp": "休暇を楽しんで下さいね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen189.0030",
   "jp": "休暇{FFEB}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen189.0031",
