   "jp": "・{FFEF}グローランド{FFF1}（カレン）",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen067.0041",
   "jp": "・{FFEF}ワイワイランド{FFF1}（ルイセ）",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen067.0042",
   "jp": "・{FFEF}ワクワクランド{FFF1}（ルイセ）",
   "en": "",
