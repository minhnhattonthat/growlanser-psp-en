   "unref": true
  },
  {
   "id": "scen067.0044",
   "jp": "・{FFEF}ティピちゃん王国{FFF1}",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen067.0045",
   "jp": "カラジューム",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen067.0046",
   "jp": "うふふっ！{n}嬉しいですぅ♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen067.0047",
   "jp": "ムスカリ",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen067.0048",
   "jp": "グローランド",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen067.0049",
   "jp": "選んでもらえて光栄です。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen067.0050",
   "jp": "ワイワイランド",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen067.0051",
   "jp": "ほ、本当にいいのかなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen067.0052",
   "jp": "ワクワクランド",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen067.0053",
   "jp": "{s:0000}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen067.0054",
   "jp": "後悔してねぇならいいさ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen067.0055",
   "jp": "ティピちゃん王国",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen067.0056",
   "jp": "じょ、冗談だったのにぃ～‥‥。{FFFB}{n}{FB00}でも、ちょっと嬉しいかも‥‥♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen067.0057",
   "jp": "どれにしますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen067.0058",
   "jp": "・{FFEF}カラジューム{FFF1}（ミーシャ）",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen067.0059",
   "jp": "・{FFEF}ムスカリ{FFF1}（ミーシャ）",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen067.0060",
   "jp": "・{FFEF}グローランド{FFF1}（カレン）",
   "en": "",
