 "entries": [
  {
   "id": "scen199.0000",
   "jp": "",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen199.0001",
   "jp": "エリオット父",
   "en": "Elliot's Father",
   "term": "null",
   "src": "ps1"
  },
  {
   "id": "scen199.0002",
   "jp": "エリオット母",
   "en": "Elliot's Mother",
   "term": "null",
   "src": "ps1"
  },
  {
   "id": "scen199.0003",
   "jp": "‥‥{v:0015}あの‥‥話が見えないんだけど‥‥。",
   "en": "...{v:0015}Um... I'm not following any of this...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0004",
   "jp": "{v:0016}戦わざるをえないってことだ。",
   "en": "{v:0016}It means we've got no choice but to fight.",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0005",
   "jp": "{v:0017}まあ、そういう事だな。",
   "en": "{v:0017}Well, that is the situation.",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0006",
   "jp": "{FFEE}少年とその両親、村人を守れ！{FFF1}",
   "en": "{FFEE}Protect the boy, his parents, and the villagers!{FFF1}",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0007",
   "jp": "{v:0026}こないだは、よくも恥をかかせてくれたな！",
   "en": "{v:0026}You've got some nerve, showing me up like that{n}last time!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0008",
   "jp": "{v:0027}それじゃ、女の子を襲うのは恥じゃないの？",
   "en": "{v:0027}Oh, so you're not ashamed of attacking a girl?",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0009",
   "jp": "{v:0028}うるせぇ！",
   "en": "{v:0028}Shut up!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0010",
   "jp": "{v:0018}大丈夫？{n}今助けてあげるから！",
   "en": "{v:0018}Are you okay? We're coming to help!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0011",
   "jp": "{v:0019}は、はい。{n}僕より、父さんと母さんを‥‥。",
   "en": "{v:0019}Y-yes. Please help my father and mother first...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0012",
   "jp": "{v:001A}任せといて！",
   "en": "{v:001A}Leave it to us!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0013",
   "jp": "{v:0046}うわっ！{n}来ないで下さい！",
   "en": "{v:0046}Aah! Please stay away!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0014",
   "jp": "そ‥そんな‥‥。",
   "en": "N-no... This can't be...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0015",
   "jp": "エリオット！",
   "en": "Elliot!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0016",
   "jp": "よし、引き上げるぞ！",
   "en": "All right, we're pulling out!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0017",
   "jp": "へい！",
   "en": "Aye, boss!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0018",
   "jp": "よし、引き上げだ！",
   "en": "All right, pull out!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0019",
   "jp": "バカ、バカ！{n}あの子やられちゃったじゃない！",
   "en": "Idiot, idiot! You let them get that boy!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0020",
   "jp": "人も助けられないなんて、何のための剣術だ！",
   "en": "What good is swordsmanship if I cannot even{n}save someone?!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0021",
   "jp": "待ってろ、エリオット！{n}今、助けるぞ！",
   "en": "Hold on, Elliot! I'm coming to help!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0022",
   "jp": "父さん‥‥。",
   "en": "Father...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0023",
   "jp": "お前をこんな所で死なせるわけにはいかないのよ。{n}早く逃げなさい！",
   "en": "I cannot let you die here. Hurry, run!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0024",
   "jp": "母さん‥‥。",
   "en": "Mother...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0025",
   "jp": "エリオットには、指一本、触れさせんぞ！",
   "en": "I won't let you lay a finger on Elliot!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0026",
   "jp": "{v:004F}うぅっ！",
   "en": "{v:004F}Ugh!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0027",
   "jp": "{v:0050}父さん！",
   "en": "{v:0050}Father!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0028",
   "jp": "{v:0051}私に構うな‥‥お前だけは‥逃げろ！",
   "en": "{v:0051}Never mind me... You, at least... must escape!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0029",
   "jp": "バカ、バカ！{n}あの子の父親がやられちゃったじゃない！",
   "en": "Idiot, idiot! You let them get that boy's father!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0030",
   "jp": "エリオット！{n}ここは私たちに任せて、はやく逃げなさい！",
   "en": "Elliot! Leave this to us and hurry away!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0031",
   "jp": "{v:0052}ああっ！",
   "en": "{v:0052}Aah!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0032",
   "jp": "{v:0053}母さん！",
   "en": "{v:0053}Mother!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0033",
   "jp": "{v:0054}私のことより、自分の身を守りなさい‥‥。",
   "en": "{v:0054}Protect yourself... Never mind me...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0034",
   "jp": "バカ、バカ！{n}あの子の母親がやられちゃったじゃない！",
   "en": "Idiot, idiot! You let them get that boy's mother!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0035",
   "jp": "{v:0059}ぐっ‥‥一度ならず、二度までも‥‥。{p}{v:005A}覚えていろ！",
   "en": "{v:0059}Grr... Not once, but twice...{p}{v:005A}You'll pay for this!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0036",
   "jp": "{v:005B}後は任せたぞ！",
   "en": "{v:005B}You lot take care of the rest!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0037",
   "jp": "{v:005C}へい！",
   "en": "{v:005C}Aye, boss!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0038",
   "jp": "くそっ。{n}逃がしたか‥‥。",
   "en": "Damn. He got away...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0039",
   "jp": "オズワルドはいなくなった。{n}次はどうすればいいのだ？",
   "en": "Oswald is gone. What should I do next?",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0040",
   "jp": "バ、バカな！？",
   "en": "I-impossible?!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0041",
   "jp": "グハッ！",
   "en": "Gah!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0042",
   "jp": "ここまでか‥‥",
   "en": "So this is it...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0043",
   "jp": "死にたくねぇ‥‥",
   "en": "I don't wanna die...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0044",
   "jp": "つ、強え‥‥",
   "en": "S-so strong...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0045",
   "jp": "何でこんな事に‥‥",
   "en": "How did it come to this...?",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0046",
   "jp": "{v:005D}やったね★",
   "en": "{v:005D}We did it!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0047",
   "jp": "‥‥{v:005E}怖かった‥‥。",
   "en": "...{v:005E}I was so scared...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0048",
   "jp": "{v:0042}うわぁっ！",
   "en": "{v:0042}Aaah!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0049",
   "jp": "{v:0043}きゃあっ！",
   "en": "{v:0043}Eek!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0050",
   "jp": "{v:0044}いかん！村人に被害が！",
   "en": "{v:0044}No! The villagers are being hurt!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0051",
   "jp": "{v:0045}ほら、何とかしないと！",
   "en": "{v:0045}Come on, we've gotta do something!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0052",
   "jp": "{v:001B}お前ら、俺の邪魔ばかりしやがって！{n}そんなに俺様に恨みがあるのかよ！",
   "en": "{v:001B}You bastards keep getting in my way! What've you got{n}against me, huh?!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0053",
   "jp": "{v:001C}アンタが悪さばかりするからでしょ！",
   "en": "{v:001C}Maybe it's because you keep doing rotten things!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0054",
   "jp": "{v:001D}馬鹿野郎！{n}これは仕事だ！",
   "en": "{v:001D}You idiot! This is a job!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0055",
   "jp": "{v:001E}仕事！？{p}{v:001F}誰かに頼まれたんですか？",
   "en": "{v:001E}A job?!{p}{v:001F}Did someone hire you?",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0056",
   "jp": "{v:0021}言えねぇなぁ！{p}{v:0022}これ以上、邪魔するっていうなら{n}こっちにも考えがある！",
   "en": "{v:0021}Wouldn't you like to know!{p}{v:0022}Keep getting in my way, and I've got a little plan of{n}my own!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0057",
   "jp": "{v:0023}おい、野郎ども！{n}ここの村人もみな殺しにしろ！",
   "en": "{v:0023}Hey, boys! Kill all the villagers here, too!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0058",
   "jp": "{v:0024}へっへっへっ！{n}了解だぁ！",
   "en": "{v:0024}Heh heh heh! You got it!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0059",
   "jp": "{v:0025}なんと卑劣な！",
   "en": "{v:0025}How despicable!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0060",
   "jp": "へっへっへっ‥‥。",
   "en": "Heh heh heh...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0061",
   "jp": "{v:0033}ああ、アイツの手下が！",
   "en": "{v:0033}Ah! His henchmen!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0062",
   "jp": "{v:0034}村の人が危ないよ！",
   "en": "{v:0034}The villagers are in danger!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0063",
   "jp": "‥‥{v:0035}見かけによらず、用意周到な奴だな。",
   "en": "...{v:0035}He is more thorough than he looks.",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0064",
   "jp": "‥‥{v:002C}多勢に無勢といったところか。{p}{v:002D}おい、お前の作戦にあわせて動いてやる！{n}どうして欲しい？",
   "en": "...{v:002C}It seems we are outnumbered.{p}{v:002D}Listen, I shall follow your strategy! What would you{n}have me do?",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0065",
   "jp": "ブッ殺してやる！",
   "en": "I'll kill you!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0066",
   "jp": "{v:0036}まだいたのか‥‥。",
   "en": "{v:0036}There are still more...?",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0067",
   "jp": "{v:0037}こんなに追っ手がいたなんて‥‥。{FFF9}{FFFB}{n}{v:0038}もうダメだ‥‥。",
   "en": "{v:0037}I never knew so many people were after{n}us...{FFF9}{FFFB}{v:0038}There's no hope...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0068",
   "jp": "何と声をかけますか？",
   "en": "What will you say?",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0069",
   "jp": "・励ます",
   "en": "・Encourage him",
   "term": "end",
   "unref": true,
   "src": "ps1"
  },
  {
   "id": "scen199.0070",
   "jp": "・安心させる",
   "en": "・Reassure him",
   "term": "end",
   "unref": true,
   "src": "ps1"
  },
  {
   "id": "scen199.0071",
   "jp": "・諦めさせる",
   "en": "・Tell him to give up",
   "term": "end",
   "unref": true,
   "src": "ps1"
  },
  {
   "id": "scen199.0072",
   "jp": "・放っておく",
   "en": "・Leave him alone",
   "term": "end",
   "unref": true,
   "src": "ps1"
  },
  {
   "id": "scen199.0073",
   "jp": "{v:0039}そうよ！{n}最後まであきらめちゃダメだよ！",
   "en": "{v:0039}That's right! Don't give up until it's over!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0074",
   "jp": "{v:003A}で、でも‥‥。",
   "en": "{v:003A}B-but...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0075",
   "jp": "{v:003B}いいから、アタシ達を信じてなさい！",
   "en": "{v:003B}Oh, just trust us!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0076",
   "jp": "{v:003C}は、はい！",
   "en": "{v:003C}Y-yes!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0077",
   "jp": "{v:003D}わ、わかりました！{n}あなたを信じます！",
   "en": "{v:003D}A-all right! I'll trust you!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0078",
   "jp": "{v:003E}ちょっと！{n}アンタがそんな調子で、どうすんのよ！",
   "en": "{v:003E}Hey! What good is that attitude of yours gonna do?!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0079",
   "jp": "{v:003F}いい！？{n}最後まであきらめちゃダメよ！",
   "en": "{v:003F}Listen up! Don't give up until it's over!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0080",
   "jp": "{v:0040}は、はい‥‥。",
   "en": "{v:0040}Y-yes...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0081",
   "jp": "{v:0041}ちょっと！{n}何か言ってやったらどうなのよ！",
   "en": "{v:0041}Hey! Can't you say something to him?!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0082",
   "jp": "お前ら全員、血祭りだぁ！",
   "en": "I'll bathe in your blood, all of you!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0083",
   "jp": "{v:0029}うわぁ！　こんなところに！",
   "en": "{v:0029}Aah! They're here, too!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0084",
   "jp": "{v:002A}きゃぁっ！{n}来ないでぇ！",
   "en": "{v:002A}Eek! Stay awaaay!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0085",
   "jp": "さぁ、次はどうすればいい？",
   "en": "Now, what should I do next?",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0086",
   "jp": "ジュリアンにどう指示しますか？",
   "en": "What orders will you give Julian?",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0087",
   "jp": "・攻撃目標を指定",
   "en": "・Choose an attack target",
   "term": "end",
   "unref": true,
   "src": "ps1"
  },
  {
   "id": "scen199.0088",
   "jp": "・自由に戦わせる",
   "en": "・Let Julian fight freely",
   "term": "end",
   "unref": true,
   "src": "ps1"
  },
  {
   "id": "scen199.0089",
   "jp": "・エリオットの護衛",
   "en": "・Guard Elliot",
   "term": "end",
   "unref": true,
   "src": "ps1"
  },
  {
   "id": "scen199.0090",
   "jp": "・その場で防御",
   "en": "・Defend in place",
   "term": "end",
   "unref": true,
   "src": "ps1"
  },
  {
   "id": "scen199.0091",
   "jp": "{v:002E}わかった！",
   "en": "{v:002E}Understood!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0092",
   "jp": "{v:0031}では、自由にやらせてもらう！",
   "en": "{v:0031}Then I shall fight as I see fit!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen199.0093",
   "jp": "{v:002F}私に任せろ！",
