  },
  {
   "id": "scen057.0001",
   "jp": "市民",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen057.0002",
   "jp": "バーンシュタイン兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen057.0003",
   "jp": "ダグラス卿部下",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen057.0004",
   "jp": "執事",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen057.0005",
   "jp": "店員",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen057.0006",
   "jp": "ユング",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen057.0007",
   "jp": "ジョニー",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen057.0008",
   "jp": "トニー",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen057.0009",
   "jp": "ダグラス卿",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen057.0010",
   "jp": "はい？{p}あら、ローランディアの方ね。{n}かなりウワサになっているようだけど、{n}インペリアル・ナイトとどっちが強いのかしら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0011",
   "jp": "何だか街の方が騒がしいなぁ‥‥。{n}と言っても、持ち場を離れるわけにいかんし‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0012",
   "jp": "ようこそ。{n}大陸でもっとも文明が進んだ街、バーンシュタインへ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0013",
   "jp": "城門付近制圧完了！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0014",
   "jp": "このあたりには、{n}もうリシャール派の兵はいません！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0015",
   "jp": "{v:0027}そういえば、{n}どうしてグローシュが強くなったんだろう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0016",
   "jp": "{v:0028}それはね、{n}わたしが皆既日食のグローシアンだってこと。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0017",
   "jp": "{FB00}{v:0029}うにゃあ？{n}よくわかんない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0018",
   "jp": "{v:002A}皆既日食って、お日様が完全に消えて、{n}また姿を現すでしょ？　わたしのグローシュも{n}完全に消えてから、もう一度戻った。{p}{v:002B}これって似てると思わない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0019",
   "jp": "{v:002C}なるほど。{n}一度能力を失い、再び戻ったとき、{n}つまり能力の生まれ変わりが、鍵だったのか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0020",
   "jp": "{v:002D}つまり、一回無くなってもう一度能力が戻るってのが、{n}真の能力の発動のきっかけだったんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0021",
   "jp": "{v:002E}つまり一回無くなってもう一度能力が戻るってのが、{n}真の能力の発動のきっかけだったんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0022",
   "jp": "{v:002F}そういうこと。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0023",
   "jp": "{v:0030}だけど、どうすればもう一度能力が戻るかは{n}わかってないんだろ？{n}これじゃ、正確な方法が残っていないわけだぜ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0024",
   "jp": "{v:0031}わたしの場合は、ただ単に運が良かっただけだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0025",
   "jp": "{v:0032}恥を忍んで、頼みたいことがある。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0026",
   "jp": "{v:0033}どうしたんだ、あらたまって？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0027",
   "jp": "{v:0034}実はこの王都から北東に向かったところに、{n}ゲヴェルの住処とおぼしき場所を見つけたのだが、{n}我々には攻め入る手段がないのだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0028",
   "jp": "{v:0035}しかし今の戦いをみて実感したよ。{n}グローシュを持つ彼女がいれば、{n}ゲヴェルを倒せるだろう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0029",
   "jp": "{v:0036}厚かましい頼みだけど、{n}君たちにゲヴェルを倒して欲しいんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0030",
   "jp": "{v:0038}ありがとう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0031",
   "jp": "{v:0039}この期に及んで、コイツ～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0032",
   "jp": "{FB00}{FFFA}{FFEC}　　　超{FFED}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0033",
   "jp": "{FB00}{FFFA}{FFEC}ティピちゃん{FFED}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0034",
   "jp": "{FB00}{FFFA}{FFEC}　　　乱{FFED}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0035",
   "jp": "{FB00}{FFFA}{FC00}{FB00}{FFEC}　　　舞{FFED}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0036",
   "jp": "{v:003A}気を取り直して‥と。{n}みんなに言われなくてもやるつもりだよ、ね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0037",
   "jp": "{v:003B}うん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0038",
   "jp": "{v:003C}ああ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0039",
   "jp": "{v:003D}そうよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0040",
   "jp": "{v:003E}まぁな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0041",
   "jp": "{v:003F}ああ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0042",
   "jp": "{v:0040}うん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0043",
   "jp": "{v:0041}後は、僕たちに任せて下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0044",
   "jp": "{v:0042}陛下！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0045",
   "jp": "{v:0043}大丈夫です。{n}ルイセさんもいますから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0046",
   "jp": "{v:0044}私もついてる。{n}陛下のことは心配しないでくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0047",
   "jp": "{v:0045}ま、そういうわけだから、任せておけって！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0048",
   "jp": "バーンシュタイン北東の沼地へ",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0049",
   "jp": "城は街の北西にある。{n}このまま一気に駆け抜けよう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0050",
   "jp": "えぇっ！？{n}敵の中を突破していくのぉ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0051",
   "jp": "あなた方のおかげで助かりました。{n}本当にありがとうございます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0052",
   "jp": "あの化け物を倒せるのは、あなた方だけです。{n}どうか我々を‥‥、大陸に住む人々を救って下さい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0053",
   "jp": "‥‥{v:0046}頼む。{n}この国の‥‥いや、この大陸の平和は、{n}君たちにかかっている。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0054",
   "jp": "{v:0047}頼むよ。{n}連中はこの街の北東の森の中、沼地の奥にいる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0055",
   "jp": "{v:000E}まさかここも正面突破？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0056",
   "jp": "{v:000F}もしご希望であれば、そうしますが？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0057",
   "jp": "{v:0010}う、ううん！{n}とんでもない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0058",
   "jp": "{v:0011}確かこのあたりに、城内への抜け道があるはずです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0059",
   "jp": "戻ってどうするんだい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0060",
   "jp": "ひょっとして、何か用意を忘れたのかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0061",
   "jp": "なかなか慎重派なんだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0062",
   "jp": "我々が市街地を突破するにあわせて、{n}ダグラス卿の軍が市街地制圧を行っているはずだ。{p}僕はここで待っているから、{n}準備を整えてくるといい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0063",
   "jp": "ならば、先を急ごう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0064",
   "jp": "用意はすんだね？{n}さ、行こうか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0065",
   "jp": "よく見ると古井戸の中に通路がある。{n}中へ入りますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0066",
   "jp": "{v:0000}はい、到着★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0067",
   "jp": "‥‥{v:0001}初めてテレポートを体験しましたが、{n}正直に言って、すごいものですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0068",
   "jp": "{v:0002}えへへ‥‥★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0069",
   "jp": "{v:0003}テレポートがあるから、{n}ぎりぎりまでねばっていたようだな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0070",
   "jp": "{v:0004}あ、ジュリアン！{n}お久しぶり～♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0071",
   "jp": "{v:0005}レティシア姫、サンドラ様、お待ちしておりました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0072",
   "jp": "{v:0006}お招きに預かり、光栄です。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0073",
   "jp": "{v:0007}会場までご案内いたします。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0074",
   "jp": "{v:0008}こちらへどうぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0075",
   "jp": "{v:0009}ありがとう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0076",
   "jp": "{v:000A}さ、お前たちも中へ。{n}みんなも待っているぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0077",
   "jp": "{v:000B}みんな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0078",
   "jp": "{v:000C}フフッ。{n}行けば分かるさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0079",
   "jp": "パーティーに行くんでしょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0080",
   "jp": "古井戸の中の通路は頑丈な鉄格子で{n}内側から閉じられていた‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0081",
   "jp": "どうぞお通り下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0082",
   "jp": "ここはバーンシュタイン城です。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0083",
   "jp": "さ、中へ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0084",
   "jp": "これはエリオット様。{n}どうぞお通り下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0085",
   "jp": "{s:0000}様ですね。{n}どうぞお通り下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0086",
   "jp": "バーンシュタイン王都",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0087",
   "jp": "ここから先は王家の直轄地である。{n}たとえ王の知人といえども、{n}一般人が足を踏み入れることはできません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0088",
   "jp": "あれ以来、化け物の姿はなくなりました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0089",
   "jp": "ゲヴェルの地下城を見張っている奴が、{n}気になることを言っていたんだが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0090",
   "jp": "お気をつけて。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0091",
   "jp": "化け物はいなくなったようですが。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0092",
   "jp": "どうやらゲヴェルのつくった地下の城に{n}再び動きがあったそうです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0093",
   "jp": "この先です。{n}この先に化け物が住み着いているみたいです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0094",
   "jp": "ぼ、ぼっちゃん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0095",
   "jp": "‥‥人違いでした。失礼。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0096",
   "jp": "うちの坊ちゃんはしばらく前に家を{n}飛び出したっきり戻られなくて‥‥。{p}このままでは豪商といわれたハウエル家も‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0097",
   "jp": "ラルフ坊ちゃんはいつ戻られるのだろう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0098",
   "jp": "お部屋のご利用は{n}宿代を払ってからにして下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0099",
   "jp": "いらっしゃいませ。{n}お泊まりは{FFEB}エルムですが？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0100",
   "jp": "ごゆっくりお休み下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0101",
   "jp": "ありがとうございました。{n}気を付けて行ってらっしゃいませ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0102",
   "jp": "お客さま‥‥[01BE]{n}お金が足りないみたいですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0103",
   "jp": "またのお越しをお待ちしております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0104",
   "jp": "{v:003E}また逃げられちゃったね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0105",
   "jp": "{v:003F}なんだか気になること言ってたな。{n}この国の兵力を奪う、とか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0106",
   "jp": "{v:0040}どういうことだと思う？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0107",
   "jp": "・人間を皆殺しにする",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen057.0108",
   "jp": "・人間を支配する",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen057.0109",
   "jp": "・わからない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen057.0110",
   "jp": "{v:0041}皆殺し？{p}{v:0042}違うな。{n}皆殺しなら、兵力を奪うなどということはしない。{p}{v:0043}答えはこうだ。{n}反抗する力を奪い、後は恐怖で支配する。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0111",
   "jp": "{v:0044}どうやらそのようだな。{n}人間の牙を折っておき、後は恐怖で支配する。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0112",
   "jp": "{v:0045}わからないか？{p}{v:0046}反抗する力を奪い、後は恐怖で支配する、{n}ってことだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0113",
   "jp": "{v:0047}被支配者である人間には手を出さない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0114",
   "jp": "{v:0048}なんだかムカツクゥ～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0115",
   "jp": "魔法学院へ報告",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0116",
   "jp": "{v:0049}でも、魔法学院の生徒は襲われたけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0117",
   "jp": "{v:004A}そりゃ、自分のことを考えてみれば分かるだろ？{n}魔法使いなんて、考えようによっちゃ兵士と{n}同じだぜ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0118",
   "jp": "{v:004B}あ、そうか‥‥。{p}{v:004C}つまり、{n}自分を狙う戦力だけを目標にしてるってこと？{p}{v:004D}支配者として、労働力には手を出さない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0119",
   "jp": "{v:004E}キ～～～ッ！！{n}やっぱり、ムカツク～ッ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0120",
   "jp": "{v:004F}さて、これからどうするか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0121",
   "jp": "ヴェンツェルの真意は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0122",
   "jp": "グギギギ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0123",
   "jp": "い、いや‥‥、{n}来ないで‥‥‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0124",
   "jp": "きゃあああっ！！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0125",
   "jp": "どうだ！{n}思い知ったか、下等な人間ども！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0126",
   "jp": "そんな‥‥。{n}間に合わなかったなんて‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0127",
   "jp": "{v:0032}市民の安全を優先するんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0128",
   "jp": "{v:0033}クックックッ！{n}暴れろ！{n}食らえ！{p}{v:0034}我々の恐ろしさを、人間どもに刻みつけてやれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0129",
   "jp": "{v:0035}そんなことはさせないわよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0130",
   "jp": "{v:0036}またお前たちか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0131",
   "jp": "{v:0037}この国を好きなようにはさせません！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0132",
   "jp": "{v:0038}今度は逃がさねぇ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0133",
   "jp": "{n}　　　　　　　鍵がかかっている。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0134",
   "jp": "あ、足がすくんでしまった‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0135",
   "jp": "やばかった‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0136",
   "jp": "怖かったわ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0137",
   "jp": "どうなっているの‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0138",
   "jp": "我々だけでは、ここを守りきれなかったでしょう。{n}ありがとうございました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0139",
   "jp": "た、助かった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0140",
   "jp": "また化け物が襲ってくるとは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0141",
   "jp": "あ、ラルフ兄ちゃん！{n}今度勉強みてくれよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0142",
   "jp": "なんだい？{n}俺の楽団『ジョニー・カルテット』に{n}出演の依頼かい？{p}依頼料は１２００エルムだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0143",
   "jp": "公演を依頼しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0144",
   "jp": "よし、引き受けた。{n}場所は‥‥？{FFFB}{n}{s:0010}だな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0145",
   "jp": "‥‥っとその前に、{n}お近づきのしるしにこれをあげよう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0146",
   "jp": "　{n}　　　　『{FFEF}サウンドテスト{FFF1}』を手に入れた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0147",
   "jp": "依頼料を払えないんじゃ、演奏は出来ないな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0148",
   "jp": "その気になったら、いつでも声をかけてくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0149",
   "jp": "ジョニー兄さんなら、公演旅行中だよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0150",
   "jp": "だれだい？{n}最近よく見かける顔だなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0151",
   "jp": "屋根が地面になっているなんて、{n}変わった構造の街だと思わないかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0152",
   "jp": "あっ{FFF0}♥{FFF1}{p}あの‥‥。{n}この間の‥‥戦いで‥‥{n}‥‥その‥‥‥{p}‥‥さようなら！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0153",
   "jp": "どこかに腕のいい仕立屋さんはいないかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0154",
   "jp": "ここから北西に行ったあたりに、{n}からくり屋敷みたいな店があるんだけど、{n}最近新しいサービスを始めたらしいぜ。{p}どうやら、可愛い女の子たちが‥‥‥{n}{FFFB}‥‥おっと、これ以上は自分の目で{n}確かめたほうがいいだろうな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0155",
   "jp": "この段々構造の街は、日当たりがいいんだけど、{n}大雨が降ったときに下層では大変なことになるんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0156",
   "jp": "早いところ、以前のようなのんびりした生活に{n}戻りたいなぁ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0157",
   "jp": "あんたらがローランディアの騎士さんたちだね？{n}早いとこ、あいつを倒してよ。{n}安心して生活できないじゃないの。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0158",
   "jp": "あら、こんにちわ。{n}今日はどちらへ‥‥‥。{n}‥‥ごめんなさい、人違いだったわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0159",
   "jp": "ラルフ様、お帰りになったのですね？{p}突然『声が聞こえる』なんて言って{n}街を飛び出していかれてから、{n}すごく心配していたんです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0160",
   "jp": "{v:000C}いらっしゃいませ。{n}当店では、様々な装備品を取り扱っております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0161",
   "jp": "{v:000E}お買い求めですか？{n}それともご売却ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0162",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen057.0163",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen057.0164",
   "jp": "他にもご用はおありですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0165",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen057.0166",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen057.0167",
   "jp": "{v:0018}またどうぞ、お越し下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0168",
   "jp": "{v:0033}いらっしゃいませ。{n}この店では、様々なグッズをお買い求めいただけます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0169",
   "jp": "{v:0034}本日はお買い求めですか？{n}それともご売却ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0170",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen057.0171",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen057.0172",
   "jp": "他にも何かおありでしょうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0173",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen057.0174",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen057.0175",
   "jp": "{v:003E}ありがとうございました！{n}またどうぞ、お越し下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0176",
   "jp": "まさかここまで来て、{n}怖じ気づいたなんてことはないよね？{n}さ、行こう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0177",
   "jp": "ここから先では、ジュリアン将軍が戦われています！{n}あなた達ははやく城内へ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0178",
   "jp": "　{n}　　　　　　鍵がかかっている！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0179",
   "jp": "おや？{n}まだ城内へは行っていないのか？{n}出来るだけはやく戦争を終わらせてくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0180",
   "jp": "あなた達のおかげで、すぐに制圧できましたよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0181",
   "jp": "いよいよ、城内に突入ですね。{n}がんばってください。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0182",
   "jp": "ここからだと、街の様子を一望できるのです。{n}もう、リシャール派の兵士たちの影はありませんね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0183",
   "jp": "お兄ちゃん！{n}何やってるのよ！{n}すぐ先で、街の人が襲われているんだよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0184",
   "jp": "ん？{n}何か用意を忘れたようだね。{p}僕はここで待っているから、{n}すぐに戻ってきてくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen057.0185",
   "jp": "おい！{n}タイミングを逃すぞ！{n}今しかないんだ！",
   "en": "",
   "term": "end"
  }
 ]
}
