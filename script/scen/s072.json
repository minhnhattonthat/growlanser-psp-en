 "entries": [
  {
   "id": "scen072.0000",
   "jp": "",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen072.0001",
   "jp": "門番",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen072.0002",
   "jp": "騎士",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen072.0003",
   "jp": "ローランディア兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen072.0004",
   "jp": "行商人",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen072.0005",
   "jp": "ブロンソン将軍",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen072.0006",
   "jp": "ラージン砦",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0007",
   "jp": "{v:0038}大きな砦だね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0008",
   "jp": "{v:0039}東にはバーンシュタイン王国。{n}南にランザック王国。{FFF9}{FFFB}{n}{v:003A}つまりここは、３つの国の接点だ。{p}{v:003B}そして軍隊が通れるような太い道もある。{n}重要な防衛拠点だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0009",
   "jp": "{v:003C}ここだけが重要な場所なの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0010",
   "jp": "{v:003D}バーンシュタインとの防衛拠点なら、{n}はるか北のノストリッジ平原にもあるな。{p}{v:003E}魔法学院のそばにある山脈のせいで、{n}その中間にはない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0011",
   "jp": "{v:003F}へぇ、ウォレスさんって物知り！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0012",
   "jp": "{v:0040}だてに十数年も旅をしてねぇぜ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0013",
   "jp": "{v:0041}すみませ～ん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0014",
   "jp": "{v:0042}誰だ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0015",
   "jp": "{v:0043}私です。{n}開門しなさい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0016",
   "jp": "{v:0044}これは、レティシア姫！{n}お待ちしておりました！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0017",
   "jp": "{v:0028}姫の護衛役だな。{n}よし、通れ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0018",
   "jp": "お通り下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0019",
   "jp": "はっ！{n}レティシア姫、よくご無事で！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0020",
   "jp": "この者たちのおかげで助かりました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0021",
   "jp": "お疲れでしょう。{n}よかったら、中で休まれてください。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0022",
   "jp": "{v:0018}アルカディウス王からの伝令だな？{n}よし、入れ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0023",
   "jp": "開門！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0024",
   "jp": "これはこれは、レティシア姫。{n}お待ちしておりました。{p}長旅でお疲れでしょう。{n}砦の中でお休み下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0025",
   "jp": "ご到着をお待ちしておりました。{n}司令室でブロンソン将軍がお待ちです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0026",
   "jp": "{v:0039}ご無事でしたか、レティシア姫？{p}{v:003A}遅くなって申し訳ありません。{n}私、インペリアル・ナイトの{n}アーネスト・ライエルと申します。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0027",
   "jp": "{v:003B}いいえ。{n}危ないところを助けていただき、{n}ありがとうございました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0028",
   "jp": "おい、{s:0000}！{n}姫を放ってどこへ行くつもりだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0029",
   "jp": "{v:0000}少し早かったようですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0030",
   "jp": "{v:0001}待っている間、お話でもしましょう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0031",
   "jp": "{v:0002}はい。{n}わたし達でよろしければ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0032",
   "jp": "{v:0003}そんなにかしこまらなくても良いのですよ。{p}{v:0004}私、ずっと城にいたもので、{n}同じ年頃の女の子と話す機会なんてありませんでした。{n}よかったらお友達になって下さいな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0033",
   "jp": "{v:0005}わっ！{n}レティシア姫とお友達だって！{n}どうしよう、ルイセちゃん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0034",
   "jp": "{v:0006}どうしようって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0035",
   "jp": "{v:0007}普通にしてたらいいんじゃないの？{n}そんな堅苦しいお友達なんて、聞いたことないよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0036",
   "jp": "{v:0008}そうですよ。{n}ティピちゃんの言うとおりです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0037",
   "jp": "{v:0009}は、はぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0038",
   "jp": "{v:000A}女同士の話だ。{n}俺たちは邪魔しないで聞いていようぜ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0039",
   "jp": "{v:000B}実は私、少しだけわくわくしているのです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0040",
   "jp": "{v:000C}わくわく？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0041",
   "jp": "{v:000D}そう。{n}私、今まで城の外に出た事なんてなかったのです。{p}{v:000E}いつも『外の世界はどうなっているんだろう？』って{n}思っていました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0042",
   "jp": "{v:000F}それで、どうだったの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0043",
   "jp": "{FFF6}{v:0010}森の緑、そして静けさ‥‥。{FFF9}{FFFB}{n}{v:0011}かすかな虫の音‥‥。{p}{v:0012}そして‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0044",
   "jp": "{v:0013}ちょっと待った！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0045",
   "jp": "{v:0014}えっ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0046",
   "jp": "{v:0015}どうやら邪魔者が来たようだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0047",
   "jp": "{v:0016}お迎えの人たちじゃないの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0048",
   "jp": "{v:0017}この殺気‥‥違うと思うぜ。{p}{v:0018}隠れてないで、出てこい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0049",
   "jp": "{v:0019}チッ！{n}ここまで来て、見つかるとは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0050",
   "jp": "{FB00}{v:001A}あ～‥‥。{n}またアンタなの‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0051",
   "jp": "{v:001B}で、カレンさんの次はレティシア姫ってわけ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0052",
   "jp": "{v:001C}ここでその姫さんに傷１つでも負わせれば、{n}護衛役のお前らが責任をとらなきゃいけねぇ。{p}{v:001D}これでお前らの信用はガタ落ち‥‥、{n}下手すれば死刑ってすんぽうよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0053",
   "jp": "{v:001E}やれやれ、セコイことを考える奴だな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0054",
   "jp": "{v:001F}何とでも言いやがれ！{p}{v:0020}行くぞ、野郎ども！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0055",
   "jp": "{v:0021}へい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0056",
   "jp": "{v:003C}君たちもご苦労だった。{n}後は我々が責任を持って、{n}バーンシュタインまでご案内する。{p}{v:003D}戴冠式が終わり次第、連絡を入れる。{n}その時、またここで会おう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0057",
   "jp": "{v:003E}では、行って来ます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0058",
   "jp": "{v:003F}いってらっしゃい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0059",
   "jp": "{v:0040}お気をつけて。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0060",
   "jp": "{v:0041}バイバ～イ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0061",
   "jp": "{v:0042}任務終了だな。{n}とりあえず、報告に戻ろうぜ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0062",
   "jp": "これは、レティシア姫！{n}お怪我などありませんか？{n}どうぞ、中で休まれて下さい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0063",
   "jp": "森の遺跡に入られるのですか？{n}でしたら役に立つかどうかわかりませんが、{n}遺跡にまつわる言い伝えをお教えしましょう。{p}　『白き光を放ちて、左へと回れ。{n}　　　さすれば扉は開かれん‥‥』{n}一体、何のことでしょうね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0064",
   "jp": "バーンシュタイン国との戦争だと！？{n}何故、グレッグ卿ほどの方が‥‥。{n}わからない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0065",
   "jp": "みなさんの活躍を、期待しています。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0066",
   "jp": "中でブロンソン将軍がお待ちです。{n}どうぞ、こちらへ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0067",
   "jp": "少し休むかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0068",
   "jp": "おお、レティシア姫！{n}皆、心配しておりました！{p}これで国王陛下もお喜びになるでしょう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0069",
   "jp": "いったいどうしたらいいんだ‥‥。{n}ついこの間まではバーンシュタインとも{n}友好関係があったというのに‥‥。{p}ああ‥‥どうしたら‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0070",
   "jp": "{v:0051}この砦の南東部には迷いの森と呼ばれる場所がある。{n}と言っても、今では普通の森と変わらないけどね。{p}{v:0052}その昔、グローシアンが{n}人間の方向感覚を狂わせる装置を動かしていたから{n}そう呼ばれているんだ。{p}{v:0053}今でもその装置は地下遺跡にあるけど、{n}もう動いてないから、影響を受けることはないよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0071",
   "jp": "{v:0054}この砦の任務は他国の軍隊の早期発見と防衛。{n}そして森の遺跡が悪用されないように見張ることだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0072",
   "jp": "まだ連絡はこないよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0073",
   "jp": "君たちも、よくやってくれた。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0074",
   "jp": "増援はまだか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0075",
   "jp": "私は装備品の行商をしております。{n}それから、精力料理なども扱っております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0076",
   "jp": "装備品の売買でしょうか？{n}それとも料理が食べたいのでしょうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0077",
   "jp": "・装備品の売買",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen072.0078",
   "jp": "・料理を食べたい",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen072.0079",
   "jp": "お買い求めですか？{n}それともご売却ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0080",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen072.0081",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen072.0082",
   "jp": "他にもご用はおありですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0083",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen072.0084",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen072.0085",
   "jp": "お一人様、８エルムで、{n}{FFEB}エルムになりますが？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0086",
   "jp": "ありがとうございました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0087",
   "jp": "お客さま‥‥[01BE]{n}お金が足りないみたいですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0088",
   "jp": "またのご利用をお待ちしております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0089",
   "jp": "これからもごひいきに！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0090",
   "jp": "{v:0045}将軍！{n}レティシア姫をお連れしました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0091",
   "jp": "{v:0046}うむ、ご苦労。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0092",
   "jp": "{v:0047}はっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0093",
   "jp": "{v:0048}遠路、ようこそおいでくださいました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0094",
   "jp": "{v:0049}そう硬くならずともよい。{n}この者たちのおかげで何の心配もありませんでした。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0095",
   "jp": "{v:004A}ははっ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0096",
   "jp": "{v:004B}それで、待ち合わせの場所は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0097",
   "jp": "{v:004C}は、すぐ東に位置する平原でございます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0098",
   "jp": "{v:004D}では、早速出発します。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0099",
   "jp": "{v:004E}はっ、お気をつけて。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0100",
   "jp": "{v:0003}これは姫！{n}ご無事で何よりです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0101",
   "jp": "{v:0004}はい。{n}私も一時は諦めていました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0102",
   "jp": "{v:0005}それにしても、君たち、よくやってくれた。{n}君たちは英雄だよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0103",
   "jp": "{v:0006}ニャハハ～、それほどでもぉお～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0104",
   "jp": "{v:0007}もうっ！{n}調子に乗らないの！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0105",
   "jp": "{v:0008}確かに調子に乗るのは良くないが、{n}自分たちのしたことに自信は持っていいぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0106",
   "jp": "{v:0009}私からも父上によく言っておきますわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0107",
   "jp": "{v:000A}さぁ、今日は疲れたことでしょう。{n}こんなところですが、休んでいってください。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0108",
   "jp": "{v:000B}よく眠れましたか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0109",
   "jp": "{v:000C}はい。{n}久しぶりにゆっくり眠れました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0110",
   "jp": "{v:000D}では、任務のしめくくりだ。{n}安全に姫を城まで送り届けるんだぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0111",
   "jp": "レティシア姫は無事送り届けたか？{n}ならば、国王にそのことを報告するんだ。{p}報告をこまめに入れるのは、士官の務めだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0112",
   "jp": "宣戦布告",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0113",
   "jp": "{v:0031}た、た、大変です！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0114",
   "jp": "{v:0032}どうした！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0115",
   "jp": "{v:0033}せ、戦争です！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0116",
   "jp": "{v:0034}何ぃ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0117",
   "jp": "{v:0035}ですから、戦争です！{n}バーンシュタイン王国が宣戦布告をしてきました！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0118",
   "jp": "{v:0036}理由は！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0119",
   "jp": "{v:0037}何でも、戴冠式の最中に、{n}グレッグ卿がリシャール王に斬りかかったと‥‥。{p}{v:0038}詳しくはここに書簡が‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0120",
   "jp": "{v:0039}くっ！{n}何という事だ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0121",
   "jp": "{v:003A}我が国から式典に参加した者たちが、{n}捕虜となっております。{n}その中にはレティシア姫も‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0122",
   "jp": "{v:003B}大変！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0123",
   "jp": "{v:003C}これじゃ任務どころじゃないぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0124",
   "jp": "{v:003D}すぐに密偵を送り、捕虜の収容先を調査しろ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0125",
   "jp": "{v:003E}はっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0126",
   "jp": "{v:003F}我々は防戦の準備をしなければならない。{n}すまぬが、この書簡を王の元へ届けてくれぬか？{p}{v:0040}そして至急増援を頼む。{n}この砦の兵力では、{n}とてもバーンシュタイン王国軍を止められぬ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0127",
   "jp": "　{n}　　　『{FFEF}援軍要請の書簡{FFF1}』を受け取った！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0128",
   "jp": "{v:001D}だけど、それまでは何としても{n}バーンシュタイン王国軍を防げって。{p}{v:001E}アタシ達は人質の救出任務を受けたんだけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0129",
   "jp": "{v:001F}密偵からの第一報で、{n}人質が近々護送されるという情報が入ったが‥‥。{p}{v:0020}姫の護送先や日時を特定するまでは至っておらん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0130",
   "jp": "{v:0021}そうすぐにはわからんか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0131",
   "jp": "{v:0022}だが当面の問題は他にある。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0132",
   "jp": "{v:0023}どうしたんだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0133",
   "jp": "{v:0024}実は東の平原を越えたところに、峡谷がある。{n}だがその峡谷にバーンシュタイン王国軍が{n}つり橋を造り始めたのだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0134",
   "jp": "{v:0025}つり橋？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0135",
   "jp": "{v:0026}本来、バーンシュタイン側から兵を進めるには、{n}峡谷を迂回し、南の森を通過する必要がある。{p}{v:0027}だが連中は峡谷に橋を架け、{n}最短距離で進軍するつもりなのだ。{p}{v:0028}そうすれば迂回ルートより、{n}１週間は早くこの砦に着ける。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0136",
   "jp": "{v:0029}こっちの援軍が来る前に、{n}包囲しちまおうってハラか‥‥。{p}{v:002A}連中、本気だな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0137",
   "jp": "{v:002B}峡谷の防衛が突破された場合に備え、{n}我々もすぐに軍備をしなければならない。{p}{v:002C}すまないが、協力は出来ない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0138",
   "jp": "{v:002C}すまないが、協力は出来ない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0139",
   "jp": "{v:0030}だけど、それまでは何としても{n}バーンシュタイン王国軍を防げって。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0140",
   "jp": "{v:0031}そのためなら、俺たちも協力しろと言っていたな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0141",
   "jp": "{v:0032}そうか。{n}それでは早速頼みたいことがある。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0142",
   "jp": "{v:0033}なぁに？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0143",
   "jp": "{v:0034}実は東の平原を越えたところに、峡谷があるんだが、{n}バーンシュタイン王国軍がそこにつり橋を{n}造り始めたのだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0144",
   "jp": "{v:0035}おっと！{n}そのつり橋なら、今はもうないぜ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0145",
   "jp": "{v:0036}む、どうした？{n}もう敵が渡って来るというのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0146",
   "jp": "{v:0037}慌てない、慌てない！{n}しばらく敵は来られなくなったから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0147",
   "jp": "{v:0038}な、何？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0148",
   "jp": "{v:0039}ええとね、わたしたち{n}橋を架けている兵隊さんを倒して、{n}橋を落としてきちゃった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0149",
   "jp": "{v:003A}すごいでしょ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0150",
   "jp": "{v:003B}おお、そうだったのか‥‥。{p}{v:003C}そろそろ完成する頃だというのに、{n}いっこうに敵が見えないので不審に思っていたのだ。{p}{v:003D}しかし、君たちは凄いな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0151",
   "jp": "{v:003E}失礼します！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0152",
   "jp": "{v:003F}どうした？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0153",
   "jp": "{v:0040}バーンシュタイン王国内に侵入させた者からの{n}緊急報告が入りました。{p}{v:0041}姫を乗せた馬車が、監禁場所から出たとの事です。{n}そして護送先は‥‥、{FFF9}{FFFB}{n}{v:0042}ガルアオス監獄です。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0154",
   "jp": "{v:0043}居場所がわかったんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0155",
   "jp": "{v:0044}難攻不落のガルアオス監獄か‥‥。{FFF9}{FFFB}{n}{v:0045}やっかいなところに。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0156",
   "jp": "{v:0046}俺たちの任務は人質の救出だ。{n}姫の居場所がわかったなら、そこへ行く。{n}それに狙うなら、護送中の今が一番だ。{p}{v:0047}あんな監獄へ移されたら、助け出すのはまず不可能だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0157",
   "jp": "{v:0048}うむ‥‥。{n}救出を行うなら、ガルアオス監獄へ{n}入れられる前しかないな。{p}{v:0049}あそこは周囲の地形が特殊なため、{n}中へ捕らえられた者の脱獄はおろか、{n}兵が攻め込むこともかなわん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0158",
   "jp": "{v:004A}そのガルアオス監獄って、どこにあるの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0159",
   "jp": "{v:004B}君たちが破壊したつり橋を越えたところにある。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0160",
   "jp": "{FB00}{v:004C}えっ？{n}それじゃアタシたち、自分で道を壊しちゃったの？{FFFA}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0161",
   "jp": "{v:004D}誰よ、橋を落とそうなんて言ったのは！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0162",
   "jp": "{v:004E}いや、その判断は間違えていない。{p}{v:004F}もし橋を奪うつもりで戦っていたら、{n}敵はいつまで経っても、橋の周囲から兵を引かず、{n}その間に姫は監獄へ移されてしまっただろう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0163",
   "jp": "{v:0050}どっちにしても急いだ方がいい。{n}このままじっとしていたら、手遅れになっちまう。{p}{v:0051}向こうへ入り込むだけでいいんだ。{n}後はルイセのテレポートで一気に帰ってこれる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0164",
   "jp": "‥‥{v:0052}わかった。{n}私に考えがある。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0165",
   "jp": "{v:0053}おい、お前！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0166",
   "jp": "{v:0054}はいっ！{n}お呼びでしょうか、司令！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0167",
   "jp": "{v:0055}この者たちに峡谷を越えてもらう。{n}ロープを用意しろ。{n}あの作戦を使う。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0168",
   "jp": "{v:0056}あ、あの作戦ですね。{n}了解しました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0169",
   "jp": "{v:0057}あの作戦？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0170",
   "jp": "{v:0058}なに、すぐにわかるさ。{n}君たちが橋を落とした峡谷へ行ってくれ。{n}すぐに向こうへ渡れるようになる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0171",
   "jp": "ガルアオス監獄へ送られる前に、姫を助けるんだ。{n}急いで峡谷へ向かってくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0172",
   "jp": "バーンシュタインとランザックを{n}同盟させないためにも頑張ってくれ！{n}今となっては君たちが頼りなんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0173",
   "jp": "困ったことになったな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0174",
   "jp": "姫をよろしく頼むぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0175",
   "jp": "{v:002B}どうだ、そろそろこの仕事にも慣れたか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0176",
   "jp": "{v:002C}そうか、飲み込みが早いんだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0177",
   "jp": "{v:002D}そう焦ることもないがな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0178",
   "jp": "{v:002E}お前たちの仕事は、私たちと違って、{n}いろんな所へおもむかねばならん。{p}{v:002F}そして自分たちで分析し、その場で判断し、{n}必要ならば実行せねばならん。{p}{v:0030}大変な仕事だ。{n}がんばるのだぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0179",
   "jp": "{v:001A}援軍はどうなっている？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0180",
   "jp": "{v:001B}今集まる兵は送るけど、{n}戦争が出来るほどの兵を収集するには{n}時間がかかるって言ってました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0181",
   "jp": "{v:001C}うむ‥‥仕方ないか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen072.0182",
   "jp": "おい、{s:0000}！{n}いつまで姫を放っておくつもりだ！",
   "en": "",
   "term": "end"
  }
 ]
}
