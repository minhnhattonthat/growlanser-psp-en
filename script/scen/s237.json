  },
  {
   "id": "scen237.0001",
   "jp": "{FFEE}エリオットを救え！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0002",
   "jp": "{v:002B}やめなさいよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0003",
   "jp": "{v:002C}どうしてこんな事するの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0004",
   "jp": "{v:002D}どんな事情か知らんが、見逃せんな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0005",
   "jp": "{v:002F}やめるんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0006",
   "jp": "{v:0030}やめて、兄さん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0007",
   "jp": "{v:0031}邪魔をするな！{n}邪魔をすれば、たとえお前でも‥‥{n}斬る！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0008",
   "jp": "{v:0032}うぅっ‥‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0009",
   "jp": "{v:0033}バカ！{n}なにぼうっとしてんのよ！{n}死にたくなかったら戦いなさい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0010",
   "jp": "{v:0034}僕も‥‥戦う？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0011",
   "jp": "{v:0035}自分の身は自分で守るモンでしょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0012",
   "jp": "{v:0036}だけど、人を傷つけるなんて‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0013",
   "jp": "{v:0037}いいから、やりなさい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0014",
   "jp": "‥‥{v:0038}やっぱり‥ダメだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0015",
   "jp": "‥‥{v:0039}任務完了。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0016",
   "jp": "{v:003A}そんな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0017",
   "jp": "そんな‥‥俺がしくじるなんて‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0018",
   "jp": "つ‥‥強すぎる‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0019",
   "jp": "{v:004B}大丈夫か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0020",
   "jp": "{v:004C}はい。{n}助かりました‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0021",
   "jp": "{v:0026}ツッ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0022",
   "jp": "！！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0023",
   "jp": "{v:0027}そんな‥兄さん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0024",
   "jp": "{v:0028}ゼノスさん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0025",
   "jp": "{v:0029}チッ！{n}バレちまったか‥‥。{p}{v:002A}だがここまできて引き下がれるか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0026",
   "jp": "{v:003B}チッ！{n}たった３人じゃ分が悪いぜ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0027",
   "jp": "{v:003C}ちょっと！{n}どうしてこんな事するのよ！{n}まるで盗賊じゃない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0028",
   "jp": "{v:003D}俺だってな、なりたくてこうなったわけじゃねぇ！{p}{v:003E}元はといえば、お前らが悪いんだ！{n}お前らが俺の人生を狂わせた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0029",
   "jp": "{v:003F}わたし達が‥‥？{n}何のこと‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0030",
   "jp": "{v:0040}ふん！{n}とぼけるなよ。{p}‥‥{v:0041}俺はな、知ってるんだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0031",
   "jp": "‥‥{v:0041}俺はな、知ってるんだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0032",
   "jp": "{v:0042}何をよ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0033",
   "jp": "{v:0043}まだしらを切るのか？{n}ならば言ってやる！{p}{v:0044}あの闘技大会の時、俺の控え室に来たお前は、{n}俺の飲み水に毒を盛った！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0034",
   "jp": "‥‥{v:0045}な‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0035",
   "jp": "{v:0046}おかげで俺は大会で負け、{n}士官に取り立てられなかった！{n}お前は順調な昇進をしているようだな？{p}{v:0047}今やお前はこの国の英雄だ！{n}だが俺は‥‥くそっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0036",
   "jp": "{v:0049}待って！　兄さん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0037",
   "jp": "{v:0048}あ、待ちなさい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen237.0038",
   "jp": "{v:004A}ゼノスさん‥‥どうして‥‥？",
   "en": "",
   "term": "end"
  }
 ]
}
