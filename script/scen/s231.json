  {
   "id": "scen231.0001",
   "jp": "ローランディア兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen231.0002",
   "jp": "{FFEE}ベルナード将軍を守れ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen231.0003",
   "jp": "くっ！{n}やるな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen231.0004",
   "jp": "{v:0031}おい、将軍に移動してもらった方が{n}守りやすくないか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen231.0005",
   "jp": "将軍に移動してもらった方が守りやすくないかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen231.0006",
   "jp": "将軍の移動場所を選んで下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen231.0007",
   "jp": "・大テントより東へ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen231.0008",
   "jp": "・大テントより南東へ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen231.0009",
   "jp": "・その場で攻撃",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen231.0010",
   "jp": "・その場で防御",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen231.0011",
   "jp": "ここでいいですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen231.0012",
   "jp": "{v:0033}わかった。{n}君の言う通りにしよう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen231.0013",
   "jp": "{v:0034}私の剣の腕を甘く見るなよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen231.0014",
   "jp": "{v:0035}ぐはっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen231.0015",
   "jp": "{v:0036}そんな！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen231.0016",
   "jp": "{v:0037}目的は達成した！{n}退却するぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen231.0017",
   "jp": "{v:0038}はっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen231.0018",
   "jp": "{v:0039}よし、目標を撃破した！{n}これより退却する！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen231.0019",
   "jp": "将軍‥‥。{n}どうやら私はこれまでのようです‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen231.0020",
   "jp": "くっ！！{n}すまぬ‥‥。{n}私がもっとしっかりとしていれば‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen231.0021",
   "jp": "{v:003A}うぐっ！{p}{v:003B}く‥‥ここまで来て‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen231.0022",
   "jp": "{v:003C}た、隊長！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen231.0023",
   "jp": "{v:003D}お前たちだけでも作戦は‥遂行‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen231.0024",
   "jp": "{v:003E}お任せ下さい！{n}最後の１人になっても、必ず！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen231.0025",
   "jp": "うう‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen231.0026",
   "jp": "これ以上は‥‥ダメ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen231.0027",
   "jp": "こ、これまで‥‥か‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen231.0028",
   "jp": "強い‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen231.0029",
   "jp": "そんな‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen231.0030",
   "jp": "{v:003F}おのれ！{n}よくも我が部下を！",
   "en": "",
   "term": "end"
  }
 ]
}
