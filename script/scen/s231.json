  },
  {
   "id": "scen231.0001",
   "jp": "ローランディア兵",
   "en": "Rolandia Soldier",
   "term": "null",
   "src": "ps1"
  },
  {
   "id": "scen231.0002",
   "jp": "{FFEE}ベルナード将軍を守れ！{FFF1}",
   "en": "{FFEE}Protect General Bernard!{FFF1}",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen231.0003",
   "jp": "くっ！{n}やるな‥‥。",
   "en": "Gh! You're good...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen231.0004",
   "jp": "{v:0031}おい、将軍に移動してもらった方が{n}守りやすくないか？",
   "en": "{v:0031}Hey, wouldn't the General be easier to guard if we had{n}him move?",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen231.0005",
   "jp": "将軍に移動してもらった方が守りやすくないかな？",
   "en": "Wouldn't it be easier to protect the General if we had{n}him move?",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen231.0006",
   "jp": "将軍の移動場所を選んで下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen231.0007",
   "jp": "・大テントより東へ",
   "en": "・East of the large tent",
   "term": "end",
   "unref": true,
   "src": "ps1"
  },
  {
   "id": "scen231.0008",
   "jp": "・大テントより南東へ",
   "en": "・Southeast of the large tent",
   "term": "end",
   "unref": true,
   "src": "ps1"
  },
  {
   "id": "scen231.0009",
   "jp": "・その場で攻撃",
   "en": "・Attack from here",
   "term": "end",
   "unref": true,
   "src": "ps1"
  },
  {
   "id": "scen231.0010",
   "jp": "・その場で防御",
   "en": "・Defend in place",
   "term": "end",
   "unref": true,
   "src": "ps1"
  },
  {
   "id": "scen231.0011",
   "jp": "ここでいいですか？",
   "en": "Is this position all right?",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen231.0012",
   "jp": "{v:0033}わかった。{n}君の言う通りにしよう。",
   "en": "{v:0033}Understood. I will do as you say.",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen231.0013",
   "jp": "{v:0034}私の剣の腕を甘く見るなよ！",
   "en": "{v:0034}Do not underestimate my swordsmanship!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen231.0014",
   "jp": "{v:0035}ぐはっ！",
   "en": "{v:0035}Gah!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen231.0015",
   "jp": "{v:0036}そんな！？",
   "en": "{v:0036}Impossible!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen231.0016",
   "jp": "{v:0037}目的は達成した！{n}退却するぞ！",
   "en": "{v:0037}Objective achieved! Retreat!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen231.0017",
   "jp": "{v:0038}はっ！",
   "en": "{v:0038}Yes, sir!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen231.0018",
   "jp": "{v:0039}よし、目標を撃破した！{n}これより退却する！",
   "en": "{v:0039}Good, the target is down! We are withdrawing!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen231.0019",
   "jp": "将軍‥‥。{n}どうやら私はこれまでのようです‥‥。",
   "en": "General... It seems this is the end for me...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen231.0020",
   "jp": "くっ！！{n}すまぬ‥‥。{n}私がもっとしっかりとしていれば‥‥。",
   "en": "Gh!! Forgive me... If only I had done better...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen231.0021",
   "jp": "{v:003A}うぐっ！{p}{v:003B}く‥‥ここまで来て‥‥。",
   "en": "{v:003A}Ugh!{p}{v:003B}Gh... After coming so far...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen231.0022",
   "jp": "{v:003C}た、隊長！？",
   "en": "{v:003C}C-Captain?!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen231.0023",
   "jp": "{v:003D}お前たちだけでも作戦は‥遂行‥‥",
   "en": "{v:003D}Even without me... carry out... the mission...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen231.0024",
   "jp": "{v:003E}お任せ下さい！{n}最後の１人になっても、必ず！",
   "en": "{v:003E}Leave it to us! Even if only one of us is left, we'll see{n}it through!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen231.0025",
   "jp": "うう‥‥",
   "en": "Ugh...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen231.0026",
   "jp": "これ以上は‥‥ダメ‥‥",
   "en": "I can't... go on...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen231.0027",
   "jp": "こ、これまで‥‥か‥‥",
   "en": "I-is this... the end...?",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen231.0028",
   "jp": "強い‥‥",
   "en": "So strong...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen231.0029",
   "jp": "そんな‥‥",
   "en": "It can't be...",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen231.0030",
   "jp": "{v:003F}おのれ！{n}よくも我が部下を！",
   "en": "{v:003F}Damn you! How dare you do that to my men!",
   "term": "end",
   "src": "ps1"
  }
 ]
}
