  },
  {
   "id": "scen275.0003",
   "jp": "{v:0123}おおっと！{n}チャンピオン『Ｊ』、{n}またまた防衛に成功だぁーーーっ！！",
   "en": "{v:0123}Ohhh! Champion 'J' has defended the title yet agaaain!!",
