 "entries": [
  {
   "id": "scen196.0000",
   "jp": "",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen196.0001",
   "jp": "ジュリアン部下",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen196.0002",
   "jp": "モンスター使い見習い",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen196.0003",
   "jp": "村人",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen196.0004",
   "jp": "店主",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen196.0005",
   "jp": "ジュリアン",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen196.0006",
   "jp": "さて、アタシ達も行きましょ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0007",
   "jp": "さあ、帰ろうよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0008",
   "jp": "僕は、あなたに助けてもらうまで、{n}自分で何かをしたことなんて{n}なかったかも知れません‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0009",
   "jp": "どうしますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0010",
   "jp": "・その通りだと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0011",
   "jp": "・これからに期待していると言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0012",
   "jp": "ちょっと、そういう言い方ってないじゃない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0013",
   "jp": "いえ、いいんです。{n}ですから今までそうだった分、{n}これからがんばろうって‥‥そう決めました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0014",
   "jp": "ありがとうございます。{n}僕も、これからどうしていくかが{n}大事だと思うんです。{p}まだまだ、僕は何もできない。{n}だから、助けてもらわなくちゃ{n}いけない事もあると思います。{p}そんなとき、またよろしくお願いしますね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0015",
   "jp": "どう答えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0016",
   "jp": "・もちろんだと答える",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0017",
   "jp": "・もう必要ないと答える",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0018",
   "jp": "これで安心して眠れますよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0019",
   "jp": "そんな‥‥。{n}僕はまだそれほど強い人間ではありません。{n}見捨てないで下さいね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0020",
   "jp": "さて、僕は明日の行軍に備えてそろそろ寝ます。{n}おやすみなさい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0021",
   "jp": "おやすみ、エリオット。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0022",
   "jp": "すっかり遅くなっちゃったけど、{n}そろそろ帰らないとね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0023",
   "jp": "‥‥厳しい戦いになりそうだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0024",
   "jp": "えっ、戦況は不利なの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0025",
   "jp": "確かに、ライエルやリシャールは強い。{n}だが、こちらには{s:0000}、{n}お前やルイセ、ウォレスがいる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0026",
   "jp": "じゃあ、心配ないじゃない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0027",
   "jp": "バーンシュタインの人間同士で{n}戦争をしなければならないのだぞ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0028",
   "jp": "そうか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0029",
   "jp": "短い間だったがライエルは良き同僚だった。{n}インペリアル・ナイツ同士で戦わねばならん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0030",
   "jp": "そうだね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0031",
   "jp": "それはきっと、私だけではない。{n}バーンシュタインの兵士達はみな、{n}同じ想いを抱いているはずだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0032",
   "jp": "どうしますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0033",
   "jp": "・激励する",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0034",
   "jp": "・黙っている",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0035",
   "jp": "・なぐさめる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0036",
   "jp": "そうだな。{n}こんな戦いは早く終わらさねば‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0037",
   "jp": "こんな戦いは早く終わらさねば‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0038",
   "jp": "よせ、{s:0000}。{n}私は戦う決意をしたのだ。{p}こんな戦いは早く終わらさねば‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0039",
   "jp": "さて、私は明日に備えて休む。{n}またな、{s:0000}、ティピ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0040",
   "jp": "おいおい、何のために来たんだ？{n}エリオットやジュリアンのところへ行って来い。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0041",
   "jp": "もう夕方だな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0042",
   "jp": "見たか、{s:0000}？{n}兵の士気が高い。{n}国に反旗をひるがえすというのにな。{p}ジュリアンの統率力は見事なものだ。{n}お前はここまでできるか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0043",
   "jp": "どう答えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0044",
   "jp": "・できる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0045",
   "jp": "・できない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0046",
   "jp": "・これほどではない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0047",
   "jp": "そうか、大した自信だな。{n}まあ、お前も騎士だ。{n}いずれ軍を率いるときが来るかも知れん。{p}その時のために、ジュリアンから学ぶんだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0048",
   "jp": "アンタ、がんばりなさいよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0049",
   "jp": "はっはっは、軍の指揮は経験がないとできんだろうな。{n}だが、お前も俺達のリーダーであることを忘れるな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0050",
   "jp": "謙虚だな。{n}確かにいきなり大軍を率いることはできんだろう。{p}だが、お前も騎士だ。{n}いずれ軍を率いるときが来るかも知れん。{n}学べることはジュリアンから学んでおけ。{p}お前ならジュリアンにも負けない将軍になれる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0051",
   "jp": "ウォレスさん、あんまりほめるとコイツ、{n}調子に乗るよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0052",
   "jp": "いよいよ決戦か‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0053",
   "jp": "お兄ちゃん、せっかく来たんだから{n}ちゃんとあいさつに行って来なよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0054",
   "jp": "ジュリアンさんやエリオット君、{n}明日の朝には出発だって。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0055",
   "jp": "あ、お兄ちゃん。{n}いよいよ始まっちゃうんだね‥‥戦争。{p}エリオット君の国がどうなるか、{n}私たちにかかってるなんて‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0056",
   "jp": "どうしますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0057",
   "jp": "・任せろと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0058",
   "jp": "・心配するなと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0059",
   "jp": "・無理はするなと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0060",
   "jp": "う、うん！{n}わたし、お兄ちゃんになら{n}全部任せられるよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0061",
   "jp": "ありがとう、お兄ちゃん。{n}わたし、がんばるね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0062",
   "jp": "無理なんてしてないよ。{n}わたし、絶対お兄ちゃんについてくもん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0063",
   "jp": "ジュリアンやウォレスさんもいるんだから大丈夫だよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0064",
   "jp": "うん、そうだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0065",
   "jp": "わたしもがんばらなくっちゃ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0066",
   "jp": "あれ、お兄さま？{n}エリオットくんやジュリアンさんのところに{n}行かなくていいんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0067",
   "jp": "戦争って怖いですよね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0068",
   "jp": "お兄さま‥‥。{n}私たち、戦争してるんですよね？{n}大勢の人が戦うんですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0069",
   "jp": "どうしますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0070",
   "jp": "・安心しろと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0071",
   "jp": "・心配するなと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0072",
   "jp": "・無理はするなと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0073",
   "jp": "ええ、お兄さまがいればアタシは安心です。{n}お兄さまについて行きます！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0074",
   "jp": "ありがとう、お兄さま。{n}アタシ、がんばっちゃいます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0075",
   "jp": "ああ、なんて優しいお兄さま。{n}{FC00}でも大丈夫、どこまでもついて行きます！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0076",
   "jp": "足ひっぱるんじゃないわよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0077",
   "jp": "ひっど～い。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0078",
   "jp": "がんばりますね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0079",
   "jp": "おやおや。{n}あいさつに行かなくていいのかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0080",
   "jp": "いよいよ決戦だね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0081",
   "jp": "戦争か‥‥。{n}相変わらず戦いばかりだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0082",
   "jp": "どうしますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0083",
   "jp": "・すぐに終わらせると言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0084",
   "jp": "・黙ってうなずく",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0085",
   "jp": "・アリオストは戦わなくても良いと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0086",
   "jp": "頼もしいな。{n}だけど、君ならできそうな気がするよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0087",
   "jp": "早く終わらせたいものだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0088",
   "jp": "僕は自分が戦いたくないんじゃない。{n}ただ、人間同士が争うのが嫌なだけなんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0089",
   "jp": "みんなでがんばろうよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0090",
   "jp": "そうだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0091",
   "jp": "早く戦争を終わらせなければね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0092",
   "jp": "あら？{n}あいさつに行かなくてよろしいんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0093",
   "jp": "もう、夕方ですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0094",
   "jp": "私、自分が戦場に立つなんて{n}考えたこともありませんでした。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0095",
   "jp": "どうしますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0096",
   "jp": "・無理はしなくていいと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0097",
   "jp": "・心配するなと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0098",
   "jp": "・守ってやると言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0099",
   "jp": "自分で選んだ事です。{n}戦場に立つことで助けられる人も{n}いるわけですから‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0100",
   "jp": "ええ、ありがとうございます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0101",
   "jp": "あなたがそう言うなら、{n}安心できますね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0102",
   "jp": "そうですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0103",
   "jp": "がんばります。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0104",
   "jp": "こちらはバーンシュタイン軍士官の{n}宿舎となっています。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0105",
   "jp": "眠いなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0106",
   "jp": "腹減ったなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0107",
   "jp": "つらい戦いになりそうだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0108",
   "jp": "リシャール様が偽王だったなんて‥‥。{n}他国の陰謀なんかじゃないだろうな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0109",
   "jp": "バーンシュタインの誇るインペリアル・ナイトが{n}敵味方にわかれて戦うなんて前代未聞だよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0110",
   "jp": "こんなとき、村長がいらっしゃれば‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0111",
   "jp": "バーンシュタイン軍の逗留で品切れだよ。{n}大繁盛さ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0112",
   "jp": "これは{s:0000}様。{n}陛下はこちらにいらっしゃいます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0113",
   "jp": "陛下はただいま、{n}作戦会議中です。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0114",
   "jp": "陛下はお休みになりました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0115",
   "jp": "こちらは陛下の{n}御寝所となっています。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0116",
   "jp": "もう、夕方だね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0117",
   "jp": "作戦会議が終了した。{n}交代だ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0118",
   "jp": "おお、ようやく飯にありつける。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0119",
   "jp": "{n}　　　　　　　鍵がかかっている。　　　　　　　{n}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0120",
   "jp": "あっ、{s:0000}さん。{n}来て下さったんですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0121",
   "jp": "いよいよ、決戦だね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0122",
   "jp": "ええ、正直言って不安です。{n}決戦のことだけではなくて、{n}その後の事も。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0123",
   "jp": "どうしますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0124",
   "jp": "・はげます",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0125",
   "jp": "・しかる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0126",
   "jp": "・心配する",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0127",
   "jp": "ありがとうございます。{n}不安は不安だけど、なんとかやってみようと{n}思っているんです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0128",
   "jp": "そうですね、僕が不安になっていては{n}戦ってくれる人たちに申し訳ないです。{n}やれるだけやってみます！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0129",
   "jp": "いつまでも、みんなに心配かけてばかりでは{n}いられません。{n}なんとかやってみせます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0130",
   "jp": "がんばりなよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0131",
   "jp": "ええ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0132",
   "jp": "陛下、作戦会議のお時間です。{n}お手数ですが宿舎の方までいらして下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0133",
   "jp": "はい。今、行きます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0134",
   "jp": "せっかく来ていただいたのに申し訳ありません。{n}また、夕方にでも。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0135",
   "jp": "２階は士官の宿舎となっておりますので、{n}立ち入りはご遠慮願います。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0136",
   "jp": "現在、作戦会議中ですので{n}お通しできません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0137",
   "jp": "落ち着かないなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0138",
   "jp": "おお、{s:0000}か。{n}来てくれたんだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0139",
   "jp": "どう、ジュリアン？{n}調子は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0140",
   "jp": "うむ、思ったよりも兵の士気が高い。{n}私は良い部下に恵まれているよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0141",
   "jp": "どうしますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0142",
   "jp": "・そのようだと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0143",
   "jp": "・ジュリアンの人望だという",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0144",
   "jp": "・うらやましいと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0145",
   "jp": "軍隊は兵がいて初めて成立する。{n}そこが、放浪していた頃との大きな違いだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0146",
   "jp": "お前にそう言われると照れるな。{n}そうであって欲しいものだが。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0147",
   "jp": "私もお前がうらやましいと思うことがあるぞ。{n}上下関係のない気心の知れた仲間と、{n}旅をするのもいいものだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0148",
   "jp": "アタシたちだって、任務をこなしてるんだよ。{n}別に気ままに旅をしているわけじゃないもん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0149",
   "jp": "そう怒るな。{n}お前たちと過ごした時間が懐かしいのだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0150",
   "jp": "将軍、陛下をお連れしました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0151",
   "jp": "では、作戦会議を始めよう。{p}{s:0000}、ティピ、{n}すまんがまた後でな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0152",
   "jp": "うん。またね～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0153",
   "jp": "お前たちか、来てくれたんだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0154",
   "jp": "私は明日に備えて寝る事にする。{n}またな、{s:0000}。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0155",
   "jp": "おやすみ、ジュリアン。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0156",
   "jp": "さっきはすまんな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0157",
   "jp": "お前たちか、わざわざ来てくれたんだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0158",
   "jp": "会議なんて、ジュリアン偉くなったよね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0159",
   "jp": "偉く‥‥か。{n}確かに責任のある立場にはなったな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0160",
   "jp": "どうしますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0161",
   "jp": "・それだけの実力があるからだと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0162",
   "jp": "・父親もインペリアル・ナイトだからと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0163",
   "jp": "・努力の成果だと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0164",
   "jp": "お前に認めてもらえると嬉しいよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0165",
   "jp": "そうだな‥‥。{n}血筋かも知れん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0166",
   "jp": "努力‥‥か。{n}それを認めてもらえるのがいちばんうれしい。{p}お前に出会うまでは、自分の剣の腕を上げることしか{n}考えていなかった。{p}だが今は、部下がいて、君主がいて、仲間がいる。{n}ただ強くなるだけで満足していては{n}いけないと気づいたよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0167",
   "jp": "少し、外で話さぬか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0168",
   "jp": "外に行きますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0169",
   "jp": "夜風に当たるのも良いものだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0170",
   "jp": "‥‥そうか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0171",
   "jp": "では、私は明日に備えて休むことにする。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0172",
   "jp": "おつかれさまです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0173",
   "jp": "ごくろう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0174",
   "jp": "僕は明日からの行軍に備えて{n}そろそろ寝るところです。{n}おやすみなさい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0175",
   "jp": "あっ、さっきはすみません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0176",
   "jp": "あっ、{s:0000}さん。{n}今、作戦会議が終わったところなんですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0177",
   "jp": "作戦会議だなんて、エリオットも{n}偉くなったじゃない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0178",
   "jp": "いえ、僕にはなにもわかりませんよ。{n}ただいるだけです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0179",
   "jp": "どうしますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0180",
   "jp": "・参加しているだけでも立派だと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0181",
   "jp": "・仕方がないと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0182",
   "jp": "・今はまだそれでいいと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen196.0183",
   "jp": "そう言っていただけるとうれしいです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0184",
   "jp": "そうですね。{n}戦争を学んだことはありませんでしたから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0185",
   "jp": "ええ。{n}ですが、これからいろいろ学んでいかなくては{n}いけないと思っています。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0186",
   "jp": "少し、外でお話ししませんか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0187",
   "jp": "では、外に行きましょう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0188",
   "jp": "‥‥そうですか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0189",
   "jp": "では、僕は明日からの行軍に備えてそろそろ寝ますね。{n}おやすみなさい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0190",
   "jp": "今日はバーンシュタイン軍が{n}宿舎として使っているから泊まれないよ。{n}また来てくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0191",
   "jp": "こら、外へ出たら連絡が取れなくなるでしょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0192",
   "jp": "みんなを置いて、どこへ行こうってのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen196.0193",
   "jp": "今日はここで一日過ごすんでしょ？",
   "en": "",
   "term": "end"
  }
 ]
}
