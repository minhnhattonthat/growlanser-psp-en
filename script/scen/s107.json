  },
  {
   "id": "scen107.0001",
   "jp": "中年の男",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen107.0002",
   "jp": "第１問",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen107.0003",
   "jp": "第２問",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen107.0004",
   "jp": "第３問",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen107.0005",
   "jp": "第４問",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen107.0006",
   "jp": "第５問",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen107.0007",
   "jp": "{v:0050}やあ、やっと着いた！{n}みなさん、ありがとうございました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0008",
   "jp": "{v:0051}どういたしまして。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0009",
   "jp": "{v:0052}いらっしゃいませ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0010",
   "jp": "{v:0053}すみません、部屋は空いていますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0011",
   "jp": "{v:0054}ええと、アリオストさんが帰ったから‥‥。{p}{v:0055}はい。ちょうど１部屋空いています。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0012",
   "jp": "{v:0056}１部屋、お願いします。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0013",
   "jp": "{v:0057}はい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0014",
   "jp": "{v:0058}アリオストって名前、聞き覚えあるなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0015",
   "jp": "{v:0059}ひょっとして、あのアリオストさんかなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0016",
   "jp": "{v:005A}ルイセちゃん、知ってるの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0017",
   "jp": "{v:005B}うん。{n}魔法学院に飛行術を研究している人がいるの。{n}その人が確かアリオストって名前だった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0018",
   "jp": "{v:005C}それよ！{n}ほら、フェザリアンについて教えてくれた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0019",
   "jp": "{v:005D}じゃ、同じアリオストさんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0020",
   "jp": "アリオストを探して‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0021",
   "jp": "{s:0000}様ですね？{n}お連れの方がお待ちです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0022",
   "jp": "いらっしゃいませ。{p}‥‥えっ、アリオストさんですか？{n}もう魔法学院へお帰りになりましたけど。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0023",
   "jp": "アリオストさんは魔法学院へお帰りになりました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0024",
   "jp": "いらっしゃいませ。{n}お泊まりですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0025",
   "jp": "こちらに、眼鏡をかけた学者風のお兄さんが{n}泊まっていませんか？{n}遊びに来たんですけど。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0026",
   "jp": "その方なら、部屋で書き物をされていますが。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0027",
   "jp": "う～ん、邪魔しちゃ悪いよね。{n}また今度にしよう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0028",
   "jp": "申し訳ございません。{n}丁度お部屋がいっぱいになってしまいました‥‥。{p}またのお越しをお待ちしております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0029",
   "jp": "いらっしゃいませ。{n}１泊、{FFEB}エルムになりますが？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0030",
   "jp": "ありがとうございました。{n}気を付けて行ってらっしゃいませ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0031",
   "jp": "お客さん‥‥[01BE]{n}お金が足りないみたいですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0032",
   "jp": "またのお越しをお待ちしております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0033",
   "jp": "{v:0023}宿代は私が持つよ。{n}君たちも泊まっていくといい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0034",
   "jp": "{v:0024}そんな、悪いです‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0035",
   "jp": "{v:0025}遠慮しなくてもいいよ。{n}こうみえても結構裕福な家なんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0036",
   "jp": "{v:0026}せっかくだから、お言葉に甘えましょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0037",
   "jp": "‥‥{v:0027}う‥ん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0038",
   "jp": "えっ？{n}暇そうに見えるって？{p}そりゃ、そうだ。{n}勤めていた料理店がつぶれちまってね。{p}これでも高級料理店のシェフだったんだぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0039",
   "jp": "彼を{s:0010}のレストランで雇いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0040",
   "jp": "えっ？{n}君のところで雇ってくれるって？{p}だけど、料理に理解のない人に{n}雇われるのはゴメンだね。{n}これから出すクイズに全問正解してみせてくれ！{p}正しければ『はい』{n}間違いだと思えば『いいえ』を選んでくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0041",
   "jp": "表面がつるつるとした卵は新しい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0042",
   "jp": "トマトは実は果物である。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0043",
   "jp": "料理の時『酢』と『砂糖』先に入れるなら『酢』から。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0044",
   "jp": "アサリに砂を吐かせるには真水にいれておく。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0045",
   "jp": "大根を煮るには沸騰した湯に入れる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0046",
   "jp": "すごい！{n}全問正解だ！{p}君のところでなら、安心して働けるよ！{p}よし！{n}さっそく出発だ！{p}場所は‥‥‥、{n}{s:0010}だね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0047",
   "jp": "‥‥全問正解にはならなかったようだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0048",
   "jp": "どこへ行くんだい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0049",
   "jp": "当店をご利用でしたら、{n}こちらで記帳なさって下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0050",
   "jp": "‥‥{v:0028}というわけなんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0051",
   "jp": "{v:0029}それじゃラルフさんはこの戦争の中、{n}わざわざバーンシュタイン王国から来たの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0052",
   "jp": "{v:002A}というか、商売でこっちに来ていたら戦争が始まって、{n}バーンシュタインに帰れなくなった、{n}と言った方が正しいかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0053",
   "jp": "{v:002B}商売？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0054",
   "jp": "{v:002C}ああ。{n}自分で言うのも何だけど、ハウエル家といって{n}バーンシュタインでは１、２を争う商人なんだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0055",
   "jp": "{v:002D}ハウエル家だと？{n}あの、紡績商のハウエルか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0056",
   "jp": "{v:002E}あれ、ご存じですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0057",
   "jp": "{v:002F}当たり前だ！{n}バーンシュタインを旅していれば、{n}何度も聞くことになるぜ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0058",
   "jp": "{v:0030}へぇ‥‥、アンタ、名家のお坊ちゃんだったのね！{p}{v:0031}もしお金持ちになったら、{n}おいしいものいっぱい食べさせてね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0059",
   "jp": "{v:0032}もう、ティピったら！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0060",
   "jp": "{v:0033}はははっ。{p}{v:0034}でも今では戦争に感謝しているよ。{n}こうして弟と再会するチャンスをくれたわけだからね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0061",
   "jp": "{v:0035}人生、何がどうでるか、わからんものだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0062",
   "jp": "{v:0036}まったく‥‥。{p}{v:0037}さて、こんなに遅くなってしまった。{n}そろそろ寝ませんか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0063",
   "jp": "{v:0038}そうですね。{n}それじゃ、そろそろ部屋に戻ります。{p}{v:0039}おやすみなさい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0064",
   "jp": "{v:003A}おやすみなさ～い！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0065",
   "jp": "{v:003B}おやすみ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0066",
   "jp": "{v:003C}では、おやすみなさい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0067",
   "jp": "ちょっと！{n}こんな夜中にどこ行く気よ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0068",
   "jp": "ちょっと！{n}ルイセちゃんを残して、どこ行く気よ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0069",
   "jp": "ここは空き部屋みたいだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0070",
   "jp": "{v:008A}どうぞ、開いていますよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0071",
   "jp": "何度も行くのは迷惑でしょ。{n}明日にしなさいよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0072",
   "jp": "{v:009B}あ、お兄さまですか？{n}どうぞ、鍵は開いてますぅ★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0073",
   "jp": "{v:0078}鍵は開いてるよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0074",
   "jp": "{v:0059}大丈夫だった、ルイセちゃん？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0075",
   "jp": "{v:005A}ありがとう、みんな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0076",
   "jp": "{v:005B}それにしても、いったい何だったんだ？{n}奴の死体はどこだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0077",
   "jp": "{v:005C}また溶けて消えちゃったよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0078",
   "jp": "{v:005D}つまり、奴もフレッシュゴーレムだったってことか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0079",
   "jp": "{v:005E}お兄ちゃんの双子だなんて言って‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0080",
   "jp": "{v:005F}ルイセちゃんを殺すために近づいたの？{n}もう、許せないんだから‥‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0081",
   "jp": "{v:0060}そう言えば、途中で助けに来てくれたあの人は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0082",
   "jp": "{v:0062}そう言えば、途中で助けてくれたあの人は‥‥{n}いったい‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0083",
   "jp": "{v:0061}そう言えば、途中で出てきたおじさんは誰だろ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0084",
   "jp": "{v:0063}敵じゃないみたいだけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0085",
   "jp": "{v:0064}どっちにしろ、{n}ルイセちゃんが狙われているって事は事実よね。{n}気をつけなきゃ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0086",
   "jp": "{v:007A}どうしたの、お兄ちゃん。{n}寝付かれないの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0087",
   "jp": "なんと答えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0088",
   "jp": "・同意する",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen107.0089",
   "jp": "・ルイセと話がしたい",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen107.0090",
   "jp": "・なんとなく",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen107.0091",
   "jp": "{v:007B}無理もないよね。{n}本当のお兄ちゃんが見つかったんだもの。{n}わたしだったらきっと眠れないよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0092",
   "jp": "{v:007C}お兄ちゃんから来てくれるなんて嬉しいな。{p}{FC00}{v:007D}でもいいの？{n}本当のお兄ちゃんと話さなくて？{p}{v:007E}わたしだったら、夜通しお話したいと思うけど‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0093",
   "jp": "{v:007F}なんとなくかぁ‥‥。{n}でもいいの？　本当のお兄ちゃんと話さなくて？{n}わたしだったら、夜通しお話したいと思うけど？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0094",
   "jp": "{v:0080}はぁ‥‥お兄ちゃんの本当のお兄ちゃんか‥‥。{n}わたしにとってもお兄ちゃんになるのかなぁ‥‥。{p}{v:0081}お兄ちゃんが本当の家に帰る事があっても、{n}わたしの事はわすれないでね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0095",
   "jp": "なんと答えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0096",
   "jp": "・忘れない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen107.0097",
   "jp": "・忘れる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen107.0098",
   "jp": "・わからない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen107.0099",
   "jp": "{v:0082}うん、さすがお兄ちゃん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0100",
   "jp": "{FFF5}{v:0083}う～‥‥わたしの事を忘れちゃうの‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0101",
   "jp": "{v:0084}アンタ、{n}ルイセちゃんをからかってるんじゃないわよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0102",
   "jp": "{FFF5}{v:0085}う～‥‥お兄ちゃんがいじめるぅ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0103",
   "jp": "{v:0086}アンタねぇ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0104",
   "jp": "{v:0087}それじゃ、そろそろ遅いからわたし寝るね。{n}お休み、お兄ちゃん、ティピ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0105",
   "jp": "{v:0088}ルイセちゃん、おやすみ★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0106",
   "jp": "{v:008B}本当のご兄弟が見つかってよかったですね。{n}お兄さんが出来た気分はどうですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0107",
   "jp": "なんと答えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0108",
   "jp": "・実感がまだない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen107.0109",
   "jp": "・結構いい",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen107.0110",
   "jp": "・面倒くさい",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen107.0111",
   "jp": "{v:008C}そうですか？{n}でも一緒に生活していれば、兄のありがたみが{n}よくわかりますよ。{p}{v:008D}いつも兄に助けてもらっていた私が言うんですから、{n}間違いありません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0112",
   "jp": "{v:008E}そうですね。{n}やはり兄はいいものだと思います。{p}{v:008F}なんだかラルフさんを見ていると、うちの兄を{n}思いだしてしまいました。{p}{FC03}{v:0090}兄も今頃どうしているのか‥‥。{n}危険な事をしていなければいいのですが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0113",
   "jp": "なんと答えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0114",
   "jp": "・ゼノスなら大丈夫",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen107.0115",
   "jp": "・ゼノスの仕事はよくわからない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen107.0116",
   "jp": "{v:0091}そうですね。{n}兄を信じないと。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0117",
   "jp": "{v:0092}私にもわかりませんが、{n}兄を信じたいと思います‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0118",
   "jp": "{v:0093}それはあなた自身が、今まで兄として{n}振る舞ってきたからじゃないでしょうか？{p}{v:0094}兄に甘えるという事に対して、{n}免疫がないからだと思います。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0119",
   "jp": "{v:0095}でもご兄弟が見つかってよかったですね。{n}これからあなたがどうされるかは知りませんが、{n}ラルフさんとは仲良くしてくださいね。{p}{v:0096}兄弟とは仲良くした方がいいですから。{p}{v:0097}それでは夜も遅いので、そろそろ寝ましょう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0120",
   "jp": "{v:0098}カレンさんおやすみ～～★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0121",
   "jp": "{v:0099}２人ともお休みなさい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0122",
   "jp": "{v:009C}どうしたんですか、お兄さま。{n}こんな時間に？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0123",
   "jp": "なんと答えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0124",
   "jp": "・寝付けないので遊びに来た",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen107.0125",
   "jp": "・ミーシャと話がしたい",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen107.0126",
   "jp": "・特に用はない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen107.0127",
   "jp": "{v:009D}やっぱりお兄さまにお兄さまが出来たからですぅ★{p}{FC05}{v:009E}あれ？{n}なんかこの言い方へんだな‥‥？{n}意味はわかるからいいや★{p}{FC04}{v:009F}でもお兄さまそっくりでびっくりしちゃった。{n}やっぱり兄弟なんだね★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0128",
   "jp": "{v:00A0}お兄さまったらもぉ★{n}正直なんだからぁ～★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0129",
   "jp": "{v:00A1}だったら、アタシとお話しましょう★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0130",
   "jp": "{v:00A2}ねぇお兄さま、お兄さまが出来た感想はどうですか？{n}アタシは兄弟がいないからよくわからなくて‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0131",
   "jp": "なんと答えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0132",
   "jp": "・いつもと変わらない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen107.0133",
   "jp": "・ちょっと動揺している",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen107.0134",
   "jp": "・嬉しい",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen107.0135",
   "jp": "{v:00A3}そうなの？{n}もっと劇的な心境の変化とかあると思ったのに‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0136",
   "jp": "{v:00A4}やっぱり急に兄弟と言われて{n}ビックリしちゃってるんですね。{p}{v:00A5}アタシも急に兄弟だって言われたら、{n}ビックリしちゃうもの。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0137",
   "jp": "{v:00A6}えへへ、やっぱり★{n}本当の兄弟が見つかったんだもの。{n}そうだよね★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0138",
   "jp": "{v:00A7}でもいいな。{n}お兄さまってルイセちゃんだけでなく、お兄さままで{n}いるなんて。{p}{v:00A8}あ～あ、どこかに兄弟って落ちてないかなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0139",
   "jp": "{v:00A9}アンタねぇ‥‥そんなもん、{n}落ちてる訳ないでしょうが！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0140",
   "jp": "{v:00AA}ふみぃ‥‥。{p}{FC00}{v:00AB}でも、本当に兄弟にはあこがれちゃうな‥‥。{p}{v:00AC}あ、もうこんな時間だ。{n}お兄さま、こんな遅くまでお話につき合ってもらって{n}ありがとう。{p}{v:00AD}続きはまた明日ね★{n}それじゃ、お休みなさ～い★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0141",
   "jp": "{v:00AE}お休み、ミーシャ★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0142",
   "jp": "{v:00AD}続きはまた明日ね★{n}それじゃ、お休みなさ～い★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0143",
   "jp": "{v:00B1}どうしたんだい、こんな時間に？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0144",
   "jp": "なんと答えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0145",
   "jp": "・なかなか寝付けなくて遊びに来た",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen107.0146",
   "jp": "・アリオストに会いに来た",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen107.0147",
   "jp": "・これといって用はない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen107.0148",
   "jp": "{v:00B2}それはそうだろう。{n}急に兄ができたんだからね。{p}{FC06}{v:00B3}僕に兄弟はいないから、うらやましい限りだよ。{n}{FC05}でも村の同世代の人達が僕の兄弟みたいなものかな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0149",
   "jp": "{v:00B4}嬉しいことをいってくれるね。{n}それじゃ、しばらく僕の話につきあってもらおうか。{p}{FC00}{v:00B5}１つ聞きたいんだが、{n}突然兄弟が出来た感想はどうだい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0150",
   "jp": "なんと答えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0151",
   "jp": "・いい感じ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen107.0152",
   "jp": "・まだ実感がない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen107.0153",
   "jp": "{v:00B6}なかなか適応が早いね。{n}普通はまだとまどっているものだと思うけど。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0154",
   "jp": "{v:00B7}確かにそうかもしれない。{n}いくらそっくりでも、急に兄だといわれれば{n}とまどうものだからね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0155",
   "jp": "{v:00B8}僕には兄弟がいないから、君がうらやましいよ。{p}{v:00B9}村の同世代の者たちが{n}ほとんど兄弟のようだとはいっても、{n}やっぱりうらやましいものがあるね。{p}{FC05}{v:00BA}これから君がどうするかは知らないけど、{n}彼の事を大切にしてあげるべきだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0156",
   "jp": "{v:00BB}そうなのかい？{n}僕はさっきのラルフ君の事で来たのかと{n}思っていたんだが。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0157",
   "jp": "{v:00BC}こいつって気まぐれだから‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0158",
   "jp": "{v:00BD}あははっ、そのようだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0159",
   "jp": "{v:00BE}さて、もう遅い。{n}そろそろ寝るとしよう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0160",
   "jp": "{v:00BF}アリオストさん、お休み。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0161",
   "jp": "{v:00C0}どうした、まだ寝ないのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0162",
   "jp": "なんと答えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0163",
   "jp": "・なかなか寝付けなくて話しかけた",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen107.0164",
   "jp": "・ウォレスは寝ないのかたずねる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen107.0165",
   "jp": "{v:00C1}そいつは仕方ないだろう。{n}急に兄ができたんだ。{n}興奮していたとしてもおかしくない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0166",
   "jp": "{v:00C2}そういえばウォレスさんには兄弟っていないの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0167",
   "jp": "{v:00C3}兄弟か？{n}結構いるぞ。{n}最近は全然会っていないがな。{p}{v:00C4}ま、俺に取っちゃ戦友も兄弟みたいなもんだが。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0168",
   "jp": "{v:00C5}ふーん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0169",
   "jp": "{v:00C6}まあ兄弟は大切にしてやれ。{n}失うのは簡単だが、簡単には得られる物じゃ{n}ないからな。{p}{v:00C7}明日も早い。{n}お前もそろそろ寝た方がいいぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0170",
   "jp": "{v:00C8}いや、もう寝るつもりだ。{n}明日も早い、お前もそろそろ寝たほうがいいぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0171",
   "jp": "{v:00C9}そうだね。お休み。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0172",
   "jp": "{v:00CA}どうした、まだ寝ないのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0173",
   "jp": "{v:00CB}あれ？{n}まだ寝ないの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0174",
   "jp": "{v:00CC}やっと生き別れの兄弟に会えたんだ。{n}ちょっと興奮してしまってね。{p}{v:00CD}でも明日も早い。{n}もう寝ないとね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0175",
   "jp": "{v:00CE}それじゃ、お休み！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0176",
   "jp": "{v:00CF}お休み。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0177",
   "jp": "{v:00D0}そろそろ寝るよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0178",
   "jp": "{v:00B0}どうぞ、鍵は開いてるよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0179",
   "jp": "もう眠りますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0180",
   "jp": "いったい、どれだけ眠れば気がすむのよ！{n}いいかげんに、起きなさい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0181",
   "jp": "{v:003D}そろそろアタシ達も寝ましょ！{n}おやすみ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0182",
   "jp": "{v:003E}{FFF0}きゃあああっ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0183",
   "jp": "{v:003F}何だ、今の声は？{n}ルイセの悲鳴みたいだったぞ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0184",
   "jp": "{v:0040}あれ？{n}ラルフさんがいない！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0185",
   "jp": "{v:0041}ええい、後少しだったのに‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0186",
   "jp": "{FFF5}{v:0042}どうして‥‥。{n}どうして、ラルフさんが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0187",
   "jp": "{v:0043}我々の計画にはお前が邪魔なんだよ。{n}お前さえいなくなれば、{n}我々の計画の障害はなくなる‥‥。{p}{v:0044}おとなしく死ね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0188",
   "jp": "{v:0045}きゃあっ！{n}お兄ちゃーーん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0189",
   "jp": "{v:0046}みんなで、ルイセちゃんを助けないと！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0190",
   "jp": "いつまでルイセちゃんを放っておく気？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0191",
   "jp": "‥‥ほら、ぐずぐずしていないで、{n}下におりましょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0192",
   "jp": "人のベッドで何するつもりよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0193",
   "jp": "おい、ヴェンツェルに話を聞きに{n}行くんだろ。{n}城の地下へ行こうぜ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0194",
   "jp": "ちょっと！{n}マスターをどこへ連れ出す気よ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0195",
   "jp": "ねぇ、一度お城へ戻ろうよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0196",
   "jp": "お母さんたちを連れて、バーンシュタインまで{n}テレポートしなくちゃいけないんでしょ？{n}今は少しでも休みたいんだけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0197",
   "jp": "そうそう！{n}街の入り口まででしょ？{n}買い物でもしながら歩いていこうよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen107.0198",
   "jp": "いったい、どこへ行く気だい？",
   "en": "",
   "term": "end"
  }
 ]
}
