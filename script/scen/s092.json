  },
  {
   "id": "scen092.0001",
   "jp": "道標",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen092.0002",
   "jp": "盗賊",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen092.0003",
   "jp": "カレン",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen092.0004",
   "jp": "ローランディア兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen092.0005",
   "jp": "フェザリアン",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen092.0006",
   "jp": "男",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen092.0007",
   "jp": "　　　　　　　　　{FFF0}熱烈歓迎{FFF1}{n}　　　　　　グランシル市　　観光協会",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0008",
   "jp": "あ、戻ってきた！{n}お帰りなさーい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0009",
   "jp": "ただいま戻りました。{n}レティシア姫、ご無事でしたか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0010",
   "jp": "ええ、こちらは何もありませんでしたよ。{n}そちらはどうでしたか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0011",
   "jp": "奥には、さっきの盗賊たちと、{n}１人のフェザリアンの女の子がいました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0012",
   "jp": "まぁ、フェザリアンがこんな所に‥‥？{n}それは珍しいですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0013",
   "jp": "けど、あいつらってば、そのフェザリアンを捕まえて{n}売り飛ばそうとしてたのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0014",
   "jp": "アタシたちがとっちめてやったけどね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0015",
   "jp": "フェザリアンを売るなんて、なんて酷いことを‥‥。{p}{FC00}しかしあなた達のおかげで、{n}そのフェザリアンの方は救われたのですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0016",
   "jp": "はい。{n}でも、そのフェザリアンさんは{n}ひどく人間のことを嫌ってる様子でした‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0017",
   "jp": "人間のせいであんな目に遭っては、{n}仕方ないでしょうがね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0018",
   "jp": "人間とフェザリアンって、{n}仲良く出来ないのかな‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0019",
   "jp": "そんなことないよ。{n}きっと、仲良くなれる日が来ると思うよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0020",
   "jp": "{FFF6}そうですね。{n}私も、人間とフェザリアンが{n}手を取り合える日がくることを願ってますわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0021",
   "jp": "うん！{FFFB}{n}‥‥じゃなかった、はい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0022",
   "jp": "では、そろそろ参りましょうか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0023",
   "jp": "{v:0000}おお、来たか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0024",
   "jp": "{v:0001}お前に言われたとおり、{n}腕に覚えのある連中を集めてきたが‥、{n}本当なんだろうな‥？{p}{v:0002}本当にフェザリアンがいたんだろうな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0025",
   "jp": "{v:0003}ああ、本当だ。{n}今もこの奥にいる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0026",
   "jp": "{v:0004}それじゃ、行こうぜ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0027",
   "jp": "{v:0005}何、アレ？{n}フェザリアンとか言ってたし、気になるわね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0028",
   "jp": "・別に気にならない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0029",
   "jp": "・気になる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0030",
   "jp": "{v:0006}お兄ちゃん、わたしも何か気になるよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0031",
   "jp": "{v:0007}気になるなら、見ておいた方がいいだろう。{n}後悔するよりマシだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0032",
   "jp": "あいつら、こっちに行ったよね？{n}早く追いかけようよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0033",
   "jp": "おい、ちょっと待て。{n}このままレティシア姫を一緒に連れてくのは、{n}さすがに危険だろう。{p}万が一、あいつらがレティシア姫に{n}危害を加えたら大変だぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0034",
   "jp": "あ、そっか。{n}護衛の任務中なのに、{n}お姫様を危険な場所になんて連れて行けないよね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0035",
   "jp": "でしたら、私はここで待っていますわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0036",
   "jp": "ダメです！{n}レティシア姫をお１人にはできません！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0037",
   "jp": "じゃあ、私が残ってレティシア姫様を{n}護衛するよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0038",
   "jp": "えええ、ミーシャがぁ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0039",
   "jp": "ひどーい、ティピちゃん。{n}アタシだって、ちゃんと護衛くらい出来るよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0040",
   "jp": "だが、さすがにそれは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0041",
   "jp": "私なら大丈夫です。{n}ミーシャさんがいてくださるなら、安心ですわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0042",
   "jp": "えへへ～★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0043",
   "jp": "‥‥{FE14}分かりました。{n}では目立たないように、{n}木の陰に隠れていてください。{p}ミーシャ、よろしく頼んだぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0044",
   "jp": "うん、任せて！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0045",
   "jp": "それじゃ、ちょっと行ってくるね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0046",
   "jp": "{v:0048}キャアアッ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0047",
   "jp": "{v:0049}この声は！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0048",
   "jp": "お兄ちゃん！{n}あの人を置いていって、どこへ行くつもり？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0049",
   "jp": "‥‥{v:004A}う‥うぅ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0050",
   "jp": "{v:004B}へっへっへっ！{n}悪ィな、姉ちゃんよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0051",
   "jp": "{v:004C}ああ、アンタは！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0052",
   "jp": "{v:004D}チッ！{n}お前らか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0053",
   "jp": "{v:004E}ええい、捕まってたまるか！{n}引き上げるぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0054",
   "jp": "{v:004F}へい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0055",
   "jp": "{v:0050}逃がさないわよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0056",
   "jp": "{v:0051}橋を落とされた！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0057",
   "jp": "{v:0052}用意周到な奴め‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0058",
   "jp": "‥‥{v:0053}逃げられちゃったね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0059",
   "jp": "{v:0054}みんな、早く来て！{n}この人ひどい傷だよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0060",
   "jp": "{v:0056}今の物音は何だ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0061",
   "jp": "{v:0057}あ、ゼノスさん！{n}カレンさんが！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0062",
   "jp": "{v:0058}何っ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0063",
   "jp": "{v:0059}カ、カレン！{n}しっかりしろ、カレン！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0064",
   "jp": "早く手当てしないと‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0065",
   "jp": "困ったな‥‥。{n}これじゃラージン砦に戻れないぞ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0066",
   "jp": "そろそろ大工が来てもいいんだが‥‥。{n}後少し、辛抱してみるか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0067",
   "jp": "もう大工を呼んだって話なんだが、{n}一体、いつになったらここへ来るんだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0068",
   "jp": "オズワルドって賊が、{n}この橋を落としたそうね‥‥。{p}もし見つけたら、おしおきしてやるのに！{n}くやし～！！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0069",
   "jp": "古い墓が並んでいる。{n}どうやら、同時期に建てられたものらしい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0070",
   "jp": "{v:0000}こんにちは。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0071",
   "jp": "{v:0001}最近よく会うわね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0072",
   "jp": "{FFF6}{v:0002}そうね。{n}この世に運命というものがあるなら、私たちは{n}出会うべくして出会ったのかもしれない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0073",
   "jp": "・そうだな",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0074",
   "jp": "・そんなことはない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0075",
   "jp": "{v:0003}ふふ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0076",
   "jp": "{v:0004}そういえばここで何してたの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0077",
   "jp": "‥‥{v:0005}そうか、ただの偶然か‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0078",
   "jp": "{v:0006}もう、このおバカはぁ！{n}嘘でもあわせなさいよね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0079",
   "jp": "‥‥{v:0007}でも嘘か‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0080",
   "jp": "{FB00}‥‥{v:0008}あ、あはははは‥‥。{p}{v:0009}そういえばここで何してたの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0081",
   "jp": "{v:000A}別に、何というほどのことではないわ。{n}ただの暇つぶしよ。{p}{v:000B}人間たちは私を見ると好奇な目をするから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0082",
   "jp": "{v:000C}フェザリアンは滅多に見かけないもんね。{n}珍しいって騒ぐよね～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0083",
   "jp": "{FFF6}{v:000D}その点、{n}お前たちは騒がないから楽でいいわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0084",
   "jp": "{v:000E}あはは‥‥そりゃどーも‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0085",
   "jp": "{v:000F}ところで、お前の持ってるその指輪だけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0086",
   "jp": "{v:0010}こいつの指輪がどうかしたの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0087",
   "jp": "{v:0011}とても、きれい。{n}不思議な光り方をしてる‥‥。{n}ちょっと見せてくれない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0088",
   "jp": "・見せない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0089",
   "jp": "・見せてあげる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0090",
   "jp": "{v:0012}そう‥‥ケチ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0091",
   "jp": "{v:0013}あ～あ、行っちゃった‥‥。{p}{v:0014}でもパワーストーンだもんね、{n}仕方ないかぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0092",
   "jp": "{v:0015}わぁ‥‥きれい‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0093",
   "jp": "‥‥{v:0016}えっ、これはパワーストーン‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0094",
   "jp": "{v:0017}えっ？{n}知ってるの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0095",
   "jp": "‥‥{v:0018}これはとても危険な物よ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0096",
   "jp": "{v:0019}もし、これを持ったまま、欲望のままに{n}願ってしまえば、奇跡を与えつつ、その代償として、{n}人々に大きな不幸を与えてしまう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0097",
   "jp": "・それは知っている",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0098",
   "jp": "・そんなことない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0099",
   "jp": "{v:001A}だったら、{n}パワーストーンを持ち歩くのはやめなさい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0100",
   "jp": "{v:001B}人間の願望は強いのよ。{n}間違えて使わないと言い切れる？{p}{FC00}{v:001C}そんな危険を冒さないためにも{n}パワーストーンを持ち歩くのはやめなさい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0101",
   "jp": "{v:001D}た、たしかに危険だけど、{n}でも持ち歩かないって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0102",
   "jp": "{v:001E}これは元々フェザリアンが時空融合計画のために{n}作り上げたもの。{n}それが遙か昔に持ち去られた。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0103",
   "jp": "{v:001F}だから私が元の場所に戻します。{n}これを預からせて下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0104",
   "jp": "・少し考えさせて",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0105",
   "jp": "・出来ない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0106",
   "jp": "・頼む",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0107",
   "jp": "{v:0031}わかった。{n}今すぐとは言わないわ。{n}でも、問題が起きる前に決断して。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0108",
   "jp": "{v:0020}きっと、パワーストーンを持っていることが、{n}あなたやこの世界に不幸を呼ぶわ。{p}{FFF6}{v:0021}そうなったら私はもう手助けできない。{n}自分たちで責任を取ることね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0109",
   "jp": "　{n}　　　　　　シエラの指輪を渡した！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0110",
   "jp": "{v:0022}ありがとう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0111",
   "jp": "‥‥{v:0023}フェザリアンなら変なことに{n}使わないと思うけど‥‥、{n}本当によかったのかなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0112",
   "jp": "{v:0032}パワーストーンを私に預からせてくれるのかしら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0113",
   "jp": "・少し考えさせて",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0114",
   "jp": "・出来ない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0115",
   "jp": "・頼む",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0116",
   "jp": "{v:000D}あ、アレってメルフィさんじゃない。{p}{v:000E}メルフィさん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0117",
   "jp": "‥‥{v:000F}あ‥‥あなたは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0118",
   "jp": "{v:0038}身体の具合はどうですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0119",
   "jp": "{v:0039}あなたには関係ないことよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0120",
   "jp": "{FB00}‥‥{v:003A}ま、まぁ、一応元気みたいね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0121",
   "jp": "{v:0010}あの‥‥実はメルフィさんに用があって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0122",
   "jp": "{v:0011}私にはないわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0123",
   "jp": "{FFF6}‥‥{v:0012}うう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0124",
   "jp": "{v:0013}ちょっと、メルフィさん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0125",
   "jp": "・ルイセの話を聞いてくれ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0126",
   "jp": "・悪いことにはならないはずだ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0127",
   "jp": "・ルイセをたしなめる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0128",
   "jp": "‥‥{v:0014}あなたがそう言うなら‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0129",
   "jp": "‥‥{v:0015}あなたがそう言うなら‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0130",
   "jp": "{v:0016}あう‥‥わたしが悪いの‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0131",
   "jp": "{v:0017}そうよ、{n}ルイセちゃんは悪いことしてないじゃない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0132",
   "jp": "‥‥{v:0018}わかったわよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0133",
   "jp": "{v:0019}それで何の用なの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0134",
   "jp": "{v:001A}うん、あのね、あなたのブレスレット、{n}留め金が壊れかけてるみたいだから、{n}修理しようと思って部品を持ってきたの。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0135",
   "jp": "{v:001B}直せるの！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0136",
   "jp": "{v:001C}うん！{n}だから、ちょっと貸してくれるかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0137",
   "jp": "‥‥{v:001D}う‥‥これは‥大切な物だから‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0138",
   "jp": "{v:001E}でも、貸してくれないと、直せないよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0139",
   "jp": "‥‥{v:001F}うぅ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0140",
   "jp": "・ルイセを信じろ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0141",
   "jp": "・無理はさせない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0142",
   "jp": "・黙ってみている",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0143",
   "jp": "‥‥{v:0020}うぅ‥‥。{n}‥‥うん、わかった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0144",
   "jp": "{v:0021}うん。{n}無理はさせられないもんね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0145",
   "jp": "{v:0022}でもさ、そのままにしておいて、{n}落としちゃったら大変だと思うけど‥‥。{p}{v:0023}例えば空を飛んでるときに{n}落としちゃったら‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0146",
   "jp": "{v:0024}それは困るわ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0147",
   "jp": "{v:0025}それじゃ、ちょっとだけ借りるね。{n}すぐ終わるから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0148",
   "jp": "‥‥{v:0026}頼む‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0149",
   "jp": "{v:0027}こっちの留め金を外して‥‥{n}新しい留め金に変えて‥‥これを‥‥ぱちん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0150",
   "jp": "‥‥{v:0028}おーー‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0151",
   "jp": "{v:0029}はい、直ったよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0152",
   "jp": "‥‥{v:002A}本当だ‥‥もう外れない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0153",
   "jp": "{v:002B}良かったわね★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0154",
   "jp": "{v:002C}ああ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0155",
   "jp": "・さすがルイセだ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0156",
   "jp": "・お礼は？",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0157",
   "jp": "{v:002D}そんな、大したことはしてないよ。{p}{FC00}{v:002E}わたしもね、{n}昔お気に入りのアクセサリーを落としたことがあって、{n}その時、凄く悲しかったの。{p}{FFF6}{v:002F}あんな想いは、誰にもさせたくないから‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0158",
   "jp": "‥‥{v:0030}そうか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0159",
   "jp": "‥‥{v:0031}う‥‥うぅ‥‥。{p}{FFF6}‥{v:0032}そうね‥‥ジャスティンも{n}よく言ってるものね‥‥。{p}{FC04}{FFF7}{v:0033}おかげで形見のブレスレットが元に戻ったわ。{n}‥‥ありがとう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0160",
   "jp": "{v:0034}どういたしまして！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0161",
   "jp": "{v:0035}そ、それじゃ、{n}私は行くから‥‥さよなら‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0162",
   "jp": "{v:0036}あはは★{n}なんだか、照れてたね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0163",
   "jp": "{v:0037}メルフィさん‥‥よかった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0164",
   "jp": "{FFF6}{v:0000}～♪～～♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0165",
   "jp": "{v:0001}わあ～、キレイな歌声‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0166",
   "jp": "{v:0002}うん。{n}聞きほれちゃうね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0167",
   "jp": "{v:0003}！！{n}お前たち、この前の人間‥‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0168",
   "jp": "{v:0004}あ、こんにちは。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0169",
   "jp": "‥‥{v:0005}くっ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0170",
   "jp": "{v:0006}ねえ、１人で平気？{n}また変な奴らが襲ってきたら‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0171",
   "jp": "{v:0007}あんなの、いつものことよ。{n}慣れてるわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0172",
   "jp": "{v:0008}いつものことって、なおさら危険じゃない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0173",
   "jp": "{v:0009}お前たちこそ、{n}この前の盗賊みたいに私を捕まえて売り飛ばそうと{n}思ってるかもしれないじゃない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0174",
   "jp": "{v:000A}そ、そんな酷いことするわけないでしょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0175",
   "jp": "‥‥{v:000B}なら、どうしてココに来たの？{n}理由は何？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0176",
   "jp": "・理由なんてない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0177",
   "jp": "・会いたかったから",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0178",
   "jp": "・通りかかっただけ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0179",
   "jp": "{v:000C}理由がないのに来た‥‥？{n}‥‥変な人間ね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0180",
   "jp": "{FFF6}{v:000D}そう‥‥。{n}私にはよく理解できないわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0181",
   "jp": "{FFF6}{v:000E}そう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0182",
   "jp": "{v:000F}えっ、もう行っちゃうの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0183",
   "jp": "‥‥{v:0010}人間とは馴れ合わないわ。{n}私がこれ以上、ここにいる必要はない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0184",
   "jp": "{v:0011}行っちゃった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0185",
   "jp": "{v:0012}よほど人間を嫌っているようだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0186",
   "jp": "{v:0013}フェザリアンと人間の種族の差って大きいんだね‥‥。{n}なんだか寂しいよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0187",
   "jp": "{v:0008}お父さん‥‥、お母さん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0188",
   "jp": "{v:0009}ほら、あそこにいるだろう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0189",
   "jp": "{v:000A}本当だ‥‥。{n}しかも、あれだけ上玉なら、高く売れそうだぜ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0190",
   "jp": "{v:000B}おい、そこのフェザリアン。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0191",
   "jp": "{v:000C}‥‥‥？{n}‥‥何かしら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0192",
   "jp": "{v:000D}頼みがあるんだが、{n}オレたちと一緒に来てくれるか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0193",
   "jp": "{v:000E}イヤ。{n}お前たちの頼みを聞く必然性がない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0194",
   "jp": "{v:000F}‥‥たく、{n}フェザリアンってのは頭にくるものの{n}言い方をしやがる‥。{p}{v:0010}もう面倒だ、実力行使と行こうぜ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0195",
   "jp": "{v:0011}離して‥‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0196",
   "jp": "{v:0013}何だ、この安っぽいブレスレットは？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0197",
   "jp": "{v:0014}返して！{n}それを返して！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0198",
   "jp": "{v:0015}返してほしけりゃ、こっちに来な！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0199",
   "jp": "{v:0016}‥‥くっ！{n}‥‥人間め‥‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0200",
   "jp": "{v:0017}ほほぅ、オレたちとやり合う気か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0201",
   "jp": "{v:0018}そこの悪人！{n}何してんのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0202",
   "jp": "{v:0019}そこのフェザリアンさん、{n}今のうちに逃げてください！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0203",
   "jp": "{v:001A}ブレスレット‥‥、私のブレスレットを返して‥‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0204",
   "jp": "{v:001B}この場を見られたなら生かして帰せねぇ！{n}こいつら全員、始末するぜ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0205",
   "jp": "{v:001C}フェザリアンも殺してもいい！{n}ただ出来るだけ目立つ傷はさけろ！{n}剥製にしたとき値が落ちるからな！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0206",
   "jp": "{v:001D}黙って聞いてりゃ、最低のヤロウたちだな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0207",
   "jp": "　{n}　　　　　　ブレスレットを返した。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0208",
   "jp": "{v:0022}あ、あの‥‥ケガは‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0209",
   "jp": "{v:0023}この程度なら、平気よ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0210",
   "jp": "{v:0024}メルフィ！{n}何があった！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0211",
   "jp": "{v:0025}ジャスティン‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0212",
   "jp": "{v:0026}大丈夫、何でもないわ‥‥いつもの事よ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0213",
   "jp": "{FFF6}{v:0027}‥‥詳しいことは後で聞こう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0214",
   "jp": "{FFF7}{v:0028}この状況を見る限り‥‥、{n}この人たちに助けてもらったようだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0215",
   "jp": "{v:0029}メルフィを助けてくれて、ありがとう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0216",
   "jp": "・当然のことをしたまで",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0217",
   "jp": "・黙っている",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0218",
   "jp": "{v:002A}人助けをしてその謙遜‥‥、{n}君たちはすごい人だね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0219",
   "jp": "{v:002B}ところで、メルフィ。{n}彼らにお礼は言ったかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0220",
   "jp": "{v:002C}‥‥‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0221",
   "jp": "{v:002D}まだのようだね。{n}さあ、ちゃんと礼を言わないと。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0222",
   "jp": "{v:002E}でも、この人たちもさっきの連中と同じ人間よ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0223",
   "jp": "{v:002F}それでも助けられたら礼をするのが当然だ。{n}ここで暮らす以上、{n}価値観の差を埋めていかないとね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0224",
   "jp": "{v:0030}‥‥わかったわ‥‥。{n}ジャスティンが言うなら、そうする。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0225",
   "jp": "{v:0031}‥‥ありがとう。{n}おかげで助かったわ。{n}このブレスレットも取り戻せた‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0226",
   "jp": "{v:0032}本当にありがとう。{n}私たちは急ぐので、これで失礼するよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0227",
   "jp": "{v:0033}さあ、メルフィ。行こうか。{n}アメリアが待ってる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0228",
   "jp": "{v:0034}了解。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0229",
   "jp": "{v:0035}フェザリアンと人間か‥‥。{n}この種族の差は、いつか越えられるのか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0230",
   "jp": "・越えられる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0231",
   "jp": "・難しい",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0232",
   "jp": "・自分たちが橋渡しをする",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen092.0233",
   "jp": "{v:0036}うん、そうだよね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0234",
   "jp": "{v:0037}難しいけど‥‥。{n}だから、やらないとダメなんだよね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0235",
   "jp": "{v:0038}‥‥ふっ。なかなかいい答えだな‥‥。{n}その日まで、オレも力を貸そう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0236",
   "jp": "{v:003A}さっきのジャスティンさんって人とは{n}仲良さそうだったし、{n}きっと打ち解けることは出来るよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0237",
   "jp": "{v:003B}そうだね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0238",
   "jp": "{v:0039}さて、寄り道は終わりだ。{n}そろそろ、行こうか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0239",
   "jp": "ちょっと！{n}あのフェザリアンの子に、ブレスレットを{n}返してあげなきゃダメでしょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0240",
   "jp": "お兄ちゃん！{n}あの人を置いていって、どうするつもり？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0241",
   "jp": "お兄ちゃん！{n}ウォレスさんを置いていって、どうするつもり？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0242",
   "jp": "レティシア姫とミーシャを放って、{n}どこへ行くつもりよ！？",
   "en": "",
   "term": "end"
  }
 ]
}
