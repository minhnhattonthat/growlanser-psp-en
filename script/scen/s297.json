  {
   "id": "scen297.0001",
   "jp": "皆さんはどうしていらっしゃるんでしょうね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen297.0002",
   "jp": "あ、{s:0000}さん。{n}楽しんでいらっしゃいますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen297.0003",
   "jp": "のんびりできるっていいですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen297.0004",
   "jp": "平和だなぁ。{n}戦っているなんて嘘みたいです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen297.0005",
   "jp": "{s:0000}さんはいつもティピと一緒で{n}楽しそうですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen297.0006",
   "jp": "そのうち、みんなで山奥で釣りなんて{n}楽しいかも知れませんね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen297.0007",
   "jp": "いつもお世話になってます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen297.0008",
   "jp": "どこ行こうか？",
   "en": "",
   "term": "end"
  }
 ]
}
