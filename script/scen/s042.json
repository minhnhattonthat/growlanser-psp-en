  },
  {
   "id": "scen042.0008",
   "jp": "受付員",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen042.0009",
   "jp": "張り紙",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen042.0010",
   "jp": "バーバラ",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen042.0011",
   "jp": "グランシル",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0012",
   "jp": "　　{FFEE}{FFEC}街をきれいに！{FFED}{FFF1}{n}　　　　　　　　　　　～グランシル子供会～",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0013",
   "jp": "‥‥世が荒れているな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0014",
   "jp": "‥‥何処へ行っても一緒さ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0015",
   "jp": "最近、この街も捨てたもんじゃないって{n}思えるようになったんだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0016",
   "jp": "‥‥‥ふぅっ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0017",
   "jp": "私もがんばるわ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0018",
   "jp": "{v:0000}俺たちも、兵隊じゃねぇけど、{n}みんなを守るために自警団を作ったんだ。{p}{v:0001}だから、この町のことは任せてくれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0019",
   "jp": "{v:0006}こんな子供ががんばってるのに、{n}大人が落ち込んでいるわけにはいかないからな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0020",
   "jp": "{v:0004}あ、お兄ちゃん達だ！{n}僕ね、畑仕事を手伝ってるんだ！{p}{v:0005}だって、お腹がすいたら、戦えないでしょ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0021",
   "jp": "アンタ、どこへ行くのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0022",
   "jp": "　　　　　　{FFEC}闘技場入り口{FFED}{n}　　　　　～{FFEE}このまま右へお進み下さい{FFF1}～",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0023",
   "jp": "文句ばっかり言ってても、{n}何にも解決しないからな。{n}まずは自分に出来ることから、始めていくよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0024",
   "jp": "大人しくヴェンツェル様の支配を受けてればいいんだ。{n}どうせ俺たちが反抗したところで、{n}何にもならないからな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0025",
   "jp": "この街にいれば安全だよ。{p}何でかって？{n}だってここにはたくさんの猛者がいるんだよ。{n}いざとなったら守ってもらうさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0026",
   "jp": "‥‥もうダメさ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0027",
   "jp": "ああ、かっこいい戦士さまは来ないかしら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0028",
   "jp": "ヴェンツェルに比べたら、{n}妻の方がいくらかはマシだな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0029",
   "jp": "{v:0027}ようお出でなさった。{n}ここでは、いろんな道具を扱っておるんじゃ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0030",
   "jp": "{v:0028}それで何のご用かのぉ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0031",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0032",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0033",
   "jp": "他にも用はあるかのぉ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0034",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0035",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0036",
   "jp": "{v:0031}また来ておくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0037",
   "jp": "{v:003F}まぁ、いらっしゃい。{n}このお店は、どんな装備品でもそろってるわよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0038",
   "jp": "{v:0041}それで、買いに来たの？{n}売りに来たの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0039",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0040",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0041",
   "jp": "で、他にも何かある？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0042",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0043",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0044",
   "jp": "{v:004B}また来てよね。{n}素敵な笑顔で待ってるから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0045",
   "jp": "{v:000C}いらっしゃいませ。{n}当店では、様々な装備品を取り扱っております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0046",
   "jp": "{v:000E}お買い求めですか？{n}それともご売却ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0047",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0048",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0049",
   "jp": "他にもご用はおありですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0050",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0051",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0052",
   "jp": "{v:0018}またどうぞ、お越し下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0053",
   "jp": "{v:0033}いらっしゃいませ。{n}この店では、様々なグッズをお買い求めいただけます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0054",
   "jp": "{v:0034}本日はお買い求めですか？{n}それともご売却ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0055",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0056",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0057",
   "jp": "他にも何かおありでしょうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0058",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0059",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0060",
   "jp": "{v:003E}ありがとうございました！{n}またどうぞ、お越し下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0061",
   "jp": "{v:0002}アンタ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0062",
   "jp": "{v:0003}ん？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0063",
   "jp": "{v:0004}私はこの街の市長をしている者だ。{n}アンタに話がある。{n}ちょっと来てくれんか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0064",
   "jp": "{v:0005}しょうがねぇな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0065",
   "jp": "{v:0006}私が話をしたいのはこの若者だけだ。{n}他の者に用はない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0066",
   "jp": "{v:0007}お、お兄ちゃんだけ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0067",
   "jp": "{v:0008}闘技場の前で待っている。{n}１人で来てくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0068",
   "jp": "{v:0009}何、アレ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0069",
   "jp": "{v:000A}俺たちが集団だと怖いんだろうよ。{p}{v:000B}俺たちはここで待っている。{n}さっさと用事を済ませて来いよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0070",
   "jp": "早く戻ってきてね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0071",
   "jp": "俺たちはここで待ってる。{n}さっさと用事を済ませて来いよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0072",
   "jp": "いったい、何でしょうね～？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0073",
   "jp": "自信をもつといい。{n}僕たちのしてきたことは間違いじゃないんだ。{n}‥‥絶対にね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0074",
   "jp": "酷いことをされないといいのですが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0075",
   "jp": "何でも他人のせいにして生きてる奴らだな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0076",
   "jp": "僕たちはあなたを信じていますから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0077",
   "jp": "私たちのしてきたことは、無駄だったのだろうか？{FFFB}{n}‥‥いや、そんなはずはない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0078",
   "jp": "君たちは俺たちの希望だ！{n}がんばってくれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0079",
   "jp": "グランシルは都会だろ？{n}きっとローランディアで１番、栄えてると思うね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0080",
   "jp": "頼むぞ！{n}負けないでくれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0081",
   "jp": "やあ、あんたか。{n}最近の調子はどうだい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0082",
   "jp": "{v:0019}おう、いらっしゃい。{n}ここは装備品を売ってる店だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0083",
   "jp": "{v:001B}買いに来たのか？{n}それとも何か売る気か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0084",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0085",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0086",
   "jp": "まだ何か用か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0087",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0088",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0089",
   "jp": "{v:0025}じゃあな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0090",
   "jp": "私はお花を売っています、るるる～♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0091",
   "jp": "かわいい花束はいかがですか～♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0092",
   "jp": "・買う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0093",
   "jp": "・買わない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0094",
   "jp": "また来て下さいね～♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0095",
   "jp": "大きなお城みたいなものが空から落ちてきたの！{n}南の方、たぶん海の側に落ちたわ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0096",
   "jp": "市民の自覚",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0097",
   "jp": "{v:004E}みなさん、大丈夫でしたか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0098",
   "jp": "{v:004F}自分たちがあれほど酷く言ったのに、{n}まだ気にかけてくれるのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0099",
   "jp": "{v:0050}当たり前じゃない！{n}アタシ達、見捨てるなんて出来ないよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0100",
   "jp": "{v:0051}ねぇ、お兄ちゃん。{p}{v:0052}僕たち、{n}このまま殺されるのを待ってなきゃダメなの？{n}どうすればいいの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0101",
   "jp": "なんと答えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0102",
   "jp": "・何も心配しなくていい",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0103",
   "jp": "・自分に出来る最良の事をすればいい",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0104",
   "jp": "・別にない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0105",
   "jp": "{v:0053}でも‥‥。{n}でも悔しいんだよ！{p}{v:0054}僕が大人で、お兄ちゃん達みたく強ければ、{n}戦えるのに！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0106",
   "jp": "{v:0055}自分にできる最良のこと？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0107",
   "jp": "{v:0056}本当に、何もないの？{n}僕じゃ、役に立たない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0108",
   "jp": "{v:0057}そうだね。{n}戦うばかりが、方法じゃないわ。{p}{v:0058}戦えない人は、少しでもこの世界がよくなるために、{n}自分ができることをがんばればいいのよ。{p}{v:0059}絶対にあきらめないで、ね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0109",
   "jp": "‥‥{v:005A}うん！{n}僕、戦えないけど、お兄ちゃん達が安心して{n}戦えるように、僕のできることを考えるよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0110",
   "jp": "{v:005B}その意気よ。{n}あの悪い奴は、アタシ達がやっつけてあげるから！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0111",
   "jp": "‥‥{v:005C}でも、そんなにちっちゃくて、戦えるの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0112",
   "jp": "{v:005D}こ、このガキ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0113",
   "jp": "{v:005E}ほ、ほら！{n}こんなちっちゃい妖精でもね、{n}あきらめないでがんばってるんだよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0114",
   "jp": "{v:005F}そうだね！{n}僕もがんばる！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0115",
   "jp": "{v:0060}俺たちも自分で出来ることをやってみるよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0116",
   "jp": "{v:0061}ああ。{n}今日の戦いで、少しは自信がもてたからな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0117",
   "jp": "‥‥{v:0062}さ、俺たちもがんばろうぜ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0118",
   "jp": "闘技場前広場",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0119",
   "jp": "こんな時でしょ？{n}変な行動はつつしんだ方がいいわよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0120",
   "jp": "俺じゃなくて、市長に話しな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0121",
   "jp": "よく逃げずに１人で来たな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0122",
   "jp": "市長と話せ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0123",
   "jp": "ほら、市長が待ってるぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0124",
   "jp": "し、市長さんがお話があるそうよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0125",
   "jp": "アンタが、英雄気取りの騎士さんかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0126",
   "jp": "俺は市長じゃないぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0127",
   "jp": "自分で出来ることをやってみるよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0128",
   "jp": "今日は自信がついたよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0129",
   "jp": "俺も少しはお前たちの役に立てるかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0130",
   "jp": "酷いことを言ってすまなかった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0131",
   "jp": "ただ諦めてるだけじゃだめよね。{n}やっぱりやれるだけのことはやってみないと！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0132",
   "jp": "今日のことは一生忘れないよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0133",
   "jp": "あんたらの言う通りだ。{n}とにかく俺もやれるだけやってみるよ。{p}何かをやって後悔する方が、{n}何もせずに後悔するよりましだからな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0134",
   "jp": "あなた方のおかげで、目が覚めました。{n}本当に申し訳ありませんでした。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0135",
   "jp": "{v:000D}ちゃんと１人で来たようだな。{p}{v:000E}今日こそは言いたいことを言わせてもらうとしようか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0136",
   "jp": "{v:000F}あんた達のせいで、{n}俺たちの生活は脅かされているんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0137",
   "jp": "{v:0010}こんな生活、もう、たくさんよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0138",
   "jp": "{v:0011}ちょ、ちょっと‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0139",
   "jp": "{v:0012}お前が余計なことをしなけりゃ、{n}生活が脅かされることもなかった！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0140",
   "jp": "{v:0013}でも、ヴェンツェルに支配されちゃうのよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0141",
   "jp": "{v:0014}どうせ王様が変わるだけだ！{n}俺たちの生活は何も変わらない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0142",
   "jp": "彼らに何かいいますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0143",
   "jp": "・ヴェンツェルの危険性を説く",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0144",
   "jp": "・今までとの違いを説く",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0145",
   "jp": "・黙っている",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0146",
   "jp": "{v:0015}危険だと？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0147",
   "jp": "{v:0016}違うだと？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0148",
   "jp": "{v:0017}そうよ！{n}アイツがやろうとしている支配は、{n}アンタ達を家畜みたいに扱うことだよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0149",
   "jp": "{v:0018}ほれ、反論も出来んだろ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0150",
   "jp": "{v:0019}ムカッ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0151",
   "jp": "{v:001A}アンタ、ここまで言われてどうして黙ってんのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0152",
   "jp": "{FFF3}‥{FE14}‥{FE14}{FC03}{v:001B}ひょっとして、あきれてんの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0153",
   "jp": "{v:001C}人をバカにしおって！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0154",
   "jp": "{v:001D}バカにされて当然よ！{p}{v:001E}ヴェンツェルがやろうとしていることが、{n}今までの支配と同じだと思ってんの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0155",
   "jp": "{v:001F}違うとでも言いたいのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0156",
   "jp": "{v:0020}アンタが言わないなら、アタシが言うわよ！{p}{v:001E}ヴェンツェルがやろうとしていることが、{n}今までの支配と同じだと思ってんの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0157",
   "jp": "‥‥{v:0023}うぅ‥‥。{p}{v:0024}だが‥‥市民が殺されるよりは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0158",
   "jp": "{v:0025}だから、そんな考えが甘いって言ってんのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0159",
   "jp": "{v:0026}おじいちゃん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0160",
   "jp": "{v:0027}子供は黙ってなさい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0161",
   "jp": "{v:0028}違うよ‥‥あれ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0162",
   "jp": "{v:0029}きゃああっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0163",
   "jp": "{v:002A}た、大変！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0164",
   "jp": "{v:002B}も、もうダメだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0165",
   "jp": "{v:002C}何言ってんのよ！{n}その武器は飾りなの！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0166",
   "jp": "{v:002D}そうは言っても、どうやって戦えば‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0167",
   "jp": "{v:002E}コイツの指示に従えばいいから！{n}死にたくなかったら戦いなさい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0168",
   "jp": "‥‥{v:002F}わかった！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0169",
   "jp": "コロシアム運営事務所",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0170",
   "jp": "調子はどうだい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0171",
   "jp": "　{n}　　　　　　　～{FFF0}闘技大会の歴史{FFF1}～{p}約５００年ほど前、ここグランシルは{n}都市国家の１つとして栄えていました。{n}しかし伝説の格闘家として名高い『{FFEF}グランバス{FFF1}』王が{n}この地方をまとめ、大きな国家を築きました。{p}その治世の間、国王は様々な部門の格闘技を奨励し{n}毎年１回、他流試合を行うためのコロシアムを{n}グランシルに造ったのです。{p}この大会は時代とともにルールなども{n}大きく変わっていきましたが、年々規模を増し、{n}今ではこの大陸で最も有名な{n}国際大会の１つになりました。{p}大陸中の猛者が集まるこの歴史ある闘技大会。{n}あなたもぜひ、チャレンジしてみませんか？{n}　{n}　　　　　　　　　　　　　{FFEE}コロシアム運営事務局{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0172",
   "jp": "当店をご利用でしたら、{n}こちらで記帳なさって下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0173",
   "jp": "いらっしゃいませ。{n}１泊、{FFEB}エルムになりますが？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0174",
   "jp": "ありがとうございました。{n}気を付けて行ってらっしゃいませ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0175",
   "jp": "お客さま‥‥[01BE]{n}お金が足りないみたいですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0176",
   "jp": "またのお越しをお待ちしております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0177",
   "jp": "私はこう見えてもオペラ歌手なのよ。{n}ただ、いい劇場がなくて、公演が出来ないのよ。{n}あなた、どこかいい場所を知らない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0178",
   "jp": "バーバラに公演を依頼しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0179",
   "jp": "私を雇ってくれるの？{n}手付け金は１０００エルムでいいわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0180",
   "jp": "・やっぱりやめる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0181",
   "jp": "・公演を依頼する",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0182",
   "jp": "あら、残念だわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0183",
   "jp": "場所は？{n}‥‥{s:0010}ね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0184",
   "jp": "お金をためて、また誘ってね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0185",
   "jp": "歌の邪魔をしないで！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0186",
   "jp": "ゼノスの家",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0187",
   "jp": "失礼しま～す。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0188",
   "jp": "俺の力が必要ってわけだな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0189",
   "jp": "‥‥手伝って欲しいのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0190",
   "jp": "どうするの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0191",
   "jp": "・ゼノスをメンバーに加える",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0192",
   "jp": "・今はメンバーに加えない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0193",
   "jp": "{v:0015}でもこれ以上は多すぎるよ。{n}誰かを仲間から外さないと。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0194",
   "jp": "誰をメンバーから外しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0195",
   "jp": "・{s:FFED}",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0196",
   "jp": "・{s:FFEE}",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen042.0197",
   "jp": "{s:FFEE}の装備を回収しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0198",
   "jp": "　{n}　　　　　{FFEF}ゼノスが仲間になった！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0199",
   "jp": "がんばらせて、もらうぜ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0200",
   "jp": "なんだ、違うのかよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0201",
   "jp": "‥‥そうか‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0202",
   "jp": "カレンの使っているドレッサーだろう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0203",
   "jp": "これは兄さんが、初めて稼いだお金で{n}買ってくれたんです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen042.0204",
   "jp": "このドレッサーにカレンの姿が映ることは{n}もう２度とない。",
   "en": "",
   "term": "end"
  }
 ]
}
