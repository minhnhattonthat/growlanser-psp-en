   "en": "",
   "term": "null"
  },
  {
   "id": "scen285.0001",
   "jp": "{FFEE}メルフィを救い、ジャスティンを倒せ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0002",
   "jp": "{v:007D}ガーディアンよ、メルフィの座標に対しＳ攻撃だ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0003",
   "jp": "{v:007E}Ｓ攻撃‥何それ‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0004",
   "jp": "ここまでよ！覚悟しなさい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0005",
   "jp": "‥‥あなただけは、{n}絶対に許さないんだから！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0006",
   "jp": "お前みたいな外道だけは、絶対に許さねぇ！{n}くたばりやがれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0007",
   "jp": "‥‥メルフィの代わりに、{n}私が博士たちの仇をとる！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0008",
   "jp": "この世界を滅ぼそうとした罪、{n}死んで償うがいい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0009",
   "jp": "{v:0080}くっくっくっ！{n}ガーディアンは、まだまだいるぞ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0010",
   "jp": "{FFF6}{v:0058}う‥‥うぅぅ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0011",
   "jp": "{v:007F}なっ、自爆させた！？{n}なんて、ヒドイことを！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0012",
   "jp": "{FFF6}‥‥{v:004C}う‥‥うぅぅ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0013",
   "jp": "{v:004D}メルフィさん、いま助けてあげる！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0014",
   "jp": "{v:004E}お兄ちゃん、みんな！{n}これから私はメルフィさんを助ける事に集中するよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0015",
   "jp": "・もう少しだけ待て",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen285.0016",
   "jp": "・頑張れ！",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen285.0017",
   "jp": "{v:004F}う、うん‥‥。{n}でも時間がないから、ちゃんと状況を見てね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0018",
   "jp": "{v:0051}うん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0019",
   "jp": "{v:0052}くそっ！{n}ここまで来て、失敗などさせるか！{n}この世界の連中は全部殺してやるのだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0020",
   "jp": "‥‥{v:0060}ぅ‥‥身体の中が光で満たされていく‥‥。{n}これは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0021",
   "jp": "{v:0061}メルフィさん‥‥助かったのね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0022",
   "jp": "{v:0062}よかったぁ～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0023",
   "jp": "{v:0030}ジャスティン‥‥許さない！{n}‥‥よくも‥‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0024",
   "jp": "{FFF6}‥‥{v:0056}う‥‥うぁ‥‥あ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0025",
   "jp": "{v:0057}もう少しだから、頑張って！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0026",
   "jp": "{v:0059}メルフィさん、がんばって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0027",
   "jp": "{FFF6}{v:005A}う‥‥‥‥、うあああああああっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0028",
   "jp": "{v:005B}これって時空の歪みが‥‥大きく‥‥！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0029",
   "jp": "{v:005C}もうだめ！{n}抑えきれない！{p}{v:005D}きゃああああああっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0030",
   "jp": "‥‥{v:0055}ご‥‥ごめんね、メルフィさん‥‥。{n}助けて‥‥あげられなかった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0031",
   "jp": "{v:0053}きゃああっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0032",
   "jp": "{v:0054}ルイセちゃん！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0033",
   "jp": "はっはっは！{n}効かない！効かないな！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0034",
   "jp": "‥‥{v:005E}ぐ‥‥ぐぅ‥‥。{n}‥‥俺は‥‥故郷を‥‥救うんだ‥‥。{n}故郷をそのままに‥‥幸せの中に‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen285.0035",
   "jp": "{FFF6}{v:005F}ジャスティン‥‥。",
   "en": "",
   "term": "end"
  }
 ]
}
