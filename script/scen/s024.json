  },
  {
   "id": "scen024.0001",
   "jp": "ルイセ",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen024.0002",
   "jp": "ティピ",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen024.0003",
   "jp": "ウォレス",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen024.0004",
   "jp": "ミーシャ",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen024.0005",
   "jp": "魔法学院生徒",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen024.0006",
   "jp": "吟遊詩人",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen024.0007",
   "jp": "アリオスト",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen024.0008",
   "jp": "行商人",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen024.0009",
   "jp": "警備兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen024.0010",
   "jp": "送魔線技師",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen024.0011",
   "jp": "{v:0000}ここがわたしが通ってる魔法学院だよ。{n}お兄ちゃん、学院について詳しく聞きたい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0012",
   "jp": "{v:0001}ここはね、ローランディア王国と{n}バーンシュタイン王国が共同で作った学校なんだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0013",
   "jp": "{v:0002}へぇ。{n}どうして２つの国が共同したの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0014",
   "jp": "{v:0003}知識の独占を防ぐためだって言ってたよ。{n}魔法は便利だけど、危険なものだから、{n}それを集中して管理するのがこの学院の目的なの。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0015",
   "jp": "{v:0004}なるほど。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0016",
   "jp": "{v:0005}ここで研究されて{n}新しく見つかった魔法とか技術は、{n}両国に報告されるんだ。{p}{v:0006}そして基本的には学院が許可したもの以外は、{n}外に持ち出してはいけないことになってるの。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0017",
   "jp": "{v:0007}学校というよりは、研究機関だな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0018",
   "jp": "{v:0008}ふふっ、そうだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0019",
   "jp": "{v:0009}それじゃ、中に入ろうか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0020",
   "jp": "魔法学院",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0021",
   "jp": "{v:0028}あれ？{n}あそこ‥‥メルフィさんの他に、誰かいる。{n}ジャスティンさんじゃないみたいだけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0022",
   "jp": "{v:0029}あっ‥‥、一緒にいる人、{n}アメリアさんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0023",
   "jp": "{v:002A}メルフィ、ブレスレットを見せてちょうだい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0024",
   "jp": "‥‥‥{v:002B}。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0025",
   "jp": "{v:002C}うーん、ちょっと金具がゆるんできてるか。{n}今度、しっかりと修理しなくちゃね。{n}他は‥‥うん、大丈夫。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0026",
   "jp": "‥‥{v:002D}アメリアは、もう魔法学院に行ってるの‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0027",
   "jp": "{v:002E}うん、この前からね。{n}ああいう空気は久しぶりだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0028",
   "jp": "{v:002F}そう‥‥。{n}‥‥連中のレベルはわかった？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0029",
   "jp": "{v:0030}正直、私たちの予想を超えてるわね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0030",
   "jp": "{v:0031}だとすると‥‥危険‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0031",
   "jp": "{v:0032}それはもう少し調べてみないと、何とも‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0032",
   "jp": "{v:0033}確かにこの声は、メルフィとアメリアだな。{n}メルフィとアメリアが知り合いだったとは、{n}驚きだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0033",
   "jp": "{FFF6}{v:0034}うん。{n}仲良くしてる人は、{n}ジャスティンさん以外にもいたんだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0034",
   "jp": "{v:0035}メルフィが心を許す人間も、{n}何人かいるってことか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0035",
   "jp": "{v:0036}うーん、今は声かけない方がいいかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0036",
   "jp": "{v:0037}そうだね。{n}水をさしたら悪いし‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0037",
   "jp": "{v:0038}あ、飛んで行っちゃった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0038",
   "jp": "{v:0039}何してたの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0039",
   "jp": "{v:003A}わぁっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0040",
   "jp": "{v:003B}あ、あなたたち、いつから？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0041",
   "jp": "{v:003C}ついさっきだけど？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0042",
   "jp": "{v:003D}そ、そうなんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0043",
   "jp": "{v:00B4}ええと‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0044",
   "jp": "{v:0048}あ、コイツは{s:0000}。{n}ルイセちゃんのお兄さんだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0045",
   "jp": "{v:0049}よろしく。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0046",
   "jp": "{v:003E}アメリアさんって、{n}あのフェザリアンの女の子と{n}知り合いだったんですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0047",
   "jp": "{FB00}{v:003F}ま、まあね。{n}研究を続けてると、色々とね‥‥。{FFFA}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0048",
   "jp": "{v:0040}さて、私は用事があるから、{n}これで失礼するわね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0049",
   "jp": "{v:0041}あからさまに怪しいな。{n}どうやら、オレたちに知られたくない{n}事情がありそうだぜ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0050",
   "jp": "ちょっと、どこへ行く気よ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0051",
   "jp": "{v:000A}お兄さま～っ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0052",
   "jp": "{v:000B}お仕事大変ですね。{n}何かあったら、遠慮なく呼んでくださいね。{p}{v:000C}それじゃ、失礼します。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0053",
   "jp": "{v:000D}何なのかしら、あの娘‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0054",
   "jp": "{v:0069}あ～、楽しかった♪{n}今度はどこ行くの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0055",
   "jp": "{FFF3}{FB00}{FE1E}{FFF4}{v:006A}あのね、ミーシャ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0056",
   "jp": "{v:006B}ちょっと！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0057",
   "jp": "{v:006C}どうしたの、アリオストさん？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0058",
   "jp": "{v:006D}ちょっと、黙って‥‥。{p}{FFF6}{FFF3}‥{FE1E}‥{FE1E}‥{FE1E}‥。{n}{FC02}{FFF7}{FFF4}{v:006E}あれは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0059",
   "jp": "{v:006F}歌声‥‥か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0060",
   "jp": "{v:0070}えっ？{n}何か聞こえるの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0061",
   "jp": "‥‥{v:0071}間違いない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0062",
   "jp": "{v:0072}アリオストさん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0063",
   "jp": "{v:0073}ねぇ、ウォレスさん、何か聞こえるの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0064",
   "jp": "{v:0074}歌声だ。{n}聞こえないか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0065",
   "jp": "{FB00}{v:0075}ウォレスさんって、耳がいいんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0066",
   "jp": "{v:0076}とにかく、行ってみようよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0067",
   "jp": "ここは研究に向いてていいよね～。{n}グローシアン遺跡やフェザリアン遺跡が{n}そばにあるし、水晶鉱山もそこそこ近いし。{p}それにローランディアとバーンシュタインの{n}国境沿いでもあるから、学院の立地条件としては{n}まさに最高って感じだな～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0068",
   "jp": "私は薬学を専攻しているから、{n}メディス村とラシェルにしか、用はないけどね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0069",
   "jp": "この前、効能の研究だって、{n}コムスプリングスへ遊びに行ってなかったっけ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0070",
   "jp": "失礼ね！{n}温泉だって、立派な研究対象よ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0071",
   "jp": "机にかじりつくだけが学問ではないと思うの。{n}やっぱり外に出ていろいろな経験を積まないと。{n}でも、この学院ってば勉強ばっかりで‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0072",
   "jp": "って言うかさ～。{n}魔法の才能がある人間を押し込めて、{n}管理してるんじゃないの？{p}教授とかもさ～、アブナイ奴いるからな～。{n}ま、俺は魔法の勉強が出来ればいいや。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0073",
   "jp": "やっとの思いで、学院に入ったのはいいけど、{n}勉強、勉強の毎日だ‥‥。{n}ああ、青春の日々が過ぎてゆく～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0074",
   "jp": "でも、今は戦争やってるし‥‥。{n}ああ、勉強にも身が入らなくなる～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0075",
   "jp": "でも、今は怪物が暴れてるし‥‥。{n}ああ、勉強にも身が入らなくなる～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0076",
   "jp": "結局は何がしたいのよ、アンタは‥‥[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0077",
   "jp": "ん？{n}君たちはグローシアンなのかい？{p}最近、よく魔法学院にグローシアンが来るものでね。{n}てっきりそうだと思ったんだが、違うようだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0078",
   "jp": "ルイセちゃんはグローシアンだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0079",
   "jp": "そうだったね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0080",
   "jp": "ん？{n}最近、よく見かける顔だな。{n}まさかここの学生じゃないよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0081",
   "jp": "武器が欲しいんだけど、{n}ワンドにするかカードにするか悩むなぁ‥‥。{p}カードは遠くにいる敵に攻撃できるし、{n}ワンドは魔法の威力を強くするし‥‥。{n}ワンドカードなんて売ってないかなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0082",
   "jp": "‥‥{v:0077}小鳥の声がささやくよ。{n}‥‥風の音がささやくよ。{n}‥‥月の光は優しくて‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0083",
   "jp": "{v:0078}すみません！{n}その歌‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0084",
   "jp": "{v:0079}な、何だ。{n}歌の邪魔をしないでくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0085",
   "jp": "{v:007A}その歌をどこで知ったのですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0086",
   "jp": "{v:007B}これかい？{n}北にある{FFEF}保養地ラシェル{FFF1}のそばで{n}野宿をしたときに聞こえてきたんだ。{p}{v:007C}あまりに美しい歌だったので、覚えてしまったよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0087",
   "jp": "{v:007D}{FFEF}ラシェル{FFF1}ですね？{n}ありがとうございます！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0088",
   "jp": "{v:007E}どうしたの、急に？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0089",
   "jp": "{v:007F}今の歌がどうかしたのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0090",
   "jp": "{v:0080}微かだけど、覚えている。{n}あの歌は、僕が幼い頃、母さんが歌ってくれた{n}歌だった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0091",
   "jp": "{v:0081}ってことは、フェザリアンの歌？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0092",
   "jp": "{v:0082}ああ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0093",
   "jp": "うーん、やはりあの歌声にはかなわない。{n}あれほどの歌唱技術、{n}どこで身につけたんだろう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0094",
   "jp": "魔法エフェクトは{FFEE}✕ボタン{FFF1}で早送りが出来て、{n}さらに{FFEE}○ボタン{FFF1}でスキップが可能‥‥。{p}魔法には{FFEF}属性{FFF1}があり、対象の魔法耐性によっては{n}{FFF0}攻撃魔法で、より多くのダメージを与える{FFF1}{n}{FFF0}攻撃魔法を吸収し、ＨＰを回復させる{FFF1}などがある。{p}例をあげると、ヘルハウンドに炎属性の魔法は厳禁。{n}逆にアンデッドには炎属性が有効‥‥‥。{p}‥‥はあ、魔導書の丸暗記だけは出来るんだけどなぁ。{n}いざ戦闘となると忘れちゃうんだろうなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0095",
   "jp": "俺って卒業できるのかな～？{n}村では１番だったけど、入ってみると{n}すごい奴ばっかりだし。{p}‥‥すっかり自信なくしたよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0096",
   "jp": "俺って卒業できるのかな～？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0097",
   "jp": "とうとう戦乱の世の中になってしまったか‥‥。{n}魔法学院で培ってきた力が役に立てばいいんだけど。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0098",
   "jp": "僕たち一般の魔法使いが、{n}ここまで魔法を使えるのは、水晶鉱山から発掘される{n}魔水晶を用いて作られた魔道具があるからなんだ。{p}‥‥まあ、魔道具を持ったところでグローシアンの{n}魔力には到底かなわないけどね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0099",
   "jp": "グランシルの闘技大会は魔法使いが出てもいいんだ。{n}攻撃魔法には自信があるから、優勝賞品の{n}コムスプリングス旅行を狙ってみたいけどな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0100",
   "jp": "え？闘技大会はもう終わっちゃった？{n}それで、君たちが優勝した？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0101",
   "jp": "‥‥はあ、僕も出てみたかったなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0102",
   "jp": "でも、こう試験に追われる毎日じゃ、{n}闘技大会どころじゃないよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0103",
   "jp": "あ～あ‥‥戦争か～。{n}まぁ、巻き込まれなきゃ別にいいや。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0104",
   "jp": "ちょっと、もう少しまじめに考えなさいよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0105",
   "jp": "別に僕たちが戦うわけじゃないんだから、{n}そんなに硬くなることもないだろ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0106",
   "jp": "ううぅ‥‥だらけてるわ、コイツ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0107",
   "jp": "あ～あ‥‥もっと魔水晶が手に入らないかな。{n}水晶鉱山がもっと発見されれば、{n}こんな悩みは解消されるんだけどな～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0108",
   "jp": "僕もグランシルの闘技大会に出場して{n}ドカーンと‥‥{FE1E}予選落ちするんだろうな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0109",
   "jp": "あ、君たちが優勝したんだ‥‥。{n}よかった、出なくて‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0110",
   "jp": "アリオストさん？{n}ついさっき学院の外へ出ていったよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0111",
   "jp": "アリオストさん？{n}さっき図書室で見たかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0112",
   "jp": "ここって娯楽が少ないんだよね。{n}早くグランシルに帰りたいよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0113",
   "jp": "私は装備品の行商をしております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0114",
   "jp": "お買い求めですか？{n}それともご売却ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0115",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen024.0116",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen024.0117",
   "jp": "他にもご用はおありですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0118",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen024.0119",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen024.0120",
   "jp": "またのお越しをお待ちしております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0121",
   "jp": "{v:003F}ったく、ヒドイ目にあったわ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0122",
   "jp": "{v:0040}学院長って、どんな人なんだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0123",
   "jp": "{v:0041}マクスウェル学院長？{n}悪い人じゃないんだけど、{n}ちょっと研究熱心っていうか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0124",
   "jp": "{v:0042}なるほどな。{p}{v:0043}で、どんな研究をしているんだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0125",
   "jp": "{v:0044}いろいろ手広く研究してきたみたいだけど、{n}メインは『グローシュと通常魔力の差違について』{FFF9}{FFFB}{n}{v:0045}だったかな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0126",
   "jp": "{v:0046}ふ～ん、グローシュねぇ‥‥。{p}{FC00}{v:0047}ルイセちゃんも研究材料にされないよう、{n}注意しなきゃね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0127",
   "jp": "{v:0048}えっ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0128",
   "jp": "{v:0049}さっきのアタシみたく捕まって、{n}あんな事やこんな事‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0129",
   "jp": "{FFF5}‥‥{v:004A}うぅ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0130",
   "jp": "{v:004B}おまけにそんな事までされちゃったり‥‥。{FFF9}{FFFB}{n}{v:004C}うわ～、悲惨よね～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0131",
   "jp": "{FFF5}‥{v:004D}うぅぅ‥‥‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0132",
   "jp": "{v:004E}おい、ルイセ泣きそうになってるぞ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0133",
   "jp": "{v:004F}あ、ごめん、ルイセちゃん。{n}大丈夫、そんなことないって！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0134",
   "jp": "{FFF5}{v:0050}う‥うん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0135",
   "jp": "{v:0051}それにしても、アンタ、本当に泣き虫ね～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0136",
   "jp": "{FFF5}‥‥{v:0052}うっ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0137",
   "jp": "{v:0059}アメリアさん、研究ははかどってますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0138",
   "jp": "{v:005A}あら、あなたたち頑張ってるみたいね。{n}色々哮を聞くわよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0139",
   "jp": "{v:005B}えへへへっ★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0140",
   "jp": "{v:005C}アメリアさんの方はどうですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0141",
   "jp": "{v:005D}ああ、私ねぇ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0142",
   "jp": "{v:005E}時空の歪みについて調べているというのは、{n}前に聞きましたけど、よかったら詳しく{n}聞かせてくれませんか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0143",
   "jp": "{v:00B8}よかったら詳しく{n}聞かせてくれませんか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0144",
   "jp": "{v:005F}そうね。{n}じゃあ、ちょっとだけ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0145",
   "jp": "{v:0060}わーーい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0146",
   "jp": "{v:0061}私たちの暮らすこの世界は、全く別の世界と、{n}元の世界の一部を重ねることで成り立っているのは{n}知っているわよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0147",
   "jp": "・いいえ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen024.0148",
   "jp": "・はい",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen024.0149",
   "jp": "{v:0062}そうなんだ。{n}それじゃ、これを機に覚えておいてね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0150",
   "jp": "{v:0063}この時空を重ねることを時空融合と{n}呼ぶのよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0151",
   "jp": "{v:0064}時空融合‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0152",
   "jp": "{v:0065}この時空融合が解けてしまうと、{n}この世界の人々は旧世界に引き戻されて{n}しまうわけだけど‥‥。{p}{v:0066}その前に様々な異変が起こることが、{n}今まで観測されてるわ。{p}{FC02}{v:0067}その異変を抑えることが出来なければ、{n}この世界の人々は遠からず滅びてしまうかも{n}しれない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0153",
   "jp": "{v:0068}ほ、滅びる！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0154",
   "jp": "{v:0069}その昔、グローシアンがこの世界を支配していた{n}時代があるわね。{n}その頃にもこの異変の抑え方を研究していたようなの。{p}{FC02}{v:006A}だから時空の歪みが大きくなりつつある今、{n}この研究はもっとも重要な事のハズよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0155",
   "jp": "{v:00B5}おかげで学院長からすぐに許可を{n}もらえたワケなんだけどね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0156",
   "jp": "・頑張って下さい",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen024.0157",
   "jp": "・何も言わない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen024.0158",
   "jp": "‥‥{v:006B}うん、頑張るわ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0159",
   "jp": "{v:006C}それは重要ですね。{n}私も卒業できたら、みんなのためになる{n}そんな研究がしたいです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0160",
   "jp": "{v:006D}あはは‥‥なんか、照れるわ‥‥。{n}とにかく、頑張るね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0161",
   "jp": "とにかく、頑張るね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0162",
   "jp": "今、ホールの方にグローシアンが沢山いるんだ。{n}あの人たちに教われば、俺も強くなれるな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0163",
   "jp": "強さってのは、{n}そういうことで身に付くもんじゃねぇだろう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0164",
   "jp": "俺もフェザリアンみたいな羽根が欲しいな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0165",
   "jp": "アタシみたいな♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0166",
   "jp": "やっぱり‥‥遠慮しておくよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0167",
   "jp": "どーいう意味よ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0168",
   "jp": "俺もグローシアンに生まれていればな‥‥。{n}きっと試験もレポートも楽勝なのに。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0169",
   "jp": "えっと‥‥[01BE]{n}試験やレポートには関係ないと思うんだけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0170",
   "jp": "あ、お兄さま。{n}アタシの力が必要なんですね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0171",
   "jp": "どうするの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0172",
   "jp": "・ミーシャをメンバーに加える",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen024.0173",
   "jp": "・今はメンバーに加えない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen024.0174",
   "jp": "でもこれ以上は多すぎるよ。{n}誰かを仲間から外さないと。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0175",
   "jp": "誰をメンバーから外しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0176",
   "jp": "・{s:FFED}",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen024.0177",
   "jp": "・{s:FFEE}",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen024.0178",
   "jp": "{s:FFED}の装備を回収しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0179",
   "jp": "　{n}　　　　　　{FFEF}ミーシャが仲間になった！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0180",
   "jp": "アタシ、がんばっちゃうね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0181",
   "jp": "そうですか‥‥。{n}ちょっとガッカリ‥‥。{p}{FC00}でも、でも！{n}ご用があったら、いつでもどうぞ！{n}アタシ、がんばりますから！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0182",
   "jp": "でね、その子が‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0183",
   "jp": "うそ～？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0184",
   "jp": "あたしも聞いたよ。{n}それでさ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0185",
   "jp": "で、その先生がかっこいいのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0186",
   "jp": "そうなんだ？{n}あたしも魔法教育論、受けてみようかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0187",
   "jp": "なーに、言ってるの。{n}あんたはアリオストさま一筋なんでしょ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0188",
   "jp": "あの方は特別よ！{n}あたしたちがどうこうできる人じゃないわ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0189",
   "jp": "頭が良くてかっこいい上に、優しいなんて‥‥。{n}魔法バカばかりのこの学院では奇跡的な存在だわ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0190",
   "jp": "そうよね‥‥。{n}アリオストさま素敵！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0191",
   "jp": "{v:000E}ここにはグローシアンの方々が保護されて{n}おられるのだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0192",
   "jp": "立入許可の無い者は、{n}この中へ入ることはできん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0193",
   "jp": "内側からカギをかけられているようだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0194",
   "jp": "アリオストさん、質問が！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0195",
   "jp": "今は忙しいから後にしてくれないかな？{n}すまないね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0196",
   "jp": "後でって‥‥、{n}最近、研究室にいることないじゃないですか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0197",
   "jp": "あはは‥‥[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0198",
   "jp": "実技だと集中力が続かないんだよね。{n}２、３回ならそこそこの魔力が出せるのに‥‥。{p}部屋で魔導書ばっかり読んでいてもダメか‥‥。{n}ちゃんと実践トレーニングしないと、{n}精神力はつかないみたいだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0199",
   "jp": "うーん‥‥。{p}バーンシュタインにはインペリアル・ナイツが‥‥、{n}ローランディアにはすごい勢いで昇進してる騎士が{n}いるっていうし‥‥。{p}どうなるんだ、この戦争は‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0200",
   "jp": "うーん、フェザリアンの飛行法を魔力で‥‥{n}‥‥しかしそれには問題が‥‥ブツブツ。{n}でも、理論的にはなあ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0201",
   "jp": "我ながら、いい仕事じゃ。{n}しかしここ最近、仕事が減ってのぉ‥‥。{n}はぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0202",
   "jp": "へんな人。{n}あんな鉄柱見てて、楽しいのかしら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0203",
   "jp": "だ、誰じゃ？{n}ワシの新型送魔線にケチをつける奴は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0204",
   "jp": "ご、ごめんなさい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0205",
   "jp": "ティピ、ダメよそんなこと言っちゃ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0206",
   "jp": "おお、ルイセ君か？{n}その変な虫は、サンドラ先生が造ったのかね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0207",
   "jp": "虫？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0208",
   "jp": "送魔線も知らんような奴は、{n}虫で十分じゃ！{p}そもそも、グローシュという言葉自体、{n}知っておるのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0209",
   "jp": "ふっふっふっ！{n}グローシュくらい知ってるわよ。{n}この『ふわふわぴかぴか』のことでしょ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0210",
   "jp": "ほほう‥‥。{n}ではなぜ、地域によってグローシュの量が異なるか{n}知っておるか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0211",
   "jp": "{FB00}うっ‥‥。{n}‥‥何だっけ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0212",
   "jp": "あのね、ティピ。{n}実はこの世界はとっても不安定な時空に{n}存在しているんだって。{p}正確には２つの時空が重なっているんだけど、{n}そっちの詳しい説明はまた今度ね。{p}それで、２つの時空の隙間が大きい場所は、{n}その隙間から魔法のエネルギーである{n}グローシュが流れ込んで来る量が多いんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0213",
   "jp": "それじゃ、グローシュがいっぱいある場所って、{n}危ないんじゃない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0214",
   "jp": "まぁ、そうじゃな。{p}この辺りでは、北に行くほどグローシュが多く、{n}南に行くほどグローシュが少ない。{n}つまり北ほど時空の狭間が大きいということじゃ。{p}そしてその隙間は、同じ場所でも微妙に変化する。{n}つまりグローシュの量も、{n}わずかだが日によって違うのじゃ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0215",
   "jp": "ふ～ん、面白かった。{n}じゃあね、おじさん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0216",
   "jp": "ちょ、ちょっと待て！{n}この送魔線の話を聞かんでいいのか？{n}な、中身の回路が新型なんじゃぞ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0217",
   "jp": "どうする、このオヤジ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0218",
   "jp": "・話を聞く",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen024.0219",
   "jp": "・聞かない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen024.0220",
   "jp": "このグローシュとは、{n}実は純粋な魔力エネルギーでな。{n}とっても貴重な物なのじゃ。{p}それで、このグローシュを集めて、{n}必要な場所へ送る装置が、{n}この『{FFEF}送魔線{FFF1}』というわけじゃ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0221",
   "jp": "そんなの集めてどうするの？{n}食べられないし。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0222",
   "jp": "魔法機械を動かすのに使われるんだよ。{n}ここの研究室以外にも{n}お母さんの実験装置なんかにも使ってるよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0223",
   "jp": "グローシュを溜めておける方法は、{n}サンドラ先生が研究しておったりするが‥‥。{p}今の所はこうやって送魔線で集め続けるしかない。{n}だから、この送魔線の設置場所、{n}その中身の回路の出来がじゃな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0224",
   "jp": "うん、うん、凄い凄い。{n}だからもう説明いらない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0225",
   "jp": "こ、これじゃから最近の若いもんは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0226",
   "jp": "ひ、ひどい‥‥。{n}これがあるおかげで、グローシュを集めて{n}魔法機械が動かせるのに‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0227",
   "jp": "アリオストの研究室",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0228",
   "jp": "{v:000A}失礼します。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0229",
   "jp": "{v:000B}やぁ、いらっしゃい。{p}{v:000C}いったいどうしたのかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0230",
   "jp": "{v:000D}アリオストさん、今、暇ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0231",
   "jp": "{v:000E}今？{n}今はマジックタイム停止装置の調整を{n}していただけだけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0232",
   "jp": "{v:000F}それじゃさ～。{n}コムスプリングスへ行こうよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0233",
   "jp": "{v:0010}どうやって行くんだい？{n}あそこはバーンシュタイン国内だよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0234",
   "jp": "{v:0011}それなら心配ない。{p}{v:0012}こいつら、闘技大会で優勝したからな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0235",
   "jp": "{v:0013}優勝だって？{p}{v:0014}これは驚いた‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0236",
   "jp": "{v:0015}その賞品がコムスプリングスへの旅券なんです。{n}一緒に行きませんか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0237",
   "jp": "{v:0016}ありがとう。{n}感謝するよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0238",
   "jp": "　{n}　　　　　{FFEF}アリオストが仲間になった！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0239",
   "jp": "{v:0071}やあ、君たち。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0240",
   "jp": "{v:0072}アリオストさん、どこかへ行くところだったんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0241",
   "jp": "{v:0073}ああ、ちょっと、学院長に呼ばれてね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0242",
   "jp": "{v:0075}ああ、そうだ。{n}君たちに話すことがあったんだ。{p}{v:0076}その前に一緒に学院長の所へつきあってくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0243",
   "jp": "　{n}　　　　　{FFEF}アリオストが同行者になった！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0244",
   "jp": "こんにちは。{n}アリオストさん、いらっしゃいますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0245",
   "jp": "いないみたいだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0246",
   "jp": "さっき、あの子が出かけたと言っていただろうが。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0247",
   "jp": "ああ、南の遺跡に行ったんだっけ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0248",
   "jp": "どこ行っちゃったんだろ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0249",
   "jp": "いろいろ探し回るしかないわね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0250",
   "jp": "{v:006D}ちょっと待っててくれ。{n}今、飛行装置に推進器を組み込むから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0251",
   "jp": "{v:006E}ふ～ん。{p}{v:006F}それがあれば空を飛べるの？{FFF9}{FFFB}{n}‥‥{v:0070}って、アタシは飛んでるけどね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0252",
   "jp": "{v:0071}動力は水晶のエネルギーを使う。{p}{v:0072}この中に浮遊円盤を６枚格納していてね、{n}それが力場を形成することで{n}この装置を浮かせることが出来る。{p}{v:0073}エネルギーの量を調整すれば、{n}高さを自在に変えることが出来るんだけど、{n}さっきも話した通り、風任せで流されるしかないんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0253",
   "jp": "{v:0074}それで推進器が必要なのか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0254",
   "jp": "{v:0075}そう。{n}それほど力があるわけじゃないから、{n}船や馬車を進ませたりは出来ないけどね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0255",
   "jp": "{v:0076}しかし、すでに宙に浮いているものなら{n}比較的小さな力で移動させることが出来る。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0256",
   "jp": "{v:0077}この小さな推進器でも十分なんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0257",
   "jp": "{v:0078}ねぇ、ねぇ。{n}難しい話はいいからさぁ。{n}まだかかるの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0258",
   "jp": "{v:0079}ああ、もうちょっと‥‥ここをつなげば‥‥{n}‥‥よし、完成だ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0259",
   "jp": "{v:007A}おめでとうございます、アリオストさん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0260",
   "jp": "{v:007B}これでマスターが助かるんだね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0261",
   "jp": "{v:007C}うん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0262",
   "jp": "{v:007D}さて、まずは試運転を‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0263",
   "jp": "{v:007E}ワクワクするね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0264",
   "jp": "{v:007F}うん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0265",
   "jp": "{v:0080}お、おい、これでいいのかよ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0266",
   "jp": "{v:0081}きゃあっ！{n}お兄ちゃ～ん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0267",
   "jp": "{v:0082}ああ、しまった！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0268",
   "jp": "{v:0083}ごめん、ごめん。{n}回路を逆につないでいたよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0269",
   "jp": "{v:0084}ほら、これでもう大丈夫。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0270",
   "jp": "{FB00}{v:0085}だ、大丈夫って‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0271",
   "jp": "{v:0086}本番では大丈夫だよ。{n}心配いらないって。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0272",
   "jp": "{FFF5}{FFF3}‥‥{v:0087}う～‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0273",
   "jp": "アリオストとフェザーランドへ",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0274",
   "jp": "{v:0088}ま、とにかく、西の岬に行こうか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0275",
   "jp": "アリオストとブローニュ村へ",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0276",
   "jp": "{v:0088}ま、とにかく、西の岬に行こうか。{p}‥‥{v:0089}と、その前に村に寄っていいかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0277",
   "jp": "{v:008A}村？{n}どこの村だ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0278",
   "jp": "{v:008B}ブローニュ村。{n}僕の生まれ育った村だよ。{p}{v:008C}ここからすぐ西に行ったところだし、通り道だから。{n}そこに寄って欲しいんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0279",
   "jp": "{v:0023}やあ、来たね。{n}楽にしてくれていいよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0280",
   "jp": "{v:0059}ところで君たちの調べたことを教えてくれないか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0281",
   "jp": "{v:005A}フェザリアンのことを研究している人が{n}わかったんだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0282",
   "jp": "{v:005B}ええと、著者は『ダニー・グレイズ』{n}住所は『コムスプリングス』だって。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0283",
   "jp": "{v:005C}そいつに会えば、もっと詳しいことが{n}わかるんじゃないかと思うんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0284",
   "jp": "{v:005D}コムスプリングスか。{n}隣の国の温泉街だね。{p}{FC00}{v:0061}あれ？{n}そういえば、コムスプリングスへの旅行の話を{n}どこかで聞いたような気がするな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0285",
   "jp": "{v:0061}あれ？{n}そういえば、コムスプリングスへの旅行の話を{n}どこかで聞いたような気がするな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0286",
   "jp": "ん？{n}僕の力が必要なのかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0287",
   "jp": "アリオストを仲間に加えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0288",
   "jp": "{v:0015}でもこれ以上は多すぎるよ。{n}誰かを仲間から外さないと。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0289",
   "jp": "{v:0016}ありがとう、がんばるよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0290",
   "jp": "そうかい。{n}僕の力が必要になったら、{n}いつでも声をかけてくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0291",
   "jp": "僕は、僕なりに、{n}フェザリアンを納得させる方法を考えてみるよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0292",
   "jp": "多目的ホール",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen024.0293",
   "jp": "あのね、お兄ちゃん。{n}学院の施設内で大きな魔法を使うと、{n}怒られちゃうんだ‥‥。",
   "en": "",
   "term": "end"
  }
 ]
}
