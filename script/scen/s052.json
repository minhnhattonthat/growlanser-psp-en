  {
   "id": "scen052.0001",
   "jp": "ランザック兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen052.0002",
   "jp": "店主",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen052.0003",
   "jp": "店員",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen052.0004",
   "jp": "市民",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen052.0005",
   "jp": "オヤジ",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen052.0006",
   "jp": "ランザック城門番",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen052.0007",
   "jp": "フェザリアン",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen052.0008",
   "jp": "ランザック王都",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0009",
   "jp": "どこへ行こうってのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0010",
   "jp": "ここは{FFEF}ランザック王都{FFF1}だ。{n}変な騒ぎは起こすなよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0011",
   "jp": "ちょっと、勝手にそっちへ行かれちゃ困るよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0012",
   "jp": "いらっしゃいませ。{n}１泊、{FFEB}エルムになりますが？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0013",
   "jp": "ありがとうございました。{n}気を付けて行ってらっしゃいませ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0014",
   "jp": "お客さま‥‥[01BE]{n}お金が足りないみたいですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0015",
   "jp": "またのお越しをお待ちしております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0016",
   "jp": "{FFF6}{v:0004}{FFF2}きゃっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0017",
   "jp": "{v:0005}くっ！{n}何だ、今の音は！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0018",
   "jp": "{v:0006}地震？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0019",
   "jp": "‥‥{v:0007}今‥魔力の波動がした‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0020",
   "jp": "‥‥{v:0008}ああ、嫌な胸騒ぎが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0021",
   "jp": "{v:0009}たしかに魔力波だった。{n}しかも、考えられないくらい巨大な‥‥。{p}{v:000A}急ごう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0022",
   "jp": "{v:000B}うん‥‥魔力だった‥‥。{p}{v:000C}でもどうやったら、こんなに大きな魔力をだせるの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0023",
   "jp": "{v:000D}チッ！{n}急いだ方が良さそうだな！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0024",
   "jp": "ん‥‥？{p}{FC04}ああ、キミたちか。誰かと思ったよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0025",
   "jp": "こんにちは！{n}ジャスティンさん、お買い物中？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0026",
   "jp": "メルフィに何かお土産でも‥‥、と思ってね。{n}{FFFB}最近、色々と僕が忙しかったせいで彼女を{n}１人にしてしまっていたから、そのおわびさ。{p}{FC03}だけど、メルフィはあまり物を欲しがらないから、{n}こういう時どうすればいいのか悩んでしまうよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0027",
   "jp": "あの子のご機嫌取りも大変そうね～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0028",
   "jp": "まぁ、僕が好きで買ってるだけなんだけどね。{p}{FC00}今日も、つい色々と買いすぎてしまったよ。{n}これだけの量を持って帰るのは、{n}さすがに大変そうだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0029",
   "jp": "あはは。{p}メルフィさんとは、{n}どこで待ち合わせてるんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0030",
   "jp": "彼女の両親のお墓の前だよ。{p}フェザリアンであるメルフィが落ち着ける場所は、{n}残念ながら地上にはあまりないからね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0031",
   "jp": "そっか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0032",
   "jp": "そう言えば最近、{n}メルフィがよくキミたちの話をするよ。{p}{FC04}あのメルフィが他の人間の話をするなんて、{n}相当めずらしいことなんだ。{n}きっと、キミたちには心を許してきてるんだね。{p}{FC00}よかったら、{n}これからもメルフィと仲良くしてやってくれ。{n}頼むよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0033",
   "jp": "もちろんです！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0034",
   "jp": "ありがとう。{p}それじゃ、メルフィが待っているから{n}僕はこれで失礼するよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0035",
   "jp": "メルフィさんが、わたしたちに心を{n}許し始めてくれてるなんて嬉しい‥‥。{p}{FC03}時間があるときでいいから、{n}またメルフィさんに会いに行きたいな。{n}{FFFB}お兄ちゃん、よかったら考えておいてね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0036",
   "jp": "{v:001A}おう、いらっしゃい。{n}ここは道具を売ってる店だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0037",
   "jp": "{v:001B}買いに来たのか？{n}それとも何か売る気か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0038",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen052.0039",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen052.0040",
   "jp": "まだ何か用か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0041",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen052.0042",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen052.0043",
   "jp": "{v:0025}じゃあな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0044",
   "jp": "{v:003F}まぁ、いらっしゃい。{n}このお店は、どんな装備品でもそろってるわよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0045",
   "jp": "{v:0041}それで、買いに来たの？{n}売りに来たの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0046",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen052.0047",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen052.0048",
   "jp": "で、他にも何かある？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0049",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen052.0050",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen052.0051",
   "jp": "{v:004B}また来てよね。{n}素敵な笑顔で待ってるから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0052",
   "jp": "{v:0032}いらっしゃいませ。{n}この店では、様々な装備品をお買い求めいただけます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0053",
   "jp": "{v:0034}本日はお買い求めですか？{n}それともご売却ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0054",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen052.0055",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen052.0056",
   "jp": "他にも何かおありでしょうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0057",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen052.0058",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen052.0059",
   "jp": "{v:003E}ありがとうございました！{n}またどうぞ、お越し下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0060",
   "jp": "お客様、申し訳ありません。{n}戦争のためにこちらへの納品が遅れて{n}お売りできるような商品がないんです。{p}できるだけ早く取り寄せますので、{n}もうしばらくお待ち下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0061",
   "jp": "ここはローランディアやバーンシュタインと{n}比べると、何もないけど、{n}私はとても気に入っているの。{p}あなた達もじっくり見てみればわかるわ。{n}ここの素晴らしさが。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0062",
   "jp": "ウェーバー将軍って、すごい怪力の持ち主だけど{n}優しい人なんだぜ。{n}いや、豪快って感じかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0063",
   "jp": "まったく‥‥。{n}なんで俺たち一般市民が、{n}戦争なんかに巻き込まれなきゃいけないんだ？{p}逃げるにしても、{n}何処もここと同じような状況だろうし‥‥。{p}はあ、どうするかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0064",
   "jp": "最近、軍の動きが活発なんだよなぁ。{n}何かあったのかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0065",
   "jp": "何か外が慌ただしいみたいだけど、{n}ここにはウェーバー将軍がいるんだから、{n}きっと大丈夫よ♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0066",
   "jp": "はぁ～。{n}今日も暑いわねぇ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0067",
   "jp": "ここから先は通行禁止だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0068",
   "jp": "お城が、お城が‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0069",
   "jp": "な、何なの、あの音は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0070",
   "jp": "何なんだ、一体‥‥。{n}俺たち人間じゃ、どうしようもないっていうのか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0071",
   "jp": "凄い衝撃が来たが‥‥。{n}城に何かあったのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0072",
   "jp": "あんた達、魔法使える？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0073",
   "jp": "あ、うん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0074",
   "jp": "それじゃ、聞きたいんだけど、{n}魔法使いと戦士が力比べしたらどっちが勝つ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0075",
   "jp": "{FFF3}う～ん‥‥。{n}{FFF4}お兄ちゃんは魔法も使えるけど、強いし‥‥。{n}いちがいには言えないなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0076",
   "jp": "純粋に力比べだけなら、{n}体を鍛えている戦士の方が勝ちそうなものだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0077",
   "jp": "それで？{n}いったい、どうしたのよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0078",
   "jp": "{v:0032}いかにも魔法使いって感じの男がやって来てね。{n}この街の衛兵と戦ったんだ。{p}{v:0033}そいつは魔法使いのくせに、めっぽう腕っ節が強くて、{n}衛兵はあっという間に殺されちゃったんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0079",
   "jp": "{v:0034}衛兵が殺された？{n}そいつはどこに行ったんだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0080",
   "jp": "{v:0035}ウェーバー将軍に追われて、{n}北西の森の方へ行ったけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0081",
   "jp": "{v:0036}ウェーバーがっ？{p}{v:0037}奴だ！{n}ヴェンツェルに違いない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0082",
   "jp": "{v:0038}急ぎましょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0083",
   "jp": "ヴェンツェルって、いったい何者なんだ‥‥。{n}何であんな事ができるんだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0084",
   "jp": "頭が混乱しちゃって、{n}何が何だかわからなくなってきたわ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0085",
   "jp": "まさか、城が無くなるなんて‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0086",
   "jp": "お城の方でスゴイ音がしたんだ！{n}ど、どうしよう！？{n}様子を見に行った方がいいのかな？{p}でも、持ち場を離れるわけにはいかないし‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0087",
   "jp": "今はそんな時じゃないでしょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0088",
   "jp": "悪いな。{n}今、身支度の途中なんだ。{p}何処か行くのかって？{n}決まってるだろ、何処か安全なところさ。{p}‥‥そんな所があるかどうかはわからないけどな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0089",
   "jp": "何で昼間からゴロゴロしてるのかって？{n}俺の仕事は王城の夜警なんだよ。{n}わかったか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0090",
   "jp": "鍵がかかっている。{n}どうやら留守のようだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0091",
   "jp": "城の方から、すごい音がしたのだが‥‥。{n}何があったんだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0092",
   "jp": "たった一撃で城を崩壊させるなんて‥‥。{n}そんな奴相手じゃ、どうしようもない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0093",
   "jp": "ウェーバー将軍ってさ、昔は凄腕の傭兵だったんだぜ。{n}それであそこまで出世するってんだから、{n}その頃から人望もあったんだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0094",
   "jp": "へい、らっしゃい。{n}スキマ屋へようこそ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0095",
   "jp": "まいどありぃ～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0096",
   "jp": "ランザック城、か‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0097",
   "jp": "あれ？{n}{FFFB}ねぇ、あそこにジャスティンさんがいるよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0098",
   "jp": "キミたち‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0099",
   "jp": "やぁ、久しぶりだね。{n}元気だったかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0100",
   "jp": "こんにちは、ジャスティンさん。{n}こんな所で会えるなんて偶然ですね。{p}ランザック城に何かご用があるんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0101",
   "jp": "いや、城に用はないんだ。{n}{FFFB}探し物をして歩き回っていたら、{n}ここにたどり着いてしまったというかね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0102",
   "jp": "‥‥えっ！？{n}{FFFB}もしかして、何か落としちゃったんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0103",
   "jp": "ああ、大したことじゃないんだ。{n}こちらのことは気にしないでくれ。{p}{FC00}キミたちとゆっくり話したいところだけど、{n}こちらも時間があまりなくてね。{n}悪いが、僕はそろそろ失礼するよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0104",
   "jp": "ジャスティンさん、忙しそうだね。{n}普段、何してる人なんだろ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0105",
   "jp": "今まで気にしたことはなかったが、{n}確かに俺たちはあいつの素性を{n}よく知らないな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0106",
   "jp": "ジャスティンさんやメルフィさんのこと、{n}これからもっと知っていけたらいいね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0107",
   "jp": "ここはランザック城だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0108",
   "jp": "{v:0000}止まれ！{n}身分のわからぬものは中へ入れるわけにはいかん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0109",
   "jp": "{v:0001}これは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0110",
   "jp": "{v:0002}我々はローランディア王国からの使者だ。{p}{v:0003}ここにアルカディウス王がしたためた書簡がある。{n}これをランザック国王に渡し、{n}説明をするのが我々の役目だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0111",
   "jp": "　{n}『{FFEF}ゲヴェルへの注意を促す書簡{FFF1}』を門番に渡した。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0112",
   "jp": "　{n}　　　『{FFEF}同盟要請の書簡{FFF1}』を門番に渡した。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0113",
   "jp": "{v:000A}それにアタシ達、前にも来たんだけど？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0114",
   "jp": "{v:000B}そうだったな。{n}ちょっと待て。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0115",
   "jp": "{v:0004}では、今しばらく待たれよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0116",
   "jp": "{v:0005}国王陛下がお会いになられるそうだ。{n}入られよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0117",
   "jp": "用件が終わったなら、速やかに立ち去られよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0118",
   "jp": "いったい、何のようだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0119",
   "jp": "王様か将軍に会いたいんだけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0120",
   "jp": "ん？{n}その妖精は‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0121",
   "jp": "あぁ、ローランディアの使者か。{n}王はお忙しいので、面会は無理だな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0122",
   "jp": "ウェーバー将軍だったら、{n}見回りに出ているはずだ。{n}しばらくしてから、来ればいいだろう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0123",
   "jp": "仕方ない。{n}少し時間をつぶしてから、また来よう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0124",
   "jp": "うん‥‥。{n}さっきの洞窟も気になるし‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0125",
   "jp": "用のない者を通すわけにはいかぬ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0126",
   "jp": "{v:000E}お、おい‥マジかよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0127",
   "jp": "{v:000F}こ、こんなことが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0128",
   "jp": "{v:0010}城が‥無くなってる‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0129",
   "jp": "{v:0011}お城も‥何もかも‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0130",
   "jp": "{v:0012}‥‥すさまじいな。{n}これを奴がやったのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0131",
   "jp": "‥{v:0013}ひどい‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0132",
   "jp": "{v:0014}‥‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0133",
   "jp": "{v:0015}ウェーバー‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0134",
   "jp": "{v:0016}城には国王陛下がいた‥‥。{n}多くの部下がいた‥‥。{p}{v:0017}魔法を教えてやるから、かくまってくれなどと言って、{n}恩を仇で返すとは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0135",
   "jp": "{v:0018}許せん！{n}ヴェンツェル！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0136",
   "jp": "{v:0019}おい、ウェーバー！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0137",
   "jp": "{v:001A}行っちゃった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0138",
   "jp": "‥‥{v:001B}でも、どうやったら、こんな事が出来るの？{n}もしわたしがグローシュを全て解放したって、{n}こんなの無理だよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0139",
   "jp": "{v:001C}あいつが予告をしてからここへ来るまでだって、{n}そんなに経っていないはずだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0140",
   "jp": "{v:001D}考えられるのはあの時の魔力波。{n}あの一撃で、ランザック王国の王城は消し飛んだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0141",
   "jp": "{v:001E}それじゃ、さっき感じた魔力？{p}{v:001F}でもあれ、１回きりだよ？{n}それでお城が消えちゃったの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0142",
   "jp": "{v:0020}さっき感じた、{n}たった１度の魔力だけでこんなになっちゃうの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0143",
   "jp": "{v:0021}ちょっと、冗談じゃないわよ！{n}そんな奴相手に、どうやって戦えっていうのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0144",
   "jp": "{v:0022}やはりここにいたか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0145",
   "jp": "{v:0023}あ、アンタ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0146",
   "jp": "{v:0024}女王陛下が話があるそうだ。{n}すぐに来て欲しいと。{p}{v:0026}それから、アリオストという人間はいるか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0147",
   "jp": "{v:0027}僕ですが？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0148",
   "jp": "{v:0028}お前がそうか。お前も必ず来いとのことだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0149",
   "jp": "{v:0029}僕も‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0150",
   "jp": "{v:002A}今は一緒じゃないけど？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0151",
   "jp": "{v:002B}ならば、そいつも連れてきてくれとのことだ。{p}{v:002D}では、伝えたからな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0152",
   "jp": "{v:0030}いったい何の用だろう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0153",
   "jp": "{v:002F}とにかく行ってみようぜ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0154",
   "jp": "{v:0031}それじゃ、悪いけど、ルイセちゃん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0155",
   "jp": "{v:0032}うん。{n}いくよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0156",
   "jp": "{v:002E}いったい何かしらね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0157",
   "jp": "{v:0033}その前にアリオストさんを連れてこないとね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0158",
   "jp": "{v:0034}アリオストさん、{n}まだバーンシュタイン王城にいるかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0159",
   "jp": "{v:000B}‥‥っと！{n}とうちゃく★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0160",
   "jp": "{v:000C}やっぱり便利よねぇ、テレポートの魔法って！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0161",
   "jp": "{v:000D}バーンシュタイン軍も、まだここまでは{n}来てないみたいね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0162",
   "jp": "{v:000E}和んでいる場合じゃない。{n}見ろ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0163",
   "jp": "{v:000F}どうやら先回り出来たようだが、{n}この様子じゃ、敵はすぐそばだ。{n}安心していられんぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0164",
   "jp": "{v:0010}そうですね。{n}急ぎましょう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0165",
   "jp": "{v:0011}ああ。{n}急いだ方がよさそうだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0166",
   "jp": "{v:0012}急ぎましょう、お兄さま！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0167",
   "jp": "‥‥{v:0000}ふぅっ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0168",
   "jp": "{v:0002}陛下！{n}今、参ります！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0169",
   "jp": "{v:0003}よし、俺たちも急ぐぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0170",
   "jp": "ここより先、許可の無い者は通せません。{n}お引き取り下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0171",
   "jp": "ウェーバー将軍と顔見知りとは、{n}正直いって、驚いたよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0172",
   "jp": "{v:0001}どうしたんだ、ウォレス。{n}陛下に用か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0173",
   "jp": "{v:0002}ちょうど良かった。{n}お前に話したいことがある。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0174",
   "jp": "‥‥{v:0003}何だ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0175",
   "jp": "{v:0004}こいつの顔に見覚えがないか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0176",
   "jp": "{v:0005}えっと‥‥初めまして。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0177",
   "jp": "{v:0006}バーンシュタイン王国の‥‥リシャール！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0178",
   "jp": "{v:0007}そうあわてるな。{n}こいつは似ているが、あのリシャールとは別人だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0179",
   "jp": "{v:0008}別人だと？{n}‥‥それにしても似ている‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0180",
   "jp": "{v:0009}当然だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0181",
   "jp": "‥‥{v:000A}ヴェンツェル殿‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0182",
   "jp": "{v:000B}お前たち、まだこんなところにいたのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0183",
   "jp": "{v:000C}いいえ、わたしたち、エリオット君に{n}王位を取り戻させようとしているのですが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0184",
   "jp": "{v:000D}今ガラシールズに進駐しているバーンシュタイン軍を、{n}こいつの王位奪還のために引き上げさせる。{p}{v:000E}そこで、彼らに追撃を行わないよう、伝えてほしい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0185",
   "jp": "‥‥{v:000F}話が見えんな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0186",
   "jp": "{v:0010}あとで私が詳しく話してやろう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0187",
   "jp": "{v:0011}そうか、とうとう動き出すのか。{n}ならば追撃を行わないよう私から王に進言しておこう。{p}{v:0012}却下される心配はない。{n}すぐにでも、引き上げの準備をさせるがよい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0188",
   "jp": "{v:0013}ありがとうございます、ヴェンツェル様。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0189",
   "jp": "{v:0014}礼はいらぬ。{n}私はゲヴェルによる人間支配を防ぎたいだけ{n}なのだからな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0190",
   "jp": "{v:0015}それじゃ、よろしくお願いします。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen052.0191",
   "jp": "お兄ちゃん、{n}状況を考えてよ‥‥。",
   "en": "",
   "term": "end"
  }
 ]
}
