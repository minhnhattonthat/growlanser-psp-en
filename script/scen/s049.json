 "entries": [
  {
   "id": "scen049.0000",
   "jp": "",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen049.0001",
   "jp": "ランザック兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen049.0002",
   "jp": "見張り",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen049.0003",
   "jp": "ルイセ",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen049.0004",
   "jp": "ミーシャ",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen049.0005",
   "jp": "アリオスト",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen049.0006",
   "jp": "カレン",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen049.0007",
   "jp": "バーンシュタイン兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen049.0008",
   "jp": "オヤジ",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen049.0009",
   "jp": "店員",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen049.0010",
   "jp": "旅人",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen049.0011",
   "jp": "市民",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen049.0012",
   "jp": "ガラシールズ",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0013",
   "jp": "{v:0053}ちょっとアンタ、{n}今の話をみんなに知らせるのが先決でしょう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0014",
   "jp": "{v:0054}お兄ちゃん、まだ屋敷を調べてないよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0015",
   "jp": "{v:0055}どこへ行こうってのよ。まったく‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0016",
   "jp": "{v:0056}まだ屋敷を調べてませんけど？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0017",
   "jp": "{v:0057}ほらほら、戻った戻った。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0018",
   "jp": "{v:0058}あれ？{n}お兄さま、まだ屋敷を調べてないけど？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0019",
   "jp": "{v:0059}まだ屋敷を調べてないけどいいのかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0020",
   "jp": "{v:0052}ちょっとアンタ、{n}まだ情報収集がすんでないでしょうが！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0021",
   "jp": "{v:00ED}ここじゃ話せねぇんだ。{n}すぐに宿に行こうぜ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0022",
   "jp": "{v:0000}やっと着いたわね。{n}通行手形ってここまでしか来られないんでしょ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0023",
   "jp": "{v:0001}そう言ってたよね。{n}とりあえず場所は覚えたから、{n}テレポートは大丈夫だよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0024",
   "jp": "{v:0002}それで、ここから先はどうする？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0025",
   "jp": "{v:0003}これから先はどうするのですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0026",
   "jp": "{v:0004}でもここから先はどうすんの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0027",
   "jp": "{v:0005}そう言えば、関所の衛兵が気になることを{n}言っていたな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0028",
   "jp": "{v:0006}気になること‥‥。{n}何だっけ？{p}{v:0007}アンタ、覚えてる？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0029",
   "jp": "ウォレスのいう『気になること』とは{n}何だと思いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0030",
   "jp": "・街で問題を起こすなと注意された事",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen049.0031",
   "jp": "・街にバーンシュタイン兵がいる事",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen049.0032",
   "jp": "・思い出せない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen049.0033",
   "jp": "{v:0008}そうは言っていましたけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0034",
   "jp": "{v:0009}たしかにそう言ってはいましたね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0035",
   "jp": "{v:000A}そんなこと、言ってたね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0036",
   "jp": "‥‥{v:000B}だが俺が言っているのはそれじゃない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0037",
   "jp": "{v:000C}えっと‥‥、バーンシュタイン王国の兵隊さんが{n}いるって言ってたよね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0038",
   "jp": "{v:000D}ああ、思い出した！確かにそう言ってた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0039",
   "jp": "{v:000E}そうだ。{n}なぜバーンシュタイン兵がランザック王国の街に{n}いるのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0040",
   "jp": "{v:000F}う～ん、何だっけ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0041",
   "jp": "{v:0010}う～ん、何だっけ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0042",
   "jp": "{v:0011}えっと‥‥、この街にバーンシュタインの兵隊さんが{n}いるって話だと思う。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0043",
   "jp": "{v:0012}ああ、思い出した！確かにそう言ってた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0044",
   "jp": "{v:0013}俺たちと同じ目的で、ここへ来ているのかも知れん。{n}バーンシュタイン王国だって敵は減らしておきたい{n}はずだからな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0045",
   "jp": "{v:0014}手遅れだったのでしょうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0046",
   "jp": "{v:0015}それじゃ、手遅れ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0047",
   "jp": "{v:0016}手遅れだったということなのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0048",
   "jp": "{v:0017}まだ何とも言えんが‥‥。{p}{v:0018}せっかくここまで来たんだ。{n}連中の行動を探るところから始めてもいいだろう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0049",
   "jp": "ここから東が、ガラシールズの街だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0050",
   "jp": "{v:00E9}‥むぅ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0051",
   "jp": "‥‥{v:00EB}すまん、ちょっと話があるんだ。{n}宿にでも行かないか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0052",
   "jp": "{v:00EC}どうかしたの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0053",
   "jp": "{v:0025}ここから先へ行くには通行証が必要だぞ。{n}通行証を持っていない者を通すことは出来ない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0054",
   "jp": "この手形は、この街までのものだ。{n}ここより先へ通すわけにはいかん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0055",
   "jp": "何がしたいんだ？{n}用がないなら戻れ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0056",
   "jp": "{v:001A}お前ら！{n}ここで何してるんだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0057",
   "jp": "{v:001B}あらゼノス。{n}お久しぶり。{p}{v:001C}ゼノスこそ何してるの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0058",
   "jp": "{v:001D}俺か？{n}ランザック王国が傭兵を募ってるって聞いてな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0059",
   "jp": "{v:001E}傭兵！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0060",
   "jp": "{v:001F}ローランディア王国とバーンシュタイン王国が{n}戦争を始めちまったからな。{n}戦争の飛び火に備えるためだろ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0061",
   "jp": "{v:0020}それで、ランザック王国の傭兵になるの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0062",
   "jp": "{v:0021}いいや、まだ時間があるから、{n}ちょっとぶらついているところだ。{n}とりあえず話を聞いて、それから決めるさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0063",
   "jp": "{v:0022}そうなんだ。{n}それじゃ、がんばってね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0064",
   "jp": "{v:0023}ああ。{n}そっちもな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0065",
   "jp": "こう‥‥ドカンともうかる話ってねぇかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0066",
   "jp": "{v:0024}ここは立ち入り禁止だ！{n}さっさと立ち去れ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0067",
   "jp": "おい。{n}これ以上進むのはまずいぞ。{n}俺の顔を見られるかもしれん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0068",
   "jp": "{v:0073}まだ立ってるよ。{n}あの警備してる人をどうにかしないと{n}あの向こうを調べられないね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0069",
   "jp": "{v:0074}それじゃ、ルイセちゃん、お願いね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0070",
   "jp": "{v:0075}う、うん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0071",
   "jp": "{v:0076}あ、あの‥‥すみません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0072",
   "jp": "{v:0077}どうした？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0073",
   "jp": "{v:0078}あっちでケンカをしている人がいるんです！{n}早く止めないと‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0074",
   "jp": "{v:0079}しょうがないな。{n}案内しなさい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0075",
   "jp": "{v:007A}はい、こっちです‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0076",
   "jp": "{v:007B}やったわね。{n}さ、今のうちよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0077",
   "jp": "{v:007C}それじゃ、ミーシャ、任せたわよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0078",
   "jp": "{v:007D}まーかせて！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0079",
   "jp": "{v:007E}う～ん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0080",
   "jp": "‥‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0081",
   "jp": "{v:007F}う～ん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0082",
   "jp": "‥‥{v:0080}何だ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0083",
   "jp": "{v:0081}ああ、おじさん！{n}このあたりに道具屋さんはありませんか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0084",
   "jp": "{v:0082}道具屋？{n}こんな外れの方にあるわけがないだろう。{p}{v:0083}もっと市街地へ行け。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0085",
   "jp": "{v:0084}えぇっ？{n}市街地ってこっちじゃないんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0086",
   "jp": "{v:0085}さっき、人に聞いた通りに歩いてきたんですけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0087",
   "jp": "{v:0086}どうやったらこんな所まで来るんだ？{n}とにかく今来た道をもどれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0088",
   "jp": "{v:0087}聞いた通りに、歩いているつもりなんですけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0089",
   "jp": "‥‥{v:0088}それじゃ、あっちかなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0090",
   "jp": "{v:0089}バカッ！{n}そっちじゃないだろ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0091",
   "jp": "{v:008A}えっ？{n}だってアタシ、こっちから歩いてきたはず‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0092",
   "jp": "{v:008B}ああ、わかった、わかった！{n}途中まで一緒に行ってやる！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0093",
   "jp": "{v:008C}ありがとう！{n}おじさん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0094",
   "jp": "{FB00}{v:008D}み、見事だわ‥‥。{n}とても演技には思えないけど‥‥。{p}{v:008E}さ、とにかく今のうちに先へ進みましょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0095",
   "jp": "{v:008F}それじゃ、アリオストさん。{n}お願いね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0096",
   "jp": "{v:0090}ああ、任せておきな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0097",
   "jp": "{v:0091}すみません！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0098",
   "jp": "{v:0092}ん？{n}何だ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0099",
   "jp": "{v:0093}ちょっと道を聞きたいんですが？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0100",
   "jp": "{v:0094}道だと？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0101",
   "jp": "{v:0095}はい。{n}この辺りに珍しい鉱石を取り扱っているお店が{n}あると聞いたのですが？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0102",
   "jp": "{v:0096}そんな店はしらんな。{n}もっと街中で聞いてみろ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0103",
   "jp": "{v:0097}は、はぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0104",
   "jp": "{v:0098}すまない。{n}ダメだったよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0105",
   "jp": "{v:0099}えぇ～",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0106",
   "jp": "{v:009A}どうやら僕には向いてないみたいだ。{n}他の人に頼んでみてくれ。{p}{v:009B}それじゃ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0107",
   "jp": "{v:009C}別の人を探すしかないわね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0108",
   "jp": "{v:009D}それじゃ、カレンさん。{n}お願いしますね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0109",
   "jp": "{v:009E}はい。がんばります。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0110",
   "jp": "{v:009F}どうも、お疲れさまです‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0111",
   "jp": "{v:00A0}あ、ああ、どうも。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0112",
   "jp": "‥‥{v:00A1}あぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0113",
   "jp": "{v:00A2}どうしたんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0114",
   "jp": "‥{v:00A3}すみません、体が弱いもので‥‥うぅ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0115",
   "jp": "{v:00A4}しっかりしろ！おい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0116",
   "jp": "‥‥{v:00A5}すみません、宿まで肩を貸して{n}いただけないでしょうか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0117",
   "jp": "{v:00A6}ああ、だからしっかりするんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0118",
   "jp": "{v:00A7}さすが、大人の魅力ね。{p}{v:00A8}さ、今のうちに進みましょっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0119",
   "jp": "ちょっと！{n}せっかくのチャンスを無駄にスル気？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0120",
   "jp": "せっかくここまで来て、手ぶらで帰る気！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0121",
   "jp": "早くみんなの所へ戻ろうよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0122",
   "jp": "{v:00A9}ここにも警備をしてる兵隊がいるよ？{p}{v:00AA}あの屋敷で何をしてるのかな？{n}アタシ、ちょっと見てくるよ。{p}{v:00AB}あの屋敷の煙突から入れば、{n}気付かれずに様子を探れると思うんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0123",
   "jp": "{v:00AC}きゃ～～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0124",
   "jp": "{v:00AD}風が強くて、飛べないよぉ‥‥。{p}{v:00EE}やっぱり、アンタと一緒に行かなきゃダメみたい。{p}{v:00AE}屋根の所まで連れてってよ！{n}そこまで行けたら、煙突を通って、{n}中の様子を見てくるから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0125",
   "jp": "{FFEE}見張りに発見されず、煙突までたどりつけ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0126",
   "jp": "{FD00}{FD01}{v:00B7}ここを足場にすれば、屋根まで登れそうだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0127",
   "jp": "{v:00B8}やったね。{n}それじゃ、中の様子を見てくるから。{p}{v:00B9}アンタは今の間に外まで戻っててね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0128",
   "jp": "{v:00B5}まったく、下手ねぇ‥‥。{p}{FC00}{v:00B6}あ、風が弱まってきたみたい。{n}アタシが１人で行って来るよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0129",
   "jp": "{v:00B1}今度は見つからないようにね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0130",
   "jp": "{v:00B4}今度こそ見つからないようにね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0131",
   "jp": "{v:00AF}こらっ！{n}ここは子供の遊び場所じゃないぞ！{p}{v:00B0}さぁ、帰るんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0132",
   "jp": "{v:00B2}こらっ！{n}またお前か！{p}{v:00B3}子供は帰った、帰った！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0133",
   "jp": "{v:00BA}しかし、互いに歳を取ったものだな。{n}昔はもっと‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0134",
   "jp": "{v:00BB}無駄話をしに来たわけではあるまい。{n}さっさと本題に入れ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0135",
   "jp": "{v:00BC}いまだにその堅苦しい性格は直らんか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0136",
   "jp": "{v:00BD}大きなお世話だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0137",
   "jp": "{v:00BE}ふん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0138",
   "jp": "{v:00BF}我々、バーンシュタイン王国は国境の森を抜け、{n}間もなくローランディア王国と交戦する。{p}{v:00C0}その間にお前たちランザック王国は{n}ローランディア王国の背後に回り込み‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0139",
   "jp": "{v:00C1}作戦の確認はいい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0140",
   "jp": "{v:00C2}ならばランザック王国としての答えを聞こうか？{p}{v:00C3}この挟撃作戦に協力するのか？{n}それともしないのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0141",
   "jp": "{v:00C4}すでに出撃の準備は出来ている。{n}本当にバーンシュタイン王国が{n}我が国に攻め込まないと言うのであれば‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0142",
   "jp": "{v:00C5}それは約束しよう。{n}お前と俺の仲ではないか。{n}信じろ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0143",
   "jp": "{v:00C6}かつての友とは言え、{n}お前は団長なき傭兵団を見捨てて、{n}自分のために生きた男だ。{p}{v:00C7}あれから俺が部下を養うためにした苦労など、{n}想像も出来んだろうな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0144",
   "jp": "{v:00C8}そう言うな。{p}{v:00C9}もし俺がいたら、もっと苦労していたかもしれんぞ？{n}お前と俺は、水と油だからな。{p}{v:00CA}それに１人で苦労した原因を{n}俺だけに求めるのはどうかと思うが？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0145",
   "jp": "‥‥{v:00CB}ウォレスか。{p}{v:00CC}話がそれたようだな。{n}本題に戻ろう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0146",
   "jp": "‥‥{v:00CD}わかった。{n}では、この盟約書に互いにサインし、{n}それぞれ国王に届ける‥‥それでよいな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0147",
   "jp": "{v:00CE}ああ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0148",
   "jp": "{v:00CF}ひぇ～‥‥。{n}大変だぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0149",
   "jp": "‥‥‥{v:00D0}という事なのよ！{p}{v:00D1}早く宿に戻って、みんなに話さないと！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0150",
   "jp": "同盟の密談",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0151",
   "jp": "　{n}　　　『{FFEF}ティピの可能性４{FFF1}』を手に入れた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0152",
   "jp": "アンタねぇ‥‥。{n}ウォレスさんを放って、どこ行く気よ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0153",
   "jp": "あんた達、タダで泊まろうってのかい？{n}ちゃんとお金を払って泊まってくれよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0154",
   "jp": "{v:002B}ちょっと話がある。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0155",
   "jp": "{v:005A}あら、お兄ちゃん。{n}どうしたの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0156",
   "jp": "{v:005B}実は街外れを調べたいんだけど、{n}兵隊が見張ってて先へ進めないのよ。{n}そこで兵隊の気を逸らしてもらいたいんだけど。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0157",
   "jp": "{v:005C}わたしで良かったら、協力するけど。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0158",
   "jp": "・協力を頼む",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen049.0159",
   "jp": "・協力を頼まない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen049.0160",
   "jp": "{v:005D}うん、わかった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0161",
   "jp": "{v:005E}何かあったら、また声をかけてね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0162",
   "jp": "あ、お兄ちゃん。{n}まだ収穫はないよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0163",
   "jp": "{v:005F}あ、お兄さまだ♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0164",
   "jp": "{v:0061}いいよ！やる、やる！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0165",
   "jp": "{v:0062}ねぇ、ミーシャに頼んでみる？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0166",
   "jp": "・協力を頼む",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen049.0167",
   "jp": "・協力を頼まない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen049.0168",
   "jp": "{v:0063}お役に立てて、うれしいです！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0169",
   "jp": "{v:0064}いつでも声をかけてね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0170",
   "jp": "これから情報集めをはじめるところですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0171",
   "jp": "{v:0065}やぁ、そっちの調子はどうだい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0172",
   "jp": "{v:0067}ふ～ん。僕で良ければ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0173",
   "jp": "・協力を頼む",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen049.0174",
   "jp": "・協力を頼まない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen049.0175",
   "jp": "{v:0068}おやすいご用さ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0176",
   "jp": "{v:0069}いつでも声をかけてくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0177",
   "jp": "{v:006A}さっきは力になれなくてすまなかったね。{n}屋敷の中の様子はもう探れたのかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0178",
   "jp": "{v:006B}ううん、まだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0179",
   "jp": "{v:006C}そうか。{n}僕では力にはなれないけど、{n}きっと他に方法があるはずだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0180",
   "jp": "{v:006D}そうね。{n}他をあたってみるわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0181",
   "jp": "聞き込みというのは、難しいものだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0182",
   "jp": "{v:006E}あら。{n}何か手がかりはつかめましたか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0183",
   "jp": "{v:0070}私でよろしければ、お手伝いしますよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0184",
   "jp": "・協力を頼む",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen049.0185",
   "jp": "・協力を頼まない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen049.0186",
   "jp": "{v:0071}では、参りましょう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0187",
   "jp": "{v:0072}いつでも声をかけてくださいな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0188",
   "jp": "私はまだ何も‥‥。{p}そちらの調子はどうですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0189",
   "jp": "ようこそ！{n}スキマ屋ガラシールズ支店です。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0190",
   "jp": "買い物をしますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0191",
   "jp": "また来てね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0192",
   "jp": "なかなかいいスキマが見つからなくてね‥‥。{n}ここは仮店舗なんですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0193",
   "jp": "{v:003F}まぁ、いらっしゃい。{n}このお店は、どんな装備品でもそろってるわよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0194",
   "jp": "{v:0041}それで、買いに来たの？{n}売りに来たの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0195",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen049.0196",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen049.0197",
   "jp": "で、他にも何かある？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0198",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen049.0199",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen049.0200",
   "jp": "{v:004B}また来てよね。{n}素敵な笑顔で待ってるから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0201",
   "jp": "{v:0033}いらっしゃいませ。{n}この店では、様々なグッズをお買い求めいただけます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0202",
   "jp": "{v:0034}本日はお買い求めですか？{n}それともご売却ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0203",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen049.0204",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen049.0205",
   "jp": "他にも何かおありでしょうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0206",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen049.0207",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen049.0208",
   "jp": "{v:003E}ありがとうございました！{n}またどうぞ、お越し下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0209",
   "jp": "ここは砂漠のオアシス、{n}ガラシールズだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0210",
   "jp": "アンタら、ここから先には行かない方がいいよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0211",
   "jp": "木陰は涼しくていい‥‥。{n}さすがにこの炎天下じゃ、倒れかねないからね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0212",
   "jp": "私も旅をしているのですが、{n}この辺りはけっこう強い風がふきますな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0213",
   "jp": "実はここに来る途中にある森で迷ってしまって‥‥。{p}あんな所で迷ったら、{n}良くて目的ではない場所に行ってしまうか、{n}悪ければ死んでしまいますよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0214",
   "jp": "アンタ達、アクセサリー商人だって？{n}女って、どうしてそういうのが好きなのかねぇ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0215",
   "jp": "アンタ達、武器商人だって？{n}だったらローランディア軍に売った方が{n}良かったんじゃないのかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0216",
   "jp": "アンタ達、薬草売りだって？{n}薬草を探すならローランディア王国に{n}いい場所があるって聞いたことがあるよ。{p}この辺りに、何か珍しいものでも採れるのかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0217",
   "jp": "アンタ達、魔道具商人だって？{n}じゃあ、欲しがる人が少しくらいいるかも{n}しれないねぇ。{p}何でも魔法を極めた人が移り住んだって哮で、{n}この国にも少しずつ魔法が広まり始めたんだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0218",
   "jp": "アンタ達、花の球根や種を売ってるんだって？{n}そんな物を買う人がいるんだねぇ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0219",
   "jp": "{v:00E6}私、聞いちゃったんだ。{p}{v:00E7}バーンシュタイン兵がこの街にいるのは、{n}バーンシュタイン王国の高官がお忍びで{n}来ているかららしいよ。{p}{v:00E8}たしか、ガム‥‥なんとか、って人だって。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0220",
   "jp": "ねぇねぇ、{s:0010}って知ってる？{p}最近出来た土地らしいけど、どんな所なのかなぁ？{n}面白い所かなぁ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0221",
   "jp": "ねぇねぇ。{n}どこか面白い所ないかなぁ？{n}どこかに遊びに行ってみたくて‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0222",
   "jp": "{v:0019}何だお前たち？{n}そんなによそ者が珍しいのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0223",
   "jp": "見慣れない顔だね？{p}ははぁん‥‥。{n}ひょっとして、今この街に来ている、{n}ウェーバー将軍を見に来たのかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0224",
   "jp": "ウェーバー将軍？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0225",
   "jp": "知らないのかい？{n}我が国随一の将軍さ。{p}寡黙な人で、人望が厚いって評判だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0226",
   "jp": "見慣れない顔だね？{n}ひょっとして、今この街に来ている、{n}ウェーバー将軍を見に来たのかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0227",
   "jp": "あんたら、ランザックの者じゃないね？{n}あの迷いの森を通ってくるとは、{n}物好きな人もいるもんだね。{p}昔、あの森に入ったものは、{n}２度と出てくることはなかったそうだ。{n}他にも変な言い伝えがあったような‥‥。{p}　『白き光を放ちて、左へと回れ。{n}　　　さすれば扉は開かれん‥‥』{n}だったかな？{p}とにかくあの森には近寄らん方がいい。{n}くわばらくわばら‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0228",
   "jp": "とにかく迷いの森には近寄らん方がいい。{n}くわばらくわばら‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0229",
   "jp": "いよいよ戦争が起きそうだな‥‥。{p}まずは迷いの森でか、それとも東の平原か‥‥？{p}ま、近くの砦にいるローランディア兵次第だね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0230",
   "jp": "街外れの一軒家に、{n}定期的に人が出入りするようになったんだ。{n}いったい何やってるんだろう？{p}ま、ひどい目に遭うのもイヤだから、{n}深入りするつもりはないどけさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0231",
   "jp": "{v:00D2}お、帰ったか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0232",
   "jp": "{v:00D5}こっちは収穫なしだよぉ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0233",
   "jp": "{v:00D3}すまない。{n}収穫なしだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0234",
   "jp": "{v:00D4}ごめんなさい。{n}特に情報はないわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0235",
   "jp": "いらっしゃいませ。{n}１泊、{FFEB}エルムになりますが？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0236",
   "jp": "ありがとうございました。{n}気を付けて行ってらっしゃいませ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0237",
   "jp": "お客さま‥‥[01BE]{n}お金が足りないみたいですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0238",
   "jp": "またのお越しをお待ちしております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0239",
   "jp": "{v:002C}どうしたんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0240",
   "jp": "{v:002D}はい、何でしょうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0241",
   "jp": "{v:002E}どうしたの、ウォレスさん？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0242",
   "jp": "{v:002F}さっき街の人がウェーバーの話をしていただろ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0243",
   "jp": "{v:0030}たしか、将軍って言っていたよね。{n}その人がどうしたの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0244",
   "jp": "{v:0031}ウェーバーは俺の傭兵仲間だった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0245",
   "jp": "{v:0032}ウォレスさんの傭兵仲間？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0246",
   "jp": "{v:0033}ああ。{n}傭兵団には、俺の他にも２人の副団長がいた。{n}その１人がウェーバーだ。{p}{v:0034}奴は団長がいなくなると、残った部下を養うため、{n}ランザック王国と独占的な契約を結び、{n}そのまま正規軍になった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0247",
   "jp": "{v:0035}それじゃ、その将軍と話が出来れば、{n}ランザック王国と同盟を取り付けるのも{n}楽になるんじゃないかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0248",
   "jp": "{v:0036}確かにそうかも知れん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0249",
   "jp": "{v:0037}ところでもう１人の副団長って誰なの？{n}どこにいるの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0250",
   "jp": "{v:0038}先ほどの話だと、{n}もう１人の副団長がいるようですが？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0251",
   "jp": "{v:0039}もう１人の副団長の方は、{n}どうなさったのですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0252",
   "jp": "{v:003A}もう１人の名はガムランという。{n}傭兵の中でも風変わりな奴でな、{n}魔法を使った裏工作が得意だった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0253",
   "jp": "{v:003B}ガムラン‥‥か。{n}どこかで聞いたような‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0254",
   "jp": "{v:003C}似たような名前を街の中で聞いたよね。{n}ガムなんとかさんっていうバーンシュタイン王国の{n}高官がここに来ているって。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0255",
   "jp": "{v:003D}たしか街の人が言っていましたわ。{n}ガムなんとかさんっていうバーンシュタイン王国の{n}高官がここに来ているって。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0256",
   "jp": "{v:003E}ここに来ているバーンシュタイン王国の高官が{n}そんな名前じゃなかったかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0257",
   "jp": "{v:003F}同じ人だったりして！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0258",
   "jp": "{v:0040}あり得るな。{p}{v:0041}確かにガムランは団長の失踪と同時に、{n}傭兵団を抜けた男だ。{n}その後バーンシュタイン王国に渡って、仕官した。{p}{v:0042}そして俺たちのように同盟を取り付けるため、{n}旧友ウェーバーを頼った。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0259",
   "jp": "{v:0043}もしそうだとしたら、{n}わたし達の任務ってどうやっても{n}成功しないんじゃ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0260",
   "jp": "{v:0044}もっと調べないとダメだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0261",
   "jp": "{v:0045}みんなで別行動して、{n}情報収集した方がいいかもね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0262",
   "jp": "{v:0046}そうですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0263",
   "jp": "{v:0047}そうだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0264",
   "jp": "{v:0048}そうだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0265",
   "jp": "{v:0049}ああ、それがいいかも知れん。{p}{v:004A}だが、スマン。俺はここに残る。{n}もしガムランとウェーバーに見つかると、{n}こっちの動きがばれるからな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0266",
   "jp": "{v:004B}しょうがないよね。{p}{v:004C}それじゃ、みんなで別行動しましょ。{n}何かわかったら、またここで落ち合いましょう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0267",
   "jp": "{v:004D}うまく出来るかなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0268",
   "jp": "{FB00}{v:004E}さて、どこから当たるか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0269",
   "jp": "{v:004F}どうやればいいのでしょう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0270",
   "jp": "{v:0050}行ってきます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0271",
   "jp": "{v:0051}さ、アタシ達も行きましょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0272",
   "jp": "すまない。{n}俺は情報収集に出かけられん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0273",
   "jp": "{v:00D6}お兄ちゃん達はどうだった？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0274",
   "jp": "{v:00D7}それが、大変なの！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0275",
   "jp": "{v:00D8}詳しく話してみろ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0276",
   "jp": "{v:00D9}実はね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0277",
   "jp": "‥‥{v:00DA}そんな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0278",
   "jp": "{v:00DB}ガムランとウェーバーが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0279",
   "jp": "{v:00DC}それより早く何とかしないと！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0280",
   "jp": "{v:00DD}連中の話からすると、{n}迷いの森を通過して攻め込むらしいな。{p}{v:00DE}確かに森の中は入り組んでいるから、{n}ローランディア、バーンシュタインの両軍隊が{n}ぶつかっている間に背後を突くことが可能だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0281",
   "jp": "{v:00DF}どうするの？{n}このままじゃ、ランザックと同盟を結ぶどころか、{n}ローランディアが負けちゃうかも知れないじゃない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0282",
   "jp": "{v:00E0}それでは、どうする？{n}このままでは、ランザックと同盟を結ぶどころか、{n}下手をするとローランディアが負けるかもしれない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0283",
   "jp": "{v:00E1}それでは、私たちはどうすれば良いのでしょう？{p}{v:00E2}このままでは同盟どころか、{n}ローランディアが負けてしまうかもしれませんよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0284",
   "jp": "{v:00E3}俺たちで何とかこれを止める方法はないのか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen049.0285",
   "jp": "ウォレスさんを放っておいて、どこ行くつもりよ！",
   "en": "",
   "term": "end"
  }
 ]
}
