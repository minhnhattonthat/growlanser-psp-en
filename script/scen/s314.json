  },
  {
   "id": "scen314.0001",
   "jp": "{v:0079}た、助かりました‥‥。{n}犬は苦手なんですよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen314.0002",
   "jp": "{v:007A}なんで犬が苦手なの？{n}あんなの大したことないじゃない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen314.0003",
   "jp": "{v:007B}子供の頃、{n}大きな犬に追いかけ回されて以来、{n}どうも犬は‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen314.0004",
   "jp": "{v:007C}まあ誰にでも苦手なものはあるか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen314.0005",
   "jp": "{v:007D}そうですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen314.0006",
   "jp": "{v:007E}ん？{n}そういえばエリオット、{n}アンタまた城を抜け出して来たの！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen314.0007",
   "jp": "{v:007F}ええ。{n}こっそりと外にでられる所を見つけたんですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen314.0008",
   "jp": "{FB00}{v:0080}それって、お城の警備に問題があるんじゃ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen314.0009",
   "jp": "でも、今日はもう帰ることにしますよ[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen314.0010",
   "jp": "あんまり迷惑かけんじゃないわよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen314.0011",
   "jp": "{v:003B}エリオットじゃない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen314.0012",
   "jp": "{v:003C}あ、どうも。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen314.0013",
   "jp": "{v:003D}どうしてここにいるのよ？{n}出ていいって言われたの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen314.0014",
   "jp": "{v:003E}あの‥‥抜け出して来ちゃいました‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen314.0015",
   "jp": "{v:003F}どーーしてぇ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen314.0016",
   "jp": "{v:0040}だって、だって！{n}ずっとお城の中にいるなんて、つまんないですよ！{p}{v:0041}僕もあなた達と一緒に遊びたかったんです‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen314.0017",
   "jp": "{v:0042}って、言ってもねぇ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen314.0018",
   "jp": "どうしますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen314.0019",
   "jp": "・城へ戻れと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen314.0020",
   "jp": "・自分の面倒は自分でみろと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen314.0021",
   "jp": "・守ってやるから安心しろと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen314.0022",
   "jp": "‥‥{v:0043}はい‥‥。{p}{FC00}{v:0044}でも、今日くらいはいいですよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen314.0023",
   "jp": "{v:00EF}ま、いざとなったらコイツが何とかするでしょ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen314.0024",
   "jp": "{v:0045}はい、ご迷惑はおかけしませんから！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen314.0025",
   "jp": "{v:0046}もう、調子イイんだから★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen314.0026",
   "jp": "{v:0047}わぁ{FFF0}♥{FFF1}{n}やっぱり頼もしいなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen314.0027",
   "jp": "{v:0048}ちょっと、甘やかし過ぎじゃない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen314.0028",
   "jp": "アンタ、いつまでぶらぶらしてるつもり？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen314.0029",
   "jp": "夕方になったらお城に帰りますよ。",
   "en": "",
   "term": "end"
  }
 ]
}
