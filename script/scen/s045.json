  },
  {
   "id": "scen045.0011",
   "jp": "闘技場前広場",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0012",
   "jp": "{v:0031}やあ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0013",
   "jp": "{v:0032}おめでとう、ジュリアン。{n}俺は眼はよく見えないが、お前の戦いぶりは{n}良くわかったぜ。{p}{v:0033}剣に迷いがなかった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0014",
   "jp": "{v:0034}ありがとう。{n}これもみんなのおかげだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0015",
   "jp": "{v:0035}ここで立ち話もなんだから、街の方へ行かない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0016",
   "jp": "{v:0036}賛成！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0017",
   "jp": "　{n}　　　　　{FFEF}ジュリアンが同行者になった！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0018",
   "jp": "まさか、まさかの展開！{n}無名の{s:0000}、ゼノスを破ったぁ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0019",
   "jp": "フレッシュマン部門の会場は左、{n}エキスパート部門は右に進んで下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0020",
   "jp": "くぅ～、まさかゼノスが負けるとは！{n}陰謀だ！{n}これは陰謀だぁ～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0021",
   "jp": "あちゃ～っ！{n}みんな負けてもうた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0022",
   "jp": "ううっ、興奮しすぎて鼻血が‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0023",
   "jp": "次はエキシビジョンね。{n}最後まで頑張ってね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0024",
   "jp": "おめでとう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0025",
   "jp": "負けた‥‥。{n}かんぺきに負けた‥‥。{n}小遣いが全部パーだよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0026",
   "jp": "あーあ、負けちゃった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0027",
   "jp": "参加者の方は中の受付へどうぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0028",
   "jp": "アンタ、すごいじゃないか！{n}こんな大穴は初めて見たぜ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0029",
   "jp": "優勝、おめでとうございます。{n}次はエキスパート部門でがんばって下さいね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0030",
   "jp": "ゼノスは不調だったのか？{n}あんなもんじゃないはずだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0031",
   "jp": "くそっ！{n}{s:0000}なんて、{n}大穴過ぎて狙わんかったわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0032",
   "jp": "血がたぎるのぉ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0033",
   "jp": "優勝なんてすごいじゃない！{n}どきどきしたわ{FFF0}♥{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0034",
   "jp": "う～ん、来年は賭けに専念しようかな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0035",
   "jp": "ジュリアン様って素敵よね‥‥。{n}お手合わせ願いたいわ{FFF0}♥{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0036",
   "jp": "次のフリーバトルが開かれるまで、{n}闘技場はしばらくお休みです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0037",
   "jp": "フレッシュマン出場者専用受付",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0038",
   "jp": "２人とも、がんばれよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0039",
   "jp": "外に出るなら、俺も一緒に行こう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0040",
   "jp": "戦いの後の温泉は格別でしょうね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0041",
   "jp": "優勝、おめでとうございます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0042",
   "jp": "お疲れさまでした。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0043",
   "jp": "大会参加者の方は、ここで休んでいくことができます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0044",
   "jp": "{FFEB}エルムになりますが？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0045",
   "jp": "ご利用ありがとうございます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0046",
   "jp": "がんばって下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0047",
   "jp": "失礼ですが、お金が足りないようです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0048",
   "jp": "またのお越しをお待ちしております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0049",
   "jp": "{v:002D}やったな！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0050",
   "jp": "{v:0083}えへへ‥‥★{p}{v:002E}勝てるなんて思わなかったよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0051",
   "jp": "{v:0030}そういや、さっきジュリアンが、{n}外で待ってるって言ってたぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0052",
   "jp": "{v:001F}俺は参加できないから、観客席にいくぜ。{n}２人ともがんばれよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0053",
   "jp": "戦いで傷ついたら、ここで休んでくといいぜ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0054",
   "jp": "優勝おめでとう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0055",
   "jp": "客席はこの奥の方だぜ？{p}って、君は参加者なのか。{n}がんばれよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0056",
   "jp": "闘技大会は終了しました。{n}ここへの立入はできません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0057",
   "jp": "{v:0076}ああ、言い忘れたことがある。{p}{v:0077}最後にエキシビジョンマッチがあるから、{n}準備が済んだら戻っておいで。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0058",
   "jp": "{v:0078}{FB00}えきしびじょんまっち？{FFFA}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0059",
   "jp": "{v:0079}これから決勝が行われるエキスパートの部の優勝者と、{n}フレッシュマンの部で優勝した君たちとの戦いだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0060",
   "jp": "{v:007A}ええっ？{n}だってエキスパートの優勝者って、{n}すっごく強いんじゃ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0061",
   "jp": "{v:007B}多分勝てないだろうね。{p}{v:007C}というか、勝てなくてもいいんだよ。{n}それが普通だからね。{p}{v:007D}エキスパートの優勝者が{n}どれくらい強いかを示すための、余興の１つなんだ。{p}{v:007E}ま、エキスパートで優勝するくらいの人がどれくらい{n}強いのか、自分とのレベル差がどれくらいあるのかを{n}知るいいチャンスだと思えばいい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0062",
   "jp": "ここから先は関係者以外、立入禁止です。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0063",
   "jp": "控え室",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0064",
   "jp": "‥‥{v:0062}ねぇ、お兄ちゃん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0065",
   "jp": "{v:0063}あら、どうしたのよルイセちゃん？{n}難しい顔しちゃって？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0066",
   "jp": "{v:0064}さっきの、バーンシュタイン王国の王子って{n}人だけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0067",
   "jp": "{v:0065}どこかで見た覚えない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0068",
   "jp": "・あるような気がする",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen045.0069",
   "jp": "・覚えていない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen045.0070",
   "jp": "・男の顔は覚えられない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen045.0071",
   "jp": "・見覚えがある",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen045.0072",
   "jp": "{v:006F}ひょっとして、アンタ。{n}面倒くさいから考えてないんでしょ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0073",
   "jp": "{v:0070}わたしが言ってるのは、エリオット君のことだよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0074",
   "jp": "‥‥{v:0071}アンタらしいわ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0075",
   "jp": "{v:0072}わたしが言ってるのは、エリオット君のことだよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0076",
   "jp": "{v:0066}だよね？{p}{v:0067}それってやっぱり‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0077",
   "jp": "誰に似ていると思いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0078",
   "jp": "・アリオスト",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen045.0079",
   "jp": "・エリオット",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen045.0080",
   "jp": "・ジュリアン",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen045.0081",
   "jp": "{v:0068}えっ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0082",
   "jp": "{v:0069}あんたって、バカ？{n}どーしてアリオストさんなのよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0083",
   "jp": "{v:006A}わたしが言ってるのは、エリオット君のことだよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0084",
   "jp": "{v:006B}だよね？{n}やっぱりそう思うよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0085",
   "jp": "{v:006C}えっ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0086",
   "jp": "{v:006D}あんたって、バカ？{n}どーしてジュリアンなのよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0087",
   "jp": "{v:006E}わたしが言ってるのは、エリオット君のことだよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0088",
   "jp": "{v:0073}でもさ、それってどういうこと？{n}王子様とエリオットが同一人物だったの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0089",
   "jp": "{v:0074}う～ん‥‥。{FFF9}{FFFB}{n}{v:0075}知られたくなかったからなのかなぁ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0090",
   "jp": "君たち、本当に初参加かい？{n}エキシビジョンでエキスパート優勝者に勝つなんて、{n}前代未聞だよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0091",
   "jp": "また戦いに来ておくれ。{n}おじさん、君のファンになったからさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0092",
   "jp": "エキシビジョンの用意はもう出来ているよ。{n}勝つことよりも、エキスパート優勝者の実力を{n}知るつもりで、戦っておいで。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0093",
   "jp": "そうだね★{n}一応、コムスプリングスへ行く旅行券は{n}手に入れたしね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0094",
   "jp": "うん。{n}もう、負けても困ることないしね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0095",
   "jp": "はははっ。{n}負けて当然なんだから、何も気負う必要はないよ。{n}それじゃ、行っておいで。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0096",
   "jp": "負けて当然なんだから、何も気負う必要はないよ。{n}それじゃ、行っておいで。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0097",
   "jp": "とうとうやったな。{n}おめでとう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0098",
   "jp": "エキシビジョンで勝ったんだって！？{n}そりゃ、ゼノスが負けるのも納得だ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0099",
   "jp": "優勝、おめでとう！{n}あのゼノスに勝つとは‥‥。{n}大した奴だよ、まったく。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0100",
   "jp": "ジュリアンと戦っているところを、{n}ここから見せてもらったんだが‥‥。{n}君たちが勝つなんて思いもしなかったよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0101",
   "jp": "フレッシュマンの部、君たちが優勝したんだってな。{n}ゼノスを倒すなんて、なかなか、やるじゃないか。{n}おじさんは、あいつに勝てないからなぁ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0102",
   "jp": "良かったわよ、あなた達の試合！{n}そんな華奢な体なのに優勝なんて凄いじゃない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0103",
   "jp": "今年の試合は、{n}去年よりも白熱した試合が多いな。{n}実に満足だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0104",
   "jp": "はぁ‥‥。{n}リシャール様、素敵‥‥。{p}あんなに美しくて華奢なのに、{n}ナイト・マスターだなんて‥‥。{n}凄すぎ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0105",
   "jp": "ゼノスも惜しかったよな～。{p}でも、決勝になった途端、{n}いきなり弱くなったような気が‥‥。{p}ま、気のせいか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0106",
   "jp": "お前ら、なかなか良かったぜ。{n}あぁ‥‥。{n}今夜は興奮して眠れねぇな、こりゃ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0107",
   "jp": "いま見た戦いを思い出してるんだ。{n}話しかけないでくれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0108",
   "jp": "あなた達って、素敵ね‥‥。{n}弟もあなたを見習って欲しいわ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen045.0109",
