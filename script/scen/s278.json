  {
   "id": "scen278.0003",
   "jp": "{FFEE}盗賊からブレスレットを取り戻せ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen278.0004",
   "jp": "ホラ、{n}お前の大事なブレスレットはこっちだぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen278.0005",
   "jp": "{v:001E}ブレスレットを返して！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen278.0006",
   "jp": "う、うわっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen278.0007",
   "jp": "{FFEE}盗賊からブレスレットを取り返した！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen278.0008",
   "jp": "‥‥！！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen278.0009",
   "jp": "ぐはぁぁぁっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen278.0010",
   "jp": "くそう‥‥{n}しくじっちまった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen278.0011",
   "jp": "こんなことになるなら、{n}やめときゃよかった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen278.0012",
   "jp": "こ、こんな話に{n}乗るんじゃなかった‥‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen278.0013",
   "jp": "つ、強すぎる‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen278.0014",
   "jp": "{v:0021}やったわね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen278.0015",
   "jp": "返せ！{n}汚い手で、そのブレスレットに触るな！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen278.0016",
   "jp": "うぅっ‥‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen278.0017",
   "jp": "ヤバイよ！{n}あのフェザリアンの子も、守ってあげないと！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen278.0018",
   "jp": "私の‥ブレスレット‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen278.0019",
   "jp": "に、人間たちなんかに‥‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen278.0020",
   "jp": "バカっ！{n}あの子が死んじゃったじゃないの！",
   "en": "",
   "term": "end"
  }
