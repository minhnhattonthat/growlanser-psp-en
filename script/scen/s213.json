  {
   "id": "scen213.0001",
   "jp": "盗掘者",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen213.0002",
   "jp": "警備兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen213.0003",
   "jp": "{FFEE}盗掘者を捕らえろ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen213.0004",
   "jp": "{v:0063}へっ！{n}アバヨ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen213.0005",
   "jp": "{v:0064}バカ、バカ！{n}１人、逃げちゃったじゃない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen213.0006",
   "jp": "じゃあな！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen213.0007",
   "jp": "{v:0066}ああ、逃げられちゃった！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen213.0008",
   "jp": "‥‥{v:0067}仕方ねぇな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen213.0009",
   "jp": "{v:0068}はぁっ、終わった！{n}もう誰もいないよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen213.0010",
   "jp": "な、なんで俺が死ななきゃならねぇんだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen213.0011",
   "jp": "くそったれが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen213.0012",
   "jp": "こ、こんな事なら、{n}盗掘なんてしなきゃ良かった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen213.0013",
   "jp": "だ、だめだ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen213.0014",
   "jp": "もう少し早く、逃げればよかった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen213.0015",
   "jp": "ちきしょう！{n}今日で最後のはずだったのに‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen213.0016",
   "jp": "こ、この俺がガキ相手に負けるのか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen213.0017",
   "jp": "{v:0065}長居は無用だな。{n}俺も脱出するか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen213.0018",
   "jp": "{v:008A}長居は無用だな。{n}俺も脱出するか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen213.0019",
   "jp": "{v:005E}おい、遅いぞ！{n}何をぐずぐずしてる？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen213.0020",
   "jp": "{v:005F}新手！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen213.0021",
   "jp": "{v:0060}あっ、お前たち！{n}いったいどうやって入った？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen213.0022",
   "jp": "{v:0061}そんなことより、俺たちが逃げられるように{n}手伝ってくれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen213.0023",
   "jp": "{v:0062}おう！",
   "en": "",
   "term": "end"
  }
 ]
}
