   "term": "null"
  },
  {
   "id": "scen241.0001",
   "jp": "{FFEE}モンスター使いを倒せ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen241.0002",
   "jp": "{v:0020}まさか川を使うとはね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen241.0003",
   "jp": "{v:0021}川の流れを利用するとは考えたものだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen241.0004",
   "jp": "{v:0022}風だけでなく、流れる水も使えるとは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen241.0005",
   "jp": "{v:0023}要はこの粉の匂いが伝わればいいのです。{n}風や水は手段にすぎないのですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen241.0006",
   "jp": "{v:0024}それじゃ、アンタがいなくなれば{n}モンスターも元通りね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen241.0007",
   "jp": "{v:0025}だが、操る奴がいなくなれば、{n}モンスターどもも元に戻る！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen241.0008",
   "jp": "{v:0026}ならば元を絶つのみ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen241.0009",
   "jp": "{v:0027}罪もないモンスターたちを戦いに使うのはやめて！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen241.0010",
   "jp": "{v:0028}どうしてモンスターを戦わせるの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen241.0011",
   "jp": "{v:0029}彼らは私の友であり道具です。{n}農夫が馬に畑を耕させる。{n}狩人が犬に獲物を追わせる。{p}{v:002A}私はモンスターを戦わせる。{n}同じことですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen241.0012",
   "jp": "{v:002B}そんなの屁理屈よ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen241.0013",
   "jp": "{v:002C}生き物を道具だなんて言わないで！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen241.0014",
   "jp": "{v:002D}‥‥く‥私は‥‥。{n}‥すまない‥ラファガ‥‥。{n}‥‥お前の‥仇討ちは‥‥‥。{p}{v:002E}‥‥今度は‥一緒に‥空‥‥‥‥ぐふっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen241.0015",
   "jp": "‥‥お、おのれ！{p}これならどうです！？",
   "en": "",
   "term": "end"
  }
 ]
}
