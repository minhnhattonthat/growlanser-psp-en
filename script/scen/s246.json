   "id": "scen246.0001",
   "jp": "部下",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen246.0002",
   "jp": "{v:0017}ところでエリオットって、{n}どのテントにいるか聞いてないんだけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0003",
   "jp": "{v:0018}すまない。{n}ここで答えれば、奴らにも知られてしまう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0004",
   "jp": "{v:0019}自分たちで探すしかないか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0005",
   "jp": "{FFEE}エリオットを守りながら敵を倒せ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0006",
   "jp": "{v:0022}ここはアタシ達が泊まるテントだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0007",
   "jp": "‥‥{v:0023}ここは俺たちのテントだしな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0008",
   "jp": "‥‥{v:0024}ここは僕たちのテントだから‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0009",
   "jp": "{v:002B}ここって、お兄ちゃん達のテントだよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0010",
   "jp": "‥‥{v:002C}見覚えのある荷物‥‥‥‥{n}‥‥ってお兄さまのテントじゃない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0011",
   "jp": "{v:0025}えっと、ここはわたし達のテントだし‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0012",
   "jp": "‥‥{v:0026}見たことある荷物が‥‥。{p}{v:0027}あ、アタシたちのテントだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0013",
   "jp": "{v:0028}ここはルイセちゃんのテントだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0014",
   "jp": "{v:0029}ここはルイセのテントだな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0015",
   "jp": "{v:002A}ここはルイセ君のテントだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0016",
   "jp": "{v:002D}あ、いた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0017",
   "jp": "{v:002F}ここにいたか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0018",
   "jp": "{v:002E}あ、いた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0019",
   "jp": "{v:0031}エリオット君、見～つけ★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0020",
   "jp": "{v:0030}エリオット君、ここだったか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0021",
   "jp": "{v:0032}どうしたんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0022",
   "jp": "{v:0033}何、ボ～ッとしてんのよ！{n}アンタ、狙われてんのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0023",
   "jp": "{v:0034}ええっ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0024",
   "jp": "‥‥{v:0035}そいつがそうか。{n}なるほど、陛下に瓜二つだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0025",
   "jp": "{v:0036}見つけたぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0026",
   "jp": "{v:0037}えっ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0027",
   "jp": "{v:0038}バカ！{n}そいつら敵よ！{n}戦いなさい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0028",
   "jp": "{v:0039}えっ？{n}あっ？{n}はいっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0029",
   "jp": "{v:001A}ここじゃないみたいね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0030",
   "jp": "‥‥{v:001B}違うな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0031",
   "jp": "{v:001C}エリオット君？{p}‥‥{v:001D}いない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0032",
   "jp": "{v:001E}エリオット君？{p}‥‥{v:001F}う～ん、いないや。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0033",
   "jp": "‥‥{v:0020}ここじゃないな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0034",
   "jp": "‥‥{v:0021}いない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0035",
   "jp": "くっ！？{n}さすがに勝てぬか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0036",
   "jp": "‥‥。{n}逃がしたか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0037",
   "jp": "‥‥{v:0043}そ、そんな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0038",
   "jp": "{v:0044}バカ、バカ！{n}エリオットがやられちゃったじゃない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0039",
   "jp": "もうダメじゃ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0040",
   "jp": "もはやこれまで‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0041",
   "jp": "見事だ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0042",
   "jp": "この俺が後れをとるとは‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0043",
   "jp": "やるな‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0044",
   "jp": "ライエル様のためならば、{n}私の命など、いくらでもくれてやる‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0045",
   "jp": "まだ私はやれる‥は‥‥ず‥‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0046",
   "jp": "騒がしかったようですが、{n}何かあったんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0047",
   "jp": "‥‥‥アンタ、敵に狙われてたのよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0048",
   "jp": "えぇっ！？{n}それで、敵は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0049",
   "jp": "その調子じゃ、何ともなかったようね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0050",
   "jp": "{v:003A}ライエル様！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0051",
   "jp": "{v:003B}どうした？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0052",
   "jp": "{v:003C}う、裏切りです！{n}リーヴス将軍がダグラス卿の元へ‥‥！{n}至急、王都へお戻り下さい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0053",
   "jp": "‥{FE14}‥{FE14}{v:003E}わかった。{p}{v:003F}私は王都へ戻る。{n}お前たち、ここを頼む！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0054",
   "jp": "{v:0040}お任せ下さい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0055",
   "jp": "{v:0041}待て！{n}逃げるのか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen246.0056",
   "jp": "{v:0042}勝負はお預けだ。{n}また会うことになるだろう。",
   "en": "",
   "term": "end"
  }
 ]
}
