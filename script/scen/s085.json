  {
   "id": "scen085.0001",
   "jp": "　{n}　　　　　　　　　一方通行のようだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen085.0002",
   "jp": "　{n}　　　　　　　　　動いていない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen085.0003",
   "jp": "スイッチを押しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen085.0004",
   "jp": "{v:0015}あれ‥‥こんな所、前はあったっけ‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen085.0005",
   "jp": "{v:0016}構造が変わっちゃってるみたい‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen085.0006",
   "jp": "『{FFEF}賢者の石{FFF1}』を見つけたが、{n}これ以上、持つことはできない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen085.0007",
   "jp": "　{n}　　　　　『{FFEF}賢者の石{FFF1}』を手に入れた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen085.0008",
   "jp": "これはセーブポイントとは違うらしい。{n}何だろう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen085.0009",
   "jp": "『{FFEF}魔力増幅奥義の書{FFF1}』を見つけたが、{n}これ以上、持つことはできない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen085.0010",
   "jp": "　{n}　　　『{FFEF}魔力増幅奥義の書{FFF1}』を手に入れた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen085.0011",
   "jp": "　{n}　　　　　　　お宝、ゲットだぜ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen085.0012",
   "jp": "　{n}　　　どこかで、何かが動く音がした‥‥。",
   "en": "",
   "term": "end"
  }
