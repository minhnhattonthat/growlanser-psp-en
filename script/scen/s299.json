 "entries": [
  {
   "id": "scen299.0000",
   "jp": "",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen299.0001",
   "jp": "カレン‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen299.0002",
   "jp": "他の奴らはどうしてるんだろうな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen299.0003",
   "jp": "俺もカレンと一緒に{n}ここを手伝おうと思ってな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen299.0004",
   "jp": "よう、{s:0000}。{n}よく考えてみれば、お前に会えたのもガムランの{n}野郎がいたからだ。不思議なもんだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen299.0005",
   "jp": "おう、{s:0000}。{n}一度、一対一でお前と勝負したいもんだぜ。{n}来年の闘技大会には出るよな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen299.0006",
   "jp": "なあ、{s:0000}。{n}ルイセを大切にしろよ。{n}家族ってのは願っても得られないもんだからな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen299.0007",
   "jp": "よう、{s:0000}。{n}どっかうまい料理を食わせてくれる店、知らねぇか？{n}俺は、こう見えても味にうるさいんでな。{p}今度、俺の行きつけの店を教えてやるからよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen299.0008",
   "jp": "よう、{s:0000}。{n}俺もお前みたいに騎士になりたいと思っていたけどよ、{n}宮仕えってのはなかなか大変そうだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen299.0009",
   "jp": "なんだか、気ままに遠くへ行きたい気分だぜ。{n}事が片づいたら旅にでも出るかな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen299.0010",
   "jp": "どこ行こうか？",
   "en": "",
   "term": "end"
  }
 ]
}
