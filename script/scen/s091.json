  {
   "id": "scen091.0005",
   "jp": "看板",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen091.0006",
   "jp": "バーンシュタイン兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen091.0007",
   "jp": "　{n}　　　　　　　{FFF0}この先、メディス村{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0008",
   "jp": "　{n}　　　　　　{FFF0}この先、ラシェル保養地{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0009",
   "jp": "土砂崩れが起きていて、先へ進めそうにない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0010",
   "jp": "この土砂を取り除くには、{n}けっこうな時間がかかると思うよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0011",
   "jp": "いきなり土砂崩れがあったんだ。{n}まったく、大変なことだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0012",
   "jp": "知り合いがラシェルにある保養所に入院していてね。{n}お見舞いに行こうと思ったんだが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0013",
   "jp": "　{n}　　　　　　　　{FFF0}この先、遺跡{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0014",
   "jp": "　{n}　　　　　　　{FFF0}ブローニュ村入り口{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0015",
   "jp": "　{FFEF}北　　：ラシェル、メディス村方面{n}　{FFF0}西　　：ブローニュ村{n}　{FFEE}東　　：魔法学院方面{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0016",
   "jp": "　　　　　　{FFF0}この先、グランシル{FFF1}{n}　　　　　　　　　熱烈歓迎{n}　　　　　グランシル市　　観光協会",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0017",
   "jp": "　{n}　　　　　　　ここより北、魔法学院",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0018",
   "jp": "‥‥あっ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0019",
   "jp": "ねぇ、お兄ちゃん。{n}確か、旅行に行けるのって５人だったよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0020",
   "jp": "うん、そうだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0021",
   "jp": "アリオストさんも誘ってあげたらどうかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0022",
   "jp": "アリオストさんかぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0023",
   "jp": "きっとフェザリアンの事、知りたいと思うんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0024",
   "jp": "確かにな。{n}戻って、誘ってやったらどうだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0025",
   "jp": "　{n}　　　　　　この先、コムスプリングス",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0026",
   "jp": "ここから先はバーンシュタイン王国だ。{n}用のない者は通れぬぞ。{p}通行手形を提示せよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0027",
   "jp": "あぁ、お前たちか‥‥。{n}念のため、通行手形を提示してもらおう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0028",
   "jp": "ん？{n}お前たちか。{n}念のため、通行手形を提示してくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0029",
   "jp": "通行手形なんて持ってないよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0030",
   "jp": "手形を発行して貰わないとダメだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0031",
   "jp": "確か学院長が発行してくれるって言ってたよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0032",
   "jp": "それじゃ魔法学院へ戻らなきゃ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0033",
   "jp": "ここは現在封鎖中だ。{n}おとなしく、戻れ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0034",
   "jp": "ローランディアへ戻るのだな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0035",
   "jp": "どうした？{n}通らないのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0036",
   "jp": "うむ、正規の手形だな。{n}行き先はコムスプリングス‥‥。{p}なるほど。{n}お前たちが闘技大会の優勝者か。{n}今年の勝者は、思ったよりもきゃしゃだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0037",
   "jp": "ゆっくり温泉で休んでこい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0038",
   "jp": "通ってよし。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen091.0039",
   "jp": "行き先は水晶鉱山か‥‥。{n}うむ、正規の手形だな。",
   "en": "",
   "term": "end"
  }
 ]
}
