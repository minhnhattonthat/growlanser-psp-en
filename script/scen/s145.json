  {
   "id": "scen145.0001",
   "jp": "ダンジョンマン",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen145.0002",
   "jp": "店員",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen145.0003",
   "jp": "よくぞここまでたどりついた！{n}さぁ、地上まで送り届けてやろう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen145.0004",
   "jp": "中は空っぽだった！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen145.0005",
   "jp": "さすがだ！{n}さすが私が見込んだ男！{n}よくぞここまで来た！{p}そこで私からお前たちに、{n}素晴らしいプレゼントを送ろうと思う。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen145.0006",
   "jp": "さて、何か用はあるか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen145.0007",
   "jp": "・プレゼントが欲しい",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen145.0008",
   "jp": "・ダンジョンを出たい",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen145.0009",
   "jp": "・特にない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen145.0010",
   "jp": "まず誰が欲しいか選べ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen145.0011",
   "jp": "・{s:0000}",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
