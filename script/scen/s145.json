  {
   "id": "scen145.0001",
   "jp": "ダンジョンマン",
   "en": "Dungeon Man",
   "term": "null",
   "src": "ps1"
  },
  {
   "id": "scen145.0002",
   "jp": "店員",
   "en": "Shop Assistant",
   "term": "null",
   "src": "ps1"
  },
  {
   "id": "scen145.0003",
   "jp": "よくぞここまでたどりついた！{n}さぁ、地上まで送り届けてやろう！",
   "en": "Well done reaching this far! Now, I shall send you back{n}to the surface!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen145.0004",
   "jp": "中は空っぽだった！",
   "en": "It was empty inside!",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen145.0005",
   "jp": "さすがだ！{n}さすが私が見込んだ男！{n}よくぞここまで来た！{p}そこで私からお前たちに、{n}素晴らしいプレゼントを送ろうと思う。",
   "en": "Impressive! Just as I expected of the man I put my{n}faith in! Well done reaching this far!{p}And so, I intend to give you all a splendid gift.",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen145.0006",
   "jp": "さて、何か用はあるか？",
   "en": "Now then, is there anything you need?",
   "term": "end",
   "src": "ps1"
  },
  {
   "id": "scen145.0007",
   "jp": "・プレゼントが欲しい",
   "en": "・I'd like a gift",
   "term": "end",
   "unref": true,
   "src": "ps1"
  },
  {
   "id": "scen145.0008",
   "jp": "・ダンジョンを出たい",
   "en": "・I'd like to leave the dungeon",
   "term": "end",
   "unref": true,
   "src": "ps1"
  },
  {
   "id": "scen145.0009",
   "jp": "・特にない",
   "en": "・Nothing in particular",
   "term": "end",
   "unref": true,
   "src": "ps1"
  },
  {
   "id": "scen145.0010",
   "jp": "まず誰が欲しいか選べ。",
   "en": "First, choose who is to receive it.",
   "term": "end",
   "src": "ps1"
  },
  {
