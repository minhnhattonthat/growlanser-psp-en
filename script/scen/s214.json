  {
   "id": "scen214.0001",
   "jp": "警備兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen214.0002",
   "jp": "工作兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen214.0003",
   "jp": "バーンシュタイン兵隊長",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen214.0004",
   "jp": "バーンシュタイン兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen214.0005",
   "jp": "{v:0079}おうっ！{n}貴様ら何者だ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0006",
   "jp": "{v:007A}ローランディア王国軍か！？{n}橋を落とすつもりだな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0007",
   "jp": "{v:007B}敵を倒すことより、橋を落とすことを優先しろ。{n}誰でもいい、橋に到達したら、ロープを切るんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0008",
   "jp": "{v:007C}わ、わかった！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0009",
   "jp": "{v:007E}そうはいかんぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0010",
   "jp": "{FFEE}橋を落とし、西岸の敵を全滅せよ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0011",
   "jp": "くそっ！{n}まさかローランディアが我々の動きに{n}気づくとはな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0012",
   "jp": "橋ができる間の辛抱だ。{n}そうすれば向こう岸から増援が来る。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0013",
   "jp": "そうだな。{n}よし、俺たちで奴らの足止めをするぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0014",
   "jp": "工作兵は、そのまま作業を続行しろ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0015",
   "jp": "了解しました！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0016",
   "jp": "{v:0082}待ってろ！{n}すぐに援護に向かう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0017",
   "jp": "{v:0083}よし、完成だ！{n}向こう側へ進軍を開始するぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0018",
   "jp": "{v:0084}ちょっと！{n}早く橋を落とさないと、敵が来ちゃうじゃない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0019",
   "jp": "橋を落としますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0020",
   "jp": "{v:0086}このロープを切ればいいんだね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0021",
   "jp": "{v:0087}このロープを切れば‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0022",
   "jp": "橋を落とさせますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0023",
   "jp": "{v:0088}これ、切っちゃえばいいんだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0024",
   "jp": "ここは通さぬ！{n}通すわけには、いかぬのだ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0025",
   "jp": "ま、負けた‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0026",
   "jp": "我が槍術が破れるとは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0027",
   "jp": "この橋だけは‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0028",
   "jp": "し‥‥か‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0029",
   "jp": "た、助けて‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0030",
   "jp": "おのれ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0031",
   "jp": "う、うわ～っ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0032",
   "jp": "この私が！？{n}ま、まさか‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0033",
   "jp": "バーンシュタイン王国、万歳！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0034",
   "jp": "我が命、ジュリアン将軍に‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0035",
   "jp": "や、やるな‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0036",
   "jp": "もはやこれまでか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0037",
   "jp": "うぐっ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0038",
   "jp": "グハッ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0039",
   "jp": "{v:0089}バカ、バカ！{n}仲間が橋の上にいるでしょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0040",
   "jp": "ちょっ、ちょっと待ちなさいよ！{n}いま橋を落としたら、{n}仲間が取り残されちゃうじゃないの！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0041",
   "jp": "{v:0085}よぉし、ロープを切っちゃおう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0042",
   "jp": "{v:008A}や、やめろーーっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0043",
   "jp": "{v:008B}やったぁ！{n}橋が落ちたよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0044",
   "jp": "{v:008C}おのれ！{n}許さんぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0045",
   "jp": "{v:008D}しつこいなぁ、もうっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0046",
   "jp": "くっ‥‥。{n}これでは手出しできん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen214.0047",
   "jp": "{v:007F}ん？{n}あれはローランディアの兵か？{p}{v:0080}橋を落とす気だな？{n}そうはさせるか！{p}{v:0081}こっち側から橋を完成させてやる！",
   "en": "",
   "term": "end"
  }
 ]
}
