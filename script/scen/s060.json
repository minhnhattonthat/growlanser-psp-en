 "entries": [
  {
   "id": "scen060.0000",
   "jp": "",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen060.0001",
   "jp": "バーンシュタイン兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen060.0002",
   "jp": "ヴェンツェル",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen060.0003",
   "jp": "レティシア姫",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen060.0004",
   "jp": "申し訳ございません。{n}お戻り下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0005",
   "jp": "扉には鍵がかかっている。{n}どうやら入れないようだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0006",
   "jp": "ここから先へはお通しできません。{n}お戻り下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0007",
   "jp": "　{n}　　　　　　　鍵がかかっている！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0008",
   "jp": "{v:00C3}マイ＝ロード‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0009",
   "jp": "{v:00C4}あ、{s:0008}、ドレスに着替えたんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0010",
   "jp": "{v:00C5}こんな時でもなければ、{n}この服に袖を通すことがなさそうで‥‥。{n}申し訳ありません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0011",
   "jp": "どうしますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0012",
   "jp": "・似合っていると言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen060.0013",
   "jp": "・似合わないと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen060.0014",
   "jp": "・何も思わないと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen060.0015",
   "jp": "{v:00C6}マイ＝ロードに褒めていただけるなんて、光栄です。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0016",
   "jp": "{v:00CD}せっかくだから、手ぐらい握ってあげなさいよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0017",
   "jp": "‥‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0018",
   "jp": "{v:00C7}踊りませんか、マイ＝ロード。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0019",
   "jp": "{v:00C8}へぇ、けっこう上手いじゃん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0020",
   "jp": "{v:00C9}一人の殿方を独占できる幸せとは、{n}こういう時なのでしょうね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0021",
   "jp": "{v:00CA}あまり長い間、主賓が席を外すのも問題ですね。{n}そろそろ戻りましょう。{p}{v:00CB}私は着替えてから戻りますので、ここで。{p}{v:00CC}楽しいひとときをありがとうございました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0022",
   "jp": "{s:0004}をよろしくお願いします。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0023",
   "jp": "{v:000D}うわ～♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0024",
   "jp": "{v:000E}すご～い‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0025",
   "jp": "{v:000F}何だか足がすくんじゃいそう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0026",
   "jp": "{v:0010}{s:0002}！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0027",
   "jp": "{v:0011}その声、{s:0157}か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0028",
   "jp": "{v:0012}ああ。{n}{s:0161}王国を代表して、私が招かれたんだ。{p}{v:0013}しかし、驚いたな。{n}お前たちが{s:0119}を倒すとは。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0029",
   "jp": "{v:0014}まあな。{p}{v:0015}それより、隊長が見つかったんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0030",
   "jp": "{v:0016}何？{p}{FC04}{v:0017}よし、向こうで詳しい話を聞かせてもらおうか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0031",
   "jp": "{v:0018}やぁ、みなさん！{n}元気そうですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0032",
   "jp": "{v:0019}{s:0004}王も、お元気そうで何よりです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0033",
   "jp": "{v:0000}{s:0004}王。{n}{s:0161}には声をかけなかったんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0034",
   "jp": "{v:0001}そんなことはありません。{n}ですが、何やら急な用事が出来たとかで‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0035",
   "jp": "{v:0002}そうですか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0036",
   "jp": "{v:0003}とりあえず、今日は楽しんでいってください。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0037",
   "jp": "{v:001B}僕が案内しますよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0038",
   "jp": "{v:001A}そんな堅苦しい挨拶は抜きですよ！{n}さ、楽しんでいって下さい。{p}{v:001B}僕が案内しますよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0039",
   "jp": "{v:001C}{s:0006}、行こう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0040",
   "jp": "{v:001D}うん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0041",
   "jp": "{v:001E}我々も行かないか？{n}せっかくの料理を食い損ねるぞ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0042",
   "jp": "{v:001F}え～っ！{n}それはヤバイよぉ！{n}行こう、行こう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0043",
   "jp": "　{n}パーティーの間は閉じられているようだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0044",
   "jp": "ちょっと！{n}どこへ行く気よ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0045",
   "jp": "{v:0020}ご来場のみなさま。{n}ご歓談中、申し訳ありません。{p}{v:0021}人々の生活を脅かした{n}異形{s:0119}の脅威が去ったことを祝し、{n}ささやかながら宴をとりおこないたいと思います。{p}{v:0022}まずは{s:0160}国王、{s:0004}陛下より、{n}開会のご挨拶をたまわりたいと思います。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0046",
   "jp": "{v:0023}みなさん、お楽しみいただけているでしょうか？{n}先日まで、{n}我々は{s:0119}の脅威にさらされていました。{p}{v:0024}{s:0119}は恐ろしくも巧妙な手段で、{n}我が国を手中に収め、更には{s:0166}王国や{n}{s:0161}王国をも戦火にまみれさせようとしました。{p}{v:0025}今日、このような場を設けられたのも、{n}ひとえに彼らが{s:0119}の企みに気づき、{n}命がけで{s:0119}を倒したからであります。{p}{v:0026}みなさん、彼らに感謝の意を込めて{n}盛大な拍手をお願いします！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0047",
   "jp": "{v:0027}なんだか、照れちゃうね‥‥★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0048",
   "jp": "{v:0028}彼らが取り戻した平和を、我々で守っていきましょう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0049",
   "jp": "{FB00}{v:0029}ほえ～‥‥。{FFF9}{FFFB}{n}{v:002A}{s:0004}、立派になっちゃったわねぇ‥‥。{p}{FC02}{v:002B}さ、アタシ達も楽しもうよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0050",
   "jp": "{v:0000}あ、お兄ちゃん{FFF0}♥{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0051",
   "jp": "{v:0001}なーに、その幸せいっぱいそうな顔は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0052",
   "jp": "{v:0002}えへへ‥‥★{p}‥{v:0003}わたし、お兄ちゃんの妹で良かった！{n}だって、この戦争を止めた英雄の妹だよ？{n}鼻が高いよね★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0053",
   "jp": "なんと答えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0054",
   "jp": "・もっと感謝するように言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen060.0055",
   "jp": "・{s:0001}も頑張ったと言う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen060.0056",
   "jp": "{v:0005}うん{FFF0}♥{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0057",
   "jp": "{v:0006}でも、わたしががんばれたのは、{n}お兄ちゃんがいたからだもん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0058",
   "jp": "‥‥{v:0007}ま、今日は蹴らないでおいてあげるわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0059",
   "jp": "{v:0008}今日は{s:012A}一杯楽しもうね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0060",
   "jp": "{v:0009}お兄ちゃん、ちゃんと食べてる？{n}好き嫌いしちゃダメだからね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0061",
   "jp": "‥‥{v:000A}アンタ、{n}気をつけないと{s:0001}ちゃんの尻に敷かれるわよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0062",
   "jp": "{v:000B}あ、お兄ちゃん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0063",
   "jp": "{v:000C}どぅ？{n}楽しんでるぅ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0064",
   "jp": "{v:000D}うん。{n}でもね、なんか実感がなくって。{n}本当にわたしたちがこの国を救ったのかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0065",
   "jp": "{v:000E}当たり前じゃない！{n}だから堂々としてればいいの！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0066",
   "jp": "‥‥{v:000F}うん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0067",
   "jp": "‥‥{v:0010}わたし、堂々としてない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0068",
   "jp": "‥‥{v:0011}堂々と、じゃなくて『オドオド』してるわよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0069",
   "jp": "{FFF5}{v:0012}う～‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0070",
   "jp": "‥‥{v:0016}やっぱりすごいよな、お前。{p}{v:0017}この歳で、世界を救っちまったんだぜ、お前は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0071",
   "jp": "{v:0018}{s:0002}さん、おおげさだよ！{n}だって、{s:0002}さんだっていっぱい戦ったじゃない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0072",
   "jp": "{v:0019}とはいえ、俺たちを引っ張っていったのはお前だぜ？{n}俺は保護者みてぇに後をくっついてただけだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0073",
   "jp": "{v:001C}いろいろ感謝してるぜ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0074",
   "jp": "{v:001D}ん、何だ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0075",
   "jp": "{v:001E}楽しんでる？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0076",
   "jp": "{v:001F}ああ。{n}久々に旧友と酒が飲めて、最高の気分だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0077",
   "jp": "{v:00CE}ああ、最高の気分だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0078",
   "jp": "{v:0021}お前たちこそ楽しんでるか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0079",
   "jp": "{v:0030}{s:0006}！{n}そんなに大きな口開けてると、アゴ外れちゃうよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0080",
   "jp": "{v:0031}はうっ、お兄さま、{s:000E}ちゃん！{p}{v:0032}み‥見られた‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0081",
   "jp": "{v:0033}いまさら恥ずかしがることないでしょ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0082",
   "jp": "{v:0034}だって、だって、お兄さまに嫌われちゃったら‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0083",
   "jp": "{v:0035}大丈夫だって！{n}そんなことで壊れるのは本当の愛じゃないのよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0084",
   "jp": "{v:0036}そ、そうですか‥‥。{n}ちょっと安心しました。{p}{v:0037}最近やっと自分に自信がもてるようになったんですよ。{n}それもお兄さまと出会って、{n}いろいろ経験できたおかげと思うんです。{p}{FC03}{v:0038}そりゃ、あの時はショックでしたけど‥‥。{p}{FC00}{v:003A}でも今はアタシのことより、お兄さまのことが{n}気がかりです。まさか、お兄さまも{s:0119}に{n}作られた存在だったなんて‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0085",
   "jp": "{v:003B}あ、ごめんなさい！{n}言っちゃいけないことでした。{p}{v:003D}アタシってダメですね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0086",
   "jp": "{v:003E}とにかく、今は楽しみましょ？{n}ね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0087",
   "jp": "{v:003F}どーせ、アタシははしたないですよぉ、っだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0088",
   "jp": "{v:0040}もう、すねない、すねない！{n}‥‥でも、なんだか平和ねぇ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0089",
   "jp": "{v:0041}あの{s:0119}も倒しちゃったってことは、{n}もうみんなで冒険できないってことですよね？{p}‥‥{v:0042}ちょっと寂しいなぁ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0090",
   "jp": "{v:0043}何言ってんのよ！{n}これからは好きな時に会えるってことじゃない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0091",
   "jp": "{v:0044}それもそうですね！{n}今は安心して食べようっと！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0092",
   "jp": "{v:0046}お兄さまも楽しんでますか？{n}おいしい料理もいっぱいありますよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0093",
   "jp": "‥‥{v:0047}まだまだ、色気よりも食い気なのかしら‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0094",
   "jp": "{v:0022}やっほー、{s:0003}さぁーん♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0095",
   "jp": "{v:0023}やあ。ご機嫌そうだね、おチビちゃん。{n}ひょっとして酔ってるのかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0096",
   "jp": "{v:0024}やだ～！　アタシ、お酒なんて飲んでないよ！{p}{v:0025}でも、嬉しいから、いい気分！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0097",
   "jp": "{v:0026}あははっ。まったく、その通りだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0098",
   "jp": "{v:0027}これからも頼むよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0099",
   "jp": "{v:0028}やぁ。ご機嫌だね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0100",
   "jp": "{v:0029}とっても♪{n}平和だし、料理はすごいし、もう最高っ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0101",
   "jp": "{v:002A}あははっ、おいしいからって食べ過ぎると、{n}重くて飛べなくなっちゃうよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0102",
   "jp": "{v:002B}えっ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0103",
   "jp": "{v:002C}なんて、冗談だよ。{n}おチビちゃんは元気が取り柄‥‥って、{n}あっ、ちょっと、聞いてる？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0104",
   "jp": "{v:002D}むむぅ‥‥ダイエットしようかしら‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0105",
   "jp": "{v:002E}まいったな‥‥冗談だったのに‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0106",
   "jp": "{v:002F}今は心から楽しもうよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0107",
   "jp": "{v:0049}あら。どうしました？{n}何かご用ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0108",
   "jp": "{v:004A}楽しんでるかなぁって。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0109",
   "jp": "{v:004B}はい。{p}‥‥{v:004C}実は見たこともない料理がいっぱい並んでいて、{n}食べるより圧倒されていたところです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0110",
   "jp": "{v:00D0}料理は見るための物じゃないよ？{n}ちゃんと食べなくちゃ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0111",
   "jp": "{v:004D}え、えぇ‥‥。{p}{v:004E}恥ずかしい話ですけど、私、テーブルマナーというか、{n}こういったパーティーでどうしたらいいのか、{n}よくわからないのです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0112",
   "jp": "{v:004F}テーブルマナーねぇ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0113",
   "jp": "{v:0050}私の家は、兄と２人で暮らすのがやっとだったので、{n}こんな豪華な料理はとても‥‥。{p}{v:0051}変なことをして、他の人に笑われないかと思うと、{n}どうしても手を出し難くて。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0114",
   "jp": "{v:0054}まぁ、このメニューだったら、{n}普通に食べてれば大丈夫だと思うわよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0115",
   "jp": "{v:0055}そ、そうですね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0116",
   "jp": "{v:0056}そのことで、ちょっと聞きたいことが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0117",
   "jp": "{v:0057}なぁに？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0118",
   "jp": "{v:0058}席の左右に食器が並んでいますよね？{n}ナイフやフォークもいろいろあって、{n}どうしていいかわからないんです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0119",
   "jp": "{v:0059}ははぁ。それで全然食べてないのね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0120",
   "jp": "{v:005A}アンタ、教えてあげなよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0121",
   "jp": "・自分に近い食器から使う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen060.0122",
   "jp": "・自分から遠い食器から使う",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen060.0123",
   "jp": "・自分も知らない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen060.0124",
   "jp": "{v:005B}自分に近い食器ですね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0125",
   "jp": "{v:005C}自分から遠い食器ですね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0126",
   "jp": "{v:005D}それじゃ、私と同じですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0127",
   "jp": "{v:005E}おいしく食べられればそれでいいと思うけどね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0128",
   "jp": "{v:005F}どぉ、{s:0007}さん食べてる？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0129",
   "jp": "{v:0052}それが、教えてもらったように食べてきたのですが、{n}スープ料理のところで、{n}ナイフとフォークしかなくなってしまって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0130",
   "jp": "{v:0053}コイツ、ウソ教えたわね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0131",
   "jp": "{v:0060}え、えぇ‥‥。{p}{v:0061}マナーに気を取られているせいか、{n}味わう余裕がないのが本当のところですけど。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0132",
   "jp": "‥‥{v:0062}もうっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0133",
   "jp": "{v:0067}俺はシャドー・ナイツの手先として、{n}{s:0166}王国と戦ってたんだぜ？{p}{v:0068}いわば{s:0160}王国にとっちゃ、{n}忘れたい過去の汚点だ。{p}{v:0069}そんな俺がここに招かれているってのは、{n}やっぱり変じゃねぇか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0134",
   "jp": "{v:006A}考え過ぎじゃないの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0135",
   "jp": "‥‥{v:006B}そうかも知れんがな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0136",
   "jp": "{v:006C}俺の立場がどうあれ、料理に罪はねぇからな。{n}しっかり食うさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0137",
   "jp": "‥‥{v:006F}よぉ、お前たちか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0138",
   "jp": "{v:0070}元気ないよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0139",
   "jp": "{v:0071}まぁな‥‥。{p}{v:0072}ここへ来ちまったことを、今は後悔してんだ。{n}本当は断ろうかと思ったんだが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0140",
   "jp": "{v:0073}それって、{s:0007}さんのこと？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0141",
   "jp": "‥‥{v:0074}ああ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0142",
   "jp": "{v:0075}バカ！{n}そんなことしても、{s:0007}さんは喜ばないよ！？{p}{v:0076}今のアンタに必要なのは、{n}済んでしまった過去を悔やむ事じゃなくて、{n}これからどうやって生きられるかじゃないの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0143",
   "jp": "‥‥{v:0077}分かってるさ。{n}だからこうして出てきたんだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0144",
   "jp": "{v:0078}だったら、ここで決意を新たに、ね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0145",
   "jp": "{v:0079}ああ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0146",
   "jp": "{v:007A}ちゃんと食べてる？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0147",
   "jp": "‥‥{v:007B}悪いな。{n}やっぱりそんな気分じゃねぇんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0148",
   "jp": "{v:0088}あ、どうも！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0149",
   "jp": "{v:0089}知り合いをこんなに招待するなんて、{n}すごいじゃない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0150",
   "jp": "{v:008A}いやぁ‥‥。{p}{v:008B}何かの節{s:012A}が欲しかったんですよ。{n}これからは安心して過ごせるんだよって、{n}みんなに知ってもらえるような。{p}{v:008C}それに、みなさんは僕にとってお世話になった人たち{n}ですから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0151",
   "jp": "{v:008D}王様になったのに、全然変わらないね。{n}もっと偉そうになってると思ったのに。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0152",
   "jp": "{v:008E}そんなにすぐには変わりませんよ。{n}あの{s:000A}だって、{s:0119}によって覚醒される{n}前の性格は消えなかったじゃないですか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0153",
   "jp": "{v:008F}そうだったね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0154",
   "jp": "{v:0090}でも僕は少し変われたかな？{p}{v:0091}あなたと出会って、少し強くなれました。身も心も。{p}{v:0092}感謝しています。そして、すっごく尊敬しています！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0155",
   "jp": "{v:0093}尊敬は‥行き過ぎじゃない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0156",
   "jp": "{v:0094}いいえ！{n}もうあこがれちゃいますよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0157",
   "jp": "{v:0095}あ‥はは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0158",
   "jp": "{v:0096}だから僕も僕のまま。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0159",
   "jp": "{v:0097}なるほどね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0160",
   "jp": "{v:0098}本当にあこがれちゃうなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0161",
   "jp": "{v:0099}今日は楽しんで下さいね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0162",
   "jp": "{v:007C}あ、あの‥‥。{n}今、お忙しいですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0163",
   "jp": "{v:007D}よろしければ、２人で上にでも行きませんか？{n}前のパーティーの時のように‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0164",
   "jp": "{v:007F}では、先に行っていてください。{n}私はちょっと準備がありますので‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0165",
   "jp": "{v:007E}そうですか。{n}気が変わったら、声をかけて下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0166",
   "jp": "{s:0008}と上に行きますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0167",
   "jp": "{v:0080}そうですか。{n}仕方ありません。{n}諦めるとします。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0168",
   "jp": "‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0169",
   "jp": "{v:0081}お前のおかげで我が国も‥‥{n}いや、この大陸が救われた。{n}大した奴だな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0170",
   "jp": "{v:0082}え～っ！{n}コイツ、そんなに大した奴じゃないよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0171",
   "jp": "{s:000E}を黙らせますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0172",
   "jp": "{v:0083}ったいなぁ！{n}突つかないでよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0173",
   "jp": "{v:0084}クックックッ‥‥。{n}本当、大した奴だよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0174",
   "jp": "{v:0085}いやいや。{n}本当に、大した奴だよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0175",
   "jp": "{v:0086}どうした？{n}料理が口に合わないのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0176",
   "jp": "{v:009B}あなた達にはいろいろとお世話になりましたね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0177",
   "jp": "{v:009D}楽しんでいって下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0178",
   "jp": "{v:009F}こうして{s:0160}の方々と一緒に{n}パーティーが出来るのも、{n}あなた達のおかげですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0179",
   "jp": "{v:00A1}こうしていられるのも、あなた達のおかげですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0180",
   "jp": "{v:00CF}あなた達は偉業を成し遂げました。{n}しかし、それに慢心してはいけませんよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0181",
   "jp": "{v:00A3}えっと、まんしん‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0182",
   "jp": "{v:00A4}おごり高ぶることです。{n}何事も謙虚でなければなりません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0183",
   "jp": "{v:00A5}は、はぁ‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0184",
   "jp": "{v:00A6}あまり羽{s:012A}を外してはダメですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0185",
   "jp": "{v:00A8}ああ、君たちは{s:0002}の‥‥。{p}{FC04}{v:00A9}まだ{s:00BD}なのに、{n}あの{s:0119}を倒すとは恐れ入ったぞ。{p}{FC04}{v:00AB}何にしても、君たちに救われた。{n}ありがとう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0186",
   "jp": "{v:00AC}君たちに救われたよ。{n}ありがとう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0187",
   "jp": "{v:00AE}おお、君たちか。{n}実は今度の理事会で、{n}私が正式に学院長になることが決まりそうなんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0188",
   "jp": "{v:00AF}へぇ！{n}おめでとうっ！{p}{v:00B0}ところで、{s:0018}さんはどう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0189",
   "jp": "{v:00B1}それは私の方が聞きたいよ。{n}{s:0001}君はどうやってグローシュを{n}取り戻したんだね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0190",
   "jp": "{v:00B2}えっ？{n}プロミス・ペンダントじゃない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0191",
   "jp": "{v:00B3}本当にそれだけなのか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0192",
   "jp": "{v:00B4}それじゃね、人の持つ奇跡の力だ★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0193",
   "jp": "‥‥{v:00B5}奇跡の力か‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0194",
   "jp": "{v:00B6}さっきの回答は信憑性に欠けるよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0195",
   "jp": "{v:00B7}お前たちには世話になった。{n}あらためて礼を言わせてもらう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0196",
   "jp": "{v:00B8}でも、つらかったでしょ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0197",
   "jp": "‥‥{v:00B9}まあな。{p}{v:00BA}だが、気にしないでくれ。{n}{s:000A}様が昔のように戻られただけで十分だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0198",
   "jp": "{v:00BB}{s:000A}様のことは、気にしないでくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0199",
   "jp": "{v:00BC}やぁ、君たちには何度お礼を言っても、{n}言い足りないね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0200",
   "jp": "{v:00BD}でも、親友だったあの偽の王様、{n}牢屋に入れられちゃったんでしょ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0201",
   "jp": "{v:00BE}生きているなら、それだけでいいさ。{p}{v:00BF}２人のどちらかが敵になれば、どちらかが生き残る。{n}そして生き残った方が陛下を最後まで守る。{p}{v:00C0}それが{s:0154}と話し合って決めていたことだ。{n}その誓いは果たせたしね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0202",
   "jp": "{v:00C1}君たちには感謝しているよ。{p}{v:00C2}さ、今は楽しもう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0203",
   "jp": "どうぞお楽しみ下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0204",
   "jp": "{v:0004}きゃああああ！{n}何ナニ、いまのナニ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0205",
   "jp": "{v:0005}みなさん、落ち着いてください！{n}いま状況を確認させます！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0206",
   "jp": "{v:0006}どこかで爆発があったみたいだが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0207",
   "jp": "{v:0007}遠くの方みたいだったけど、{n}いったいどこだろう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0208",
   "jp": "{v:0008}陛下！{n}南の方で爆発を確認しました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0209",
   "jp": "{v:0009}南ですか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0210",
   "jp": "{v:000A}はい、方角と距離からして、{n}{s:0161}かと‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0211",
   "jp": "{v:000B}{s:0161}だと！？{n}そういえば、今日は{s:0161}が不参加だったな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0212",
   "jp": "{v:000C}偶然とは思えませんね。{p}{v:000E}{s:0001}、テレポートの使えるお前なら、{n}すぐに向かえるでしょう。{n}調査をお願いします。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0213",
   "jp": "{v:000D}は、はい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0214",
   "jp": "{s:0161}の調査",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0215",
   "jp": "{v:0030}{s:0001}ちゃん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0216",
   "jp": "{v:0031}うん！{FFFB}{n}{v:0032}テレポートするよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0217",
   "jp": "‥‥{v:0033}頼みますよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0218",
   "jp": "{s:0161}王城が危ない",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0219",
   "jp": "{v:0000}　　　　　　{FFEE}クックックックッ！{n}　　　　　　愚かな人間どもめ‥‥！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0220",
   "jp": "{v:0001}何！？{n}この声？{n}どこから聞こえるの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0221",
   "jp": "{v:0002}　　　　　{FFEE}聞こえるか、愚かな人間ども！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0222",
   "jp": "{v:0003}やっぱり聞こえる！{n}どこから！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0223",
   "jp": "{v:0004}頭の中に直接‥‥。{n}この波動は‥‥グローシュ！？{p}‥‥{v:0005}グローシアンの技術なの！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0224",
   "jp": "{v:0006}すごいなぁ、こんな技術を持っていたのか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0225",
   "jp": "{v:0007}感心してる場合かよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0226",
   "jp": "{v:0008}{FFEE}ついに‥‥私はついに、すべての力を取り戻した！{n}　　　　もう人間のふりをする必要はない！{n}　　　　　覚悟しろ、愚かな人間ども！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0227",
   "jp": "‥‥{v:0009}この声‥御師様‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0228",
   "jp": "‥{v:000A}{s:0025}‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0229",
   "jp": "{v:000B}{FFEE}　　　　　　我が名は{s:0025}。{n}　　　　　キング・オブ・グローシアン。{n}　　　　　お前たちの支配者たる存在だ。{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0230",
   "jp": "{v:000C}支配者だと！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0231",
   "jp": "{v:000D}{FFEE}　　　{s:0119}を倒して浮かれているようだが、{n}　　　我が能力をあの程度と一緒にするなよ。{n}　　　いわば、あれは旧型なのだからな！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0232",
   "jp": "{v:000E}それじゃ、あのフェザリアンが言ってた？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0233",
   "jp": "{v:000F}{FFEE}これから、この{s:0025}様の支配が始まるのだ！{n}　　　　　　まずは手始めに、{n}　　この{s:0161}王城を吹き飛ばしてくれる！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0234",
   "jp": "{v:0010}な、何！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0235",
   "jp": "{v:0011}待て、{s:0157}！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0236",
   "jp": "{v:0012}止めるな、{s:0002}！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0237",
   "jp": "{v:0013}今から急いでも、{n}お前が向こうに帰るまでに、{n}どれくらいかかると思ってるんだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0238",
   "jp": "‥‥{v:0014}くっ！{n}しかし、このまま黙っているわけには‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0239",
   "jp": "{v:0015}アタシ達と一緒に行きましょう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0240",
   "jp": "{v:0016}わたしのテレポートで、すぐに送ってあげられます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0241",
   "jp": "{v:0017}よし！{n}俺たちと一緒に行こう、{s:0157}。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0242",
   "jp": "{v:0018}すまない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0243",
   "jp": "　{n}　　{FFF0}一緒に向かうメンバーを選んで下さい。{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0244",
   "jp": "　{n}　　{FFF0}一緒に戦うメンバーを選んで下さい。{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0245",
   "jp": "{v:001A}アタシを連れてってくれますか！{n}お兄さまのお役に立ちたいの！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0246",
   "jp": "{s:0006}をパーティーに加えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0247",
   "jp": "{v:001B}{s:0006}、がんばるであります！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0248",
   "jp": "‥‥{v:001C}そうですか‥‥。{n}でも、アタシの力が必要になったら、{n}いつでも声をかけて下さいね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0249",
   "jp": "{v:001D}僕もご一緒していいのかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0250",
   "jp": "{s:0003}をパーティーに加えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0251",
   "jp": "{v:001E}きっと奴を倒せば、真の平和が訪れる。{n}さぁ、がんばろう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0252",
   "jp": "{v:0034}さぁ、がんばろう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0253",
   "jp": "‥‥{v:001F}そうか、仕方ないな。{n}少しはここに残って様子を見るよ。{p}{v:0020}僕の力が必要なら、いつでも呼びに来てくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0254",
   "jp": "{v:0021}私を連れて行って下さい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0255",
   "jp": "{s:0007}をパーティーに加えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0256",
   "jp": "{v:0022}これ以上、不幸な人は増やさせません！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0257",
   "jp": "‥‥{v:0023}そうですか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0258",
   "jp": "私も、兄さんと一緒にここに残ります。{n}みなさん、どうかお気をつけてください。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0259",
   "jp": "{v:0024}俺も連れてけ！{n}あんな奴、俺が葬ってやるぜ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0260",
   "jp": "{s:0005}をパーティーに加えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0261",
   "jp": "{v:0025}よっしゃ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0262",
   "jp": "‥‥{v:0026}チッ！{n}今回は譲ってやるよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0263",
   "jp": "いざって時のために、{n}こっちにも何人か残ってた方がいいだろ。{p}ここは俺が引き受けるから、{n}お前たちは{s:0161}に行ってくれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0264",
   "jp": "{v:0027}みんなの幸せを守りたいんです！{n}僕を連れていってくれませんか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0265",
   "jp": "{s:0004}をパーティーに加えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0266",
   "jp": "{v:0028}僕、がんばります！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0267",
   "jp": "‥‥{v:0029}そうですか。がんばって下さいね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0268",
   "jp": "{v:002A}国王として、できるかぎりのことをします。{n}まずは軍隊を動かして、{n}みなさんのバックアップをしますね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0269",
   "jp": "{v:002B}私も‥私も連れて行ってくれぬか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0270",
   "jp": "{s:0008}をパーティーに加えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0271",
   "jp": "{v:002C}ありがとう。{n}命の限り、戦い抜くつもりだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0272",
   "jp": "‥‥{v:002D}そうか。{n}共に闘えず、残念だ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0273",
   "jp": "{v:002E}私は{s:0153}や{s:0151}と、{s:00EA}を率いて戦う。{n}構わず先に行ってくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0274",
   "jp": "{v:0036}構わず先に行ってくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0275",
   "jp": "まさか{s:0025}が‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0276",
   "jp": "何が起こったのでしょう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0277",
   "jp": "何ということでしょう。{n}やっと平和が訪れたというのに‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0278",
   "jp": "なんだか、とても嫌な予感がします‥‥。{n}私の思い違いだといいのですが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0279",
   "jp": "頼みますよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0280",
   "jp": "さぁ、早く{s:0161}へ向かおう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0281",
   "jp": "うぅ‥‥。{n}こんな事がいつまで続くのだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0282",
   "jp": "今の揺れ方、自然ではなかったぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0283",
   "jp": "{s:0025}め‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0284",
   "jp": "万が一に備えて、私はここに残る。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0285",
   "jp": "クッ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0286",
   "jp": "あの揺れ、気になるな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0287",
   "jp": "これから我々はどうなるんだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0288",
   "jp": "また何か事件なんでしょうか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0289",
   "jp": "やっと{s:0119}がいなくなったのに‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0290",
   "jp": "何事もなければいいのですが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0291",
   "jp": "なんて事だ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0292",
   "jp": "な、何があったんだ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0293",
   "jp": "{v:002F}どうやら決まったみてぇだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0294",
   "jp": "どこへ行くつもりだい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0295",
   "jp": "お兄ちゃん！{n}今はそれどこじゃないでしょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen060.0296",
   "jp": "　{n}　　　　不思議な力でかき消された‥‥。",
   "en": "",
   "term": "end"
  }
 ]
}
