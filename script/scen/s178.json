  {
   "id": "scen178.0001",
   "jp": "時空制御塔の調査",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0002",
   "jp": "{v:0000}こ、これが時空制御塔‥‥！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0003",
   "jp": "{v:0001}お、大きいねぇ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0004",
   "jp": "{v:0002}これが時空融合計画の要だったのか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0005",
   "jp": "{FFF6}{v:0003}左様。{n}今は機能をロックされているがな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0006",
   "jp": "{v:0004}機能をロックだと？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0007",
   "jp": "{v:0005}安心しろ。{n}グローシアンの王であるワシだけが、{n}この機能を回復することが出来る。{p}{v:0034}どうだ、連れてきてよかっただろう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0008",
   "jp": "{v:0006}それじゃ、さっさとやってもらおうか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0009",
   "jp": "{v:0007}では、上に行くとしよう。",
   "en": "",
   "term": "end"
  }
 ]
}
