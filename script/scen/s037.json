 "entries": [
  {
   "id": "scen037.0000",
   "jp": "",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen037.0001",
   "jp": "ミーシャ",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen037.0002",
   "jp": "村人",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen037.0003",
   "jp": "ティピ",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen037.0004",
   "jp": "店主",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen037.0005",
   "jp": "召使い",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen037.0006",
   "jp": "ブラッドレー副学院長",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen037.0007",
   "jp": "医者",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen037.0008",
   "jp": "メディス村",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0009",
   "jp": "‥‥{v:000C}あれ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0010",
   "jp": "{v:000D}どしたの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0011",
   "jp": "{v:000E}ミーシャがいない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0012",
   "jp": "{v:000F}もうっ！{n}あの娘は‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0013",
   "jp": "{v:0000}懐かしいなぁ‥‥。{FFF9}{FFFB}{n}{v:0001}もうしばらく帰ってなかったから‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0014",
   "jp": "{FB00}{v:0002}えっ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0015",
   "jp": "{FFF3}‥‥{v:0003}ん？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0016",
   "jp": "{v:0004}だって、ミーシャ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0017",
   "jp": "‥‥{v:0005}なぁに？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0018",
   "jp": "‥‥{v:0006}頭、大丈夫？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0019",
   "jp": "{v:0007}ヒドイなぁっ！{n}そりゃ、アタシ、バカだけど、そんなに変じゃないよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0020",
   "jp": "‥‥{v:0008}ごめん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0021",
   "jp": "{v:0058}ああ！{n}待って、待って！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0022",
   "jp": "{v:0059}何処行ってたのよ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0023",
   "jp": "{v:005A}ちょっと。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0024",
   "jp": "ちょっと！{n}どこ行くのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0025",
   "jp": "{v:0009}あっ、お兄さま！{n}ここから向こうに行くと、{n}アタシのお家があるんですよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0026",
   "jp": "{v:000A}来てくれたら、お茶くらいごちそうしますよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0027",
   "jp": "{v:000B}この向こうにお前の家があるのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0028",
   "jp": "{v:000C}うん、そうだよ。{p}{v:000D}段々になったお花畑があって、{n}その上の方に一軒だけ家が建ってて、{n}そこがアタシのお家なんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0029",
   "jp": "{v:007E}へぇ‥‥。{n}ミーシャのお家ねぇ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0030",
   "jp": "{v:000E}アタシ、小さい頃に、お父さんとお母さんを{n}亡くしちゃって、困ってたところを{n}おじさまに拾われたんだよね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0031",
   "jp": "{v:000F}学院長先生に？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0032",
   "jp": "{v:0010}優しい人よね。{p}{v:0011}だけどアタシ、出来が良くないから、{n}おじさまの期待に応えられなくって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0033",
   "jp": "{v:0012}ミーシャ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0034",
   "jp": "{v:0013}ま、暗い話はやめておいて、とにかく家に来ない？{n}お茶くらい飲む時間あるでしょ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0035",
   "jp": "{v:0014}え、えぇ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0036",
   "jp": "{v:0015}ねぇ、お兄ちゃん。{n}ミーシャのことなんだけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0037",
   "jp": "{v:0016}ミーシャって、わたしの親友だよ。{p}{v:0017}だけど、何だかこの村に来てから、{n}ミーシャのことがちょっとヘンに思えちゃって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0038",
   "jp": "{v:0018}確かに今までも変だったよね。{p}{v:0019}この村に来るといつもいなくなっちゃってたし、{n}同じ村に住んでたはずの副学院長を{n}知らなかったり。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0039",
   "jp": "{v:001A}ミーシャの言ってたことも食い違ってるし‥‥。{p}{v:001B}それから、ブレーム山にクリアノ草を採りに{n}行った時だって、いきなり変な口調で喋ったり‥‥。{p}{v:001C}親友を疑うなんて、わたし、いけない子なのかな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0040",
   "jp": "何と言ってあげますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0041",
   "jp": "・親友を疑うのはいけない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen037.0042",
   "jp": "・確かにミーシャはおかしい",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen037.0043",
   "jp": "・ミーシャの目を覚ませるのはルイセだけ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen037.0044",
   "jp": "{v:0024}う‥うん。{n}そうだよね‥‥。{p}{FC00}{v:0025}ミーシャはわたしの親友だもんね！{n}何があっても、信じるよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0045",
   "jp": "{v:001D}そうよねぇ‥‥。{p}{v:001E}あの娘には何かあると思うわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0046",
   "jp": "{v:001F}ま、何があっても、最後まで見届けてやれ。{n}それが親友ってモンだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0047",
   "jp": "{v:0020}親友‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0048",
   "jp": "{v:0021}わたしが？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0049",
   "jp": "{v:0022}どんな秘密があるのか知らないけど。{n}何かあったら、頼むわよ。{p}{v:0023}親友ってのは、強いんだから！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0050",
   "jp": "{v:0026}ほら、早く、早くー！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0051",
   "jp": "{v:0023}入れ違いに帰っちゃったのかも知れないね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0052",
   "jp": "{v:0024}副学院長、実は家の中で倒れてるかもよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0053",
   "jp": "{v:0030}ドキドキするよぉ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0054",
   "jp": "{v:0031}いいから、早くしなさい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0055",
   "jp": "{FFF5}{v:0032}ふぇ～ん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0056",
   "jp": "{v:0033}不用心ね、ホントに鍵をかけてないなんて‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0057",
   "jp": "{v:0034}それじゃ、中に入るぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0058",
   "jp": "{FFF5}{v:0035}う、うぅ‥‥。{p}{FFF5}{v:0036}それじゃ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0059",
   "jp": "{FB00}{v:0037}あ、開いちゃった‥‥。{n}どうしよう！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0060",
   "jp": "{v:0038}決まってるだろ、入るんだよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0061",
   "jp": "おさげ髪の女の子？{n}ああ、その子なら村の外へ出ていったよ。{p}何か思い詰めた表情していたけど、{n}ご家族が病気か何かで保養所にでもいるのかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0062",
   "jp": "村の真ん中の大きな家が、{n}今度、魔法学院の学院長になられた{n}ブラッドレー様のお屋敷さ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0063",
   "jp": "こんな暇な村に来るなんて、{n}よほど重要な用事なんだろうね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0064",
   "jp": "え、魔法学院の副学院長の家だって？{p}それなら村の真ん中の大きなお屋敷さ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0065",
   "jp": "学院長の秘書を見かけなかったかって？{n}どんな人だかわからないけど、{n}誰もこの村には来てないわよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0066",
   "jp": "いいお天気ですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0067",
   "jp": "最近、何かと物騒ねぇ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0068",
   "jp": "ブラッドレーさん？{n}さあ、私は見かけてないけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0069",
   "jp": "わざわざこんな所まで‥‥。{n}ひょっとして、薬草の買い付けかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0070",
   "jp": "商人や薬師でもないのに、{n}物好きな人もいるんだねぇ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0071",
   "jp": "ねぇねぇ。{n}ちょっと前にも、女の人が来なかった？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0072",
   "jp": "待ち合わせでもしてるのかい？{n}残念だけど、誰も来てないよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0073",
   "jp": "{v:001A}おう、いらっしゃい。{n}ここは道具を売ってる店だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0074",
   "jp": "{v:001B}買いに来たのか？{n}それとも何か売る気か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0075",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen037.0076",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen037.0077",
   "jp": "まだ何か用か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0078",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen037.0079",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen037.0080",
   "jp": "{v:0025}じゃあな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0081",
   "jp": "副学院長はシロだと思うが‥‥。{n}念のために調べておいた方が、いいだろうな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0082",
   "jp": "副学院長、居留守してたりして‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0083",
   "jp": "この屋敷にアイリーンさんがいればいいのですが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0084",
   "jp": "僕は屋敷を調べるべきだと思うよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0085",
   "jp": "さて、どうしたものかな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0086",
   "jp": "{v:001F}留守だってよ。{n}これからどうする？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0087",
   "jp": "申し訳ございません。{n}ただいま、ブラッドレー様は外出しておりまして。{p}もうしばらくしたら戻られると思うのですが。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0088",
   "jp": "そうなんだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0089",
   "jp": "留守か‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0090",
   "jp": "留守‥‥留守‥‥。{p}留守っていえば、{n}アタシの実家はどうなってるだろ？{n}う～ん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0091",
   "jp": "お兄ちゃん‥‥。{n}わたし、ミーシャが心配なの‥‥。{n}お願い、一緒に探して！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0092",
   "jp": "副学院長は、さっき学院に行ったと思うけど？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0093",
   "jp": "{v:0012}ごめんくださーい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0094",
   "jp": "はい。ブラッドレー様にご用ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0095",
   "jp": "うん。{n}ちょっと会いたいんだけど？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0096",
   "jp": "そうですか‥‥。{n}それでしたら、その時にまた来ます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0097",
   "jp": "どうしようか？{n}一度、学院にでも戻る？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0098",
   "jp": "{v:0013}誰かな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0099",
   "jp": "{v:0014}あ、あのわたし、学院の生徒で‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0100",
   "jp": "{v:0015}ああ、たしかルイセ君だったね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0101",
   "jp": "{v:0016}はい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0102",
   "jp": "{v:0017}それで、何のようかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0103",
   "jp": "{v:0018}なに、のんびりしてるのよ！{n}ホールからグローシアンが消えちゃったってのに！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0104",
   "jp": "{v:0019}なんだと！？{n}それは大変だっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0105",
   "jp": "{FFF3}‥‥{FFF4}{v:001A}行っちゃった‥‥。{p}{FC00}{v:001B}これからどうする？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0106",
   "jp": "{v:001C}ミーシャもいなくなっちゃったし‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0107",
   "jp": "{v:001D}ごめんくださーい！{p}‥‥‥‥‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0108",
   "jp": "‥‥‥{v:001E}留守みたいだよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0109",
   "jp": "{v:0020}えぇっ！{n}お、お兄ちゃん、押し入る気！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0110",
   "jp": "{v:0021}確かに、他人の家に勝手に入るってのは{n}勧められねぇな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0111",
   "jp": "{v:0022}でも、副学院長、中で倒れてるかもよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0112",
   "jp": "{v:0025}それも一理あるな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0113",
   "jp": "{v:0026}それじゃ、こうしない？{p}{v:0027}鍵がかかってたら、あきらめるって事で。{n}どう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0114",
   "jp": "{v:0028}鍵を開けっ放しでいなくなるなんて思えねぇからな。{n}いないってわかれば、諦めもつくだろう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0115",
   "jp": "{v:0029}決まりね！{n}それじゃルイセちゃんお願い。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0116",
   "jp": "{v:002A}え、わたしぃっ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0117",
   "jp": "{v:002B}だって扉を開けてすぐ副学院長がいた時、{n}アンタだったら顔見知りじゃない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0118",
   "jp": "{v:002C}そんなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0119",
   "jp": "{v:002D}頼んだぜ、ルイセ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0120",
   "jp": "{v:002E}ふぇ～ん‥‥。{n}何でわたしが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0121",
   "jp": "{v:002F}早くしなさい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0122",
   "jp": "‥‥{v:0027}あらぁ‥‥。{FFF9}{FFFB}{n}{v:0028}しばらく来なかったら、お花畑がなくなってる‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0123",
   "jp": "{v:0029}ここは昔からこの通りですよ。{n}ここへはよく薬草を取りに来ましたから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0124",
   "jp": "{v:002A}ここは昔からこのままだって‥‥。{n}カレンさんがここに薬草を取りに来てたって。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0125",
   "jp": "ここは昔からこのままだって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0126",
   "jp": "{v:002B}うそ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0127",
   "jp": "{v:002C}あのね、ミーシャ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0128",
   "jp": "{v:002D}うそだよ！{p}{v:002E}この先にはアタシの家が‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0129",
   "jp": "{v:002F}ミーシャ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0130",
   "jp": "おい、{s:0000}。{n}あのまま放っておくつもりか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0131",
   "jp": "{v:0030}ミーシャ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0132",
   "jp": "{v:0031}アタシのお家、なくなってる‥‥。{n}どうして‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0133",
   "jp": "{v:0032}ミーシャ君‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0134",
   "jp": "{v:0033}ミーシャちゃん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0135",
   "jp": "{v:0034}お父さんとお母さんと、３人で暮らした‥‥、{n}アタシの‥お家が‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0136",
   "jp": "{v:0035}しっかりしてよ、ミーシャ！{n}きっと場所を間違えたんだよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0137",
   "jp": "{v:0036}もう、ミーシャったら、そそっかしいんだから！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0138",
   "jp": "{FFF3}{FFF6}‥‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0139",
   "jp": "‥‥{v:0037}ミーシャ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0140",
   "jp": "{FFF3}{FFF6}‥‥{FFF4}{v:0038}な‥わけ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0141",
   "jp": "{v:0039}えっ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0142",
   "jp": "{v:003A}そんなわけ、ないじゃない！{n}いくら、アタシが方向オンチでも、{n}自分の育ったお家を忘れるわけないじゃない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0143",
   "jp": "{v:003B}ミーシャ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0144",
   "jp": "{FFF5}{v:003C}確かにここだった！{n}ここで暮らしてた！{n}お花畑に囲まれた、小さなお家で暮らしてた！{p}{FC03}‥‥{v:003D}でも、ないの‥‥。{p}{v:003E}車百合のお花畑も‥‥。{n}赤い屋根の小さなお家も‥‥。{p}{v:003F}なんで、ないのよ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0145",
   "jp": "{v:0040}ほら、きっと、空き家だったから、{n}取り壊されちゃって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0146",
   "jp": "{FFF5}{v:0041}気休めはよして！{p}{v:0042}最初からここに家がなかったことなんて{n}見ればわかる！{p}{v:0043}だけど、アタシの記憶ではたしかにここなの！{n}ここで育った思い出があるの！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0147",
   "jp": "{v:0044}お、落ち着いてよ、ミーシャ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0148",
   "jp": "{FFF5}{v:0045}この記憶はなに！？{n}どっちが間違えてるの？{p}{v:0046}本当に、アタシはミーシャなの？{p}{v:0047}誰かの記憶をもった、ミーシャ？{n}ミーシャの記憶をもった、誰か？{n}ねぇ、教えてよ、ルイセちゃん！{p}{v:0048}ねぇ、教えて、お兄さま‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0149",
   "jp": "ミーシャにどんな言葉をかけますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0150",
   "jp": "・黙って抱きしめる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen037.0151",
   "jp": "・答えを急ぐ必要はないと慰める",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen037.0152",
   "jp": "・気をしっかり持つように励ます",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen037.0153",
   "jp": "・かける言葉が見あたらない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen037.0154",
   "jp": "{FFF5}{FFF3}‥‥{FFF2}{v:0049}あ‥‥{FFF6}{FFF3}。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0155",
   "jp": "{v:004A}１人で悩むな。{n}俺たちは仲間だろ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0156",
   "jp": "{v:004B}そうよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0157",
   "jp": "{v:004C}答えは急がなくていい。{n}じっくり考えて、一番正しい方向を見極めるんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0158",
   "jp": "{v:004D}何事も急いじゃダメよ。{n}急いだって、何にもならないんだから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0159",
   "jp": "{FFF5}‥‥{v:004E}みんな‥‥。{n}アタシなんかのために‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0160",
   "jp": "{v:004F}当たり前じゃない。{n}わたしたち、親友でしょ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0161",
   "jp": "‥‥‥{v:0050}ありがとう。{p}{v:0051}そうだよね。{n}もう少しよく考えてみる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0162",
   "jp": "{v:0052}そうだよ、急いじゃダメだよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0163",
   "jp": "{v:0053}でも‥‥でも‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0164",
   "jp": "{v:0054}いい、ミーシャ。{n}落ち着いて聞いて！{p}{v:0055}あなたの記憶が実際のものと違っていた。{n}でもそれがどうしたの？{n}それだけなんだよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0165",
   "jp": "{v:0056}そうだ。{n}君は君じゃないか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0166",
   "jp": "{FFF5}{v:0057}そうよ。{n}あなたはあなたじゃない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0167",
   "jp": "‥{v:0058}アタシは‥‥アタシ‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0168",
   "jp": "{v:0059}ああ。{n}お前はこうしてここにいる。{p}{v:005A}過去がなんだ。{n}今があるじゃないか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0169",
   "jp": "‥‥{v:005B}ごめんね、みんな‥‥。{n}確かに今のアタシはここにいるよ？{p}{v:005C}でも、過去のアタシの積み重ねが{n}今のアタシなの‥‥。{FFF9}{FFFB}{n}{v:005D}過去が違ってたら、今のアタシだって違っちゃうよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0170",
   "jp": "{v:005E}あ、ミーシャ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0171",
   "jp": "{v:005F}そうだよ、しっかりしなさいよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0172",
   "jp": "{v:0060}でも、自分の記憶が偽物だって思うと、不安なの！{p}{FC03}{v:0061}今の自分が、本当の自分じゃないように思えて‥‥。{n}記憶だけじゃなく、{n}すべてが作り物なんじゃないかって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0173",
   "jp": "{v:0062}ミーシャ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0174",
   "jp": "‥‥{v:0063}アタシはいったい誰なの？{p}{v:0064}ここで生まれたんじゃないなら、{n}アタシはどこで生まれたの！？{n}アタシは‥‥アタシは‥‥アタシは誰！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0175",
   "jp": "{v:0065}あ、ミーシャ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0176",
   "jp": "{v:0066}アタシ、誰なの‥‥？{n}教えて、お兄さま‥‥。{p}‥‥{v:0067}どうしてアタシは間違いの記憶を{n}こんなにはっきり覚えてるの？{n}アタシ、本当にミーシャでいいの？{p}{v:0068}助けて‥‥誰か、助けてよぉっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0177",
   "jp": "{v:0069}ミーシャ君！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0178",
   "jp": "{v:006A}ミーシャちゃん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0179",
   "jp": "‥‥{v:006B}冷たいようだが、どんな慰めも出来ねぇ。{n}自分で強くなるしか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0180",
   "jp": "{v:006C}だけど、その手伝いくらいできるよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0181",
   "jp": "{v:006D}そうね！{n}なんとかミーシャの謎を解いてあげましょう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0182",
   "jp": "‥‥{v:0039}おじゃましま～す‥‥。{p}{v:003A}なんだか緊張するね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0183",
   "jp": "{v:003B}大丈夫だ。{n}人の気配はない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0184",
   "jp": "‥‥{v:0039}おじゃましま～す‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0185",
   "jp": "多少進展があったんだ。{n}今外へ出るのは得策とは思えねぇな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0186",
   "jp": "おかしいな‥‥。{n}何の研究施設もないのが気になる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0187",
   "jp": "‥‥そうだよね。{n}どこかに隠し部屋があるのかなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0188",
   "jp": "もう少し詳しく調べてみる価値はありそうだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0189",
   "jp": "{v:0040}ねぇ、こんなところに階段ってあったかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0190",
   "jp": "{v:0041}きっと、さっきの音はこれだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0191",
   "jp": "{v:0042}地下室か‥‥。{p}{v:0043}ここにグローシアンが監禁されているのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0192",
   "jp": "絵の一部が不自然に盛り上がっている。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0193",
   "jp": "{v:003C}何かしら、これ？{n}スイッチになってるみたいだけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0194",
   "jp": "スイッチを押してみますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0195",
   "jp": "{v:003D}なになに、今の音！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0196",
   "jp": "{v:003E}何か動いたみたいな音だったぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0197",
   "jp": "{v:003F}そうね。{n}勝手にいじって壊したら困るモンね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0198",
   "jp": "本や小物が並んでいる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0199",
   "jp": "本が並んでいる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0200",
   "jp": "花が生けてある。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0201",
   "jp": "机の上や中には怪しいものはなさそうだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0202",
   "jp": "とくに怪しいところはない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0203",
   "jp": "この壁は叩くと音が響く。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0204",
   "jp": "{FFF3}‥‥‥‥。{FFFB}{n}誰もいないよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0205",
   "jp": "なんだか拍子抜け‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0206",
   "jp": "床の上には光の魔法陣が展開している。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0207",
   "jp": "この魔法陣って何かな？{n}ナニか危ないものかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0208",
   "jp": "この魔法陣って、何だと思う？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0209",
   "jp": "・すごく危険なもの",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen037.0210",
   "jp": "・危険なものではない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen037.0211",
   "jp": "・予想もつかない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen037.0212",
   "jp": "そ、それじゃ、すぐに逃げようよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0213",
   "jp": "‥‥アンタ、いい加減なこと言わないでよね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0214",
   "jp": "よくわかったね。{n}これは魔法の影響を{n}外界へもらさないようにするための物だよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0215",
   "jp": "うん。{n}この魔法陣は、魔法の影響を{n}外界へもらさないようにするための物だから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0216",
   "jp": "へぇ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0217",
   "jp": "うぅ‥‥大丈夫かなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0218",
   "jp": "慌てなくても大丈夫だよ。{p}これは魔法の影響を{n}外界へもらさないようにするための物だからね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0219",
   "jp": "大丈夫だよ。{n}この魔法陣は、魔法の影響を{n}外界へもらさないようにするための物だから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0220",
   "jp": "ジェームズ‥‥‥８２点（{FFEF}優{FFF1}）{n}ローリー‥‥‥‥７０点（良）{n}グイン‥‥‥‥‥７７点（良）{p}ルービン‥‥‥‥３５点（{FFF0}不{FFF1}）{n}ナンターラ‥‥‥５１点（可）{n}　　　　　　　どうやらテストの成績表らしい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0221",
   "jp": "カラのフラスコがある。{n}最近使われた形跡はない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0222",
   "jp": "　大呪術学体系　（序）{n}　　　　　　魔法学院副学院長　ブラッドレー著{p}どうやら副学院長が執筆した本らしい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0223",
   "jp": "‥‥ツボがある。{FFFB}{n}‥‥くずかご代わりに使われているようだ。{p}特に怪しいところはない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0224",
   "jp": "人の頭がい骨と思われる物が置かれている。{n}だが、特に怪しいところはない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0225",
   "jp": "アンタ、こんな物に興味があるの！？{FFFB}{n}{FB00}趣味を疑っちゃうわ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0226",
   "jp": "あ、わら束で作ったお人形だ！{p}{FC03}でも、何に使うんだろ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0227",
   "jp": "乳鉢と染料の粉がおいてある。{n}特に怪しいところはない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0228",
   "jp": "不気味な怪物がこちらをにらんでいる絵画だ。{n}グロテスクではあるが、その画力は高く、{n}今にも動き出しそうな雰囲気がある。{p}だが、特に怪しいところはない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0229",
   "jp": "何だか気持ち悪いなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0230",
   "jp": "小さなツボがたくさん並んでいる。{n}それぞれのツボには、薬や染料が入っているだけだ。{p}特に怪しいところは見あたらない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0231",
   "jp": "赤い染料を溶かした液が入っている。{n}特に怪しいところはない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0232",
   "jp": "大きなタルだ。{n}中に人の入っている様子はない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0233",
   "jp": "特に怪しい所は、ないみたい‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0234",
   "jp": "何か見つかったか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0235",
   "jp": "何だかいろいろあって、楽しいね★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0236",
   "jp": "気味が悪い部屋ですね‥‥。{n}気分が悪くなってきました‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0237",
   "jp": "う～ん。{n}‥‥これといって怪しい所はないようだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0238",
   "jp": "‥‥{v:0048}う～ん、ないや‥‥。{p}{v:0049}お兄ちゃん。{n}グローシアンに関係するような研究は、{n}どこにもないよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0239",
   "jp": "{v:004A}あてが外れたな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0240",
   "jp": "{v:004B}ここには何もなかった‥‥。{p}{v:004C}グローシアンはホールから消えてしまった。{n}その前後、校庭の隅から箱を持ち出す怪しい人影‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0241",
   "jp": "{v:004D}ホールで死んでいた副学院長の知り合い。{n}その手に握られていた赤いピアス‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0242",
   "jp": "{v:004E}犯人は誰なんだろう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0243",
   "jp": "お客様、勝手に入られては困ります。{n}お泊まりの際は、こちらにお申し付け下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0244",
   "jp": "君たち、インジェクターを見たことないかね？{p}あっ、インジェクターって言うのは注射器の事でね。{FFFB}{n}何度も手に入れることで中身の液体を変えて、{n}４段階まで強くする事ができるんだ。{p}グランシルのフリーバトルの賞品にあったらしいけど、{n}あんなものを使いこなせるのは{n}ラシェル保養所の看護婦さんくらいかな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0245",
   "jp": "どこかにいいインジェクターはないものか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0246",
   "jp": "いらっしゃいませ。{n}１泊、{FFEB}エルムになりますが？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0247",
   "jp": "ありがとうございました。{n}気を付けて行ってらっしゃいませ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0248",
   "jp": "お客さま‥‥[01BE]{n}お金が足りないみたいですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen037.0249",
   "jp": "お泊まりの際は、お声をかけて下さい。",
   "en": "",
   "term": "end"
  }
 ]
}
