  },
  {
   "id": "scen258.0101",
   "jp": "{v:002B}さて、ここに立てるとするか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen258.0102",
   "jp": "‥‥{v:002C}ん？{n}反応がない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen258.0103",
   "jp": "{v:002D}どうしたんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen258.0104",
   "jp": "{v:002E}どうしたんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen258.0105",
   "jp": "{v:002F}うむ、ここまで魔力を送信することが出来んようじゃ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen258.0106",
   "jp": "{v:0030}えぇっ！？{n}ど、どうすんのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen258.0107",
   "jp": "{v:0031}調整しなければダメじゃな。{n}もう少し待ってくれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen258.0108",
   "jp": "{v:0032}頼むぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen258.0109",
   "jp": "{v:0040}やれやれ、やっとたどり着いたわい。{p}{v:0041}ワシはこれで帰らせてもらう。{n}後はお前さんたち次第じゃ！{p}{v:0042}がんばってくれよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen258.0110",
   "jp": "{v:0043}ありがとね、おじちゃん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen258.0111",
   "jp": "{v:0044}人生で一番の思い出になったわい。",
   "en": "",
   "term": "end"
  },
