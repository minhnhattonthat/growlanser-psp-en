   "jp": "ローランディア兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen251.0005",
   "jp": "ぐはっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0006",
   "jp": "{v:0000}サンドラ様、援軍が到着しました！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0007",
   "jp": "{v:0001}逃げ遅れた市民の救助を優先させなさい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0008",
   "jp": "{v:0002}はっ！{p}{v:0003}第１小隊は敵の足止めを！{n}第２小隊は市民の救助を{n}優先せよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0009",
   "jp": "{v:0004}了解！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0010",
   "jp": "{v:0005}これ以上被害を出してはなりません！{n}なんとしてもここで食い止めるのです！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0011",
   "jp": "{v:0006}はっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0012",
   "jp": "{v:0007}まだ何とか持ちこたえてるみたい‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0013",
   "jp": "{v:0008}よし、俺たちも加勢するぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0014",
   "jp": "{FFEE}ルイセ、サンドラを守りつつ市民を救出しろ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0015",
   "jp": "{v:0009}マスター！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0016",
   "jp": "{v:000A}あなたたち、間に合ったのですね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0017",
   "jp": "{v:000B}俺たちも戦うぜ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0018",
   "jp": "{v:000C}クックックッ、報告通りだな。{n}その娘のグローシュが弱っているというのは。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0019",
   "jp": "{v:000D}今まで我が兄弟たちをいたぶってきた、{n}礼をさせてもらおうか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0020",
   "jp": "{v:0011}きゃあぁっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0021",
   "jp": "{v:0012}ルイセ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0022",
   "jp": "{v:0013}ルイセちゃん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0023",
   "jp": "いや～っ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0024",
   "jp": "そ、そんなひどい‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0025",
   "jp": "まだ死にたくない‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0026",
   "jp": "あぁ‥‥。{n}空が青い‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0027",
   "jp": "ぼ、僕、もうダメ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0028",
   "jp": "もっと遊びたかったよ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0029",
   "jp": "うぅ‥‥。{n}寒いよ～‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0030",
   "jp": "街の者たちを守らなければ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0031",
   "jp": "まだ死ねぬ、まだ死ねぬのだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0032",
   "jp": "こ、ここは‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0033",
   "jp": "後は頼んだぞ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0034",
   "jp": "{v:000E}ああっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0035",
   "jp": "{v:000F}サンドラ様！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0036",
   "jp": "{v:0010}マスター！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen251.0037",
   "jp": "あぁ‥‥街の人たちを{n}１人も助けられなかった‥‥",
   "en": "",
   "term": "end"
  }
 ]
