  {
   "id": "scen279.0001",
   "jp": "ジャスティン",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen279.0002",
   "jp": "ガーディアン",
   "en": "Guardian",
   "term": "null",
   "src": "ps1"
  },
  {
   "id": "scen279.0003",
   "jp": "{FFEE}援軍到着までヴェンツェルを守れ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen279.0004",
   "jp": "{v:0013}ああっ！{n}待ってアメリアさん！{n}それは‥‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen279.0005",
   "jp": "‥‥{v:0014}ごめんなさい‥‥。{n}これを返すわけにはいかないの‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen279.0006",
   "jp": "{v:0015}アメリアさーん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen279.0007",
   "jp": "くそっ、逃げられたか！{p}その上ヴェンツェルが殺されちまったら、{n}ルイセを戻す方法が分からなくなるぞ。{n}それだけは阻止するんだ、いいな！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen279.0008",
   "jp": "{v:0011}どうしてヴェンツェルをかばうの？{n}そいつは死んでもいい人間なのに‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen279.0009",
   "jp": "{v:0012}そんなこと言われたって、{n}アタシたちも殺させるわけにはいかないのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen279.0010",
   "jp": "俺たちの邪魔をするな！！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen279.0011",
   "jp": "チッ‥‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen279.0012",
   "jp": "邪魔をしないでくれ。{n}その男は生かしておけないんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen279.0013",
   "jp": "こっちに来るよ！{n}みんな、気をつけて！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen279.0014",
   "jp": "うっ‥‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen279.0015",
   "jp": "ギギ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen279.0016",
   "jp": "遅くなりました！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen279.0017",
   "jp": "あっ、やっときた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen279.0018",
   "jp": "マスターが今、こっちに警備兵を向かわせてるって！{n}それまで、ヴェンツェルを死なせちゃダメよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen279.0019",
   "jp": "‥‥ち、力を取り戻す寸前で‥‥。{p}‥‥ぐはっ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen279.0020",
   "jp": "ああ！{n}ヴェンツェルが死んじゃったら、{n}手がかりが‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen279.0021",
   "jp": "{v:0016}さすが、ローランディアの騎士たちだな‥‥。{p}{v:0017}メルフィ、ここは引き上げるぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen279.0022",
   "jp": "{v:0018}だけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen279.0023",
   "jp": "{v:0019}我々はこんなところで死ぬわけにはいかない。{n}今は退くんだ。{p}{FC02}{v:001A}ヴェンツェルからグローシュは奪った。{n}これで奴は脅威ではなくなった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen279.0024",
   "jp": "{v:0019}我々はこんなところで死ぬわけにはいかない。{n}今は退くんだ。{p}{v:001A}ヴェンツェルからグローシュは奪った。{n}これで奴は脅威ではなくなった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen279.0025",
   "jp": "‥‥‥‥{v:001B}わかった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen279.0026",
   "jp": "{v:001C}ああ、待て待て、待ちなさーーい！",
   "en": "",
   "term": "end"
  }
 ]
}
