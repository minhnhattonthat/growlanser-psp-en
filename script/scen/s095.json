 "entries": [
  {
   "id": "scen095.0000",
   "jp": "",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen095.0001",
   "jp": "プレート",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen095.0002",
   "jp": "ローランディア兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen095.0003",
   "jp": "ガルアオス監獄",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0004",
   "jp": "{v:0000}うわっ！{n}まるで要塞だね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0005",
   "jp": "{v:0001}ガルアオス監獄だ。{p}{v:0002}ガルアオスは『終局』を意味する。{n}生きてここを出られた奴はいねぇ。{p}{v:0003}有事の際には要塞として使えるように{n}造られてるって話だ。{n}ここに入れられたら、救出は不可能だな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0006",
   "jp": "{v:0004}それじゃ、護送中に助けないとダメなんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0007",
   "jp": "{v:0005}でもここへ連れて来られるのはわかっているから、{n}待ち伏せしやすいね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0008",
   "jp": "{v:0006}そうだな。{n}周囲の地形を調べて、襲撃ポイントを探そう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0009",
   "jp": "　　バーンシュタイン王国{n}　　　ガルアオス監獄",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0010",
   "jp": "{v:00A0}もう敵はいないようね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0011",
   "jp": "{v:00A1}くっ！{n}たった４人にここまでやられるとは‥‥。{p}{FC00}{v:00A2}だが手並みは、さすがと言うところか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0012",
   "jp": "お兄ちゃん、隠れる場所を探さないの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0013",
   "jp": "まだ見たい場所があるんだろう。{n}護送隊がくるまで、まだ時間があるからな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0014",
   "jp": "見たい場所って‥‥。{n}またあの監獄でも見るの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0015",
   "jp": "とにかく隠れる場所を探すのは、{n}{s:0000}に任せよう。{p}いい場所が見つかったら、{n}そこでじっと待っていればいい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0016",
   "jp": "{v:000A}ここって、橋に囲まれてるね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0017",
   "jp": "{v:000B}方角から考えて、この東側から護送隊が来るはずだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0018",
   "jp": "{v:000C}どうやらここが襲撃に適しているようだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0019",
   "jp": "{v:000D}あの橋も簡単な造りだから、すぐに壊せそう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0020",
   "jp": "{v:000E}ってことは、前に使ったあの作戦をやるの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0021",
   "jp": "{v:000F}そうだな。{p}{v:0010}大事な人質を歩かせて護送するとは思えん。{n}となると、馬車で来るはずだ。{p}{v:0011}馬車がここを通りかかったら戦闘を仕掛け、{n}橋を２ヶ所とも壊す。{n}そうすれば、護衛の奴らもそれ以上は手出し出来ねぇ。{p}{v:0012}後は残った敵を倒せば、楽に姫さんを助け出せる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0022",
   "jp": "{v:0013}だったら、それまでどこかに身を隠していた方が{n}いいんじゃない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0023",
   "jp": "{v:0014}そうだな。{p}{v:0015}俺は目が見えんから、お前が探してくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0024",
   "jp": "おい、それ以上先には進まない方がいいぜ。{n}下手に進むと護送隊とはちあわせだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0025",
   "jp": "{v:00A3}みなさんのおかげで、助かりました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0026",
   "jp": "{v:00A4}礼には及びません。{n}これも任務ですから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0027",
   "jp": "{v:00A5}しかし、これからどうやって帰るのですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0028",
   "jp": "{v:00A6}それは大丈夫！{n}こっちにはグローシアンがいるからね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0029",
   "jp": "{v:00A7}それじゃ、帰ろうよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0030",
   "jp": "{v:00A8}うん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0031",
   "jp": "　{n}　　　　{FFEF}レティシア姫が同行者になった！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0032",
   "jp": "もしよければ、ラージン砦に寄っていただけますか？{n}ブロンソン将軍にも心配をかけたと思うので‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0033",
   "jp": "確かにそうだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0034",
   "jp": "ここなら見えないんじゃない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0035",
   "jp": "ダメだ。{n}橋まで遠すぎる。{n}戦いを仕掛けたときに間に合わない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0036",
   "jp": "他の場所を、さがそうか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0037",
   "jp": "{v:0019}ここなら見つからないね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0038",
   "jp": "{v:001A}物陰になっていて、なかなかいい場所だ。{n}敵が通りかかるまでここで休んで、体力を温存しよう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0039",
   "jp": "{v:001B}賛成！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0040",
   "jp": "{v:001C}しかし、またここへ来ることになろうとはな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0041",
   "jp": "{v:001D}ウォレスさん、この辺りで何かあったんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0042",
   "jp": "{v:001E}ここから北東に行ったところに、{n}クレインっていう小さな村があってな。{p}{v:001F}その村を抜けたところで、{n}俺は両目と右腕を失ったんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0043",
   "jp": "{v:0020}ええっ！{n}そうなの！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0044",
   "jp": "{v:0021}まぁな。{p}{v:0022}{FC00}だが今は姫さんを助け出すことが第一だ。{n}体力を温存するために早く休んだ方がいい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0045",
   "jp": "{v:0023}それじゃ、２人ずつ、交代で休もうよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0046",
   "jp": "{v:0024}ルイセちゃん、頭いい～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0047",
   "jp": "{v:0025}もう、ミーシャったら、ちゃかさないでよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0048",
   "jp": "{v:0026}俺は先に休ませてもらうぜ。{n}後の方が、来る確率が高そうだからな。{n}その時は、俺が見張りをしていよう。{p}{v:0027}お前が一緒に見張りをしたい相手を選ぶんだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0049",
   "jp": "誰と見張りをしますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0050",
   "jp": "・ルイセ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen095.0051",
   "jp": "・ミーシャ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen095.0052",
   "jp": "{v:0028}わかったよ、お兄ちゃん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0053",
   "jp": "{v:0029}それじゃ頼んだぜ。{n}何かあったらすぐに起こせよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0054",
   "jp": "{v:002A}お兄さま、お休みなさい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0055",
   "jp": "{v:002D}それじゃ、ちょっとだけおしゃべりしようか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0056",
   "jp": "{v:002E}まぁ、少しだけだったらいいよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0057",
   "jp": "{v:002F}あのさ、お兄ちゃん？{p}{v:0030}国に仕官したこと後悔してない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0058",
   "jp": "なんと答えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0059",
   "jp": "・していない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen095.0060",
   "jp": "・ちょっとしてる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen095.0061",
   "jp": "・している",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen095.0062",
   "jp": "・なぜそんな質問をするのかたずねる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen095.0063",
   "jp": "{v:0031}そっか、やっぱりなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0064",
   "jp": "{v:0032}どうしてそんなこと聞くの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0065",
   "jp": "{v:0033}そうなんだ。{n}ちょっと意外‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0066",
   "jp": "{v:0034}どうしてそんなこと聞くの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0067",
   "jp": "{v:0035}だって、戦争になっちゃって、{n}バーンシュタイン王国の人たちと{n}戦わなくちゃいけないじゃない。{p}{FC03}{v:0036}ちょっと前まではお互い仲良かったのに‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0068",
   "jp": "{v:0037}そうよねぇ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0069",
   "jp": "{v:0038}このまま仲直りできなかったら、{n}まるでフェザリアンとグローシアンみたいに{n}なっちゃうんじゃないかなぁ‥‥。{p}{v:0039}そんなこと思っちゃったから‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0070",
   "jp": "‥‥{v:003A}それって、絶対嫌よねぇ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0071",
   "jp": "{FFF5}{v:003B}うん‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0072",
   "jp": "{v:003C}それじゃ、そろそろ見張りに専念しようか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0073",
   "jp": "{v:003D}でもそろそろ交代の時間だよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0074",
   "jp": "{v:0040}う～ん、よく休めたぜ。{n}それじゃ今度は俺とミーシャで見張る番だな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0075",
   "jp": "{v:0041}ゆっくり休んでね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0076",
   "jp": "{v:0042}はぁい！{n}一緒にがんばりましょ、お兄さま！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0077",
   "jp": "{v:0043}それじゃ頼んだぜ。{n}何かあったらすぐに起こせよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0078",
   "jp": "{v:0044}それじゃ、がんばってね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0079",
   "jp": "{v:0047}ねぇねぇ、お兄さま！{n}ちょっとだけおしゃべりしようよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0080",
   "jp": "{v:0048}まぁ、少しだけだったらいいよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0081",
   "jp": "{v:0049}実はお兄さまに聞きたいことがあったんです！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0082",
   "jp": "ミーシャの質問に答えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0083",
   "jp": "う゛‥‥[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0084",
   "jp": "{v:004A}お兄さまの好きな料理って何ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0085",
   "jp": "なんと答えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0086",
   "jp": "・あっさりした料理",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen095.0087",
   "jp": "・こってりした料理",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen095.0088",
   "jp": "・激辛料理",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen095.0089",
   "jp": "・激甘料理",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen095.0090",
   "jp": "・激苦料理",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen095.0091",
   "jp": "・好き嫌いはない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen095.0092",
   "jp": "{v:004B}あっさり系ですか‥‥。{p}{v:004C}サラダとか、お魚とかですかね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0093",
   "jp": "{v:00D4}こってり‥‥。{p}{v:004D}クリームシチューとかかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0094",
   "jp": "{FB00}{v:004E}げ、激辛ですかぁ！？{p}{v:004F}アタシ、辛いのはダメなんですよぉ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0095",
   "jp": "‥‥{v:0050}お兄さまが、甘党だったなんて、意外‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0096",
   "jp": "{v:0051}でも、でも！{n}アタシもケーキとか大好きなんですぅ♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0097",
   "jp": "{FB00}{v:00D5}激苦？{n}な、な、何ですか、それ！？{FFFA}{p}{v:0052}食べてみたいような、みたくないような‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0098",
   "jp": "{v:0053}わぁ♪{n}お兄さまの奥さんになる人って、{n}料理のしがいがありますねぇ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0099",
   "jp": "{v:0054}で？{n}そんなこと聞いてどうするの？{n}コイツに作ってあげるわけ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0100",
   "jp": "{v:0055}そうですねぇ‥‥。{p}{FC05}{FB00}{v:0056}あぁっ！{FFFA}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0101",
   "jp": "{v:0057}どうしたのよ、いきなり？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0102",
   "jp": "{v:0058}ど、ど、どうしましょ～[01BE]{n}アタシ、料理できない‥‥。{FFFA}{p}{FC03}{FFF5}{v:0059}ごめんなさい、お兄さま～[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0103",
   "jp": "{v:005A}そんなことだと思いました‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0104",
   "jp": "{v:005B}それじゃ、そろそろ見張りに専念しようか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0105",
   "jp": "{v:005C}でも、そろそろ交代の時間だよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0106",
   "jp": "{v:005F}う～ん、よく休めたぜ。{FFF9}{FFFB}{n}{v:0060}それじゃ今度は俺とルイセで見張る番だな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0107",
   "jp": "{v:0061}ゆっくり休んでね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0108",
   "jp": "{v:0062}おい、起きろ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0109",
   "jp": "{FFF6}{v:0063}また交代？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0110",
   "jp": "{v:0064}音が聞こえる‥‥。{p}{v:0065}歩兵が多数と、馬車の車輪の音‥‥。{p}{v:0066}どうやら護送隊がこっちに向かってるようだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0111",
   "jp": "{v:0067}いよいよだね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0112",
   "jp": "{v:0068}う～、緊張‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0113",
   "jp": "{v:0069}いいか。{p}{v:006A}戦闘を仕掛けるタイミングはお前に任せる。{n}一番いいと判断したときに、飛び出すぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0114",
   "jp": "{v:006B}任せたわよ！{n}変なタイミングに仕掛けたら、{n}すぐに負けちゃうからね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0115",
   "jp": "{FFEE}これより、{FFF0}待機モード{FFEE}に入り、{n}戦闘を仕掛けるタイミングを待ちます。{p}攻撃タイミングは、{n}画面上部に表示されるレーダーを見て、{n}判断して下さい。{p}敵は赤色のマーカーで、{n}姫が乗っている馬車は緑色のマーカーで、{n}表示されます。{p}攻撃を仕掛けるには、岩陰から出て下さい。{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0116",
   "jp": "ここじゃ見つかっちゃうよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0117",
   "jp": "ここじゃダメだと思うんだけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0118",
   "jp": "別の場所を探しましょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0119",
   "jp": "{v:0045}２人とも、お休み。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0120",
   "jp": "{v:002C}見張りって退屈だね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0121",
   "jp": "{v:005D}そうだったね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0122",
   "jp": "{v:005E}２人とも、起きて！{n}交代の時間だよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0123",
   "jp": "{v:0077}もう馬車がいないよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0124",
   "jp": "{v:0072}いっけーー！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0125",
   "jp": "{v:0076}む、敵だ！{n}馬車を止めるな！{n}兵は馬車の後方に！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0126",
   "jp": "{v:0078}くっ！{n}タイミングが遅すぎる‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0127",
   "jp": "{v:0073}む、敵だ！{n}馬車を止めろ！{n}兵は前に！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0128",
   "jp": "{v:0074}ああ、馬車がこっちまで来ない！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0129",
   "jp": "{v:0075}くっ！{n}タイミングが早すぎたか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0130",
   "jp": "{FFF3}‥‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0131",
   "jp": "{v:006C}あ、ジュリアンさんだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0132",
   "jp": "{v:006D}何、ジュリアンがいるのか？{p}{FC02}{v:006E}おい、奴はナイツ・メンバーだ。{n}せめて奴だけはやり過ごした方が賢明だぞ。{p}{FC00}{v:006F}ま、タイミングはお前に任せるがな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0133",
   "jp": "{v:0070}あ、馬車だ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0134",
   "jp": "{v:0071}多分、その馬車に姫さんが乗ってるはずだ。{n}攻撃タイミングはお前に任せる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0135",
   "jp": "{v:00A9}あ、ダメだ‥‥、お兄ちゃん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0136",
   "jp": "{v:00AA}どうしたの、ルイセちゃん！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0137",
   "jp": "{v:00AB}魔法を使いすぎたみたい。{n}‥‥テレポート出来ない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0138",
   "jp": "{v:00AC}それじゃ、この作戦自体が成り立たないじゃない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0139",
   "jp": "‥‥{v:003C}ふぅっ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0140",
   "jp": "{v:003D}やっと終わったわね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0141",
   "jp": "{v:003E}終わりじゃないだろ？{n}これからが本当の仕事だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0142",
   "jp": "{v:003F}えへへ、そうでした★",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0143",
   "jp": "{v:0012}何だ、ここまで来てるじゃない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0144",
   "jp": "{v:0013}何だ、ここまで来てるじゃない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0145",
   "jp": "{v:0014}でもなんだか様子が変だよ？{n}バーンシュタイン王国軍の格好してるし‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0146",
   "jp": "{v:0015}おい、それってもしかして‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0147",
   "jp": "あ、バーンシュタインの兵隊さんがいるよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0148",
   "jp": "でも、あいつらって、{n}ジュリアンの部下には見えないよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0149",
   "jp": "おい、それってもしかして‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0150",
   "jp": "{v:0016}あっはっはっ！{n}そりゃ、傑作だな！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0151",
   "jp": "{v:0017}だろう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0152",
   "jp": "{v:0018}それにしてもローランディアの連中も哀れだよな～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0153",
   "jp": "{v:0019}そうそう。{n}遠路はるばるやって来て、足止めだもんな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0154",
   "jp": "{v:001A}どうやらあの連中が、{n}ローランディア軍の進軍を妨害してるみたいね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0155",
   "jp": "{v:001B}お兄ちゃん、どうする？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0156",
   "jp": "・戦って倒す",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen095.0157",
   "jp": "・このまま接近する",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen095.0158",
   "jp": "・逃げ出す",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen095.0159",
   "jp": "{v:001C}幸い、あの連中は俺たちに気づいていない。{n}物陰に潜みながら進めば近づけるだろう。{p}{v:001D}戦うのはそれからでも遅くはない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0160",
   "jp": "{v:001E}逃げてどうすんのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0161",
   "jp": "{v:001F}奴らはこっちに気づいていない。{n}倒すなら今だぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0162",
   "jp": "{v:0020}ここには身を隠せるところが、いっぱいあるしね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0163",
   "jp": "{v:0028}むっ！{n}敵だ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0164",
   "jp": "{v:0029}あ、アニキ！{n}敵です！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0165",
   "jp": "{v:002A}馬鹿もの！{n}隊長と呼ばんか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0166",
   "jp": "{v:002B}馬鹿者！{p}{v:002C}こんな近くに来るまで気づかなかったのか！{n}お前たちは何をしていたんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0167",
   "jp": "{v:002D}も、申し訳ありません！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0168",
   "jp": "{v:002E}あれはグレンガル様の言っていた連中！？{p}{v:002F}奴らを、ここから逃がすな！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0169",
   "jp": "{v:0027}はっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0170",
   "jp": "{v:0022}おい！{n}何を無駄話をしているんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0171",
   "jp": "{v:0023}あ、アニキ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0172",
   "jp": "{v:0024}この馬鹿者がっ！{n}敵の接近に気づかんとは！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0173",
   "jp": "{v:0025}えっ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0174",
   "jp": "{v:0026}連絡されるとやっかいだ！{n}ここから逃がすな！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0175",
   "jp": "そう言えば、お前、あの娘どうなった？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0176",
   "jp": "あの娘？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0177",
   "jp": "お前がご執心だった、道具屋の娘だよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0178",
   "jp": "ああ。{n}ありゃダメだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0179",
   "jp": "どうした？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0180",
   "jp": "‥‥息子がいやがった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0181",
   "jp": "人妻だったのかよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0182",
   "jp": "ところでよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0183",
   "jp": "なんだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0184",
   "jp": "ローランディアの騎士で{n}{s:0000}って名前は聞いたことあるか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0185",
   "jp": "ある、ある！{n}なんでも凄腕で、{n}不可能を可能にするような奴なんだって？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0186",
   "jp": "何たって、あのグレンガル様が勝てなかったって話だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0187",
   "jp": "さっきの{s:0000}って奴だけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0188",
   "jp": "あん？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0189",
   "jp": "一緒にグローシアンまでいるらしいぜ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0190",
   "jp": "俺はメガネをかけた、大ボケ娘が一緒だって聞いたぜ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0191",
   "jp": "後は魔法学院の学者もいるって話だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0192",
   "jp": "俺は、何か虫みたいな奴を連れてるって聞いたぜ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0193",
   "jp": "後はごっついオヤジも一緒だって話だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0194",
   "jp": "なんてにぎやかなメンバー構成なんだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0195",
   "jp": "そんなんで、無敵ってんだから、信じられねぇよな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0196",
   "jp": "何で、そんな連中にグレンガル様が勝てないんだ？{n}オズワルドの馬鹿ならわかるが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0197",
   "jp": "お、おい！{n}そんなの聞かれたら、きっついおしおきをされるぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0198",
   "jp": "{v:001D}これでもう大丈夫だよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0199",
   "jp": "{v:001E}ありがとうございました！{p}{v:001F}すぐに橋を架けて合流地点に向かいます。{n}バーンシュタインの将軍に、そうお伝え下さい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0200",
   "jp": "{v:000D}どうした、ローランディアの腰抜けども！{n}渡りたかったら渡ってみろ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0201",
   "jp": "‥‥{v:000E}ムカツク奴ぅ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0202",
   "jp": "このままでは先へ進めないぞ‥‥。{n}一体どうすれば‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0203",
   "jp": "おかげで進軍できるようになりました。{n}ありがとうございます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0204",
   "jp": "こんな所で足踏みなんて‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0205",
   "jp": "急いで援護に向かわないと‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0206",
   "jp": "悔しいッス！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0207",
   "jp": "嬉しいッス！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0208",
   "jp": "くっ！{n}やっぱりダメだ！{n}これでは橋を架けられない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0209",
   "jp": "わはははっ！{n}悔しいかぁ～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0210",
   "jp": "あいつ、ムカツクゥ～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0211",
   "jp": "このまま忍び寄って、奴らを倒そう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0212",
   "jp": "{v:0004}ハッ！{n}アニキ、敵です！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0213",
   "jp": "{v:0005}何ぃっ！{n}見張りの連中は何をしていたんだ！{p}{v:0006}ええい、それより応戦準備だ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0214",
   "jp": "{v:0008}おお、君たちか。{n}実は、この先にかかっている小さな橋を{n}落とされてしまってな、先へ進めずにいるのだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0215",
   "jp": "{v:0009}橋くらい直せばいいじゃない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0216",
   "jp": "{v:000A}無茶言わないでくれ。{n}対岸に陣取られているので、{n}すぐに妨害されてしまうのだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0217",
   "jp": "{v:000B}で、立ち往生か‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0218",
   "jp": "{v:000C}このままでは、時間だけが浪費されてしまう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0219",
   "jp": "{v:000F}君たちはすごいな。この戦争を終わらせる、{n}最大の要因は君たち自身だよ。",
