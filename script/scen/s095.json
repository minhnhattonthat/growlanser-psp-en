   "term": "end"
  },
  {
   "id": "scen095.0230",
   "jp": "ありがとうございます！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen095.0231",
   "jp": "あんた達、その人数でどうしてあの連中を？",
